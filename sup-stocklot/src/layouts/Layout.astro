---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  path?: string;
  /** Full robots meta content override (e.g. "noindex, nofollow, noarchive"). */
  robots?: string;
}

const { title, description, noindex = false, path = '', robots } = Astro.props;
const siteName = SITE.name;
const fullTitle = path ? `${title} — ${siteName}` : `${siteName} — ${title}`;
const desc =
  description ??
  'B2B liquidation of brand-new cancelled-order and surplus inflatable SUP stocklots. FOB Qingdao, 72-hour inflated QC, third-party inspection welcome.';
const canonical = `https://supstocklot.com${path}`;
const robotsContent = robots ?? (noindex ? 'noindex, nofollow, noarchive' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <WhatsAppFloat />
  </body>
</html>
