---
import { SITE, waLink } from '../config';
---

<header class="sticky top-0 z-40 border-b border-slate-800/80 bg-slate-950/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <svg viewBox="0 0 24 24" class="h-7 w-7" aria-hidden="true">
        <path d="M3 14c2.2-3 4.4-3 6.6 0s4.4 3 6.6 0" fill="none" stroke="#2dd4bf" stroke-width="2" stroke-linecap="round"/>
        <path d="M3 18.5c2.2-3 4.4-3 6.6 0s4.4 3 6.6 0" fill="none" stroke="#2dd4bf" stroke-width="2" stroke-linecap="round" opacity="0.45"/>
        <circle cx="17.5" cy="6" r="2.6" fill="none" stroke="#f8fafc" stroke-width="1.8"/>
      </svg>
      <span class="text-slate-100">{SITE.name}</span>
    </a>
    <nav class="hidden items-center gap-5 text-sm text-slate-300 lg:flex" aria-label="Main">
      <a href="/available-sup-stock/" class="hover:text-teal-300">Inventory</a>
      <a href="/wholesale-inflatable-sup/" class="hover:text-teal-300">Wholesale</a>
      <a href="/sup-boards-for-rental/" class="hover:text-teal-300">Rental</a>
      <a href="/sup-boards-for-schools/" class="hover:text-teal-300">Schools</a>
      <a href="/shipping/" class="hover:text-teal-300">Shipping</a>
      <a href="/how-to-buy/" class="hover:text-teal-300">How to Buy</a>
      <a href="/about/" class="hover:text-teal-300">About</a>
      <a href="/contact/" class="hover:text-teal-300">Contact</a>
    </nav>
    <div class="flex items-center gap-3">
      <a
        href={waLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-3.5 py-2 text-sm font-semibold text-slate-950 transition hover:bg-[#1ebe5b]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.2-3.5-.7-3-1.2-4.9-4.2-5-4.4-.2-.2-1.2-1.6-1.2-3.1s.8-2.2 1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.6c-.2.2-.3.4-.1.7.2.3.9 1.5 1.9 2.4 1.3 1.1 2.3 1.5 2.7 1.7.3.1.5.1.7-.1l1-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.3 1.5Z"/>
        </svg>
        WhatsApp Sales
      </a>
    </div>
  </div>
</header>
