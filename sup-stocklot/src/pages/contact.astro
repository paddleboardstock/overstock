---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../config';
import { STOCKLOTS } from '../data/stocklots';
---

<Layout
  title="Contact & RFQ — Request a Stocklot Quotation"
  path="/contact/"
  description="Send your request for quotation: lots, quantities, destination market. Formal quote with tier pricing and freight within one business day. WhatsApp +86 133 0532 4192 or the RFQ form."
>
  <PageHero
    eyebrow="Contact &amp; RFQ"
    title="Request a Quotation"
    subtitle="Tell us what you need and where it is going — you get a formal quote with tier pricing, carton data and freight options within one business day. B2B inquiries only."
  />

  <section class="border-b border-slate-800/80">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-5">
        <!-- RFQ form -->
        <div class="lg:col-span-3">
          <h2 class="text-xl font-bold text-slate-100">RFQ form</h2>
          <p class="mt-2 text-sm text-slate-400">
            The form composes a structured WhatsApp message — nothing is stored on this site.
          </p>
          <form id="rfq-form" class="mt-6 grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <label for="rfq-company" class="block text-sm font-medium text-slate-300">Company / business name *</label>
              <input id="rfq-company" name="company" type="text" required class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-900/70 px-4 py-2.5 text-slate-100 placeholder-slate-500 focus:border-teal-400 focus:outline-none" placeholder="e.g. Coastline Watersports LLC" />
            </div>
            <div class="sm:col-span-1">
              <label for="rfq-website" class="block text-sm font-medium text-slate-300">Website / social store</label>
              <input id="rfq-website" name="website" type="text" class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-900/70 px-4 py-2.5 text-slate-100 placeholder-slate-500 focus:border-teal-400 focus:outline-none" placeholder="yourdomain.com or store link" />
            </div>
            <div class="sm:col-span-1">
              <label for="rfq-email" class="block text-sm font-medium text-slate-300">Business email *</label>
              <input id="rfq-email" name="email" type="email" required class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-900/70 px-4 py-2.5 text-slate-100 placeholder-slate-500 focus:border-teal-400 focus:outline-none" placeholder="you@company.com" />
              <p id="rfq-email-hint" class="mt-1.5 hidden text-xs text-amber-300">Free email domains are screened — corporate email is verified faster.</p>
            </div>
            <div class="sm:col-span-1">
              <label for="rfq-whatsapp" class="block text-sm font-medium text-slate-300">WhatsApp number</label>
              <input id="rfq-whatsapp" name="whatsapp" type="tel" class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-900/70 px-4 py-2.5 text-slate-100 placeholder-slate-500 focus:border-teal-400 focus:outline-none" placeholder="+1 555 000 0000" />
            </div>
            <div class="sm:col-span-1">
              <label for="rfq-nature" class="block text-sm font-medium text-slate-300">Business nature *</label>
              <select id="rfq-nature" name="nature" required class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-900/70 px-4 py-2.5 text-slate-100 focus:border-teal-400 focus:outline-none">
                <option value="">Select…</option>
                <option>Importer / distributor</option>
                <option>Brick-and-mortar retail</option>
                <option>Online retail (own store)</option>
                <option>Online marketplace seller</option>
                <option>Rental / watersports center</option>
                <option>School / club / training program</option>
                <option>Other B2B</option>
              </select>
            </div>
            <div class="sm:col-span-1">
              <label for="rfq-volume" class="block text-sm font-medium text-slate-300">Planned take-off volume *</label>
              <select id="rfq-volume" name="volume" required class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-900/70 px-4 py-2.5 text-slate-100 focus:border-teal-400 focus:outline-none">
                <option value="">Select…</option>
                <option>Trial: 10–49 pcs (express / LCL)</option>
                <option>Starter: 50–99 pcs (LCL / part-container)</option>
                <option>Wholesale: 100–299 pcs</option>
                <option>Container: 300+ pcs / FCL</option>
                <option>Take-all: entire lot(s)</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="rfq-market" class="block text-sm font-medium text-slate-300">Destination market / port *</label>
              <input id="rfq-market" name="market" type="text" required class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-900/70 px-4 py-2.5 text-slate-100 placeholder-slate-500 focus:border-teal-400 focus:outline-none" placeholder="e.g. Los Angeles, US / Hamburg, DE" />
            </div>
            <div class="sm:col-span-2">
              <span class="block text-sm font-medium text-slate-300">Lots of interest</span>
              <div class="mt-2 grid gap-2 sm:grid-cols-2">
                {STOCKLOTS.map((lot) => (
                  <label class="flex cursor-pointer items-start gap-2.5 rounded-xl border border-slate-800 bg-slate-900/50 px-3.5 py-2.5 text-sm text-slate-300 transition hover:border-teal-400/40">
                    <input type="checkbox" name="lots" value={lot.id} class="mt-0.5 h-4 w-4 accent-teal-400" />
                    <span><span class="font-mono text-xs text-teal-300">{lot.id}</span> — {lot.title}</span>
                  </label>
                ))}
              </div>
            </div>
            <div class="sm:col-span-2">
              <label for="rfq-message" class="block text-sm font-medium text-slate-300">Message</label>
              <textarea id="rfq-message" name="message" rows="4" class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-900/70 px-4 py-2.5 text-slate-100 placeholder-slate-500 focus:border-teal-400 focus:outline-none" placeholder="Target quantity, timeline, freight preferences, inspection plans…"></textarea>
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] px-6 py-3.5 font-semibold text-slate-950 transition hover:bg-[#1ebe5b] sm:w-auto">
                Send RFQ via WhatsApp
              </button>
              <p class="mt-3 text-xs text-slate-500">Opens WhatsApp with your RFQ pre-filled. By sending you accept our <a class="text-teal-300 hover:text-teal-200" href="/terms/">terms</a>.</p>
            </div>
          </form>
        </div>

        <!-- Direct channels -->
        <div class="lg:col-span-2">
          <h2 class="text-xl font-bold text-slate-100">Direct channels</h2>
          <div class="mt-6 space-y-4">
            <a href={`https://wa.me/${SITE.whatsappNumber.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="block rounded-2xl border border-slate-800 bg-slate-900/50 p-5 transition hover:border-[#25D366]/50">
              <p class="font-semibold text-slate-100">WhatsApp (fastest)</p>
              <p class="mt-1 text-sm text-slate-400">{SITE.whatsappDisplay} · replies within hours, Mon–Sat.</p>
            </a>
            <a href={`mailto:${SITE.contactEmail}`} class="block rounded-2xl border border-slate-800 bg-slate-900/50 p-5 transition hover:border-teal-400/50">
              <p class="font-semibold text-slate-100">Email</p>
              <p class="mt-1 text-sm text-slate-400">{SITE.contactEmail} · quotes within one business day.</p>
            </a>
            <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
              <p class="font-semibold text-slate-100">Warehouse &amp; port</p>
              <p class="mt-1 text-sm text-slate-400">{SITE.warehouseLocation} · {SITE.port}. Visits by appointment via WhatsApp.</p>
            </div>
            <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
              <p class="font-semibold text-slate-100">Hours</p>
              <p class="mt-1 text-sm text-slate-400">China time (UTC+8), Mon–Sat 08:30–18:30.</p>
            </div>
          </div>
          <div class="mt-6 rounded-2xl border border-amber-400/30 bg-amber-400/5 p-5 text-sm text-slate-300">
            <p class="font-semibold text-amber-300">B2B only</p>
            <p class="mt-1.5 leading-relaxed">Minimum order {SITE.moqPolicy}. We do not answer single-board consumer requests — try a local retailer instead.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { SITE } from '../config';

  const FREE_DOMAINS = new Set([
    'gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'aol.com', 'icloud.com', 'proton.me',
    'protonmail.com', 'live.com', 'msn.com', 'mail.com', 'yandex.com', 'gmx.com', 'qq.com', '163.com', '126.com',
  ]);
  const WA_NUMBER = SITE.whatsappNumber.replace(/\D/g, '');

  const form = document.getElementById('rfq-form') as HTMLFormElement | null;
  if (form) {
    const emailInput = document.getElementById('rfq-email') as HTMLInputElement | null;
    const hint = document.getElementById('rfq-email-hint');
    if (emailInput && hint) {
      emailInput.addEventListener('blur', () => {
        const domain = (emailInput.value.split('@')[1] || '').toLowerCase();
        hint.classList.toggle('hidden', !(domain.length > 0 && FREE_DOMAINS.has(domain)));
      });
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const lots = data.getAll('lots').filter((v) => String(v).length > 0).map(String);
      const lines: string[] = [
        'RFQ — supstocklot.com',
        `Company: ${String(data.get('company') || '-')}`,
        `Website: ${String(data.get('website') || '-')}`,
        `Email: ${String(data.get('email') || '-')}`,
        `WhatsApp: ${String(data.get('whatsapp') || '-')}`,
        `Business nature: ${String(data.get('nature') || '-')}`,
        `Take-off volume: ${String(data.get('volume') || '-')}`,
        `Destination market: ${String(data.get('market') || '-')}`,
        `Lots of interest: ${lots.length > 0 ? lots.join(', ') : 'Open / advise'}`,
        `Message: ${String(data.get('message') || '-')}`,
      ];
      const url = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(url, '_blank', 'noopener');
    });
  }
</script>
