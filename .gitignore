# build output
dist/
.output/
output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
.dev.vars
cloudfalre.txt

# macOS-specific files
.DS_Store

pnpm-lock.yaml

.astro

# wrangler local cache
.wrangler/
.wrangler-tmp/

# keystatic local cache (created on first admin load)
.keystatic/

# yarn berry linker artefacts (recreated by `yarn install`)
.yarn/
.pnp.*
# Note: .yarnrc.yml is tracked in git so Cloudflare's yarn install
# uses the same nodeLinker: node-modules and produce a node_modules
# tree that `npm run build` (and `node_modules/.bin/astro`) need.
# R2-managed files (served from Cloudflare R2, not git)
public/files/

# Backup files
*.bak

public/data/
src/i18n/generated/

tmp-root.txt
NUL
workers/*/node_modules/
workers/*/.wrangler/
functions/.wrangler/

# python bytecode
__pycache__/
*.pyc

# local SEO gate report (generated by scripts/05_ci_gate.py --report)
ci-seo-report.md

.cache/*.txt
!.cache/seo-advice.txt
