        <th class="p-3 text-left font-semibold text-gray-900 border">Had Angin</th>
        <th class="p-3 text-left font-semibold text-gray-900 border">Ketinggian Ombak Ketara (Hs)</th>
        <th class="p-3 text-left font-semibold text-gray-900 border">Produk Biasa</th>
      </tr>
    </thead>
    <tbody>
