        <th class="p-3 text-left font-semibold text-gray-900 border">Ветрови лимит</th>
        <th class="p-3 text-left font-semibold text-gray-900 border">Значителна височина на вълната (Hs)</th>
        <th class="p-3 text-left font-semibold text-gray-900 border">Типични продукти</th>
      </tr>
    </thead>
