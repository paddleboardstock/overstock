---
import { SITE } from 'astrowind:config';

const { lang = 'th' } = Astro.props;
const p = lang && lang !== 'en' ? '/' + lang : '';
---

<section class="px-6 sm:px-6 py-16 sm:py-20 mx-auto max-w-5xl">
  <a href={p + '/randdcenter'} class="text-sm text-gray-500 hover:underline">← กลับไปที่ศูนย์วิจัยและพัฒนา</a>
  <div class="mt-4 grid md:grid-cols-5 gap-10">
    <div class="md:col-span-3">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">ห้องปฏิบัติการ 06</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold">ห้องปฏิบัติการคุณภาพและการตรวจสอบ</h1>
      <p class="mt-3 text-lg text-muted">การตรวจสอบอิสระ — ผ่านการทดสอบทุกครั้งก่อนส่งมอบ</p>
    </div>
    <div class="md:col-span-2">
      <img
        src="https://assets.aquafarer.com/images/aquafarer/factory/aquafarer-uv-resistance-testing.webp"
        alt="Aquafarer ห้องปฏิบัติการตรวจสอบคุณภาพ UV การทดสอบ"
        class="w-full h-48 object-cover rounded-xl"
      />
    </div>
  </div>
</section>

<section class="px-6 sm:px-6 pb-12 mx-auto max-w-4xl prose prose-gray dark:prose-invert">
  <h2>เชื่อใจ แต่ต้องตรวจสอบ</h2>
  <p>
    ทุกเรือที่ออกจากเวิร์กช็อปของเรามาพร้อมกับใบรับรองว่าผ่านการตรวจสอบคุณภาพและการทดสอบวัสดุตามที่กำหนดแล้ว
    ห้องปฏิบัติการคุณภาพและการตรวจสอบของเราเป็นหน่วยงานอิสระภายในองค์กร — รายงานตรงต่อกรรมการผู้จัดการ ไม่ใช่ฝ่ายผลิต —
    เพื่อให้แน่ใจว่าไม่แรงกดดันทางการค้าสามารถส่งผลกระทบต่อการตรวจสอบได้
    หากวัสดุล็อตใดหรือตัวเรือที่เสร็จสมบูรณ์ไม่เป็นไปตามข้อกำหนดที่เผยแพร่
    ห้องปฏิบัติการมีอำนาจในการระงับการส่งสินค้าจนกว่าปัญหาการไม่เป็นไปตามมาตรฐานจะได้รับการแก้ไข
  </p>
  <p>
    ห้องปฏิบัติการดำเนินงานภายใต้ระบบการจัดการคุณภาพที่สอดคล้องกับหลักการ และวิธีการทดสอบของเราขึ้นอยู่กับมาตรฐาน ISO,
    ASTM และ EN เมื่อสามารถนำมาใช้ได้ เรารักษาบันทึกรายละเอียดของการทดสอบทุกครั้งที่ดำเนินการ
    สร้างห่วงโซ่การตรวจสอบย้อนหลังที่ครบถ้วนตั้งแต่การรับวัตถุดิบจนถึงการส่งมอบเรือขั้นสุดท้าย
  </p>

  <h2>อุปกรณ์ทดสอบและความสามารถ</h2>
  <table>
    <thead><tr><th>อุปกรณ์</th><th>การทดสอบที่ดำเนินการ</th><th>มาตรฐาน / วิธีการ</th></tr></thead>
    <tbody>
      <tr
        ><td>เครื่องทดสอบสากล (50 กิโลนิวตัน)</td><td
          >ความต้านทานแรงดึง (ผ้า), ความต้านทานการลอก (รอยต่อ), การแพร่กระจายของรอยขาด</td
        ><td>, ISO 4674</td></tr
      >
      <tr
        ><td>เครื่องทดสอบการเก็บอากาศ (ตั้งโปรแกรมได้)</td><td
          >ความทนทานต่อการขยายตัว/การหดตัวจากการเปลี่ยนแปลงความดัน 1000 รอบ, การทดสอบการกดคงที่ 24-48 ชั่วโมง</td
        ><td>(ภายใน)</td></tr
      >
      <tr
        ><td>ชุดจิกปอกตะเข็บ (ปอกด้วยมอเตอร์ 180°)</td><td
          >ความทนทานต่อการปอกของรอยเชื่อมและรอยต่อกาวที่ 100 มม./นาที</td
        ><td>/ ASTM D1876</td></tr
      >
      <tr><td>เครื่องทดสอบแรงดันน้ำ</td><td>ความทนทานต่อการซึมน้ำของผ้า (0 — 00 มิลลิเมตรปรอท)</td><td>ISO 811</td></tr>
      <tr
        ><td>เกจวัดความหนาดิจิทัลและไมโครมิเตอร์</td><td>ความหนาของผ้า ความหนาผนังท่อ ความหนาฟิล์มกาว</td><td
          >ISO 2286-3</td
        ></tr
      >
      <tr
        ><td>ห้องทดลองสภาพแวดล้อม</td><td
          >การปรับสภาพอุณหภูมิ (-40 °C ถึง +80 °C) สำหรับการทดสอบการแตกร้าวจากความเย็นและการเสื่อมอายุจากความร้อน</td
        ><td>ISO 188, ISO 4675</td></tr
      >
      <tr
        ><td>เครื่องวิเคราะห์สเปกโตรโฟโตมิเตอร์สี</td><td>การวัดสี Delta-E หลังUVการสัมผัส</td><td
          >ISO 105-A05 / ASTM D2244</td
        ></tr
      >
    </tbody>
  </table>

  <h2>ประตูตรวจสอบ — ตั้งแต่วัสดุจนถึงการส่งมอบ</h2>
  <p>
    เรือทุกลําต้องปฏิบัติตามแผนคุณภาพที่กําหนดไว้
    พร้อมจุดตรวจสอบที่บังคับไม่มีเรือลําใดสามารถข้ามประตูได้;แต่ละประตูต้องได้รับการอนุมัติจากผู้ตรวจสอบคุณภาพก่อนเริ่มขั้นตอนการผลิตถัดไป
  </p>

  <div class="not-prose my-8">
    <div class="relative">
      <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-blue-200 dark:bg-blue-800"></div>
      <div class="space-y-6 relative">
        {
          [
            {
              gate: 'Gate 1',
              label: 'การตรวจสอบวัตถุดิบเข้ามา',
              desc: 'ล็อตผ้า ล็อตกาว ฮาร์ดแวร์ — ถูกตรวจสอบทั้งหมดตามข้อกำหนดที่เข้ามาก่อนปล่อยเข้าสู่การผลิต',
            },
            {
              gate: 'Gate 2',
              label: 'การตรวจสอบรอยเชื่อมระหว่างกระบวนการ',
              desc: 'คูปองเชื่อมแรกทดสอบ (ปอก + ตรวจด้วยสายตา) ในตอนเริ่มของแต่ละกะการผลิต',
            },
            {
              gate: 'Gate 3',
              label: 'การทดสอบอากาศในห้อง',
              desc: 'ห้องแต่ละห้องได้รับการเพิ่มความดันถึง 1.25 เท่าของความดันทำงาน คงสภาพไว้ 24-48 ชั่วโมง ข้อมูลถูกบันทึกตามหมายเลขซีเรียล',
            },
            {
              gate: 'Gate 4',
              label: 'การตรวจสอบก่อนส่งมอบ',
              desc: 'ตรวจสอบเรือเสร็จสมบูรณ์: ขันสกรูทุกตัวเรียบร้อยแล้ว ระบบทั้งหมดใช้งานได้ ไม่มีข้อบกพร่องด้านความสวยงาม รายการตรวจสอบ 100 จุด',
            },
            {
              gate: 'Gate 5',
              label: 'การรับรองสุดท้าย',
              desc: 'รายงานการทดสอบจัดทำเรียบร้อย บันทึกการตรวจสอบได้ตรวจสอบแล้ว ใบรับรองความสอดคล้องออกให้แล้ว',
            },
          ].map((g) => (
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-bold z-10">
                {g.gate}
              </div>
              <div class="flex-1 p-3 rounded-lg bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800">
                <p class="text-sm font-semibold">{g.label}</p>
                <p class="text-xs text-gray-500 mt-1">{g.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <h2>ตัวชี้วัดคุณภาพหลัก (ค่าเฉลี่ยหมุนเวียนปี 2025)</h2>
  <div class="not-prose my-8 grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="p-4 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 text-center">
      <span class="block text-2xl font-bold text-blue-600">99.7 %</span>
      <span class="text-xs text-gray-500">ผลผลิตรอบแรก (ชุดผ้า)</span>
    </div>
    <div class="p-4 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 text-center">
      <span class="block text-2xl font-bold text-blue-600"> 0.2 %</span>
      <span class="text-xs text-gray-500">อัตราการปฏิเสธรอยเชื่อม (เมตรเชิงเส้น)</span>
    </div>
    <div class="p-4 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 text-center">
      <span class="block text-2xl font-bold text-blue-600">100 %</span>
      <span class="text-xs text-gray-500">ห้องทดสอบด้วยอากาศก่อนประกอบ</span>
    </div>
    <div class="p-4 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 text-center">
      <span class="block text-2xl font-bold text-blue-600"></span>
      <span class="text-xs text-gray-500">การปฏิบัติตามหมวดหมู่การออกแบบ</span>
    </div>
  </div>

  <h2>ทีมงานคุณภาพของเรา</h2>
  <p>
    ห้องปฏิบัติการประกอบด้วยผู้จัดการคุณภาพ (มีประสบการณ์ 10 ปีในสายงาน QA ทางทะเล, วิศวกรคุณภาพที่ได้รับการรับรองจาก
    ASQ), ผู้ตรวจสอบคุณภาพสองคน (แต่ละคนได้รับการรับรอง NDT ระดับ 2 ในการทดสอบด้วยสายตา)
    และช่างเทคนิควัสดุที่รับผิดชอบการทดสอบทางกายภาพทั้งหมดทีมงานจะผ่านการทดสอบความชํานาญประจําปีผ่านผู้ให้บริการอิสระภายนอกเพื่อให้แน่ใจว่าผลการทดสอบของเรายังคงถูกต้องและสามารถทําซ้ําได้
  </p>

  <h2>การทดสอบอิสระสําหรับลูกค้า</h2>
  <p>
    ห้องปฏิบัติการคุณภาพและตรวจสอบของเราพร้อมให้บริการทดสอบอิสระหากคุณต้องการตรวจสอบข้อกําหนดผ้า ตรวจสอบระบบกาวใหม่
    หรือขอรายงานการทดสอบจากบุคคลที่สามเพื่อรับรองการจัดซื้อ
    เราสามารถดําเนินการทดสอบตามมาตรฐานที่เกี่ยวข้องและออกรายงานการทดสอบที่ได้รับการรับรอง
  </p>
  <p>ตัวอย่างงานทดสอบจากบุคคลที่สามล่าสุด:</p>
  <ul>
    <li>การเปรียบเทียบความแข็งแรงของฟิล์มกาว 5 ผลิตภัณฑ์สําหรับโครงการจัดซื้อจัดจ้างทางทหารของยุโรป</li>
    <li>
      การศึกษาการบ่มแบบเร่งรัด (UV + การหมุนเวียนความร้อน) สําหรับสูตรสีส้มใหม่ PVC โดยมีการวัดระหว่างทางเป็นประจําทุก
      500 ชั่วโมง
    </li>
    <li>การตรวจสอบการกักเก็บอากาศของวาล์วบาฟเฟิลต้นแบบ 50 ตัวสําหรับการออกแบบท่อแรงดันสูงแบบใหม่</li>
  </ul>

  <h2>ความมุ่งมั่นของเราต่อคุณ</h2>
  <p>
    เมื่อคุณได้รับ{SITE.name}เรือ คุณยังจะได้รับแฟ้มคุณภาพของมัน — บันทึกที่รวบรวมผลการทดสอบที่ใช้กับเรือเฉพาะของคุณ
    ใบรับรองชุดผ้า ทดสอบการลอกเชื่อม บันทึกการทดสอบอากาศในห้อง และรายการตรวจสอบก่อนส่งมอบ ทุกตัวเลขสามารถติดตามได้
    ผู้ตรวจสอบทุกคนระบุชื่อ นี่ไม่ใช่แค่เอกสาร — นี่คือคำมั่นสัญญาของเราว่าสิ่งที่เราส่งมอบคือสิ่งที่เรากำหนดไว้
  </p>
  <p>
    หากคุณมีข้อกังวลด้านคุณภาพ คุณสามารถติดต่อห้องปฏิบัติการโดยตรง —
    รายละเอียดการติดต่อจะพิมพ์อยู่ในใบรับรองความสอดคล้องของคุณเรารับฟังทุกคําถามอย่างจริงจังและมุ่งมั่นที่จะดําเนินการตรวจสอบอย่างเป็นทางการภายใน
    48 ชั่วโมง
  </p>
</section>

<section class="px-6 sm:px-6 pb-20 mx-auto max-w-4xl text-center">
  <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
    <h2 class="text-xl font-bold">ต้องการทดสอบอิสระหรือการตรวจสอบคุณภาพหรือไม่?</h2>
    <p class="mt-2 text-sm text-muted">
      ห้องปฏิบัติการของเรารับงานทดสอบจากบุคคลที่สาม — ติดต่อเราพร้อมความต้องการของคุณ
    </p>
    <a
      href={p + '/contact'}
      class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
      >ติดต่อห้องปฏิบัติการคุณภาพ</a
    >
  </div>
</section>
