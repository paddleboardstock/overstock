---
import { SITE } from 'astrowind:config';

const { lang = 'th' } = Astro.props;
const p = lang && lang !== 'en' ? '/' + lang : '';
---

<section class="px-6 sm:px-6 py-16 sm:py-20 mx-auto max-w-5xl">
  <a href={p + '/randdcenter'} class="text-sm text-gray-500 hover:underline">← กลับไปที่ศูนย์วิจัยและพัฒนา</a>
  <div class="mt-4 grid md:grid-cols-5 gap-10">
    <div class="md:col-span-3">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">ห้องปฏิบัติการ 05</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold">เวิร์กช็อปต้นแบบ</h1>
      <p class="mt-3 text-lg text-muted">ตั้งแต่โมเดล CAD สู่เรือพร้อมเดินทะเล — สร้าง ติดตั้ง และพิสูจน์แล้ว</p>
    </div>
    <div class="md:col-span-2">
      <img
        src="https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp"
        alt="Paddle Board Overstock การสร้างเรือต้นแบบในเวิร์กช็อป"
        class="w-full h-48 object-cover rounded-xl"
      />
    </div>
  </div>
</section>

<section class="px-6 sm:px-6 pb-12 mx-auto max-w-4xl prose prose-gray dark:prose-invert">
  <h2>ที่ซึ่งการออกแบบกลายเป็นความจริง</h2>
  <p>
    โมเดล CAD ไม่ว่าสูงรายละเอียดแค่ไหน ก็ไม่สามารถบอกได้ว่าลำเรือจะจัดการอย่างไรจนกว่าจะลงสู่ผิวน้ำ
    นั่นคือเหตุผลที่เวิร์กช็อปต้นแบบของเราออกแบบมาเพื่อแปลงข้อมูลวิศวกรรมให้กลายเป็นยานพาหนะที่สามารถออกสู่ทะเลได้อย่างรวดเร็วและแม่นยำที่สุด
    ทุกครั้งที่มีใหม่{SITE.name}รุ่น — และการสร้างตามสั่งที่สำคัญทุกอย่าง —
    จะต้องผ่านเวิร์กช็อปนี้ก่อนที่จะนำเครื่องมือการผลิตมาใช้งาน
  </p>
  <p>
    เวิร์กช็อปนี้มีอุปกรณ์ครบครันสําหรับการผลิตตัวถัง ท่อ
    และเต้านมพร้อมกันแนวทางการทํางานแบบขนานนี้ช่วยลดระยะเวลาการผลิตต้นแบบเหลือ 8-12 สัปดาห์หลังจากปล่อยวิศวกรรม
    เมื่อเทียบกับมาตรฐานอุตสาหกรรมที่ใช้เวลา 16-20 สัปดาห์เมื่อแอปพลิเคชันของคุณต้องการโซลูชันเฉพาะทาง
    เราสามารถเปลี่ยนจากแนวคิดไปสู่การตรวจสอบบนผิวน้ําได้ภายในสามเดือน
  </p>

  <h2>ความสามารถในเวิร์กช็อป</h2>
  <table>
    <thead><tr><th>สถานีทํางาน</th><th>อุปกรณ์</th><th>วัตถุประสงค์</th></tr></thead>
    <tbody>
      <tr
        ><td>การผลิตตัวเรือ</td><td
          >เตาอบขึ้นรูปแบบหมุน (HDPE), ช่องเชื่อม TIG (อะลูมิเนียม), แม่พิมพ์วางมือ (ไฟเบอร์กลาส)</td
        ><td>การผลิตตัวเรือเต็มรูปแบบในวัสดุทั้งสามประเภท</td></tr
      >
      <tr
        ><td>การประกอบท่อ</td><td>เครื่องเชื่อม RF, สถานียึดด้วยอากาศร้อน, จิ๊กทดสอบการเป่าลม</td><td
          >การผลิตชุดท่อขนาดเต็มที่มีแผ่นกั้น กรวย และวาล์วทั้งหมด</td
        ></tr
      >
      <tr
        ><td>การติดตั้งและการติดตั้ง</td><td
          >รอกเครื่องยนต์ (500 กก.) โครงจําลองคอนโซล ที่บีบสายไฮดรอลิก แผงสายไฟไฟฟ้า</td
        ><td>อุปกรณ์ครบครัน: เครื่องยนต์, พวงมาลัย, ระบบควบคุม, ระบบเชื้อเพลิง, อิเล็กทรอนิกส์, ที่นั่ง</td></tr
      >
      <tr
        ><td>ช่องเครื่องมือวัด</td><td
          >เซ็นเซอร์ความเร็ว GPS, เครื่องวัดการไหลของเชื้อเพลิง, เครื่องวัดความเร่ง, ชุดเทอร์โมคัปเปิล,
          เครื่องบันทึกข้อมูล</td
        ><td>การติดตั้งและสอบเทียบเครื่องมือทดลองทางทะเล</td></tr
      >
    </tbody>
  </table>

  <h2>การเดินทางต้นแบบ — ทีละขั้นตอน</h2>
  <ol>
    <li>
      <strong>การส่งมอบวิศวกรรม</strong>— ชุดการออกแบบ (โมเดล 3 มิติ, รายงาน FEA, รายการวัสดุ, ตารางการวางวัสดุ)
      ได้รับการตรวจสอบอย่างเป็นทางการโดยหัวหน้าเวิร์กช็อปและวิศวกรโครงการข้อกังวลในการผลิตใด ๆ
      จะถูกแจ้งเตือนและแก้ไขก่อนเริ่มการตัด
    </li>
    <li>
      <strong>การผลิตที่ลําเรือ</strong>— ตัวเรือถูกสร้างตามข้อกําหนดทางวิศวกรรมสําหรับ HDPE:
      โปรแกรมขึ้นรูปแบบหมุนถูกโหลดจากการจําลอง Moldex3D สําหรับอลูมิเนียม: CNCแผ่นตัดจะถูกเชื่อมในช่อง TIG
      ตามแผนที่เชื่อมที่ได้รับอนุมัติสําหรับไฟเบอร์กลาส: จะติดตามหนังสืออัดทีละชั้น
    </li>
    <li>
      <strong>การผลิตท่อ</strong>— ผ้าถูกตัดโดยใช้CNCแม่แบบ -pattern จากนั้นเชื่อม RF
      เป็นห้องขนาดเต็มแต่ละห้องจะถูกเป่าลมเพื่อทดสอบแรงดันและปล่อยทิ้งไว้ 24 ชั่วโมงเพื่อความมั่นคงเบื้องต้น
    </li>
    <li>
      <strong>การประกอบและการติดตั้งอุปกรณ์</strong>— ตัวถังและท่อเชื่อมต่อกันเครื่องยนต์ถูกแขวน
      พวงมาลัยและระบบควบคุมเชื่อมต่อ ระบบเชื้อเพลิงติดตั้ง และวงจรไฟฟ้าทั้งหมดเดินสายและตรวจสอบ
    </li>
    <li>
      <strong>การทดสอบแบบคงที่</strong>— ก่อนที่เรือจะสัมผัสน้ํา จะต้องผ่าน: การตรวจสอบแรงลอยตัว (+สํารองเต็ม 30%)
      การทดสอบแรงดันระบบเชื้อเพลิง การทดสอบวงจรล็อกเต็มรูปแบบของระบบบังคับเลี้ยว และการทดสอบความต่อเนื่องของสายดินไฟฟ้า
    </li>
    <li><strong>โครงการทดลองเดินเรือ</strong>— การทดสอบในน้ํา 20 ชั่วโมง รายละเอียดด้านล่าง</li>
    <li>
      <strong>การตรวจสอบต้นแบบ</strong>— มีการประชุมลงนามอย่างเป็นทางการร่วมกับทีมวิศวกรรม ทีมผลิต
      และทีมคุณภาพการเปลี่ยนแปลงการออกแบบที่จําเป็นจะถูกบันทึกและรวมไว้ในประกาศใช้งานจริง
    </li>
  </ol>

  <div class="not-prose my-10 p-6 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
    <p class="text-sm font-semibold text-gray-500 mb-3 uppercase tracking-wider">
      โปรแกรมทดลองเดินเรือ 20 ชั่วโมง — ตารางการทดสอบ
    </p>
    <div class="space-y-2 text-sm">
      <div class="flex items-center gap-3 p-2 rounded bg-white dark:bg-gray-950">
        <span class="w-12 text-xs font-bold text-blue-600">2 h</span><span class="flex-1"
          >การควบคุมท่าเรือ — การควบคุมความเร็วต่ํา, ถอยหลัง, ตรวจสอบซุ้มล้อ</span
        >
      </div>
      <div class="flex items-center gap-3 p-2 rounded bg-white dark:bg-gray-950">
        <span class="w-12 text-xs font-bold text-blue-600">4 h</span><span class="flex-1"
          >การทดสอบความเร็ว — ความเร็วสูงสุด, ความเร็วเดินทาง, อัตราการใช้น้ํามันที่ 3 รอบต่อนาทีที่ 3 รอบต่อนาที</span
        >
      </div>
      <div class="flex items-center gap-3 p-2 rounded bg-white dark:bg-gray-950">
        <span class="w-12 text-xs font-bold text-blue-600">3 h</span><span class="flex-1"
          >การทดสอบการเลี้ยว — เส้นผ่านศูนย์กลางยุทธวิธี, การเคลื่อนที่ และการถ่ายโอนที่ 20 นอต ซ้ายและขวา</span
        >
      </div>
      <div class="flex items-center gap-3 p-2 rounded bg-white dark:bg-gray-950">
        <span class="w-12 text-xs font-bold text-blue-600">3 h</span><span class="flex-1"
          >การทดสอบการชน — วิ่งซ้ําผ่านความชัน 0.5–1.0 เมตร;เครื่องวัดความเร่งบนฐานที่นั่งพวงมาลัย</span
        >
      </div>
      <div class="flex items-center gap-3 p-2 rounded bg-white dark:bg-gray-950">
        <span class="w-12 text-xs font-bold text-blue-600">3 h</span><span class="flex-1"
          >การทดสอบความมั่นคง — มุมส้นคงที่พร้อม+เฟืองลูกเรือ 4 ตัวไปทางขวา น้ําหนักบรรทุกแบบเลื่อน</span
        >
      </div>
      <div class="flex items-center gap-3 p-2 rounded bg-white dark:bg-gray-950">
        <span class="w-12 text-xs font-bold text-blue-600">3 h</span><span class="flex-1"
          >การวิ่งต่อเนื่อง — 3 ชั่วโมงต่อเนื่องที่ความเร็วเดินทาง;ตรวจสอบอุณหภูมิ (เครื่องยนต์, เชื้อเพลิง, ไฟฟ้า)</span
        >
      </div>
      <div class="flex items-center gap-3 p-2 rounded bg-white dark:bg-gray-950">
        <span class="w-12 text-xs font-bold text-blue-600">2 h</span><span class="flex-1"
          >การตรวจสอบขั้นสุดท้าย — ตรวจสอบระบบทั้งหมดหลังการทดลอง ขัน/ตรวจสอบอุปกรณ์ยึดทั้งหมด บันทึกผลการตรวจ</span
        >
      </div>
    </div>
  </div>

  <h2>การสร้างต้นแบบแบบกําหนดเองสําหรับแอปพลิเคชันเฉพาะ</h2>
  <p>เวิร์กช็อปต้นแบบคือที่ที่เราแก้ไขปัญหาที่เรือผลิตมาตรฐานไม่สามารถแก้ไขได้ตัวอย่างล่าสุดได้แก่:</p>
  <ul>
    <li>
      ขนาด 7.8 เมตรRIBสําหรับองค์กรค้นหาและกู้ภัย
      ซึ่งต้องการโครงสร้างห้องโดยสารที่ออกแบบเฉพาะพร้อมการป้องกันการพลิกคว่ํา ขาตั้งเปลในตัว
      และแท่นโซนาร์ติดตั้งที่หัวเรือ — ทั้งหมดนี้ผ่านการทดลองต้นแบบ ติดตั้ง และทดสอบที่ศูนย์ของเรา
    </li>
    <li>
      เรือเป่าลมขนาด 5.2 เมตรสําหรับผู้รับเหมาสํารวจทางทะเล พร้อมส่วนท้ายเรือแบบตัดลง เสาเครื่องมือถอดออกได้
      และช่องทรานสดิวเซอร์ทะลุตัวเรือที่ออกแบบมาเพื่อลดการรบกวนการไหลของน้ํา
    </li>
    <li>
      เรือเทนเดอร์ขับเคลื่อนไฟฟ้ายาว 4.5 เมตรสําหรับซูเปอร์ยอชต์ ซึ่งต้นแบบถูกใช้ตรวจสอบระยะทาง โครงสร้างพื้นฐานการชาร์จ
      และระดับเสียง ก่อนที่ลูกค้าจะตัดสินใจซื้อกองเรือสี่ลํา
    </li>
  </ul>

  <h2>ทีมต้นแบบของเรา</h2>
  <p>
    เวิร์กช็อปนี้มีช่างเทคนิคทางทะเลที่มีทักษะหลากหลายจํานวนแปดคน
    ซึ่งแต่ละคนผ่านการฝึกอบรมข้ามสาขาอย่างน้อยสองในสามสาขาหลัก (ตัวเรือ, ท่อ,
    อุปกรณ์เสากระโดง)หัวหน้าทีมเป็นช่างต่อเรือระดับปรมาจารย์ที่มีประสบการณ์ 16 ปี
    ตั้งแต่การสร้างแบบเฉพาะครั้งเดียวจนถึงการผลิตจริงต้นแบบทุกลําจะได้รับมอบหมายวิศวกรโครงการเฉพาะทาง
    ซึ่งเป็นจุดติดต่อเดียวสําหรับลูกค้าตลอดกระบวนการสร้างและทดลอง
  </p>

  <h2>การมีส่วนร่วมของลูกค้า</h2>
  <p>
    เราสนับสนุนให้ลูกค้าของเราเข้าร่วมกับเหตุการณ์สําคัญในระหว่างการสร้างต้นแบบ
    โดยเฉพาะการตรวจสอบการติดตั้งเบื้องต้นและการทดลองเดินเรือข้อเสนอแนะด้านการดําเนินงานของคุณในช่วงเหล่านี้มีคุณค่าอย่างยิ่งในการปรับแต่งเรือก่อนเข้าสู่การผลิตเราไม่ได้สร้างเรือในสุญญากาศ;เราสร้างเรือร่วมกับคุณ
  </p>
  <p>
    การทดลองเดินเรือ 20 ชั่วโมงยังเป็นโอกาสให้ทีมของคุณได้ทําความคุ้นเคยกับการควบคุมเรือ การจัดวางระบบ
    และความต้องการการบํารุงรักษา เพื่อให้การเปลี่ยนผ่านสู่บริการเป็นไปอย่างราบรื่นเมื่อเรือผลิตถูกส่งมอบ
  </p>
</section>

<section class="px-6 sm:px-6 pb-20 mx-auto max-w-4xl text-center">
  <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
    <h2 class="text-xl font-bold">เริ่มโครงการต้นแบบของคุณ</h2>
    <p class="mt-2 text-sm text-muted">บอกเราเกี่ยวกับเรือที่คุณต้องการ แล้วเราจะเสนอแผนพัฒนาต้นแบบให้</p>
    <a
      href={p + '/contact'}
      class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
      >ติดต่อทีมต้นแบบของเรา</a
    >
  </div>
</section>
