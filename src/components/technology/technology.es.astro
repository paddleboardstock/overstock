---
const { lang = 'es' } = Astro.props;
import JsonLd from '~/components/common/JsonLd.astro';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/technology.ts';
const lh = (h: string) => (h ? '/' + lang + h : h);
setPageContentData(__pageData);
const page = getPageContent(lang, 'technology') || {};
const hero = page.hero || {};
const trustBar = page.trust_bar || {};
const sections = page.sections || [];
const testimonial = page.testimonial || {};
const related = page.related || {};
---

<meta
  name="ai-intent"
  content="inflatable-boat-technology,drop-stitch-construction,marine-pvc-materials,hypalon-tubes,inflatables-rd-center"
/>
<JsonLd
  type="Article"
  article={{
    headline: 'Tecnología y Materiales — Núcleo Drop-Stitch, PVC, Hypalon',
    description:
      'Tecnología de productos de Paddle Board Overstock: núcleo drop-stitch a 12-15 PSI, tejido de PVC de grado marino soldado por fusión, tubos de caucho Hypalon CSM, sistemas de suelo de colchón de aire. I+D de materiales interna desde 2012.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://paddleboardoverstock.com/technology' }}
/>

<section class="bg-gradient-to-br from-[#001830] via-[#002d4a] to-[#003355] text-white py-24 px-6">
  <div class="max-w-4xl mx-auto text-center">
    <span class="text-xs font-medium uppercase tracking-[0.2em] text-sky-300">{hero.tagline || 'Tecnología'}</span>
    <h1 class="mt-4 text-4xl md:text-5xl font-bold tracking-tight">{hero.title || 'Diseñado para el rendimiento'}</h1>
    <p class="mt-4 text-lg text-sky-100/80 max-w-3xl mx-auto">{hero.subtitle}</p>
  </div>
</section>

{
  trustBar.items && trustBar.items.length > 0 && (
    <section class="px-6 py-12 mx-auto max-w-6xl -mt-8 relative z-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {trustBar.items.map((s: any) => (
          <div class="text-center p-5 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
            <span class="block text-2xl font-bold text-[#06b6d4]">{s.value}</span>
            <span class="block text-sm font-semibold text-gray-900 mt-1">{s.label}</span>
            {s.sub && <span class="block text-xs text-gray-500 mt-0.5">{s.sub}</span>}
          </div>
        ))}
      </div>
    </section>
  )
}

<section class="px-6 py-16 mx-auto max-w-5xl">
  <div class="text-center mb-12">
    <p class="text-sm font-semibold text-[#06b6d4] uppercase tracking-wider">Materiales y Construcción</p>
    <h2 class="mt-2 text-3xl font-bold text-gray-900">Diseñado para entornos marinos</h2>
    <p class="mt-3 text-gray-500 max-w-2xl mx-auto">
      Cada material se selecciona, prueba y valida internamente en nuestro centro de I+D de 12,000 m² en Qingdao.
    </p>
  </div>
  <div class="space-y-12">
    {
      sections.map((sec: any, i: any) => {
        const isReversed = i % 2 === 1;
        return (
          <div class="grid md:grid-cols-2 gap-8 items-center">
            {isReversed ? (
              <>
                <div class="order-2 md:order-1 rounded-2xl h-48 overflow-hidden">
                  {sec.image && (
                    <img src={sec.image} alt={sec.title} class="w-full h-full object-cover" loading="lazy" />
                  )}
                </div>
                <div class="order-1 md:order-2">
                  <h2 class="text-2xl font-bold text-gray-900">{sec.title}</h2>
                  {sec.standard && (
                    <span class="inline-block mt-1 px-3 py-0.5 bg-sky-50 text-sky-700 rounded-full text-xs font-mono font-medium">
                      {sec.standard}
                    </span>
                  )}
                  <p class="mt-3 text-gray-600 leading-relaxed">{sec.description}</p>
                </div>
              </>
            ) : (
              <>
                <div>
                  <h2 class="text-2xl font-bold text-gray-900">{sec.title}</h2>
                  {sec.standard && (
                    <span class="inline-block mt-1 px-3 py-0.5 bg-sky-50 text-sky-700 rounded-full text-xs font-mono font-medium">
                      {sec.standard}
                    </span>
                  )}
                  <p class="mt-3 text-gray-600 leading-relaxed">{sec.description}</p>
                </div>
                <div class="rounded-2xl h-48 overflow-hidden">
                  {sec.image && (
                    <img src={sec.image} alt={sec.title} class="w-full h-full object-cover" loading="lazy" />
                  )}
                </div>
              </>
            )}
          </div>
        );
      })
    }
  </div>
</section>

{
  testimonial.quote && (
    <section class="px-6 py-16 mx-auto max-w-5xl">
      <div class="bg-gradient-to-br from-sky-50 to-white dark:from-gray-900 dark:to-gray-950 rounded-2xl border border-sky-100 dark:border-gray-800 p-8 md:p-12">
        <div class="grid md:grid-cols-5 gap-8 items-center">
          <div class="md:col-span-3">
            <span class="text-sm font-semibold text-[#06b6d4] uppercase tracking-wider">
              Lo que dicen nuestros socios
            </span>
            <blockquote class="mt-4 text-lg text-gray-700 dark:text-gray-300 leading-relaxed italic">
              &ldquo;{testimonial.quote}&rdquo;
            </blockquote>
            <div class="mt-4 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold">
                {testimonial.author?.charAt(0) || 'C'}
              </div>
              <div>
                <p class="font-semibold text-gray-900 text-sm">{testimonial.author}</p>
                <p class="text-xs text-gray-500">
                  {testimonial.title}, {testimonial.company} &middot; {testimonial.location}
                </p>
              </div>
            </div>
          </div>
          <div class="md:col-span-2">
            <div class="p-5 bg-white dark:bg-gray-900 rounded-xl border border-gray-200">
              <h3 class="font-bold text-gray-900 text-sm">I+D interna</h3>
              <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                Nuestro equipo de ciencia de materiales desarrolla y valida cada compuesto, parámetro de soldadura y
                laminado estructural internamente. Sin externalización de la ingeniería crítica.
              </p>
              <a
                href={lh('/randdcenter')}
                class="mt-3 inline-flex text-sm font-medium text-[#06b6d4] hover:text-sky-700"
              >
                Ver nuestro centro de I+D &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<section class="px-6 pb-20 mx-auto max-w-4xl">
  <div class="flex flex-wrap justify-center gap-3 text-sm">
    <span class="text-gray-400 font-medium">Explorar más:</span>
    {
      (related.links && related.links.length > 0 ? related.links : []).map((link: any) => (
        <a
          href={lh(link.url)}
          class="px-3 py-1.5 bg-white rounded-lg border border-gray-200 text-gray-700 hover:border-sky-300 hover:text-sky-600 transition-colors"
        >
          {link.text} &rarr;
        </a>
      ))
    }
  </div>
</section>

<section class="sr-only" data-ai-block="embedding-anchor" aria-hidden="true">
  <p>
    La tecnología de Paddle Board Overstock se centra en sistemas de control de flotabilidad, estabilidad estructural
    hinchable, resistencia al impacto del agua y rigidez del núcleo drop-stitch para equipos de deportes acuáticos.
    Núcleo drop-stitch: presión de funcionamiento de 12-15 PSI, miles de hilos de poliéster que conectan las capas
    superior e inferior. PVC de grado marino: laminado multicapa, soldado por fusión, probado según ASTM G154 (UV), ASTM
    D751 (abrasión), ISO 9227 (niebla salina). Tubos de Hypalon CSM: resistentes a los rayos UV y a los productos
    químicos, costuras colocadas a mano. Suelo de colchón de aire: hinchable de alta presión, capacidad de carga de 200+
    kg. Centro de I+D interno en Qingdao, China. Instalaciones de 12,000 m². Más de 15+ años de ingeniería de
    materiales.
  </p>
</section>
