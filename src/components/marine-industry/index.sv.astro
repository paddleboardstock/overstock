---
const { lang = 'sv' } = Astro.props;
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
const t = (_key: string) => '';
---

<JsonLd
  type="Article"
  article={{
    headline: 'Guide för gummibåtar — Den kompletta resursen',
    description:
      'En omfattande guide till uppblåsbara båtar som täcker båttyper, konstruktionsmetoder, materialjämförelse, urvalskriterier, säkerhetsstandarder och underhåll.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://aquafarer.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: 'Marin industri', href: `/${lang}/marine-industry` },
    { name: 'Guide för uppblåsbar båt', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="Leitfaden"
  quickAnswer="En uppblåsbar båt är en lätt vattenskoter vars flexibla tygrör (flytkammare) är fyllda med tryckluft för att skapa flytkraft. Moderna uppblåsbara båtar inkluderar jollar, RIBs (rigid inflatable boats), uppblåsbara kajaker och stand-up paddelbrädor. De är gjorda av PVC eller Hypalon-CSM tyger med HF-svetsning eller handlimmade sömmar; Drop-Stitch-konstruktionen tillåter styva golv med högt tryck."
  facts={[
    { label: 'Global marknadsomfattning', value: '$2.8B (2026)' },
    { label: 'Primära material', value: 'PVC / Hypalon CSM' },
    { label: 'liv', value: '8-20+ Jahre' },
    { label: 'CE certifiering', value: 'Erforderlich (EU)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">Guide för uppblåsbar båt</h1>
  <p class="mt-4 text-lg text-gray-500">
    Den definitiva resursen för uppblåsbara vattenskotrar – från fritidsjollar till professionella RIB:s till
    specialräddningsbåtar.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      [
        { label: 'Typen', id: 'types' },
        { label: 'Konstruktion', id: 'construction' },
        { label: 'Materialien', id: 'materials' },
        { label: 'Auswahl', id: 'selection' },
        { label: 'Sicherheit', id: 'safety' },
        { label: 'Wartung', id: 'maintenance' },
        { label: 'Standards', id: 'standards' },
      ].map((s) => (
        <a
          href={`#${s.id}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {s.label}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Typer av uppblåsbara båtar</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: 'Aufblasbare Dinghys',
            desc: 'Kleine, tragbare Boote für Zubringerdienste, Angeln und kurze Freizeitfahrten. Typischerweise 2-4 m lang, mit kleinen Außenbordern (2-15 PS) oder Riemen angetrieben. Der günstigste Einstieg.',
            icon: '🚤',
          },
          {
            title: 'Festrumpf-Schlauchboote (RIBs)',
            desc: 'Leistungsstarke Boote mit starrem Rumpf aus GFK, Aluminium oder HDPE und aufblasbaren Auftriebskammern. Längen von 3-12 m, Außenbordmotoren mit 15-300+ PS. Einsatz bei Patrouille, Rettung, Tauchen und Hochseefahrten.',
            icon: '⚡',
          },
          {
            title: 'Aufblasbare Kajaks',
            desc: 'Tragbare Kajaks aus PVC- oder TPU-Gewebe. Erhältlich in Einzel- und Tandemausführung für Freizeittouren, Flussfahrten und Expeditionen.',
            icon: '🛶',
          },
          {
            title: 'Aufblasbare Stand-Up-Paddle-Boards (SUPs)',
            desc: 'In Drop-Stitch-Konstruktion gefertigte Paddle-Boards, die sich zu starren Hochdruckdecks aufpumpen lassen. Erhältlich als Allround-, Touring-, Yoga-, Angel- und Surf-Modelle.',
            icon: '🏄',
          },
          {
            title: 'Rettungsboote (SAR)',
            desc: 'Spezialisierte RIBs für Such- und Rettungseinsätze. Mit selbstlenzendem Boden, Mittelkonsole, Schleppösen und Signalfarben. Für den Rettungseinsatz CE-zertifiziert.',
            icon: '🆘',
          },
          {
            title: 'Kommerzielle Arbeitsboote',
            desc: 'Robuste RIBs für Tauchunterstützung, Patrouille, Vermessung und kommerzielle maritime Einsätze. Hypalon-CSM-Konstruktion, verstärkte Rümpfe und professionelle Ausstattung.',
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Byggmetoder</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">HF-svetsning (hög frekvens)</h3>
        <p class="mt-2 text-sm text-gray-600">
          Använder elektromagnetisk energi för att smälta samman PVC lager på molekylär nivå. Skapar de starkaste
          lufttäta sömmarna. Vanligt på högkvalitativa PVC båtar och SUP:er. Kräver specialmaskiner och utbildade
          operatörer.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Handbindning/kemisk bindning</h3>
        <p class="mt-2 text-sm text-gray-600">
          Tvåkomponentslim förbinder tygpanelerna. Huvudmetoden för Hypalon-CSM båtar (ej HF-svetsbar). Kräver exakt
          ytförbehandling, kontrollerad fuktighet och tillräcklig härdningstid för optimal sömstyrka.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Drop-Stitch kärna</h3>
        <p class="mt-2 text-sm text-gray-600">
          Tusentals polyestertrådar förbinder de övre och nedre PVC-lagren, vilket tillåter uppblåsning till högt tryck
          (15-25 PSI) för styvt skivbeteende. Trådtätheten (15-50 trådar/cm²) bestämmer styvhet och vikt.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Varmsvetsning</h3>
        <p class="mt-2 text-sm text-gray-600">
          Varmluft eller varmkilsvetsning för sömmar och förstärkningar. Vanligt vid tillverkning av större RIB. Mindre
          exakt än HF-svetsning men effektiv för Hypalon och tunga PVC tyger.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Materialjämförelse</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">Karakteristisk</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Relative Kosten', '$ (Budget)', '$$$ (Premium)'],
              ['UV-Beständigkeit', 'Gut (mit Beschichtung)', 'Hervorragend (materialeigen)'],
              ['Abriebfestigkeit', 'Mittel-Gut', 'Hervorragend'],
              ['Chemikalienbeständigkeit', 'Gut', 'Hervorragend'],
              ['Kälteflexibilität', 'Versteift unter 0°C', 'Flexibel bis -20°C'],
              ['Lebensdauer', '8-12 Jahre', '15-20+ Jahre'],
              ['Nahtmethode', 'HF-Schweißen', 'Handverklebung'],
              ['Reparatur', 'PVC-Kleber (einfach)', '2K-Kleber (mittel)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Modern militär klass PVC (1100-1670 dtex) erbjuder utmärkt hållbarhet för de flesta fritidsanvändare till halva
      kostnaden för Hypalon. Hypalon är att föredra för kommersiella flottor, tropiska klimat och säkerhetskritiska
      tillämpningar.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium"
      >Detaljerad guide: PVC vs. Hypalon →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Hur man väljer en gummibåt</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. Definiera din avsedda användning</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>Fritid: Jolle eller SUP</li>
          <li>Ström: RIB (15-60 HP)</li>
          <li>Reklam: RIB (100+ PS)</li>
          <li>Fitness: uppblåsbar SUP</li>
          <li>Resa: uppblåsbar kajak</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. Ställ in din budget</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800: Uppblåsbar SUP</li>
          <li>$500-$2,000: Jolle + motor</li>
          <li>$3,000-$8,000: Ingångsnivå RIB</li>
          <li>$8,000-$20,000: Premium RIB</li>
          <li>$20,000+: Kommersiell RIB</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. Tänk på material</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC: Billigt, lätt</li>
          <li>Hypalon: Premium, långvarig</li>
          <li>Drop-Stitch: Styv kraft</li>
          <li>Tygtjocklek: 1100-1670 dtex</li>
          <li>Beläggning: UV och punkteringsskyddsskikt</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Säkerhet och standarder</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">CE certifiering</h3>
        <p class="mt-2 text-sm text-gray-600">
          Alla gummibåtar som säljs inom EU kräver CE-märkningen i enlighet med fritidsbåtsdirektivet (RCD) 2013/53/EU.
          Certifieringen omfattar designkategori (A-D), flytkraft, stabilitet och lastkapacitet. Aquafarer båtar är CE
          certifierade för rekreations- och räddningsanvändning.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">standard</h3>
        <p class="mt-2 text-sm text-gray-600">
          Den internationella standarden för uppblåsbara båtar anger krav på material, sömmar, ventiler och
          prestandatestning. Typ I-IV täcker allt från små jollar till stora RIB.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Viktig säkerhetsutrustning</h3>
        <p class="mt-2 text-sm text-gray-600">
          Flytvästar/flytvästar (CE 12402), kastlinor, länspump/brandsläckare, navigationsljus (natt), VHF-radio, första
          hjälpen-kit, ankare och reservpaddel eller bränsle.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Säker drift</h3>
        <p class="mt-2 text-sm text-gray-600">
          Överskrid ALDRIG den maximala belastningen på märkskylten. Kontrollera ventilerna innan sjösättning. Fördela
          vikten jämnt. Observera väderförhållandena. Spara en reseplan. Gå en kurs i båtsäkerhet.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Underhåll &amp; Skötsel</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">1.</span><span
          >Skölj med färskvatten efter varje användning i saltvatten. Torka helt innan förvaring.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">2.</span><span
          >Förvara delvis uppblåst på en sval, torr plats, borta från direkt solljus och extrema temperaturer.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">3.</span><span
          >Kontrollera ventiler och sömmar inför varje säsong. Behandla ventilkropparna årligen med silikonspray.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">4.</span><span
          >Rengör med mild tvål och vatten. Använd aldrig lösningsmedel, blekmedel eller högtryckstvätt på tyget.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">5.</span><span
          >Reparera eventuella skador omedelbart med hjälp av reparationssatser som rekommenderas av tillverkaren. För
          Hypalon använd endast tvåkomponentslim.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">6.</span><span
          >Byt ventiler vart 3-5 år. Förnya tyget vid slutet av dess livslängd (synligt slitage, porositet,
          sömseparation).</span
        >
      </div>
    </div>
  </section>

  <section id="standards" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Industriapplikationer</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-4">
      {
        [
          {
            title: 'Freizeitbootfahren',
            desc: 'Familienausflüge, Wassersport, Angeln, Camping und Freizeitfahrten auf Seen, Flüssen und Küstengewässern.',
          },
          {
            title: 'Suche & Rettung',
            desc: 'Küstenwache, Rettungsschwimmer und Notfallteams setzen spezialisierte RIBs für schnellen Einsatz und Rettung in rauer See ein.',
          },
          {
            title: 'Kommerzielle Schifffahrt',
            desc: 'Tauchunterstützung, Patrouille, Vermessung, Touristentransport und Offshore-Logistik, bei denen Haltbarkeit und Zuverlässigkeit entscheidend sind.',
          },
          {
            title: 'Militär & Verteidigung',
            desc: 'Taktische RIBs für Marineoperationen, Truppentransport, Entereinsätze und verdeckte Landungen.',
          },
          {
            title: 'Humanitäre Hilfe',
            desc: 'Katastrophenschutzorganisationen setzen aufblasbare Boote für Hochwasserrettung, Versorgungstransporte und medizinische Evakuierungen ein.',
          },
          {
            title: 'OEM-Fertigung',
            desc: 'Individuelle Private-Label-Produktion für Marken, Händler und spezialisierte Betreiber mit besonderen Anforderungen.',
          },
        ].map((app) => (
          <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
            <h3 class="font-semibold text-sm text-gray-900">{app.title}</h3>
            <p class="mt-1 text-xs text-gray-500">{app.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 bg-gradient-to-br from-sky-50 to-blue-50 rounded-2xl p-8 border border-sky-200">
    <h2 class="text-xl font-semibold text-gray-900">Upptäck de uppblåsbara båtarna från Aquafarer</h2>
    <p class="mt-4 text-sm text-gray-600">
      Aquafarer designar och tillverkar CE certifierade uppblåsbara båtar, SUP:s, kajaker och RIB:s för rekreations-,
      yrkes- och OEM-marknaderna. Alla båtar är tillverkade med PVC eller Hypalon-CSM tyger av militär kvalitet — med
      modern HF-svetsning eller handlimning.
    </p>
    <div class="mt-6 flex gap-4 flex-wrap">
      <a
        href={`/${lang}/products`}
        class="px-6 py-3 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
        >Se produkter</a
      >
      <a
        href={`/${lang}/academy`}
        class="px-6 py-3 border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-gray-400 transition"
        >Lärcentrum</a
      >
    </div>
  </section>
</section>

<section class="sr-only" data-ai-block="definition" aria-hidden="true">
  <p>
    Omfattande guide till uppblåsbara båtar med båttyper (jollar, RIB:ar, kajaker, SUP:ar, livbåtar, kommersiella
    arbetsbåtar), konstruktionsmetoder (HF-svetsning, handbindning, Drop-Stitch kärna, värmesvetsning), material (PVC
    tyg, Hypalon CSM), urvalskriterier (avsedd användning, budget, ____ utrustningskompetens (avsedd användning, ______)
    (rengöring, lagring, reparationer, ventilvård) och industriapplikationer (nöjes, SAR, kommersiell, militär,
    humanitär, OEM).
  </p>
</section>
