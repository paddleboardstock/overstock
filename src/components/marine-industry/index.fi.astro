---
const { lang = 'fi' } = Astro.props;
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
const t = (_key: string) => '';
---

<JsonLd
  type="Article"
  article={{
    headline: 'Kumiveneopas – täydellinen resurssi',
    description:
      'Kattava kumiveneopas kattaa venetyypit, rakennustavat, materiaalivertailun, valintakriteerit, turvallisuusstandardit ja huollon.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://aquafarer.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: 'Meriteollisuus', href: `/${lang}/marine-industry` },
    { name: 'Kumiveneen opas', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="Leitfaden"
  quickAnswer="Kumivene on kevyt vesikulkuneuvo, jonka joustavat kangasputket (nostekammiot) on täytetty paineilmalla nosteen luomiseksi. Nykyaikaisiin puhallettaviin veneisiin kuuluvat veneet, RIB:t (jäykät puhallettavat veneet), puhallettavat kajakit ja seisomamelalaudat. Ne on valmistettu PVC tai Hypalon-CSM kankaista käyttäen HF-hitsausta tai käsin liimattuja saumoja; Drop-Stitch-rakenne mahdollistaa korkeapaineiset, jäykät lattiat."
  facts={[
    { label: 'Globaalit markkinat', value: '$2.8B (2026)' },
    { label: 'Ensisijaiset materiaalit', value: 'PVC / Hypalon CSM' },
    { label: 'elämää', value: '8-20+ Jahre' },
    { label: 'CE -sertifikaatti', value: 'Erforderlich (EU)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">Kumiveneen opas</h1>
  <p class="mt-4 text-lg text-gray-500">
    Lopullinen resurssi puhallettaviin vesikulkuneuvoihin – huviveneistä ammattilaisveneisiin ja
    erikoispelastusveneisiin.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      [
        { label: 'Typen', id: 'types' },
        { label: 'Konstruktion', id: 'construction' },
        { label: 'Materialien', id: 'materials' },
        { label: 'Auswahl', id: 'selection' },
        { label: 'Sicherheit', id: 'safety' },
        { label: 'Wartung', id: 'maintenance' },
        { label: 'Standards', id: 'standards' },
      ].map((s) => (
        <a
          href={`#${s.id}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {s.label}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Kumiveneiden tyypit</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: 'Aufblasbare Dinghys',
            desc: 'Kleine, tragbare Boote für Zubringerdienste, Angeln und kurze Freizeitfahrten. Typischerweise 2-4 m lang, mit kleinen Außenbordern (2-15 PS) oder Riemen angetrieben. Der günstigste Einstieg.',
            icon: '🚤',
          },
          {
            title: 'Festrumpf-Schlauchboote (RIBs)',
            desc: 'Leistungsstarke Boote mit starrem Rumpf aus GFK, Aluminium oder HDPE und aufblasbaren Auftriebskammern. Längen von 3-12 m, Außenbordmotoren mit 15-300+ PS. Einsatz bei Patrouille, Rettung, Tauchen und Hochseefahrten.',
            icon: '⚡',
          },
          {
            title: 'Aufblasbare Kajaks',
            desc: 'Tragbare Kajaks aus PVC- oder TPU-Gewebe. Erhältlich in Einzel- und Tandemausführung für Freizeittouren, Flussfahrten und Expeditionen.',
            icon: '🛶',
          },
          {
            title: 'Aufblasbare Stand-Up-Paddle-Boards (SUPs)',
            desc: 'In Drop-Stitch-Konstruktion gefertigte Paddle-Boards, die sich zu starren Hochdruckdecks aufpumpen lassen. Erhältlich als Allround-, Touring-, Yoga-, Angel- und Surf-Modelle.',
            icon: '🏄',
          },
          {
            title: 'Rettungsboote (SAR)',
            desc: 'Spezialisierte RIBs für Such- und Rettungseinsätze. Mit selbstlenzendem Boden, Mittelkonsole, Schleppösen und Signalfarben. Für den Rettungseinsatz CE-zertifiziert.',
            icon: '🆘',
          },
          {
            title: 'Kommerzielle Arbeitsboote',
            desc: 'Robuste RIBs für Tauchunterstützung, Patrouille, Vermessung und kommerzielle maritime Einsätze. Hypalon-CSM-Konstruktion, verstärkte Rümpfe und professionelle Ausstattung.',
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Rakennusmenetelmät</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">HF-hitsaus (korkeataajuus)</h3>
        <p class="mt-2 text-sm text-gray-600">
          Käyttää sähkömagneettista energiaa sulattamaan PVC kerrosta molekyylitasolla. Luo vahvimmat ilmatiiviit
          saumat. Yleinen korkealaatuisissa PVC -veneissä ja SUP-veneissä. Vaatii erikoiskoneita ja koulutettuja
          käyttäjiä.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Käsin liimaus/kemiallinen liimaus</h3>
        <p class="mt-2 text-sm text-gray-600">
          Kaksikomponenttinen liima yhdistää kangaspaneelit. Päämenetelmä Hypalon-CSM-veneille (ei-HF-hitsattava).
          Edellyttää tarkkaa pinnan esikäsittelyä, hallittua kosteutta ja riittävää kovettumisaikaa optimaalisen sauman
          lujuuden saavuttamiseksi.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Drop-Stitch ydin</h3>
        <p class="mt-2 text-sm text-gray-600">
          Tuhannet polyesterilangat yhdistävät ylemmän ja alemman PVC-kerroksen mahdollistaen täytön korkeaan paineeseen
          (15-25 PSI) jäykän levyn käyttäytymisen vuoksi. Langan tiheys (15-50 lankaa/cm²) määrää jäykkyyden ja painon.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Kuuma hitsaus</h3>
        <p class="mt-2 text-sm text-gray-600">
          Kuumailma- tai kuumakiilahitsaus saumoille ja vahvistuksille. Yleistä suurempia RIB-levyjä valmistettaessa.
          Vähemmän tarkka kuin HF-hitsaus, mutta tehokas Hypalon ja raskaille PVC kankaille.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Materiaalivertailu</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">Ominaista</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Relative Kosten', '$ (Budget)', '$$$ (Premium)'],
              ['UV-Beständigkeit', 'Gut (mit Beschichtung)', 'Hervorragend (materialeigen)'],
              ['Abriebfestigkeit', 'Mittel-Gut', 'Hervorragend'],
              ['Chemikalienbeständigkeit', 'Gut', 'Hervorragend'],
              ['Kälteflexibilität', 'Versteift unter 0°C', 'Flexibel bis -20°C'],
              ['Lebensdauer', '8-12 Jahre', '15-20+ Jahre'],
              ['Nahtmethode', 'HF-Schweißen', 'Handverklebung'],
              ['Reparatur', 'PVC-Kleber (einfach)', '2K-Kleber (mittel)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Moderni sotilaslaatu PVC (1100-1670 dtex) tarjoaa erinomaisen kestävyyden useimmille vapaa-ajan käyttäjille
      puoleen hintaan Hypalon. Hypalon on suositeltava kaupallisiin laivastoihin, trooppiseen ilmastoon ja
      turvallisuuskriittisiin sovelluksiin.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium"
      >Yksityiskohtainen opas: PVC vs. Hypalon →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Kuinka valita puhallettava vene</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. Määrittele käyttötarkoitus</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>Vapaa-aika: Jolla tai SUP</li>
          <li>Teho: RIB (15-60 HP)</li>
          <li>Kaupallinen: RIB (100+ PS)</li>
          <li>Kunto: puhallettava SUP</li>
          <li>Matkustaminen: puhallettava kajakki</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. Aseta budjettisi</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800: puhallettava SUP</li>
          <li>$500-$2,000: Jolla + moottori</li>
          <li>$3,000-$8,000: Lähtötaso RIB</li>
          <li>$8,000-$20,000: Premium RIB</li>
          <li>$20,000+: kaupallinen RIB</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. Harkitse materiaalia</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC: Edullinen, kevyt</li>
          <li>Hypalon: Premium, pitkäikäinen</li>
          <li>Drop-Stitch: Jäykkä teho</li>
          <li>Kankaan paksuus: 1100-1670 dtex</li>
          <li>Pinnoite: UV ja pistosuojakerrokset</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Turvallisuus ja standardit</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">CE -sertifikaatti</h3>
        <p class="mt-2 text-sm text-gray-600">
          Kaikki EU:ssa myytävät kumiveneet vaativat CE-merkinnän huvivenedirektiivin (RCD) 2013/53/EU mukaisesti.
          Sertifiointi kattaa suunnitteluluokan (A-D), kelluvuuden, vakauden ja kantavuuden. Aquafarer -veneet ovat CE
          sertifioituja virkistys- ja pelastuskäyttöön.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">standardi</h3>
        <p class="mt-2 text-sm text-gray-600">
          Kumiveneiden kansainvälinen standardi määrittelee vaatimukset materiaaleille, saumoille, venttiileille ja
          suorituskyvyn testaukselle. Tyypit I-IV kattavat kaiken pienistä veneistä suuriin RIB-veneisiin.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Välttämättömät turvavarusteet</h3>
        <p class="mt-2 text-sm text-gray-600">
          Pelastusliivit/pelastusliivit (CE 12402), heittoköydet, pilssipumppu/sammutin, navigointivalot (yö),
          VHF-radio, ensiapulaukku, ankkuri ja varamela tai polttoaine.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Turvallinen toiminta</h3>
        <p class="mt-2 text-sm text-gray-600">
          ÄLÄ KOSKAAN ylitä tyyppikilven enimmäiskuormitusta. Tarkista venttiilit ennen käynnistämistä. Jaa paino
          tasaisesti. Huomioi sääolosuhteet. Tallenna matkasuunnitelma. Osallistu veneilyturvallisuuskurssille.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Huolto ja hoito</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">1.</span><span
          >Huuhtele makealla vedellä jokaisen käytön jälkeen suolavedessä. Kuivaa kokonaan ennen varastointia.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">2.</span><span
          >Säilytä osittain täytettynä viileässä, kuivassa paikassa, suojassa suoralta auringonvalolta ja äärimmäisiltä
          lämpötiloilta.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">3.</span><span
          >Tarkista venttiilit ja saumat ennen jokaista kautta. Käsittele venttiilirungot vuosittain silikonisuihkeella.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">4.</span><span
          >Puhdista miedolla saippualla ja vedellä. Älä koskaan käytä liuottimia, valkaisuaineita tai
          korkeapainepesureita kankaalle.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">5.</span><span
          >Korjaa kaikki vauriot välittömästi käyttämällä valmistajan suosittelemia korjaussarjoja. Käytä Hypalon vain
          kaksikomponenttista liimaa.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">6.</span><span
          >Vaihda venttiilit 3-5 vuoden välein. Uusi kangas sen käyttöiän lopussa (näkyvää kulumista, huokoisuutta,
          sauman irtoamista).</span
        >
      </div>
    </div>
  </section>

  <section id="standards" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Teollisuuden sovellukset</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-4">
      {
        [
          {
            title: 'Freizeitbootfahren',
            desc: 'Familienausflüge, Wassersport, Angeln, Camping und Freizeitfahrten auf Seen, Flüssen und Küstengewässern.',
          },
          {
            title: 'Suche & Rettung',
            desc: 'Küstenwache, Rettungsschwimmer und Notfallteams setzen spezialisierte RIBs für schnellen Einsatz und Rettung in rauer See ein.',
          },
          {
            title: 'Kommerzielle Schifffahrt',
            desc: 'Tauchunterstützung, Patrouille, Vermessung, Touristentransport und Offshore-Logistik, bei denen Haltbarkeit und Zuverlässigkeit entscheidend sind.',
          },
          {
            title: 'Militär & Verteidigung',
            desc: 'Taktische RIBs für Marineoperationen, Truppentransport, Entereinsätze und verdeckte Landungen.',
          },
          {
            title: 'Humanitäre Hilfe',
            desc: 'Katastrophenschutzorganisationen setzen aufblasbare Boote für Hochwasserrettung, Versorgungstransporte und medizinische Evakuierungen ein.',
          },
          {
            title: 'OEM-Fertigung',
            desc: 'Individuelle Private-Label-Produktion für Marken, Händler und spezialisierte Betreiber mit besonderen Anforderungen.',
          },
        ].map((app) => (
          <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
            <h3 class="font-semibold text-sm text-gray-900">{app.title}</h3>
            <p class="mt-1 text-xs text-gray-500">{app.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 bg-gradient-to-br from-sky-50 to-blue-50 rounded-2xl p-8 border border-sky-200">
    <h2 class="text-xl font-semibold text-gray-900">Tutustu puhallettavaan veneeseen osoitteesta Aquafarer</h2>
    <p class="mt-4 text-sm text-gray-600">
      Aquafarer suunnittelee ja valmistaa CE-sertifioituja kumiveneita, SUP-veneitä, kajakkeja ja RIB-veneitä
      vapaa-ajan-, ammatti- ja OEM-markkinoille. Kaikki veneet on valmistettu sotilasluokan PVC- tai
      Hypalon-CSM-kankaista - käyttämällä nykyaikaista HF-hitsausta tai käsinliimausta.
    </p>
    <div class="mt-6 flex gap-4 flex-wrap">
      <a
        href={`/${lang}/products`}
        class="px-6 py-3 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
        >Katso tuotteet</a
      >
      <a
        href={`/${lang}/academy`}
        class="px-6 py-3 border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-gray-400 transition"
        >Oppimiskeskus</a
      >
    </div>
  </section>
</section>

<section class="sr-only" data-ai-block="definition" aria-hidden="true">
  <p>
    Kattava opas kumiveneisiin venetyypeillä (joilla, RIB-veneillä, kajakit, SUP-veneet, pelastusveneet, kaupalliset
    työveneet), rakennusmenetelmät (HF-hitsaus, käsin liimaus, Drop-Stitch ydin, lämpöhitsaus), materiaalit (PVC kangas,
    Hypalon CSM), turvallisuuskriteerit (tarkoitettu käyttö), turvallisuuskriteerit (tarkoitettu käyttö) (CE
    sertifiointi, välttämättömät laitteet), huolto (puhdistus, varastointi, korjaukset, venttiilien hoito) ja
    teollisuussovellukset (virkistys-, SAR-, kaupalliset, sotilaalliset, humanitaariset, OEM).
  </p>
</section>
