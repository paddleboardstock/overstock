---
const { lang = 'fr' } = Astro.props;
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
const t = (_key: string) => '';
---

<JsonLd
  type="Article"
  article={{
    headline: 'Guide des bateaux gonflables — La ressource complète',
    description:
      "Un guide complet des bateaux gonflables couvrant les types, les méthodes de construction, la comparaison des matériaux, les critères de sélection, les normes de sécurité et l'entretien.",
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://aquafarer.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: 'Industrie marine', href: `/${lang}/marine-industry` },
    { name: 'Guide des bateaux gonflables', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="Guide"
  quickAnswer="Un bateau gonflable est une embarcation légère dotée de tubes en tissu flexible (flotteurs) remplis d'air sous pression pour assurer la flottabilité. Les bateaux gonflables modernes comprennent les annexes, les RIB (bateaux rigides gonflables), les kayaks gonflables et les planches à pagaie. Ils sont fabriqués en tissus PVC ou Hypalon CSM par soudure RF ou coutures collées à la main, la construction drop-stitch permettant des planchers rigides haute pression."
  facts={[
    { label: 'Taille du marché mondial', value: '$2.8B (2026)' },
    { label: 'Matériaux principaux', value: 'PVC / Hypalon CSM' },
    { label: 'Durée de vie', value: '8-20+ ans' },
    { label: 'Certification CE', value: 'Requis (UE)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">Guide des bateaux gonflables</h1>
  <p class="mt-4 text-lg text-gray-500">
    La ressource de référence sur les embarcations gonflables — des annexes de loisir aux RIB professionnels, en passant
    par les navires de sauvetage spécialisés.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      [
        { label: 'Types', id: 'types' },
        { label: 'Construction', id: 'construction' },
        { label: 'Matériaux', id: 'materials' },
        { label: 'Sélection', id: 'selection' },
        { label: 'Sécurité', id: 'safety' },
        { label: 'Entretien', id: 'maintenance' },
        { label: 'Normes', id: 'standards' },
      ].map((s) => (
        <a
          href={`#${s.id}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {s.label}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Les types de bateaux gonflables</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: 'Annexes gonflables',
            desc: "Petites embarcations portables pour la navette, la pêche et l'usage récréatif sur de courtes distances. Généralement 2-4 m, propulsées par de petits moteurs hors-bord (2-15 HP) ou des rames. Le point d'entrée le plus abordable.",
            icon: '🚤',
          },
          {
            title: 'Bateaux rigides gonflables (RIBs)',
            desc: "Embarcations haute performance dotées d'une coque rigide en fibre de verre, aluminium ou HDPE et de flotteurs gonflables. Longueurs de 3-12 m, moteurs hors-bord de 15-300+ HP. Utilisés pour la patrouille, le sauvetage, la plongée et la croisière en mer.",
            icon: '⚡',
          },
          {
            title: 'Kayaks gonflables',
            desc: "Kayaks portables fabriqués en tissus PVC ou TPU. Disponibles en configurations simple et tandem pour les excursions récréatives, la descente de rivières et les voyages d'expédition.",
            icon: '🛶',
          },
          {
            title: 'Planches à pagaie gonflables (SUPs)',
            desc: 'Planches à pagaie construites en drop-stitch qui se gonflent en ponts rigides haute pression. Modèles polyvalents, de touring, de yoga, de pêche et de surf disponibles.',
            icon: '🏄',
          },
          {
            title: 'Bateaux de sauvetage (SAR)',
            desc: "RIB spécialisés pour les opérations de recherche et de sauvetage. Dotés de planchers auto-videurs, de consoles avant, de bitte d'amarrage et de coloris très visibles. Certifiés CE pour le sauvetage.",
            icon: '🆘',
          },
          {
            title: 'Bateaux de travail commerciaux',
            desc: "RIB robustes pour le soutien à la plongée, la patrouille, l'inspection et les opérations marines commerciales. Construction Hypalon CSM, coques renforcées et aménagement de qualité professionnelle.",
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Méthodes de construction</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Soudure RF (haute fréquence)</h3>
        <p class="mt-2 text-sm text-gray-600">
          Utilise l\'énergie électromagnétique pour fusionner les couches de PVC au niveau moléculaire. Crée les
          coutures étanches les plus résistantes. Courante dans les bateaux PVC et SUPs de haute qualité. Nécessite des
          machines spécialisées et un savoir-faire qualifié.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Collage à la main / liaison chimique</h3>
        <p class="mt-2 text-sm text-gray-600">
          Un adhésif deux composants relie les panneaux de tissu. Méthode principale pour les bateaux Hypalon CSM (non
          soudables par RF). Nécessite une préparation précise de la surface, une humidité contrôlée et un temps de
          polymérisation adéquat pour une résistance optimale des coutures.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Noyau drop-stitch</h3>
        <p class="mt-2 text-sm text-gray-600">
          Des milliers de fils en polyester relient les couches supérieure et inférieure de PVC, permettant un gonflage
          à haute pression (15-25 PSI) pour des performances de planche rigide. La densité des fils (15-50 fils/cm²)
          détermine la rigidité et le poids.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Soudure à chaud</h3>
        <p class="mt-2 text-sm text-gray-600">
          Soudure à air chaud ou à coin chaud utilisée pour les coutures et les renforts. Courante dans la construction
          des grands RIB. Moins précise que la soudure RF mais efficace pour le Hypalon et les tissus PVC résistants.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Comparaison des matériaux</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">Propriété</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Coût relatif', '$ (économique)', '$$$ (premium)'],
              ['Résistance aux UV', 'Bonne (avec revêtement)', 'Excellente (intrinsèque)'],
              ["Résistance à l'abrasion", 'Moyenne-Bonne', 'Excellente'],
              ['Résistance chimique', 'Bonne', 'Excellente'],
              ['Flexibilité à froid', 'Se rigidifie sous 0°C', "Souple jusqu'à -20°C"],
              ['Durée de vie', '8-12 ans', '15-20+ ans'],
              ["Méthode d'assemblage", 'Soudure RF', 'Collage à la main'],
              ['Réparation', 'Colle PVC (facile)', 'Adhésif 2 composants (modéré)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Le PVC moderne de qualité militaire (1100-1670 dtex) offre une excellente durabilité pour la plupart des
      utilisateurs de loisir pour la moitié du coût du Hypalon. Le Hypalon est privilégié pour les flottes commerciales,
      les climats tropicaux et les applications critiques.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium">Guide approfondi PVC vs Hypalon →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Comment choisir un bateau gonflable</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. Définissez votre usage</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>Loisir : annexe ou SUP</li>
          <li>Performance : RIB (15-60 HP)</li>
          <li>Commercial : RIB (100+ HP)</li>
          <li>Fitness : SUP gonflable</li>
          <li>Voyage : kayak gonflable</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. Fixez votre budget</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800 : SUP gonflable</li>
          <li>$500-$2,000 : Annexe + moteur</li>
          <li>$3,000-$8,000 : RIB d\'entrée de gamme</li>
          <li>$8,000-$20,000 : RIB premium</li>
          <li>$20,000+ : RIB commercial</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. Considérez le matériau</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC : économique, léger</li>
          <li>Hypalon : premium, longue durée</li>
          <li>Drop-Stitch : performance rigide</li>
          <li>Poids du tissu : 1100-1670 dtex</li>
          <li>Revêtement : couches UV + anti-perforation</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Sécurité & normes</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Certification CE</h3>
        <p class="mt-2 text-sm text-gray-600">
          Tous les bateaux gonflables vendus dans l\'UE nécessitent le marquage CE conformément à la directive sur les
          embarcations de plaisance (RCD) 2013/53/UE. La certification couvre la catégorie de conception (A-D), la
          flottabilité, la stabilité et la capacité de charge. Les bateaux Aquafarer sont certifiés CE pour un usage de
          loisir et de sauvetage.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Norme</h3>
        <p class="mt-2 text-sm text-gray-600">
          Norme internationale pour les bateaux gonflables précisant les exigences relatives aux matériaux, aux
          coutures, aux valves et aux tests de performance. Les types I-IV couvrent tout, des petites annexes aux grands
          RIB.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Équipement de sécurité essentiel</h3>
        <p class="mt-2 text-sm text-gray-600">
          Gilets de sauvetage/VFI (CE 12402), cordes de lancer, écope/extincteur, feux de navigation (nuit), radio VHF,
          trousse de premiers secours, ancre et pagaie de rechange ou carburant.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Utilisation en toute sécurité</h3>
        <p class="mt-2 text-sm text-gray-600">
          NE DÉPASSEZ JAMAIS la capacité maximale indiquée. Vérifiez la sécurité des valves avant la mise à l\'eau.
          Répartissez le poids uniformément. Surveillez les conditions météo. Déposez un plan de navigation. Suivez un
          cours de sécurité nautique.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Entretien & soins</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">1.</span><span
          >Rincer à l\'eau douce après chaque utilisation en eau salée. Sécher complètement avant le rangement.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">2.</span><span
          >Ranger partiellement gonflé dans un endroit frais et sec, à l\'abri de la lumière directe du soleil et des
          températures extrêmes.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">3.</span><span
          >Vérifier les valves et les coutures avant chaque saison. Appliquer un lubrifiant silicone sur les corps de
          valves chaque année.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">4.</span><span
          >Nettoyer avec un savon doux et de l\'eau. Ne jamais utiliser de solvants, d\'eau de Javel ou de nettoyeurs
          haute pression sur le tissu.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">5.</span><span
          >Réparer les perforations rapidement avec les kits de réparation recommandés par le fabricant. Pour le
          Hypalon, n\'utiliser que l\'adhésif deux composants.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">6.</span><span
          >Remplacer les valves tous les 3-5 ans. Remplacer le tissu en fin de vie (usure visible, porosité, décollement
          des coutures).</span
        >
      </div>
    </div>
  </section>

  <section id="standards" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Applications industrielles</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-4">
      {
        [
          {
            title: 'Navigation de loisir',
            desc: 'Sorties en famille, sports nautiques, pêche, camping et croisières de détente sur les lacs, rivières et eaux côtières.',
          },
          {
            title: 'Recherche & sauvetage',
            desc: "Garde-côtes, maîtres-nageurs et équipes d'intervention d'urgence utilisant des RIB spécialisés pour un déploiement rapide et le sauvetage en mer agitée.",
          },
          {
            title: 'Marine commerciale',
            desc: 'Soutien à la plongée, patrouille, inspection, transport touristique et logistique offshore où la durabilité et la fiabilité sont essentielles.',
          },
          {
            title: 'Militaire & défense',
            desc: "RIB tactiques pour les opérations navales, le transport de troupes, les opérations d'abordage et les insertions discrètes.",
          },
          {
            title: 'Aide humanitaire',
            desc: "Les organisations de secours déploient des bateaux gonflables pour le sauvetage en cas d'inondation, le transport de fournitures et l'évacuation médicale.",
          },
          {
            title: 'Fabrication OEM',
            desc: 'Production privée personnalisée pour les marques, les détaillants et les opérateurs spécialisés recherchant des spécifications uniques.',
          },
        ].map((app) => (
          <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
            <h3 class="font-semibold text-sm text-gray-900">{app.title}</h3>
            <p class="mt-1 text-xs text-gray-500">{app.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 bg-gradient-to-br from-sky-50 to-blue-50 rounded-2xl p-8 border border-sky-200">
    <h2 class="text-xl font-semibold text-gray-900">Explorez les bateaux gonflables Aquafarer</h2>
    <p class="mt-4 text-sm text-gray-600">
      Aquafarer conçoit et fabrique des bateaux gonflables, SUPs, kayaks et RIB certifiés CE pour les marchés de loisir,
      professionnel et OEM. Tous les bateaux sont fabriqués avec des tissus PVC de qualité militaire ou Hypalon CSM, par
      soudure RF avancée ou collage à la main.
    </p>
    <div class="mt-6 flex gap-4 flex-wrap">
      <a
        href={`/${lang}/products`}
        class="px-6 py-3 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
        >Voir les produits</a
      >
      <a
        href={`/${lang}/academy`}
        class="px-6 py-3 border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-gray-400 transition"
        >Centre d\'apprentissage</a
      >
    </div>
  </section>
</section>

<section class="sr-only" data-ai-block="definition" aria-hidden="true">
  <p>
    Guide complet des bateaux gonflables couvrant les types (annexes, RIBs, kayaks, SUPs, bateaux de sauvetage, bateaux
    de travail commerciaux), les méthodes de construction (soudure RF, collage à la main, noyau drop-stitch, soudure à
    chaud), les matériaux (tissu PVC, Hypalon CSM), les critères de sélection (usage, budget, comparaison des
    matériaux), les normes de sécurité (certification CE, équipement essentiel), l\'entretien (nettoyage, rangement,
    réparations, entretien des valves) et les applications industrielles (loisir, SAR, commercial, militaire,
    humanitaire, OEM).
  </p>
</section>
