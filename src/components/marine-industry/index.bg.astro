---
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
import { getUiForLang } from '~/i18n/generated/ui-all';

const { lang = 'bg' } = Astro.props;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
---

<JsonLd
  type="Article"
  article={{
    headline: 'Ръководство за надуваеми лодки — Пълният ресурс',
    description:
      'Изчерпателно ръководство за надуваеми лодки, обхващащо типове, методи на строителство, сравнение на материали, критерии за избор, стандарти за безопасност и поддръжка.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://aquafarer.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: 'Морска индустрия', href: `/${lang}/marine-industry` },
    { name: 'Ръководство за надуваеми лодки', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="Ръководство"
  quickAnswer="Надуваемата лодка е лек плавателен съд, изграден с гъвкави тубуси (спонзони), пълнени с подготвен въздух за осигуряване на плавучест. Модерните надуваеми лодки включват джонки, RIBs (твърдонадуваеми лодки), надуваеми каяци и дъски за стоящо гребане. Те са изработени от PVC или Hypalon CSM платове с използване на RF заварка или ръчно залепени шевове, като drop-stitch конструкцията позволява твърди подове под високо налягане."
  facts={[
    { label: 'Размер на глобалния пазар', value: '$2.8B (2026)' },
    { label: 'Първични материали', value: 'PVC Hypalon CSM/' },
    { label: 'Продължителност на живота', value: '8-20+ години' },
    { label: 'CE Сертификация', value: 'Задължително (ЕС)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">Ръководство за надуваеми лодки</h1>
  <p class="mt-4 text-lg text-gray-500">
    Определящият ресурс за надуваеми водни съдове — от развлекателни лодки до RIBs професионални и специализирани
    спасителни съдове.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      ['Types', 'Construction', 'Materials', 'Selection', 'Safety', 'Maintenance', 'Standards'].map((section) => (
        <a
          href={`#${section.toLowerCase()}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {section}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Видове надуваеми лодки</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: 'Надуваеми лодки',
            desc: 'Малки, преносими лодки за обслужване, риболов и краткосрочно развлекателно използване. Обикновено 2-4 м, задвижвани от малки извънбордови двигатели (2-15 HP) или гребла. Най-достъпният вариант.',
            icon: '🚤',
          },
          {
            title: 'Твърди надуваеми лодки (RIBs)',
            desc: 'Високопроизводителни лодки с твърд корпус от фибростъкло, алуминий или HDPE и надуваеми бордове. Дължина 3-12 м, извънбордови двигатели 15-300+ HP. Използват се за патрулиране, спасяване, гмуркане и морски круизи.',
            icon: '⚡',
          },
          {
            title: 'Надуваеми каяци',
            desc: 'Преносими каяци, изработени от PVC или TPU тъкани. Налично в индивидуални и тандемни конфигурации за развлекателен туризъм, плаване по река и експедиционно пътуване.',
            icon: '🛶',
          },
          {
            title: 'Надуваеми платформи за гребане правостоящи (SUPs)',
            desc: 'Drop-stitch конструира дъски за гребане, които се надуват до твърди високо налягани палуби. Налични са модели за общо ползване, туризъм, йога, риболов и сърф.',
            icon: '🏄',
          },
          {
            title: 'Спасителни лодки (SAR)',
            desc: 'Специализиран RIBs за операции по търсене и спасяване. Разполага с подове с автоматично източване, предни конзоли, буксировъчни бигове и цветови схеми с висока видимост. Сертифициран CE за спасяване.',
            icon: '🆘',
          },
          {
            title: 'Търговски работни кораби',
            desc: 'Тежкотоварен RIBs за поддръжка на гмуркане, патрулиране, проучвания и търговски морски операции. Hypalon CSM конструкция, подсилени корпуси и професионално оборудване.',
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Методи на изработка</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">RF заваряване (високочестотно)</h3>
        <p class="mt-2 text-sm text-gray-600">
          Използва електромагнитна енергия за PVC сливане на слоеве на молекулярно ниво. Създава най-здравите херметични
          шевове. Често срещано при висококачествени PVC лодки и SUPs. Изисква специализирана техника и умело
          управление.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Ръчно лепило / Химическо свързване</h3>
        <p class="mt-2 text-sm text-gray-600">
          Двукомпонентни лепилки свързват платнени панели. Основен метод за Hypalon CSM лодки (не може да се заварява
          RF). Изисква прецизна подготовка на повърхността, контролирана влажност и правилно време за втвърдяване за
          оптимална здравина на шева.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Drop-Stitch Ядро</h3>
        <p class="mt-2 text-sm text-gray-600">
          Хиляди полиестерни резби свързват горния и долния PVC слой, позволявайки високонадуване (15-25PSI) за твърда
          производителност на платката. Плътността на резбата (15-50 резби/см²) определя твърдостта и теглото.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Топлинно заваряване</h3>
        <p class="mt-2 text-sm text-gray-600">
          Заваряване с горещ въздух или горещ клин, използвано за шевове и подсилвания. Често срещано в по-голяма RIB
          конструкция. По-малко прецизно от RF заваряването, но ефективно за Hypalon здрави PVC тъкани.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Сравнение на материали</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">Имоти</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Relative Cost', '$ (budget)', '$$$ (premium)'],
              ['UV Resistance', 'Good (with coating)', 'Excellent (inherent)'],
              ['Abrasion Resistance', 'Moderate-Good', 'Excellent'],
              ['Chemical Resistance', 'Good', 'Excellent'],
              ['Cold Flexibility', 'Stiffens below 0°C', 'Flexible to -20°C'],
              ['Lifespan', '8-12 years', '15-20+ years'],
              ['Seam Method', 'RF welding', 'Hand gluing'],
              ['Repair', 'PVC glue (easy)', '2-part adhesive (moderate)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Модерният военен клас PVC (1100-1670 dtex) предлага отлична издръжливост за повечето развлекателни потребители на
      половината цена на Hypalon. Hypalon се предпочита за търговски флотове, тропически климат и критични за мисията
      приложения.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium"
      >Подробно ръководство за PVC и Hypalon →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Как да изберем надуваема лодка</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. Определете вашия случай на използване</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>Рекреационен: Дингии или SUP</li>
          <li>Производителност: RIB (15-60 HP)</li>
          <li>Рекламно: RIB (100+ HP)</li>
          <li>Фитнес: надуваем SUP</li>
          <li>Пътуване: Надуваем каяк</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. Определете своя бюджет</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800: Надуваем SUP</li>
          <li>$500-$2,000: двигател за гумена лодка +</li>
          <li>$3,000-$8,000: Вход RIB</li>
          <li>$8,000-$20,000: Премиум RIB</li>
          <li>$20,000+: Търговски RIB</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. Разгледайте материала</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC: Икономичен, лек</li>
          <li>Hypalon: Висококачествен, дълготраен</li>
          <li>Drop-Stitch: твърдо изпълнение</li>
          <li>Тегло на плата: 1100-1670 дтекс</li>
          <li>Покритие: UV + слоя против пробиване</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Безопасност и стандарти</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">CE Сертификация</h3>
        <p class="mt-2 text-sm text-gray-600">
          Всички надуваеми лодки, продавани в ЕС, изискват маркировка CE според Директивата за развлекателни плавателни
          съдове (RCD) 2013/53/ЕС. Сертификацията обхваща категория на проектиране (A-D), плавучест, стабилност и
          товароносимост. Aquafarer лодки са сертифицирани по CE за развлекателна и спасителна употреба.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Стандарт</h3>
        <p class="mt-2 text-sm text-gray-600">
          Международен стандарт за надуваеми лодки, определящ изискванията за материали, шевове, клапани и изпитвания на
          производителността. Типове I-IV обхващат всичко от малки гумени лодки до големи RIBs.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Основно оборудване за безопасност</h3>
        <p class="mt-2 text-sm text-gray-600">
          Спасителни жилетки/PFD (CE 12402), въжета за хвърляне, кофа/пожарогасител, навигационни светлини (нощем), VHF
          радио, комплект за първа помощ, котва и резервно гребло или гориво.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Безопасна експлоатация</h3>
        <p class="mt-2 text-sm text-gray-600">
          НИКОГА не превишавайте максималния капацитет, посочен на табелата. Проверявайте сигурността на клапаните преди
          пускането във вода. Разпределяйте равномерно теглото. Следете метеорологичните условия. Подайте план за
          плаване. Вземете курс по безопасност на лодките.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Поддръжка и грижи</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <>
          <span class="text-sky-600 font-bold flex-shrink-0">1.</span>
          <span
            >Изплаквайте с прясна вода след всяка употреба в солена вода. Съхранявайте напълно сухо преди съхранение.</span
          >
        </>
      </div>
    </div>
  </section>
</section>
