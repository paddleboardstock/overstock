---
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
import { getUiForLang } from '~/i18n/generated/ui-all';

const { lang = 'et' } = Astro.props;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
---

<JsonLd
  type="Article"
  article={{
    headline: 'Täispuhutava paadi juhend — täielik ressurss',
    description:
      'Põhjalik juhend täispuhutavate paatide kohta, mis käsitleb tüüpe, ehitusmeetodeid, materjalide võrdlust, valikukriteeriume, ohutusstandardeid ja hooldust.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://aquafarer.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: 'Merendustööstus', href: `/${lang}/marine-industry` },
    { name: 'Täispuhutava paadi juhend', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="Juhend"
  quickAnswer="Täispuhutav paat on kerge veesõiduk, mis on valmistatud paindlikest kangast torudest (sponsonid), mis on täidetud rõhuga õhuga ujuvuse tagamiseks. Kaasaegsed täispuhutavad paadid hõlmavad kummipaate, RIBs (jäigad täispuhutavad paadid), täispuhutavaid kajakke ja seisvalt sõitmise lauad. Neid valmistatakse PVC või Hypalon CSM kangastest kasutades RF-keevitust või käsitsi liimitud õmblusi, kus drop-stitch konstruktsioon võimaldab kõrge rõhuga jäikade põrandate tegemist."
  facts={[
    { label: 'Globaalne turu suurus', value: '$2.8B (2026)' },
    { label: 'Esmased materjalid', value: 'PVC / Hypalon CSM' },
    { label: 'Eluiga vahemik', value: '8–20+ aastat' },
    { label: 'CE Sertifitseerimine', value: 'Kohustuslik (EL)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">Täispuhutava paadi juhend</h1>
  <p class="mt-4 text-lg text-gray-500">
    Parim ressurss täispuhutavate veesõidukite kohta — alates vabaaja paadidest kuni RIBs professionaalsete ja
    spetsiaalsete päästelaevadeni.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      ['Types', 'Construction', 'Materials', 'Selection', 'Safety', 'Maintenance', 'Standards'].map((section) => (
        <a
          href={`#${section.toLowerCase()}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {section}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Täispuhutavate paatide tüübid</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: 'Täispuhutavad paadid',
            desc: 'Väikesed, kaasaskantavad paadid kasutamiseks tenderina, kalapüügiks ja lühikese vahemaa meelelahutuslikuks kasutamiseks. Tavaliselt 2-4 m, varustatud väikeste tööpingiroolidega (2-15 HP) või aerudega. Kõige taskukohasem sisenemise punkt.',
            icon: '🚤',
          },
          {
            title: 'Kerged jäigad täispuhutavad paadid (RIBs)',
            desc: 'Kõrge jõudlusega paadid jäiga klaaskiust, alumiiniumist või HDPE kerega ja täispuhutavate paberlauaga. Pikkus 3–12 m, 15–300 + HP välise mootori võimsusega. Kasutatakse patrullimiseks, päästetöödeks, sukeldumiseks ja avamere kruiisiks.',
            icon: '⚡',
          },
          {
            title: 'Täispuhutavad kajakid',
            desc: 'Kaasaskantavad kajakid, mis on valmistatud PVC või TPU kangast. Saadaval ühe- ja kahekohalistes variantides vaba aja veesõiduks, jõeületusteks ja ekspeditsioonideks.',
            icon: '🛶',
          },
          {
            title: 'Täispuhutavad seisulaudadega aerulaud (SUPs)',
            desc: 'Drop-stitch konstruktsiooniga aerulauad, mis täidavad kõrgendatud survega jäigaks tekiks. Saadaval universaalsed, turismiks, jooga, kalapüügi ja surfamise mudelid.',
            icon: '🏄',
          },
          {
            title: 'Päästepaadid (SAR)',
            desc: 'Spetsiaalsed RIBs otsingute ja päästetööde jaoks. Omavad isetühjenevat põrandat, esikonsoole, veokiisid ja kõrge nähtavusega värviskeeme. CE sertifitseeritud päästetöödeks.',
            icon: '🆘',
          },
          {
            title: 'Kaubanduslikud tööpaadid',
            desc: 'Raskekujulised RIBs sukeldumise toetuseks, patrullimiseks, mõõdistamiseks ja kaubanduslikeks meretöödeks. Hypalon CSM konstruktsioon, tugevdatud kestad ja professionaalse kvaliteediga sisustus.',
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Ehitusmeetodid</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">RF-keevitus (kõrgsageduslik)</h3>
        <p class="mt-2 text-sm text-gray-600">
          Kasutab elektromagnetilist energiat, et PVC ühendada kihtide molekulaarsel tasandil. Loob kõige tugevamad
          õhukindlad õmblused. Tavaline PVC kvaliteetsetes paatides ja SUPs. Nõuab spetsiaalset masinavärki ja
          oskuslikku tööd.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Käsitsi liimimine / Keemiline sidumine</h3>
        <p class="mt-2 text-sm text-gray-600">
          Kaheosaline liimiga seob kangapaneelid. Hypalon CSM Paatide peamine meetod (ei saa RF-keevitada). Nõuab täpset
          pinna ettevalmistust, kontrollitud niiskust ja õiget kõvenemisaega optimaalse õmbluse tugevuse saavutamiseks.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Drop-Stitch Tuum</h3>
        <p class="mt-2 text-sm text-gray-600">
          Tuhanded polüesterkeermed ühendavad ülemise ja PVC alumise kihti, võimaldades kõrgsurve täitmist (15–25PSI)
          jäiga plaadi toimimiseks. Keermetihedus (15–50 keerme/cm²) määrab jäikuse ja kaalu.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Kuumkeevitus</h3>
        <p class="mt-2 text-sm text-gray-600">
          Kuuma õhu või kuuma kiilkeevituse kasutamine õmbluste ja tugevduste jaoks. Levinud RIB suuremates
          konstruktsioonides. Vähem täpne kui RF-keevitus, kuid tõhus Hypalon nii tugevate PVC kangaste jaoks.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Materjalide võrdlus</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">Kinnisvara</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Relative Cost', '$ (budget)', '$$$ (premium)'],
              ['UV Resistance', 'Good (with coating)', 'Excellent (inherent)'],
              ['Abrasion Resistance', 'Moderate-Good', 'Excellent'],
              ['Chemical Resistance', 'Good', 'Excellent'],
              ['Cold Flexibility', 'Stiffens below 0°C', 'Flexible to -20°C'],
              ['Lifespan', '8-12 years', '15-20+ years'],
              ['Seam Method', 'RF welding', 'Hand gluing'],
              ['Repair', 'PVC glue (easy)', '2-part adhesive (moderate)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Moodne sõjaväe-klassi PVC (1100-1670 dtex) pakub suurepärase vastupidavuse enamikule vaba aja kasutajatele poole
      hinnaga võrreldes Hypalon. Hypalon on eelistatud kaubanduslike laevastike, troopiliste kliimade ja kriitilise
      tähtsusega missioonide puhul.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium">Sügavuti PVC vs Hypalon juhend →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Kuidas valida täispuhutav paat</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. Määratle oma kasutusala</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>Vaba aeg: Paadikese või SUP</li>
          <li>Tulemuslikkus: RIB (15-60 HP)</li>
          <li>Kaubanduslik: RIB (100+ HP)</li>
          <li>Fitness: Täispuhutav SUP</li>
          <li>Reisimine: Täispuhutav kajak</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. Määra oma eelarve</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800: Täispuhutav SUP</li>
          <li>$500-$2,000: Paadikese + mootor</li>
          <li>$3,000-$8,000: Algtaseme RIB</li>
          <li>$8,000-$20,000: Premium RIB</li>
          <li>$20,000+: Kaubanduslik RIB</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. Mõtle materjalile</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC: Eelarvesõbralik, kerge</li>
          <li>Hypalon: Premium, pikaealine</li>
          <li>Drop-Stitch: Jäik jõudlus</li>
          <li>Kanga kaal: 1100-1670 dtex</li>
          <li>Kate: UV + läbistuskihid</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Ohutus ja standardid</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">CE Sertifitseerimine</h3>
        <p class="mt-2 text-sm text-gray-600">
          Kõik EU-s müüdavad täispuhutavad paadid nõuavad CE märgistust Vaba aja veesõidukite direktiivi (RCD)
          2013/53/EU alusel. Sertifikaat katab disainikategooria (A-D), ujukuse, stabiilsuse ja koormuse kandevõime.
          Aquafarer paadid on CE-sertifitseeritud vaba aja ja päästeotstarbeks.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Standard</h3>
        <p class="mt-2 text-sm text-gray-600">
          Rahvusvaheline standard täispuhutavate paatide jaoks, mis sätestab nõuded materjalidele, õmblustele,
          ventiilidele ja jõudlustestidele. Tüübid I-IV katavad kõike alates väikestest paatidest kuni suurte RIBs.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Oluline turvavarustus</h3>
        <p class="mt-2 text-sm text-gray-600">
          Päästevestid/PFD-d (CE 12402), viskerööpad, paagipump/tulekustuti, navigatsioonituled (öösel), VHF-raadio,
          esmaabikomplekt, ankur ja varupaat või kütus.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Ohutu kasutamine</h3>
        <p class="mt-2 text-sm text-gray-600">
          ÄRGE kunagi ületage maksimaalset koormustahvlit. Kontrollige ventiilide turvalisust enne veeületust. Jaotage
          kaal ühtlaselt. Jälgige ilmastikutingimusi. Esitage liikumiskava. Osalege paaditurvalisuse kursusel.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Hooldus ja hoolitsus</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <>
          <span class="text-sky-600 font-bold flex-shrink-0">1.</span>
          <span>Puhastage pärast iga soolase veega kasutamist värske veega. Kuivatage täielikult enne hoiustamist.</span
          >
        </>
      </div>
    </div>
  </section>
</section>
