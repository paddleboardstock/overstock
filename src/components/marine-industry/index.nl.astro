---
const { lang = 'nl' } = Astro.props;
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
const t = (_key: string) => '';
---

<JsonLd
  type="Article"
  article={{
    headline: 'Gids voor opblaasbare boten — De complete hulpbron',
    description:
      'Een uitgebreide gids voor opblaasbare boten met informatie over boottypen, constructiemethoden, materiaalvergelijking, selectiecriteria, veiligheidsnormen en onderhoud.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://aquafarer.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: 'Maritieme industrie', href: `/${lang}/marine-industry` },
    { name: 'Gids voor opblaasbare boten', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="Leitfaden"
  quickAnswer="Een opblaasbare boot is een lichtgewicht vaartuig waarvan de flexibele stoffen buizen (drijfkamers) zijn gevuld met perslucht om drijfvermogen te creëren. Moderne opblaasbare boten zijn onder meer rubberboten, RIB's (stijve opblaasbare boten), opblaasbare kajaks en stand-up paddleboards. Ze zijn gemaakt van PVC of Hypalon-CSM stoffen met behulp van HF-lassen of met de hand gelijmde naden; De Drop-Stitch-constructie maakt harde vloeren onder hoge druk mogelijk."
  facts={[
    { label: 'Mondiale marktomvang', value: '$2.8B (2026)' },
    { label: 'Primaire materialen', value: 'PVC / Hypalon CSM' },
    { label: 'leven', value: '8-20+ Jahre' },
    { label: 'CE certificering', value: 'Erforderlich (EU)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">Gids voor opblaasbare boten</h1>
  <p class="mt-4 text-lg text-gray-500">
    De ultieme informatiebron op het gebied van opblaasbare waterscooters – van recreatieve rubberboten tot
    professionele RIB's en speciale reddingsboten.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      [
        { label: 'Typen', id: 'types' },
        { label: 'Konstruktion', id: 'construction' },
        { label: 'Materialien', id: 'materials' },
        { label: 'Auswahl', id: 'selection' },
        { label: 'Sicherheit', id: 'safety' },
        { label: 'Wartung', id: 'maintenance' },
        { label: 'Standards', id: 'standards' },
      ].map((s) => (
        <a
          href={`#${s.id}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {s.label}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Soorten opblaasbare boten</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: 'Aufblasbare Dinghys',
            desc: 'Kleine, tragbare Boote für Zubringerdienste, Angeln und kurze Freizeitfahrten. Typischerweise 2-4 m lang, mit kleinen Außenbordern (2-15 PS) oder Riemen angetrieben. Der günstigste Einstieg.',
            icon: '🚤',
          },
          {
            title: 'Festrumpf-Schlauchboote (RIBs)',
            desc: 'Leistungsstarke Boote mit starrem Rumpf aus GFK, Aluminium oder HDPE und aufblasbaren Auftriebskammern. Längen von 3-12 m, Außenbordmotoren mit 15-300+ PS. Einsatz bei Patrouille, Rettung, Tauchen und Hochseefahrten.',
            icon: '⚡',
          },
          {
            title: 'Aufblasbare Kajaks',
            desc: 'Tragbare Kajaks aus PVC- oder TPU-Gewebe. Erhältlich in Einzel- und Tandemausführung für Freizeittouren, Flussfahrten und Expeditionen.',
            icon: '🛶',
          },
          {
            title: 'Aufblasbare Stand-Up-Paddle-Boards (SUPs)',
            desc: 'In Drop-Stitch-Konstruktion gefertigte Paddle-Boards, die sich zu starren Hochdruckdecks aufpumpen lassen. Erhältlich als Allround-, Touring-, Yoga-, Angel- und Surf-Modelle.',
            icon: '🏄',
          },
          {
            title: 'Rettungsboote (SAR)',
            desc: 'Spezialisierte RIBs für Such- und Rettungseinsätze. Mit selbstlenzendem Boden, Mittelkonsole, Schleppösen und Signalfarben. Für den Rettungseinsatz CE-zertifiziert.',
            icon: '🆘',
          },
          {
            title: 'Kommerzielle Arbeitsboote',
            desc: 'Robuste RIBs für Tauchunterstützung, Patrouille, Vermessung und kommerzielle maritime Einsätze. Hypalon-CSM-Konstruktion, verstärkte Rümpfe und professionelle Ausstattung.',
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Bouwmethoden</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">HF-lassen (hoge frequentie)</h3>
        <p class="mt-2 text-sm text-gray-600">
          Gebruikt elektromagnetische energie om PVC-lagen op moleculair niveau samen te smelten. Creëert de sterkste
          luchtdichte naden. Gebruikelijk op hoogwaardige PVC-boten en SUP's. Vereist speciale machines en getrainde
          operators.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Handverlijming/chemische verlijming</h3>
        <p class="mt-2 text-sm text-gray-600">
          Tweecomponentenlijm verbindt de stoffen panelen. De belangrijkste methode voor Hypalon-CSM boten
          (niet-HF-lasbaar). Vereist een nauwkeurige voorbereiding van het oppervlak, gecontroleerde vochtigheid en
          voldoende uithardingstijd voor optimale naadsterkte.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Drop-Stitch kern</h3>
        <p class="mt-2 text-sm text-gray-600">
          Duizenden polyesterdraden verbinden de bovenste en onderste PVC-lagen, waardoor opblazen tot hoge druk (15-25
          PSI) mogelijk is voor een stijf boardgedrag. De draaddichtheid (15-50 draden/cm²) bepaalt de stijfheid en het
          gewicht.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Heet lassen</h3>
        <p class="mt-2 text-sm text-gray-600">
          Hetelucht- of heetwiglassen voor naden en verstevigingen. Vaak bij het produceren van grotere RIB's. Minder
          nauwkeurig dan HF-lassen, maar effectief voor Hypalon en zware PVC stoffen.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Materiaalvergelijking</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">Kenmerkend</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Relative Kosten', '$ (Budget)', '$$$ (Premium)'],
              ['UV-Beständigkeit', 'Gut (mit Beschichtung)', 'Hervorragend (materialeigen)'],
              ['Abriebfestigkeit', 'Mittel-Gut', 'Hervorragend'],
              ['Chemikalienbeständigkeit', 'Gut', 'Hervorragend'],
              ['Kälteflexibilität', 'Versteift unter 0°C', 'Flexibel bis -20°C'],
              ['Lebensdauer', '8-12 Jahre', '15-20+ Jahre'],
              ['Nahtmethode', 'HF-Schweißen', 'Handverklebung'],
              ['Reparatur', 'PVC-Kleber (einfach)', '2K-Kleber (mittel)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Moderne militaire kwaliteit PVC (1100-1670 dtex) biedt uitstekende duurzaamheid voor de meeste recreatieve
      gebruikers tegen de helft van de kosten van Hypalon. Hypalon heeft de voorkeur voor commerciële vloten, tropische
      klimaten en veiligheidskritische toepassingen.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium"
      >Gedetailleerde gids: PVC versus Hypalon →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Hoe een opblaasbare boot te kiezen</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. Definieer uw beoogde gebruik</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>Vrije tijd: rubberboot of SUP</li>
          <li>Vermogen: RIB (15-60 PK)</li>
          <li>Commercieel: RIB (100+ PS)</li>
          <li>Fitness: opblaasbaar SUP</li>
          <li>Reizen: opblaasbare kajak</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. Stel uw budget in</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800: Opblaasbaar SUP</li>
          <li>$500-$2,000: Bijboot + motor</li>
          <li>$3,000-$8,000: instapniveau RIB</li>
          <li>$8,000-$20,000: Premium RIB</li>
          <li>$20,000+: Commercieel RIB</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. Denk aan materiaal</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC: Goedkoop, licht</li>
          <li>Hypalon: Premium, duurzaam</li>
          <li>Drop-Stitch: Stijve kracht</li>
          <li>Stofdikte: 1100-1670 dtex</li>
          <li>Coating: UV en lekbeschermingslagen</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Veiligheid en normen</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">CE certificering</h3>
        <p class="mt-2 text-sm text-gray-600">
          Alle opblaasbare boten die in de EU worden verkocht, vereisen de CE-markering in overeenstemming met de
          Richtlijn Pleziervaartuigen (RCD) 2013/53/EU. De certificering heeft betrekking op de ontwerpcategorie (A-D),
          het drijfvermogen, de stabiliteit en het draagvermogen. Aquafarer boten zijn CE gecertificeerd voor recreatief
          en reddingsgebruik.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">standaard</h3>
        <p class="mt-2 text-sm text-gray-600">
          De internationale norm voor opblaasbare boten specificeert eisen voor materialen, naden, kleppen en
          prestatietests. Types I-IV bestrijken alles, van kleine rubberboten tot grote RIB's.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Essentiële veiligheidsuitrusting</h3>
        <p class="mt-2 text-sm text-gray-600">
          Reddingsvesten/reddingsvesten (CE 12402), werplijnen, lenspomp/brandblusser, navigatieverlichting (nacht),
          marifoon, EHBO-doos, anker en reservepeddel of brandstof.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Veilige werking</h3>
        <p class="mt-2 text-sm text-gray-600">
          Overschrijd NOOIT de maximale belasting op het typeplaatje. Controleer de kleppen voordat u vertrekt. Verdeel
          het gewicht gelijkmatig. Houd rekening met de weersomstandigheden. Bewaar een reisplan. Volg een cursus
          vaarveiligheid.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Onderhoud en verzorging</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">1.</span><span
          >Spoel na elk gebruik in zout water af met zoet water. Droog volledig voordat u het opbergt.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">2.</span><span
          >Gedeeltelijk opgeblazen bewaren op een koele, droge plaats, uit de buurt van direct zonlicht en extreme
          temperaturen.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">3.</span><span
          >Controleer de kleppen en naden vóór elk seizoen. Behandel de kleplichamen jaarlijks met siliconenspray.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">4.</span><span
          >Reinigen met milde zeep en water. Gebruik nooit oplosmiddelen, bleekmiddel of hogedrukreinigers op de stof.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">5.</span><span
          >Repareer eventuele schade onmiddellijk met behulp van reparatiesets die door de fabrikant worden aanbevolen.
          Voor Hypalon uitsluitend tweecomponentenlijm gebruiken.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">6.</span><span
          >Vervang de kleppen elke 3-5 jaar. Vernieuw de stof aan het einde van zijn levensduur (zichtbare slijtage,
          porositeit, naadscheiding).</span
        >
      </div>
    </div>
  </section>

  <section id="standards" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Industriële toepassingen</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-4">
      {
        [
          {
            title: 'Freizeitbootfahren',
            desc: 'Familienausflüge, Wassersport, Angeln, Camping und Freizeitfahrten auf Seen, Flüssen und Küstengewässern.',
          },
          {
            title: 'Suche & Rettung',
            desc: 'Küstenwache, Rettungsschwimmer und Notfallteams setzen spezialisierte RIBs für schnellen Einsatz und Rettung in rauer See ein.',
          },
          {
            title: 'Kommerzielle Schifffahrt',
            desc: 'Tauchunterstützung, Patrouille, Vermessung, Touristentransport und Offshore-Logistik, bei denen Haltbarkeit und Zuverlässigkeit entscheidend sind.',
          },
          {
            title: 'Militär & Verteidigung',
            desc: 'Taktische RIBs für Marineoperationen, Truppentransport, Entereinsätze und verdeckte Landungen.',
          },
          {
            title: 'Humanitäre Hilfe',
            desc: 'Katastrophenschutzorganisationen setzen aufblasbare Boote für Hochwasserrettung, Versorgungstransporte und medizinische Evakuierungen ein.',
          },
          {
            title: 'OEM-Fertigung',
            desc: 'Individuelle Private-Label-Produktion für Marken, Händler und spezialisierte Betreiber mit besonderen Anforderungen.',
          },
        ].map((app) => (
          <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
            <h3 class="font-semibold text-sm text-gray-900">{app.title}</h3>
            <p class="mt-1 text-xs text-gray-500">{app.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 bg-gradient-to-br from-sky-50 to-blue-50 rounded-2xl p-8 border border-sky-200">
    <h2 class="text-xl font-semibold text-gray-900">Ontdek de opblaasbare boten van Aquafarer</h2>
    <p class="mt-4 text-sm text-gray-600">
      Aquafarer ontwerpt en produceert CE gecertificeerde opblaasbare boten, SUP's, kajaks en RIB's voor de recreatieve,
      professionele en OEM markt. Alle boten zijn vervaardigd met stoffen van militaire kwaliteit PVC of Hypalon-CSM,
      waarbij gebruik wordt gemaakt van modern HF-lassen of handverlijming.
    </p>
    <div class="mt-6 flex gap-4 flex-wrap">
      <a
        href={`/${lang}/products`}
        class="px-6 py-3 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
        >Bekijk producten</a
      >
      <a
        href={`/${lang}/academy`}
        class="px-6 py-3 border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-gray-400 transition"
        >Leercentrum</a
      >
    </div>
  </section>
</section>

<section class="sr-only" data-ai-block="definition" aria-hidden="true">
  <p>
    Uitgebreide gids voor opblaasbare boten met boottypen (bijboten, RIB's, kajaks, SUP's, reddingsboten, commerciële
    werkboten), constructiemethoden (HF-lassen, handverlijming, Drop-Stitch kern, thermisch lassen), materialen (PVC
    stof, Hypalon CSM), selectiecriteria (beoogd gebruik, budget, materiaalvergelijking), veiligheidsnormen (CE
    certificering, essentiële uitrusting), onderhoud (reiniging, opslag, reparatie, kleponderhoud) en industriële
    toepassingen (recreatief, SAR, commercieel, militair, humanitair, OEM).
  </p>
</section>
