---
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
import { getUiForLang } from '~/i18n/generated/ui-all';

const { lang = 'ko' } = Astro.props;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
---

<JsonLd
  type="Article"
  article={{
    headline: '플라스틱 보트 가이드 — 완전한 자료',
    description:
      '플라스틱 보트의 종류, 제작 방법, 소재 비교, 선택 기준, 안전 기준 및 유지 관리에 대한 종합 가이드입니다.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://paddleboardoverstock.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: '해양 산업', href: `/${lang}/marine-industry` },
    { name: '플라스틱 보트 가이드', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="가이드"
  quickAnswer="고무보트는 부력을 제공하기 위해 압축 공기로 채워진 유연한 천 튜브(스폰슨)로 제작된 가벼운 수상 보트입니다. 현대의 고무보트에는 딩기, RIBs (강체 고무보트), 고무 카약, 스탠드업 패들보드가 포함됩니다. 이들은 PVC 또는 Hypalon CSM 천으로 RF 용접이나 손으로 붙인 솔기를 사용하여 제작되며, drop-stitch 구조로 높은 압력의 강체 바닥을 구현합니다."
  facts={[
    { label: '글로벌 시장 규모', value: '$2.8B (2026)' },
    { label: '주요 소재', value: 'PVC / Hypalon CSM' },
    { label: '수명 범위', value: '8-20+ 년' },
    { label: 'CE 인증', value: '필수 (EU)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">플라스틱 보트 가이드</h1>
  <p class="mt-4 text-lg text-gray-500">
    레크리에이션 딩히에서 전문 RIBs 및 특수 구조 선박에 이르기까지 플라스틱 수상 운송 수단에 대한 결정적 자료.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      ['Types', 'Construction', 'Materials', 'Selection', 'Safety', 'Maintenance', 'Standards'].map((section) => (
        <a
          href={`#${section.toLowerCase()}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {section}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">플라스틱 보트의 종류</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: '고무보트',
            desc: '텐더링, 낚시, 단거리 레크리에이션용으로 사용되는 작고 휴대 가능한 보트. 일반적으로 2-4m이며, 작은 외부 엔진(2-15 HP)이나 노로 운항. 가장 저렴한 진입점.',
            icon: '🚤',
          },
          {
            title: '단단한 고무보트(RIBs)',
            desc: '강체 유리섬유, 알루미늄 또는 HDPE 선체와 팽창식 스폰슨을 갖춘 고성능 보트. 길이 3-12m, 15-300+ HP 외부 엔진. 순찰, 구조, 잠수 및 연안 항해용으로 사용됨.',
            icon: '⚡',
          },
          {
            title: '팽창식 카약',
            desc: '휴대용 카약은 PVC 또는 TPU 원단으로 제작됩니다. 레크리에이션 투어, 강 래프팅, 원정 여행용으로 싱글 및 2인용 구성이 가능합니다.',
            icon: '🛶',
          },
          {
            title: '에어 바람으로 부풀리는 스탠드업 패들 보드 (SUPs)',
            desc: 'Drop-stitch는 강한 압력 데크로 팽창하는 패들 보드를 제작했습니다. 올어라운드, 투어링, 요가, 낚시 및 서핑 모델을 사용할 수 있습니다.',
            icon: '🏄',
          },
          {
            title: '구조 보트 (SAR)',
            desc: '수색 및 구조 작업을 위해 특수 제작된 RIBs. 자동 배수 바닥, 전방 콘솔, 견인 장치 및 고가시성 색상 체계를 갖추고 있습니다. 구조용으로 CE 인증을 받았습니다.',
            icon: '🆘',
          },
          {
            title: '상업용 작업선',
            desc: '잠수 지원, 순찰, 조사 및 상업 해양 작업용 중장비 RIBs. Hypalon CSM 구조, 강화된 선체 및 전문가급 장비 구성.',
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">제작 방법</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">RF 용접 (고주파)</h3>
        <p class="mt-2 text-sm text-gray-600">
          분자 수준에서 PVC 층을 융합하기 위해 전자기 에너지를 사용. 가장 강력한 기밀 봉합을 생성. 고품질 PVC 보트 및
          SUPs에서 일반적. 특수 장비와 숙련된 기술 필요.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">손 접착 / 화학 접착</h3>
        <p class="mt-2 text-sm text-gray-600">
          투파트 접착제로 패브릭 패널 결합. Hypalon CSM 보트의 주요 방법(RF 용접 불가). 최적 봉합 강도를 위해 정밀한
          표면 준비, 습도 조절 및 충분한 경화 시간 필요.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Drop-Stitch 코어</h3>
        <p class="mt-2 text-sm text-gray-600">
          수천 개의 폴리에스터 실이 상하 PVC 층을 연결, 고압 팽창(15-25 PSI)으로 단단한 보드 성능 제공. 실 밀도(15-50
          실/cm²)가 강성과 무게를 결정.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">열 용접</h3>
        <p class="mt-2 text-sm text-gray-600">
          이열/열 쐐기 용접으로 봉합 및 보강. 대형 RIB 제작에서 일반적. RF 용접보다는 정밀하지 않지만 Hypalon 및 중장비
          PVC 패브릭에 효과적.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">소재 비교</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">속성</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Relative Cost', '$ (budget)', '$$$ (premium)'],
              ['UV Resistance', 'Good (with coating)', 'Excellent (inherent)'],
              ['Abrasion Resistance', 'Moderate-Good', 'Excellent'],
              ['Chemical Resistance', 'Good', 'Excellent'],
              ['Cold Flexibility', 'Stiffens below 0°C', 'Flexible to -20°C'],
              ['Lifespan', '8-12 years', '15-20+ years'],
              ['Seam Method', 'RF welding', 'Hand gluing'],
              ['Repair', 'PVC glue (easy)', '2-part adhesive (moderate)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      현대 군용 등급 PVC (1100-1670 dtex)은 대부분의 레크리에이션 사용자에게 Hypalon 비용의 절반으로 뛰어난 내구성을
      제공합니다. Hypalon은 상업용 함대, 열대 기후, 중요한 임무에서 선호됩니다.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium">심층 PVC vs Hypalon 가이드 →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">고무보트를 선택하는 방법</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. 사용 용도를 정의하세요</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>레크리에이션: 딩기 또는 SUP</li>
          <li>성능: RIB (15-60 HP)</li>
          <li>상업용: RIB (100+ HP)</li>
          <li>피트니스: 고무 SUP</li>
          <li>여행: 고무 카약</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. 예산 설정</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800: 고무 SUP</li>
          <li>$500-$2,000: 딩기 + 모터</li>
          <li>$3,000-$8,000: 입문용 RIB</li>
          <li>$8,000-$20,000: 프리미엄 RIB</li>
          <li>$20,000 이상+: 상업용 RIB</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. 재질 고려</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC: 저렴하고 가벼움</li>
          <li>Hypalon: 프리미엄, 오래 지속됨</li>
          <li>Drop-Stitch: 단단한 성능</li>
          <li>원단 무게: 1100-1670 dtex</li>
          <li>코팅: UV + 천공 방지 층</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">안전 및 표준</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">CE 인증</h3>
        <p class="mt-2 text-sm text-gray-600">
          EU에서 판매되는 모든 고무보트는 2013/53/EU 레크리에이션 선박 지침(RCD)에 따라 CE 표시가 필요합니다. 인증은
          설계 등급(A-D), 부력, 안정성, 적재 용량을 포함합니다. Paddle Board Overstock 보트는 레크리에이션 및 구조용으로
          CE 인증을 받았습니다.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">표준</h3>
        <p class="mt-2 text-sm text-gray-600">
          재료, 솔기, 밸브 및 성능 시험에 대한 요구 사항을 지정하는 공기주입식 보트에 대한 국제 표준. 유형 I-IV는 작은
          딩기부터 큰 RIBs까지 모든 것을 포함합니다.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">필수 안전 장비</h3>
        <p class="mt-2 text-sm text-gray-600">
          구명조끼/PFD(CE 12402), 던지는 밧줄, 물 퍼내개/소화기, 항해등(야간), VHF 라디오, 구급상자, 닻, 예비 노 또는
          연료.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">안전 운전</h3>
        <p class="mt-2 text-sm text-gray-600">
          최대 적재량을 절대 초과하지 마십시오. 출발 전에 밸브 안전성을 확인하십시오. 무게를 고르게 분배하십시오. 기상
          상태를 모니터링하십시오. 플로트 계획을 작성하십시오. 보트 운전 안전 교육을 받으십시오.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">유지 관리</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <>
          <span class="text-sky-600 font-bold flex-shrink-0">1.</span>
          <span>바닷물 사용 후에는 항상 깨끗한 물로 헹구세요. 보관하기 전에 완전히 건조시키세요.</span>
        </>
      </div>
    </div>
  </section>
</section>
