---
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
import { getUiForLang } from '~/i18n/generated/ui-all';

const { lang = 'tl' } = Astro.props;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
---

<JsonLd
  type="Article"
  article={{
    headline: 'Gabay sa Inflatable Boat — Ang Kumpletong Sanggunian',
    description:
      'Isang komprehensibong gabay sa mga inflatable boat na sumasaklaw sa mga uri, paraan ng konstruksyon, paghahambing ng materyales, mga pamantayan sa pagpili, mga pamantayan sa kaligtasan, at pagpapanatili.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://paddleboardoverstock.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: 'industriya ng dagat', href: `/${lang}/marine-industry` },
    { name: 'Gabay sa Inflatable na Bangka', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="Patnubay"
  quickAnswer="Ang isang inflatable na bangka ay isang magaan na sasakyang pantubig na binuo gamit ang mga flexible na tubo ng tela (sponsons) na pinupuno ng pinahigpit na hangin upang magbigay ng buoyancy. Ang mga modernong inflatable na bangka ay kinabibilangan ng dinghies, RIBs (rigid inflatable boats), inflatable na kayak, at mga stand-up paddle board. Ito ay ginawa mula sa PVC o Hypalon CSM na tela gamit ang RF welding o mga tahi na pinagdikit ng kamay, na may drop-stitch na konstruksyon na nagpapahintulot sa mataas na presyon na matitibay na sahig."
  facts={[
    { label: 'Pandaigdigang Laki ng Pamilihan', value: '$2.8B (2026)' },
    { label: 'Pangunahing Materyales', value: 'PVC / Hypalon CSM' },
    { label: 'Saklaw ng Buhay', value: '8-20+ taon' },
    { label: 'CE Sertipikasyon', value: 'Kinakailangan (EU)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">Gabay sa Inflatable na Bangka</h1>
  <p class="mt-4 text-lg text-gray-500">
    Ang pinakamahalagang mapagkukunan tungkol sa inflatable watercraft — mula sa mga recreational dinghies hanggang sa
    mga propesyonal RIBs at espesyal na rescue vessels.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      ['Types', 'Construction', 'Materials', 'Selection', 'Safety', 'Maintenance', 'Standards'].map((section) => (
        <a
          href={`#${section.toLowerCase()}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {section}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Mga Uri ng Inflatable na Bangka</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: 'Mga Pambobote na Inflatable',
            desc: 'Maliit, madaling dalhin na mga bangka para sa tendering, pangingisda, at panandaliang gamit na panglibangan. Karaniwang 2-4m, pinatatakbo ng maliliit na outboard (2-15 HP) o sagwan. Pinakamurang panimulang punto.',
            icon: '🚤',
          },
          {
            title: 'Matigas na Napapalawig na Bangka (RIBs)',
            desc: 'Mataas na pagganap na mga bangka na may matibay na fiberglass, aluminyo, o HDPE na katawan at inflatable na sponson. Haba na 3-12m, 15-300+ HP na outboard. Ginagamit para sa pagpapatrolya, pagsagip, diving, at offshore na paglalayag.',
            icon: '⚡',
          },
          {
            title: 'Napalalaking Kayak',
            desc: 'Mga portable na kayak na gawa sa PVC o TPU na tela. Available sa single at tandem na mga configuration para sa recreational na paglilibot, paglalangoy sa ilog, at paglalakbay sa ekspedisyon.',
            icon: '🛶',
          },
          {
            title: 'Mga Inflatable na Stand-Up Paddle Board (SUPs)',
            desc: 'Drop-stitch gumawa ng mga paddle board na maaaring palapitin hanggang maging matibay na deck na may mataas na presyon. Available ang mga modelo para sa all-around, touring, yoga, pangingisda, at surfing.',
            icon: '🏄',
          },
          {
            title: 'Mga Bangka ng Pagsagip (SAR)',
            desc: 'Espesyalisado RIBs para sa mga operasyon ng paghahanap at pagsagip. Nagtatampok ng self-bailing floors, forward consoles, towing bits, at mga high-visibility na kulay scheme. CE-Sertipikado para sa paggamit ng rescue.',
            icon: '🆘',
          },
          {
            title: 'Komersyal na Mga Bangkang Pangtrabaho',
            desc: 'Matibay na RIBs para sa suporta sa pagsisid, pag-patrol, pagsusuri, at komersyal na operasyon sa dagat. Hypalon CSM konstruksyon, pinalakas na mga katawan ng barko, at propesyonal na antas ng pag-aayos.',
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Mga Pamamaraan ng Konstruksyon</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">RF Welding (Mataas na Frequency)</h3>
        <p class="mt-2 text-sm text-gray-600">
          Gumagamit ng electromagnetic energy upang pagsamahin PVC ang mga layer sa antas ng molekular. Lumilikha ng
          pinakamalalakas na airtight seams. Karaniwan sa mga de-kalidad na PVC bangka at SUPs. Nangangailangan ng
          espesyal na makina at bihasang operasyon.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Pagdikit ng Kamay / Kemikal na Pagdikit</h3>
        <p class="mt-2 text-sm text-gray-600">
          Dalawang-bahagi na pandikit ang nagbubuklod sa mga panel ng tela. Pangunahing paraan para sa Hypalon CSM mga
          bangka (hindi maaaring RF welded). Nangangailangan ng eksaktong paghahanda ng ibabaw, kontroladong halumigmig,
          at tamang oras ng pag-cure para sa pinakamainam na tibay ng tahi.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Drop-Stitch Pangunahing</h3>
        <p class="mt-2 text-sm text-gray-600">
          Libu-libong polyester threads ang nag-uugnay sa itaas at ibabang PVC mga layer, na nagpapahintulot ng mataas
          na pressure inflation (15-25) PSIpara sa matibay na performance ng board. Ang densidad ng sinulid (15-50
          threads/cm²) ang tumutukoy sa rigidity at bigat.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Pag-init ng Paghahabi</h3>
        <p class="mt-2 text-sm text-gray-600">
          Hot air o hot wedge welding na ginagamit para sa mga tahi at reinforcement. Karaniwan sa mas malalaking RIB
          konstruksyon. Hindi kasing tumpak ng RF welding ngunit epektibo para sa Hypalon mga matitibay na PVC tela.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Paghahambing ng mga Materyales</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">Katangian</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Relative Cost', '$ (budget)', '$$$ (premium)'],
              ['UV Resistance', 'Good (with coating)', 'Excellent (inherent)'],
              ['Abrasion Resistance', 'Moderate-Good', 'Excellent'],
              ['Chemical Resistance', 'Good', 'Excellent'],
              ['Cold Flexibility', 'Stiffens below 0°C', 'Flexible to -20°C'],
              ['Lifespan', '8-12 years', '15-20+ years'],
              ['Seam Method', 'RF welding', 'Hand gluing'],
              ['Repair', 'PVC glue (easy)', '2-part adhesive (moderate)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Modernong military-grade PVC (1100-1670 dtex) ay nag-aalok ng mahusay na tibay para sa karamihan ng mga
      pang-recreational na gumagamit sa kalahati ng halaga ng Hypalon. Ang Hypalon ay mas pinipili para sa mga
      commercial na fleet, tropikal na klima, at mga mission-critical na aplikasyon.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium"
      >Detalyadong PVC laban sa Hypalon Gabay →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Paano Pumili ng Inflatable na Bangka</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. Tukuyin ang Iyong Gamit</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>Pang-recreational: Dinghy o SUP</li>
          <li>Pagganap: RIB (15-60 HP)</li>
          <li>Komersyal: RIB (100+ HP)</li>
          <li>Pang-kalusugan: Inflatable SUP</li>
          <li>Paglalakbay: Inflatable kayak</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. Itakda ang Iyong Badyet</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800: Napuputing SUP</li>
          <li>$500-$2,000: Dinghy + motor</li>
          <li>$3,000-$8,000: Panimulang RIB</li>
          <li>$8,000-$20,000: Premium RIB</li>
          <li>$20,000+: Pangkomersyal RIB</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. Isaalang-alang ang Materyal</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC: Abot-kaya, magaan</li>
          <li>Hypalon: Premium, matagal ang buhay</li>
          <li>Drop-Stitch: Matigas na performance</li>
          <li>Bigat ng tela: 1100-1670 dtex</li>
          <li>Coating: UV + mga layer na panlaban sa tuldok</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Kaligtasan at Pamantayan</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">CE Sertipikasyon</h3>
        <p class="mt-2 text-sm text-gray-600">
          Lahat ng inflatable na bangka na binebenta sa EU ay nangangailangan ng CE markadong ayon sa Recreational Craft
          Directive (RCD) 2013/53/EU. Saklaw ng sertipikasyon ang kategorya ng disenyo (A-D), buoyancy, katatagan, at
          kapasidad ng karga. Ang Paddle Board Overstock na mga bangka ay CE-certified para sa pang-recreational at
          rescue na paggamit.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Pamantayan</h3>
        <p class="mt-2 text-sm text-gray-600">
          Pandaigdigang pamantayan para sa mga inflatable na bangka na nagtatakda ng mga kinakailangan para sa mga
          materyales, tahi, balbula, at pagsubok sa pagganap. Saklaw ng Mga Uri I-IV ang lahat mula sa maliliit na
          dinghy hanggang sa malalaking RIBs.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Mahahalagang Kagamitang Pangkaligtasan</h3>
        <p class="mt-2 text-sm text-gray-600">
          Mga life jacket/PFD (CE 12402), lubid panghagis, timba/pamasahe ng apoy, ilaw sa nabigasyon (gabi), radyo VHF,
          first aid kit, angkla, at ekstrang sagwan o gasolina.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Ligtas na Operasyon</h3>
        <p class="mt-2 text-sm text-gray-600">
          Huwag kailanman lumampas sa pinakamataas na kapasidad ng plato. Suriin ang seguridad ng balbula bago ilunsad.
          Pantayin ang pamamahagi ng timbang. Bantayan ang kondisyon ng panahon. Maghain ng plano para sa paglalayag.
          Mag-aral ng kurso sa kaligtasan sa pagbo-boat.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Pagpapanatili at Pangangalaga</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <>
          <span class="text-sky-600 font-bold flex-shrink-0">1.</span>
          <span
            >Banlawan gamit ang malinis na tubig pagkatapos gamitin sa maalat na tubig. Patuyuin nang lubusan bago
            itago.</span
          >
        </>
      </div>
    </div>
  </section>
</section>
