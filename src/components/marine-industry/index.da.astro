---
const { lang = 'da' } = Astro.props;
import JsonLd from '~/components/common/JsonLd.astro';
import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
const t = (_key: string) => '';
---

<JsonLd
  type="Article"
  article={{
    headline: 'Guide til gummibåde - Den komplette ressource',
    description:
      'En omfattende guide til gummibåde, der dækker bådtyper, konstruktionsmetoder, materialesammenligning, udvælgelseskriterier, sikkerhedsstandarder og vedligeholdelse.',
    datePublished: '2026-07-07',
  }}
  data={{ url: 'https://paddleboardoverstock.com/marine-industry/' }}
/>

<JsonLd
  type="BreadcrumbList"
  breadcrumbs={[
    { name: t('nav.home') || 'Home', href: `/${lang}/` },
    { name: 'Marine industri', href: `/${lang}/marine-industry` },
    { name: 'Guide til gummibåd', href: `/${lang}/marine-industry/` },
  ]}
/>

<AiQuickAnswer
  entityType="Leitfaden"
  quickAnswer="En gummibåd er et letvægtsfartøj, hvis fleksible stofrør (opdriftskamre) er fyldt med trykluft for at skabe opdrift. Moderne oppustelige både omfatter joller, RIB'er (rigid oppustelige både), oppustelige kajakker og stand-up paddle boards. De er lavet af PVC eller Hypalon-CSM stoffer ved hjælp af HF-svejsning eller håndlimede sømme; Drop-Stitch konstruktionen giver mulighed for højtryks, stive gulve."
  facts={[
    { label: 'Globalt markeds omfang', value: '$2.8B (2026)' },
    { label: 'Primære materialer', value: 'PVC / Hypalon CSM' },
    { label: 'liv', value: '8-20+ Jahre' },
    { label: 'CE certificering', value: 'Erforderlich (EU)' },
  ]}
/>

<section class="max-w-4xl mx-auto py-16 px-6">
  <h1 class="text-4xl font-semibold text-gray-900">Guide til gummibåd</h1>
  <p class="mt-4 text-lg text-gray-500">
    Den definitive ressource på oppustelige vandfartøjer - fra fritidsjoller til professionelle RIB'er til
    special-redningsbåde.
  </p>

  <nav class="mt-8 flex flex-wrap gap-2">
    {
      [
        { label: 'Typen', id: 'types' },
        { label: 'Konstruktion', id: 'construction' },
        { label: 'Materialien', id: 'materials' },
        { label: 'Auswahl', id: 'selection' },
        { label: 'Sicherheit', id: 'safety' },
        { label: 'Wartung', id: 'maintenance' },
        { label: 'Standards', id: 'standards' },
      ].map((s) => (
        <a
          href={`#${s.id}`}
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm font-medium text-gray-700 transition"
        >
          {s.label}
        </a>
      ))
    }
  </nav>

  <section id="types" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Typer af oppustelige både</h2>
    <div class="mt-8 grid gap-6">
      {
        [
          {
            title: 'Aufblasbare Dinghys',
            desc: 'Kleine, tragbare Boote für Zubringerdienste, Angeln und kurze Freizeitfahrten. Typischerweise 2-4 m lang, mit kleinen Außenbordern (2-15 PS) oder Riemen angetrieben. Der günstigste Einstieg.',
            icon: '🚤',
          },
          {
            title: 'Festrumpf-Schlauchboote (RIBs)',
            desc: 'Leistungsstarke Boote mit starrem Rumpf aus GFK, Aluminium oder HDPE und aufblasbaren Auftriebskammern. Längen von 3-12 m, Außenbordmotoren mit 15-300+ PS. Einsatz bei Patrouille, Rettung, Tauchen und Hochseefahrten.',
            icon: '⚡',
          },
          {
            title: 'Aufblasbare Kajaks',
            desc: 'Tragbare Kajaks aus PVC- oder TPU-Gewebe. Erhältlich in Einzel- und Tandemausführung für Freizeittouren, Flussfahrten und Expeditionen.',
            icon: '🛶',
          },
          {
            title: 'Aufblasbare Stand-Up-Paddle-Boards (SUPs)',
            desc: 'In Drop-Stitch-Konstruktion gefertigte Paddle-Boards, die sich zu starren Hochdruckdecks aufpumpen lassen. Erhältlich als Allround-, Touring-, Yoga-, Angel- und Surf-Modelle.',
            icon: '🏄',
          },
          {
            title: 'Rettungsboote (SAR)',
            desc: 'Spezialisierte RIBs für Such- und Rettungseinsätze. Mit selbstlenzendem Boden, Mittelkonsole, Schleppösen und Signalfarben. Für den Rettungseinsatz CE-zertifiziert.',
            icon: '🆘',
          },
          {
            title: 'Kommerzielle Arbeitsboote',
            desc: 'Robuste RIBs für Tauchunterstützung, Patrouille, Vermessung und kommerzielle maritime Einsätze. Hypalon-CSM-Konstruktion, verstärkte Rümpfe und professionelle Ausstattung.',
            icon: '⚙️',
          },
        ].map((item) => (
          <div class="flex gap-4 p-5 bg-gray-50 rounded-xl border border-gray-200">
            <span class="text-2xl flex-shrink-0">{item.icon}</span>
            <div>
              <h3 class="font-semibold text-gray-900">{item.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="construction" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Byggemetoder</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">HF svejsning (høj frekvens)</h3>
        <p class="mt-2 text-sm text-gray-600">
          Bruger elektromagnetisk energi til at fusionere PVC lag på molekylært niveau. Skaber de stærkeste lufttætte
          sømme. Fælles på PVC både og SUP'er af høj kvalitet. Kræver specielle maskiner og uddannede operatører.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Håndbinding/kemisk binding</h3>
        <p class="mt-2 text-sm text-gray-600">
          To-komponent klæbemiddel forbinder stofpanelerne. Hovedmetoden for Hypalon-CSM både (ikke-HF svejsbar). Kræver
          præcis overfladeforberedelse, kontrolleret fugtighed og tilstrækkelig hærdetid for optimal sømstyrke.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Drop-Stitch kerne</h3>
        <p class="mt-2 text-sm text-gray-600">
          Tusindvis af polyestertråde forbinder det øverste og nederste PVC lag, hvilket tillader oppustning til højt
          tryk (15-25 PSI) for stiv pladeadfærd. Trådtætheden (15-50 tråde/cm²) bestemmer stivhed og vægt.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Varm svejsning</h3>
        <p class="mt-2 text-sm text-gray-600">
          Varmluft eller varmkilesvejsning til sømme og forstærkninger. Almindelig ved produktion af større RIB'er.
          Mindre præcis end HF-svejsning, men effektiv til Hypalon og tunge PVC stoffer.
        </p>
      </div>
    </div>
  </section>

  <section id="materials" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Materiale sammenligning</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="px-4 py-3 text-left font-semibold text-gray-700">Karakteristisk</th>
            <th class="px-4 py-3 text-center font-semibold text-sky-700">PVC</th>
            <th class="px-4 py-3 text-center font-semibold text-emerald-700">Hypalon CSM</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Relative Kosten', '$ (Budget)', '$$$ (Premium)'],
              ['UV-Beständigkeit', 'Gut (mit Beschichtung)', 'Hervorragend (materialeigen)'],
              ['Abriebfestigkeit', 'Mittel-Gut', 'Hervorragend'],
              ['Chemikalienbeständigkeit', 'Gut', 'Hervorragend'],
              ['Kälteflexibilität', 'Versteift unter 0°C', 'Flexibel bis -20°C'],
              ['Lebensdauer', '8-12 Jahre', '15-20+ Jahre'],
              ['Nahtmethode', 'HF-Schweißen', 'Handverklebung'],
              ['Reparatur', 'PVC-Kleber (einfach)', '2K-Kleber (mittel)'],
            ].map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                {row.map((cell, j) => (
                  <td
                    class={`px-4 py-3 border-b border-gray-200 ${j === 0 ? 'font-medium text-gray-700' : 'text-center text-gray-600'}`}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Moderne militærkvalitet PVC (1100-1670 dtex) tilbyder fremragende holdbarhed til de fleste rekreative brugere til
      halvdelen af prisen for Hypalon. Hypalon foretrækkes til kommercielle flåder, tropiske klimaer og
      sikkerhedskritiske applikationer.
    </p>
    <a
      href={`/${lang}/learn/pvc-vs-hypalon`}
      class="mt-4 inline-block text-sky-600 hover:text-sky-700 text-sm font-medium"
      >Detaljeret vejledning: PVC vs. Hypalon →</a
    >
  </section>

  <section id="selection" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Sådan vælger du en gummibåd</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">1. Definer din tilsigtede brug</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>Fritid: Jolle eller SUP</li>
          <li>Strøm: RIB (15-60 HP)</li>
          <li>Reklame: RIB (100+ PS)</li>
          <li>Fitness: oppustelig SUP</li>
          <li>Rejser: oppustelig kajak</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">2. Indstil dit budget</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>$200-$800: Oppustelig SUP</li>
          <li>$500-$2,000: Jolle + motor</li>
          <li>$3,000-$8,000: Indgangsniveau RIB</li>
          <li>$8,000-$20,000: Premium RIB</li>
          <li>$20,000+: Kommerciel RIB</li>
        </ul>
      </div>
      <div class="p-6 bg-sky-50 rounded-xl border border-sky-200">
        <h3 class="font-semibold text-gray-900">3. Overvej materiale</h3>
        <ul class="mt-3 space-y-2 text-sm text-gray-600">
          <li>PVC: Billig, let</li>
          <li>Hypalon: Premium, langtidsholdbar</li>
          <li>Drop-Stitch: Stiv kraft</li>
          <li>Stoftykkelse: 1100-1670 dtex</li>
          <li>Belægning: UV og punkteringsbeskyttelseslag</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="safety" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Sikkerhed og standarder</h2>
    <div class="mt-8 grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">CE certificering</h3>
        <p class="mt-2 text-sm text-gray-600">
          Alle gummibåde, der sælges i EU, kræver CE-mærkningen i overensstemmelse med direktivet om fritidsfartøjer
          (RCD) 2013/53/EU. Certificeringen dækker designkategori (A-D), opdrift, stabilitet og lasteevne. Paddle Board
          Overstock både er CE certificeret til fritids- og redningsbrug.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">standard</h3>
        <p class="mt-2 text-sm text-gray-600">
          Den internationale standard for gummibåde specificerer krav til materialer, sømme, ventiler og ydelsestest.
          Type I-IV dækker alt fra små joller til store RIB'er.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Væsentligt sikkerhedsudstyr</h3>
        <p class="mt-2 text-sm text-gray-600">
          Redningsveste/redningsveste (CE 12402), kasteliner, lænsepumpe/brandslukker, navigationslys (nat), VHF-radio,
          førstehjælpskasse, anker og reservepagaj eller brændstof.
        </p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200">
        <h3 class="font-semibold text-gray-900">Sikker drift</h3>
        <p class="mt-2 text-sm text-gray-600">
          Overskrid ALDRIG den maksimale belastning på typeskiltet. Kontroller ventilerne før søsætning. Fordel vægten
          jævnt. Overhold vejrforholdene. Gem en rejseplan. Tag et bådsikkerhedskursus.
        </p>
      </div>
    </div>
  </section>

  <section id="maintenance" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Vedligeholdelse &amp; Pleje</h2>
    <div class="mt-8 space-y-4 text-sm text-gray-600">
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">1.</span><span
          >Skyl med ferskvand efter hver brug i saltvand. Tør helt inden opbevaring.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">2.</span><span
          >Opbevares delvist oppustet på et køligt, tørt sted, væk fra direkte sollys og ekstreme temperaturer.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">3.</span><span
          >Kontroller ventiler og sømme før hver sæson. Behandl ventilhusene årligt med silikonespray.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">4.</span><span
          >Rengør med mild sæbe og vand. Brug aldrig opløsningsmidler, blegemidler eller højtryksrensere på stoffet.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">5.</span><span
          >Reparer omgående skader med reparationssæt anbefalet af producenten. Til Hypalon skal du kun bruge
          to-komponent klæbemiddel.</span
        >
      </div>
      <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
        <span class="text-sky-600 font-bold flex-shrink-0">6.</span><span
          >Udskift ventiler hvert 3-5 år. Forny stoffet ved slutningen af dets levetid (synligt slid, porøsitet,
          sømadskillelse).</span
        >
      </div>
    </div>
  </section>

  <section id="standards" class="mt-16">
    <h2 class="text-2xl font-semibold text-gray-900">Industri applikationer</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-4">
      {
        [
          {
            title: 'Freizeitbootfahren',
            desc: 'Familienausflüge, Wassersport, Angeln, Camping und Freizeitfahrten auf Seen, Flüssen und Küstengewässern.',
          },
          {
            title: 'Suche & Rettung',
            desc: 'Küstenwache, Rettungsschwimmer und Notfallteams setzen spezialisierte RIBs für schnellen Einsatz und Rettung in rauer See ein.',
          },
          {
            title: 'Kommerzielle Schifffahrt',
            desc: 'Tauchunterstützung, Patrouille, Vermessung, Touristentransport und Offshore-Logistik, bei denen Haltbarkeit und Zuverlässigkeit entscheidend sind.',
          },
          {
            title: 'Militär & Verteidigung',
            desc: 'Taktische RIBs für Marineoperationen, Truppentransport, Entereinsätze und verdeckte Landungen.',
          },
          {
            title: 'Humanitäre Hilfe',
            desc: 'Katastrophenschutzorganisationen setzen aufblasbare Boote für Hochwasserrettung, Versorgungstransporte und medizinische Evakuierungen ein.',
          },
          {
            title: 'OEM-Fertigung',
            desc: 'Individuelle Private-Label-Produktion für Marken, Händler und spezialisierte Betreiber mit besonderen Anforderungen.',
          },
        ].map((app) => (
          <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
            <h3 class="font-semibold text-sm text-gray-900">{app.title}</h3>
            <p class="mt-1 text-xs text-gray-500">{app.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 bg-gradient-to-br from-sky-50 to-blue-50 rounded-2xl p-8 border border-sky-200">
    <h2 class="text-xl font-semibold text-gray-900">Oplev gummibådene fra Paddle Board Overstock</h2>
    <p class="mt-4 text-sm text-gray-600">
      Paddle Board Overstock designer og producerer CE certificerede gummibåde, SUP'er, kajakker og RIB'er til det
      rekreative, professionelle og OEM markeder. Alle både er fremstillet med PVC eller Hypalon-CSM stoffer af militær
      kvalitet — ved hjælp af moderne HF-svejsning eller håndlimning.
    </p>
    <div class="mt-6 flex gap-4 flex-wrap">
      <a
        href={`/${lang}/products`}
        class="px-6 py-3 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
        >Se produkter</a
      >
      <a
        href={`/${lang}/academy`}
        class="px-6 py-3 border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-gray-400 transition"
        >Læringscenter</a
      >
    </div>
  </section>
</section>

<section class="sr-only" data-ai-block="definition" aria-hidden="true">
  <p>
    Omfattende guide til oppustelige både med bådtyper (joller, RIB'er, kajakker, SUP'er, redningsbåde, kommercielle
    arbejdsbåde), konstruktionsmetoder (HF-svejsning, håndlimning, Drop-Stitch kerne, varmesvejsning), materialer (PVC
    stof, Hypalon CSM), udvælgelseskriterier (tilsigtet brug, CSM), essentiel brug, budget, ____materialegodkendelse,
    sikkerhedsudstyr, ______), (rengøring, opbevaring, reparationer, ventilpleje) og industriapplikationer (rekreativt,
    SAR, kommercielt, militært, humanitært, OEM).
  </p>
</section>
