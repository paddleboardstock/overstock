---
export interface Props {
  dir: string;
  label: string;
}
const { dir } = Astro.props as Props;
---

<div id="csv-toolbar" data-dir={dir} class="flex items-center gap-2">
  <button
    id="export-csv-btn"
    type="button"
    class="px-3 py-1.5 text-xs font-medium rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800"
  >
    Export CSV
  </button>
  <label
    class="px-3 py-1.5 text-xs font-medium rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 cursor-pointer"
  >
    Import CSV
    <input id="import-csv-input" type="file" accept=".csv" class="hidden" />
  </label>
  <span id="csv-status" class="text-xs text-gray-500 hidden"></span>
</div>

<script is:inline>
  (function () {
    const toolbar = document.getElementById('csv-toolbar');
    if (!toolbar) return;
    const dir = toolbar.dataset.dir || '';
    const exportBtn = document.getElementById('export-csv-btn');
    const importInput = document.getElementById('import-csv-input');
    const status = document.getElementById('csv-status');

    function showStatus(msg, isError) {
      if (!status) return;
      status.textContent = msg;
      status.className = 'text-xs ' + (isError ? 'text-red-600' : 'text-gray-500');
      status.classList.remove('hidden');
    }

    function escapeCsv(val) {
      if (val == null) return '';
      const s = String(val);
      if (s.includes(',') || s.includes('"') || s.includes('\n')) {
        return '"' + s.replace(/"/g, '""') + '"';
      }
      return s;
    }

    function parseFrontmatterCSV(text) {
      const m = text.match(/^---\s*\n([\s\S]*?)\n---\s*\n/);
      if (!m) return { frontmatter: {}, body: text };
      const body = text.slice(m[0].length);
      const fm = {};
      m[1].split('\n').forEach(function (line) {
        const idx = line.indexOf(':');
        if (idx > 0) {
          const k = line.slice(0, idx).trim();
          let v = line.slice(idx + 1).trim();
          v = v.replace(/^["']|["']$/g, '');
          if (v === 'true') v = true;
          else if (v === 'false') v = false;
          fm[k] = v;
        }
      });
      return { frontmatter: fm, body: body };
    }

    function slugify(text) {
      return (
        text
          .toString()
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-+|-+$/g, '')
          .slice(0, 80) || 'untitled'
      );
    }

    exportBtn.addEventListener('click', async function () {
      showStatus('Exporting...');
      try {
        const res = await fetch('/api/admin/list?dir=' + encodeURIComponent(dir), { credentials: 'include' });
        if (!res.ok) throw new Error('List failed: ' + res.status);
        const files = await res.json();
        if (!Array.isArray(files)) throw new Error('Unexpected response');

        const mdFiles = files.filter(function (f) {
          return f.type === 'file' && /\.(md|mdx)$/i.test(f.name);
        });
        const rows = [['title', 'publishDate', 'category', 'draft', 'tags', 'filename', 'content']];

        for (let i = 0; i < mdFiles.length; i++) {
          const f = mdFiles[i];
          try {
            const r = await fetch('/api/admin/read?path=' + encodeURIComponent(f.path), { credentials: 'include' });
            if (!r.ok) continue;
            const data = await r.json();
            if (!data || !data.decoded) continue;
            const decoded = data.decoded;
            const parsed = parseFrontmatterCSV(decoded);
            const fm = parsed.frontmatter;
            const tags = Array.isArray(fm.tags) ? fm.tags.join(';') : fm.tags || '';
            const draft = fm.draft === true || fm.draft === 'true' ? 'true' : 'false';
            rows.push([
              escapeCsv(fm.title || ''),
              escapeCsv(fm.publishDate || ''),
              escapeCsv(fm.category || ''),
              draft,
              escapeCsv(tags),
              escapeCsv(f.name),
              escapeCsv(parsed.body || ''),
            ]);
          } catch {
            /* skip file */
          }
        }

        const csv = rows
          .map(function (r) {
            return r.join(',');
          })
          .join('\n');
        const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = dir.replace(/[/\\]/g, '-') + 'export.csv';
        a.click();
        URL.revokeObjectURL(url);
        showStatus('Exported ' + (rows.length - 1) + ' items');
      } catch (e) {
        showStatus('Export error: ' + e.message, true);
      }
    });

    importInput.addEventListener('change', function () {
      const file = importInput.files && importInput.files[0];
      if (!file) return;
      showStatus('Importing...');
      const reader = new FileReader();
      reader.onload = async function (e) {
        const text = e.target.result;
        const lines = text
          .split('\n')
          .map(function (l) {
            return l.trim();
          })
          .filter(function (l) {
            return l;
          });
        if (lines.length < 2) {
          showStatus('CSV file is empty', true);
          return;
        }

        const headers = parseCSVLine(lines[0]);
        let total = 0;
        let errors = 0;

        for (let i = 1; i < lines.length; i++) {
          const values = parseCSVLine(lines[i]);
          if (values.length < 2) continue;
          const row = {};
          for (let j = 0; j < headers.length; j++) {
            row[headers[j]] = values[j] || '';
          }

          const title = row.title || 'Untitled';
          const slug = slugify(title);
          const filename = slug + '.md';
          const path = dir.replace(/\/+$/, '') + '/' + filename;

          try {
            const tags = (row.tags || '')
              .split(/[;,]/)
              .map(function (t) {
                return t.trim();
              })
              .filter(Boolean);
            const draft = row.draft === 'true' || row.draft === '1' || String(row.draft).toLowerCase() === 'true';

            const fm = {
              title: title,
              publishDate: row.publishDate || new Date().toISOString().split('T')[0],
              category: row.category || '',
              draft: String(draft),
            };
            if (tags.length > 0)
              fm.tags =
                '[' +
                tags
                  .map(function (t) {
                    return '"' + t + '"';
                  })
                  .join(', ') +
                ']';
            if (row.excerpt) fm.excerpt = row.excerpt;

            let frontmatterStr = '---\n';
            Object.keys(fm).forEach(function (k) {
              frontmatterStr += k + ': ' + String(fm[k]) + '\n';
            });
            frontmatterStr += '---\n';

            const content = row.content || '';
            const fullContent = frontmatterStr + '\n' + content;

            const createRes = await fetch('/api/admin/create', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                path: path,
                content: fullContent,
                message: 'Import: ' + title,
                branch: 'draft',
              }),
            });
            if (!createRes.ok) {
              errors++;
            } else {
              total++;
            }
          } catch {
            errors++;
          }
        }

        showStatus('Imported ' + total + ' items' + (errors ? ', ' + errors + ' errors' : ''));
        importInput.value = '';
        setTimeout(function () {
          window.location.reload();
        }, 1500);
      };
      reader.readAsText(file);
    });

    function parseCSVLine(line) {
      const result = [];
      let current = '';
      let inQuotes = false;
      for (let i = 0; i < line.length; i++) {
        const c = line[i];
        if (inQuotes) {
          if (c === '"') {
            if (i + 1 < line.length && line[i + 1] === '"') {
              current += '"';
              i++;
            } else {
              inQuotes = false;
            }
          } else {
            current += c;
          }
        } else {
          if (c === ',') {
            result.push(current);
            current = '';
          } else if (c === '"') {
            inQuotes = true;
          } else {
            current += c;
          }
        }
      }
      result.push(current);
      return result;
    }
  })();
</script>
