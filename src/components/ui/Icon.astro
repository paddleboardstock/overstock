---
// Build-time icon component. It inlines pre-rendered SVG markup from
// ./icon-svgs (generated by scripts/gen-icon-svgs.cjs) instead of using
// astro-icon's runtime <Icon />, which recurses / crashes the static
// prerender on icon names whose parent chain is missing or circular.
import { ICON_SVGS } from './icon-svgs';

interface Props {
  name?: string;
  class?: string;
}

const { name, class: className } = Astro.props as Props;

const svg = typeof name === 'string' ? ICON_SVGS[name] : undefined;
const out = svg && className ? svg.replace('<svg', `<svg class="${className}"`) : svg;
---

{out ? <Fragment set:html={out} /> : <span class={className} aria-hidden="true" />}
