---
import Icon from '~/components/ui/Icon.astro';
import ProductGradeBadge from '~/components/widgets/ProductGradeBadge.astro';
import { getUiForLang } from '~/i18n/generated/ui-all';

export interface Props {
  items: string[];
  grade?: 'A' | 'B';
  lang?: string;
}

const { items, grade, lang = 'en' } = Astro.props;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
---

{
  items.length > 0 && (
    <div class="rounded-2xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/50 p-5">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <Icon name="tabler:package" class="w-5 h-5 text-primary" />
        <span class="text-sm font-bold text-gray-900 dark:text-slate-100">{t('product.inTheBox')}</span>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400 text-[11px] font-semibold rounded-full">
          <Icon name="tabler:check" class="w-3 h-3" />
          {t('product.fullSet') || 'Complete package'}
        </span>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2">
        {items.map((item) => (
          <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-slate-300">
            <span class="mt-0.5 w-4 h-4 rounded-full bg-green-500/15 text-green-600 dark:text-green-400 flex items-center justify-center shrink-0">
              <Icon name="tabler:check" class="w-3 h-3" />
            </span>
            <span class="capitalize">{item}</span>
          </li>
        ))}
      </ul>

      {grade && (
        <details class="group mt-4 pt-4 border-t border-gray-200 dark:border-slate-700">
          <summary class="flex items-center gap-2 text-xs font-semibold text-gray-500 dark:text-slate-400 cursor-pointer hover:text-gray-700 dark:hover:text-slate-200 transition-colors list-none">
            <Icon name="tabler:award" class="w-4 h-4" />
            {t('product.stockGrading') || 'Stock grading'}
            <span class="text-[10px] group-open:rotate-180 transition-transform">&#9660;</span>
          </summary>
          <div class="mt-3 space-y-2">
            <div class="flex items-start gap-2.5">
              <ProductGradeBadge grade="A" lang={lang} size="sm" />
              <p class="text-xs text-gray-600 dark:text-slate-400 leading-relaxed pt-0.5">{t('product.gradeADesc')}</p>
            </div>
            <div class="flex items-start gap-2.5">
              <ProductGradeBadge grade="B" lang={lang} size="sm" />
              <p class="text-xs text-gray-600 dark:text-slate-400 leading-relaxed pt-0.5">{t('product.gradeBDesc')}</p>
            </div>
          </div>
        </details>
      )}
    </div>
  )
}
