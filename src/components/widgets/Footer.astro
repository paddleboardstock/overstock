---
import Icon from '~/components/ui/Icon.astro';
import cfg from '~/config.yaml';
const branding = (cfg as any)?.branding || {};
import { getSeoSettings } from '~/utils/seo-settings';
import { getLangFromUrl } from '~/i18n/utils';
import { localizeHref, entityForHref } from '~/i18n/routing';
import { getUiForLang } from '~/i18n/generated/ui-all';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote, theme = 'light' } = Astro.props;

const seo = await getSeoSettings();

const ksSocialLinks: Array<Link> = (seo.socialLinks || [])
  .filter((s) => s?.url && s.url !== '#')
  .map((s) => ({
    ariaLabel: s.ariaLabel || s.platform,
    href: s.url || '#',
    icon: s.icon || '',
  }));

const mergedSocialLinks = (
  ksSocialLinks.length > 0
    ? [
        ...ksSocialLinks,
        ...socialLinks.filter(
          (s) => !ksSocialLinks.find((k) => k.ariaLabel?.toLowerCase() === s.ariaLabel?.toLowerCase())
        ),
      ]
    : socialLinks
).filter((s) => s?.href && s.href !== '#');

const currentLocale = getLangFromUrl(Astro.url);

const navTextMap: Record<string, string> = {
  Products: 'nav.products',

  'Materials Science': 'nav.materialsScience',
  Solutions: 'nav.solutions',

  'By Use Case': 'nav.byUseCase',

  Learn: 'nav.learn',
  Company: 'nav.company',
  Support: 'nav.support',
  'All Products': 'nav.allProducts',
  Accessories: 'nav.accessories',
  Compare: 'nav.compare',

  Guides: 'nav.guides',

  Safety: 'nav.safety',

  News: 'nav.news',
  About: 'nav.about',

  Contact: 'nav.contact',
  Login: 'nav.login',

  'Get a quote': 'cta.quote',
  Terms: 'nav.terms',
  'Privacy Policy': 'nav.privacy',
  'Medical Disclaimer': 'nav.disclaimer',
  FAQ: 'nav.faq',

  'Quality & Testing': 'nav.quality',

  'SUP Boards': 'nav.supBoards',
  'Knowledge Graph': 'nav.knowledgeGraph',

  'Water Safety': 'nav.waterSafety',
  Academy: 'nav.academy',

  Warranty: 'nav.warranty',
  'Media Center': 'nav.media',

  'Paddle Board Overstock Story': 'nav.paddleboardoverstockStory',

  'Why Paddle Board Overstock': 'nav.brandWhyPaddle Board Overstock',
  'Our Team': 'nav.brandTeam',

  'Case Studies': 'nav.cases',
  Resources: 'nav.resources',

  'For Clubs': 'nav.solutionsForClubs',

  'For Resorts': 'nav.solutionsForResorts',

  'Rental Business': 'nav.solutionsRentalBusiness',
  'Success Stories': 'nav.solutionsSuccessStories',
  Testimonials: 'nav.solutionsTestimonials',

  Manufacturing: 'nav.manufacturing',
  'Quality Control System': 'nav.qualityControlSystem',

  Wholesale: 'nav.wholesale',
  'Wholesale SUP Boards': 'nav.wholesaleSupBoards',
  'Mixed Model Wholesale': 'nav.mixedModelWholesale',
  'For Rental Businesses': 'nav.forRentalBusinesses',

  Markets: 'nav.markets',
  'Latin America': 'nav.marketLatinAmerica',
  'Southeast Asia': 'nav.marketSoutheastAsia',
  Africa: 'nav.marketAfrica',
  'Middle East': 'nav.marketMiddleEast',
  Mexico: 'nav.marketMexico',
  Brazil: 'nav.marketBrazil',
  Philippines: 'nav.marketPhilippines',
  Indonesia: 'nav.marketIndonesia',
  'South Africa': 'nav.marketSouthAfrica',
  Kenya: 'nav.marketKenya',
  'United Arab Emirates': 'nav.marketUae',
  Thailand: 'nav.marketThailand',

  'Shipping & Support': 'nav.shippingSupport',
  'International Shipping': 'nav.internationalShipping',

  'About Us': 'nav.aboutUs',
  'About Paddle Board Overstock': 'nav.aboutPaddleboardoverstock',

  'Shop Overstock Deals': 'nav.shopOverstockDeals',
  'Clearance Shop': 'nav.clearanceShop',
  'Inflatable vs Hard Board': 'nav.inflatableVsHard',
};

function t(text: string | undefined, locale: string): string {
  const key = text ? navTextMap[text] : undefined;
  if (key) {
    const uiData = getUiForLang(locale || 'en');
    const translated = uiData?.[key];
    if (translated) return translated;
  }
  return text ?? '';
}

const siteName = branding?.site_name?.trim() || 'Paddle Board Overstock';
const year = new Date().getFullYear();
const rawCopyright = footNote ?? branding?.copyright ?? `© ${year} ${siteName} · All rights reserved.`;
const copyrightHtml = String(rawCopyright)
  .replace(/\{year\}/gi, String(year))
  .replace(/\{site_name\}/gi, siteName);
---

<footer
  class:list={[
    { dark: theme === 'dark' },
    'relative border-t border-gray-200 dark:border-slate-800 not-prose bg-sky-600 text-white',
  ]}
>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 text-white/90 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      {
        links.map(({ title, links }) => (
          <div>
            <div class="text-white/90 font-medium mb-2">{t(title, currentLocale)}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li class="mb-2">
                    <a
                      class="text-white/70 hover:text-white hover:underline transition duration-150 ease-in-out"
                      href={localizeHref(href, currentLocale)}
                      aria-label={ariaLabel}
                      data-entity={entityForHref(href)}
                    >
                      <Fragment set:html={t(text, currentLocale)} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div
      class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 py-4 border-t border-white/20 text-sm text-white/70"
    >
      {
        secondaryLinks.map(({ text, href }) => (
          <a
            class="text-white/70 hover:text-white hover:underline transition duration-150 ease-in-out"
            href={localizeHref(href, currentLocale)}
            set:html={t(text, currentLocale)}
          />
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8">
      {
        mergedSocialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {mergedSocialLinks.map(({ ariaLabel, href, text: _text, icon }) => (
              <li>
                <a
                  class="text-white/70 hover:text-white hover:bg-white/10 focus:outline-none focus:ring-4 focus:ring-white/30 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }

      <div class="text-sm mr-4 text-white/70">
        <Fragment set:html={copyrightHtml} />
        <div class="mt-1 text-xs text-white/50">
          {
            getUiForLang(currentLocale || 'en')?.['footer.credit'] ||
              'Designed & Managed by Weihai Dongjilian Co., Ltd. · Made in China'
          }
        </div>
      </div>
    </div>
  </div>
</footer>
