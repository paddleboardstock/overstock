---
import Icon from '~/components/ui/Icon.astro';
import cfg from '~/config.yaml';
const branding = (cfg as any)?.branding || {};
import { getSeoSettings } from '~/utils/seo-settings';
import { getLangFromUrl } from '~/i18n/utils';
import { localizeHref, entityForHref } from '~/i18n/routing';
import { getUiForLang } from '~/i18n/generated/ui-all';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote, theme = 'light' } = Astro.props;

const seo = await getSeoSettings();

const ksSocialLinks: Array<Link> = (seo.socialLinks || [])
  .filter((s) => s?.url && s.url !== '#')
  .map((s) => ({
    ariaLabel: s.ariaLabel || s.platform,
    href: s.url || '#',
    icon: s.icon || '',
  }));

const mergedSocialLinks = (
  ksSocialLinks.length > 0
    ? [
        ...ksSocialLinks,
        ...socialLinks.filter(
          (s) => !ksSocialLinks.find((k) => k.ariaLabel?.toLowerCase() === s.ariaLabel?.toLowerCase())
        ),
      ]
    : socialLinks
).filter((s) => s?.href && s.href !== '#');

const currentLocale = getLangFromUrl(Astro.url);

const navTextMap: Record<string, string> = {
  Products: 'nav.products',
  'Technology & Innovation': 'nav.technologyInnovation',
  'Technology Overview': 'nav.technologyOverview',
  'Engineering Excellence': 'nav.engineeringExcellence',
  'Materials Science': 'nav.materialsScience',
  Solutions: 'nav.solutions',
  'By Industry': 'nav.byIndustry',
  'By Use Case': 'nav.byUseCase',
  'OEM/ODM Manufacturing': 'nav.oemOdm',
  'Custom Lab': 'nav.custom',
  Lifestyle: 'nav.lifestyle',
  Gallery: 'nav.gallery',
  'Solutions by Industry': 'nav.solutionsIndustry',
  'Solutions by Use Case': 'nav.solutionsUseCase',
  Learn: 'nav.learn',
  Company: 'nav.company',
  Support: 'nav.support',
  'All Products': 'nav.allProducts',
  'RIB Boats': 'nav.ribBoats',
  'Inflatable Boats': 'nav.inflatableBoats',
  Accessories: 'nav.accessories',
  Compare: 'nav.compare',
  'SUP vs Kayak': 'nav.supVsKayak',
  'Inflatable vs Hardboard': 'nav.inflatableVsHardboard',
  Guides: 'nav.guides',
  'SUP Basics': 'nav.supBasics',
  'Inflatable Technology': 'nav.inflatableTech',
  'Water Sports Safety': 'nav.safetyWaterSports',
  Journal: 'nav.journal',
  Technology: 'nav.technology',
  Safety: 'nav.safety',
  'Size Guide': 'nav.sizeGuide',
  News: 'nav.news',
  About: 'nav.about',
  Brand: 'nav.brand',
  Community: 'nav.community',
  'SUP Knowledge': 'nav.supKnowledge',
  'Boat Knowledge': 'nav.boatKnowledge',
  'R&D Center': 'nav.randd',
  Contact: 'nav.contact',
  Login: 'nav.login',
  'Sign In': 'nav.signIn',
  'Get a quote': 'cta.quote',
  Terms: 'nav.terms',
  'Privacy Policy': 'nav.privacy',
  'Medical Disclaimer': 'nav.disclaimer',
  FAQ: 'nav.faq',
  Bundles: 'nav.bundles',
  'Product Catalog': 'nav.catalog',
  'Quality & Testing': 'nav.quality',
  'Factory Tour': 'nav.factoryTour',
  'Buyers Guide': 'nav.buyersGuide',
  'Search & Rescue': 'nav.searchRescue',
  'Engineering Perfection': 'nav.engineeringPerfection',
  'Disaster Relief': 'nav.disasterRelief',
  'Commercial Workboats': 'nav.commercialWorkboats',
  'SUP Boards': 'nav.supBoards',
  'Knowledge Graph': 'nav.knowledgeGraph',
  'Learn Hub': 'nav.learnHub',
  'Water Safety': 'nav.waterSafety',
  Academy: 'nav.academy',
  'Knowledge Base': 'nav.knowledge',
  Trust: 'nav.trust',
  Factory: 'nav.factory',
  'Production Capacity': 'nav.factoryCapacity',
  'Quality Lab': 'nav.factoryQualityLab',
  'OEM/ODM Capability': 'nav.factoryOemCapability',
  Quality: 'nav.qualityFooter',
  Warranty: 'nav.warranty',
  'Media Center': 'nav.media',
  'Design & Innovation': 'nav.designPowerhouse',
  'Paddle Board Overstock Story': 'nav.paddleboardoverstockStory',
  'Buyer Center': 'nav.buyerCenter',
  'Marine Expertise': 'nav.brandMarineExpertise',
  'Global Presence': 'nav.brandGlobalPresence',
  'Why Paddle Board Overstock': 'nav.brandWhyPaddle Board Overstock',
  'Our Team': 'nav.brandTeam',
  Certifications: 'nav.certifications',
  Partners: 'nav.partners',
  'Case Studies': 'nav.cases',
