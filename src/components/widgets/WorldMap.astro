---
import Icon from '~/components/ui/Icon.astro';
import { marketPresence, marketPresenceByLang, worldMapUi } from '~/data/world-map-data';
import type { RegionData } from '~/data/world-map-data';

const { lang = 'en' } = Astro.props;
const data = marketPresenceByLang[lang] || null;
const ui = worldMapUi[lang] || null;
const uiEn = {
  title: 'Global Customer Map',
  countriesServed: 'Countries Served',
  subtitle:
    'From resorts in the Maldives to SUP clubs in California — Aquafarer equipment powers water adventures in {total}+ countries across {n} continents.',
  keyMarketsTitle: 'Key Markets by Region',
};
const U = ui || uiEn;
const regions = data?.regions || marketPresence.regions;
const keyMarkets = data?.keyMarkets || marketPresence.keyMarkets;
const totalCountries = marketPresence.totalCountries;
const subtitle = U.subtitle.replace('{total}', String(totalCountries)).replace('{n}', String(regions.length));
---

<section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 py-16 md:py-20">
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none"
    style="background-image: radial-gradient(circle at 25% 50%, white 1px, transparent 1px), radial-gradient(circle at 75% 50%, white 1px, transparent 1px); background-size: 60px 60px;"
  >
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <div
        class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-sky-500/10 border border-sky-500/20 mb-4"
      >
        <Icon name="tabler:world" class="w-8 h-8 text-sky-400" />
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-3">{U.title}</h2>
      <div class="flex items-center justify-center gap-x-3 text-sky-400 font-semibold text-lg">
        <span class="text-4xl font-bold text-white">{totalCountries}+</span>
        <span>{U.countriesServed}</span>
      </div>
      <p class="mt-3 text-slate-400 max-w-2xl mx-auto">{subtitle}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        regions.map((region: RegionData) => (
          <div class="group relative bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] hover:border-sky-500/30 rounded-xl p-5 transition-all duration-200">
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-base font-semibold text-white">{region.name}</h3>
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-sky-500/10 text-sky-400 text-sm font-bold">
                {region.count}
              </span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed mb-3">{region.description}</p>
            <div class="flex flex-wrap gap-1.5">
              {region.countries.map((country: string) => (
                <span class="inline-block text-[11px] text-slate-500 bg-white/[0.04] px-2 py-0.5 rounded">
                  {country}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 bg-white/[0.03] border border-white/[0.06] rounded-xl p-6 md:p-8">
      <div class="flex items-center gap-3 mb-5">
        <Icon name="tabler:map-pin" class="w-5 h-5 text-sky-400" />
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">{U.keyMarketsTitle}</h3>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          keyMarkets.map((market: { region: string; countries: string[] }) => (
            <div>
              <p class="text-xs font-semibold text-sky-400 mb-2 uppercase tracking-wider">{market.region}</p>
              <ul class="space-y-1">
                {market.countries.map((c: string) => (
                  <li class="text-xs text-slate-400 flex items-start gap-2">
                    <span class="w-1 h-1 rounded-full bg-sky-500/50 mt-1.5 flex-shrink-0" />
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
