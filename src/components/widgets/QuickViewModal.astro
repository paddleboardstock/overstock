---
export interface Props {
  productId: string;
  lang?: string;
}

import { getUiForLang } from '~/i18n/generated/ui-all';

const { productId, lang = 'en' } = Astro.props;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
---

<div
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40"
  id={`quick-view-${productId}`}
  role="dialog"
  aria-modal="true"
  data-quick-view
>
  <div
    class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto"
    onclick="arguments[0].stopPropagation()"
  >
    <div class="flex items-center justify-between p-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900" data-quick-view-title></h3>
      <button
        onclick="document.getElementById('quick-view-{productId}').classList.add('hidden')"
        class="p-1 hover:bg-gray-100 rounded-lg transition-colors"
      >
        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg
        >
      </button>
    </div>
    <div class="p-6">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-gray-100 rounded-xl overflow-hidden">
          <img data-quick-view-image class="w-full h-56 object-cover" alt="" loading="lazy" />
        </div>
        <div>
          <div class="text-sm uppercase tracking-wider text-sky-600 font-medium" data-quick-view-category></div>
          <div class="mt-3 text-gray-600 text-sm leading-relaxed" data-quick-view-desc></div>
          <div class="mt-4 text-2xl font-bold text-gray-900" data-quick-view-price></div>
          <div class="mt-4 flex flex-col gap-2">
            <button
              type="button"
              data-quick-view-add
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition-colors shadow-md"
            >
              {t('product.addToCart') || 'Add to Cart'}
            </button>
            <a
              data-quick-view-link
              class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-primary text-primary text-sm font-medium hover:bg-primary/5 transition-colors"
              href=""
            >
              {t('product.viewDetails') || 'View Details'}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { addItem } from '~/lib/cart';

  const langPrefix =
    document.documentElement.lang && document.documentElement.lang !== 'en' ? `/${document.documentElement.lang}` : '';
  const products: Record<string, any>[] = await fetch('/search-index.json')
    .then((r) => r.json())
    .catch(() => []);
  const modalMap: Record<string, any> = {};
  products.forEach((p: any) => {
    if (p?.slug) modalMap[p.slug] = p;
  });

  let currentSlug = '';

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-quick-view-btn]');
    if (!btn) return;
    const slug = btn.getAttribute('data-quick-view-btn');
    if (!slug) return;
    const data = modalMap[slug];
    if (!data) return;
    const modal = document.getElementById(`quick-view-${slug}`);
    if (!modal) return;

    currentSlug = slug;
    modal.querySelector('[data-quick-view-title]')!.textContent = data.title || '';
    modal.querySelector('[data-quick-view-category]')!.textContent = data.type || '';
    modal.querySelector('[data-quick-view-desc]')!.textContent = data.excerpt || '';
    (modal.querySelector('[data-quick-view-image]') as HTMLImageElement).src = data.image || '';
    (modal.querySelector('[data-quick-view-image]') as HTMLImageElement).alt = data.title || '';

    const priceNum = Number(String(data.price || '').replace(/[^0-9.]/g, ''));
    const priceEl = modal.querySelector('[data-quick-view-price]')!;
    if (Number.isFinite(priceNum) && priceNum > 0) {
      priceEl.textContent = `$${priceNum % 1 === 0 ? priceNum.toFixed(0) : priceNum.toFixed(2)} ${
        data.currency || 'USD'
      }`;
      priceEl.classList.remove('hidden');
    } else {
      priceEl.classList.add('hidden');
    }

    modal.querySelector('[data-quick-view-link]')!.setAttribute('href', `${langPrefix}/products/${slug}`);
    modal.querySelector('[data-quick-view-add]')!.removeAttribute('disabled');

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  });

  document.addEventListener('click', (e) => {
    const addBtn = (e.target as HTMLElement).closest('[data-quick-view-add]');
    if (!addBtn || !currentSlug) return;
    const data = modalMap[currentSlug];
    if (!data) return;
    const priceCents = Math.round(Number(String(data.price || '0').replace(/[^0-9.]/g, '')) * 100);
    addItem(
      {
        slug: currentSlug,
        title: data.title || currentSlug,
        priceCents,
        currency: data.currency || 'USD',
        image: data.image || '',
      },
      1
    );
    const modal = document.getElementById(`quick-view-${currentSlug}`);
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  document.addEventListener('click', (e) => {
    const modal = (e.target as HTMLElement).closest('[data-quick-view]');
    if (modal && e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-quick-view]').forEach((el) => {
        el.classList.add('hidden');
        el.classList.remove('flex');
      });
    }
  });
</script>
