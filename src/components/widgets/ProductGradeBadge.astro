---
import Icon from '~/components/ui/Icon.astro';
import { getUiForLang } from '~/i18n/generated/ui-all';

export interface Props {
  grade: 'A' | 'B';
  lang?: string;
  size?: 'sm' | 'md';
}

const { grade, lang = 'en', size = 'md' } = Astro.props;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
const isB = grade === 'B';
const label = isB ? t('product.gradeB') || 'Grade B' : t('product.gradeA') || 'Grade A';
---

<span
  class:list={[
    'inline-flex items-center gap-1 font-bold uppercase tracking-wide text-white rounded-full shadow-sm whitespace-nowrap',
    size === 'sm' ? 'px-2 py-0.5 text-[10px]' : 'px-3 py-1 text-xs',
    isB ? 'bg-amber-500' : 'bg-sky-600',
  ]}
>
  <Icon name="tabler:award" class={size === 'sm' ? 'w-3 h-3' : 'w-3.5 h-3.5'} />
  {label}
</span>
