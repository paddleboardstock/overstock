<section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
  <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter">Medikal na Pagtatangi</h1>
  <div
