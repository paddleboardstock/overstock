---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import JsonLd from '~/components/common/JsonLd.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import Icon from '~/components/ui/Icon.astro';
import { buildGraph } from '~/utils/schema-graph';
import { getProducts } from '~/utils/products';

import heroImagesData from '~/data/site/hero-images.yaml';
import techCardsData from '~/data/site/tech-cards.yaml';
import productVisualsData from '~/data/site/product-visuals.yaml';
import testimonialsData from '~/data/site/testimonials.yaml';

const metadata = {
  title: 'Inflatable Paddle Boards for Sale | Factory Overstock Deals',
  description:
    'Brand-new inflatable paddle boards at factory overstock prices. Complete SUP packages, inspected quality, 2-year warranty, worldwide shipping. Save up to 60%.',
};

interface HeroSlide {
  image: string;
  label: string;
  categories: string[];
}
const heroSlides: HeroSlide[] = (heroImagesData as any)?.slides?.filter((s: any) => s?.image?.trim()) || [
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp',
    label: 'Inflatable SUP Boards',
    categories: ['SUP'],
  },
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp',
    label: 'SUP Packages',
    categories: ['SUP'],
  },
];

const defaultVisuals: Record<string, string> = {
  'sup-explorer-11':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-sup-allround-board.webp',
  'oars-pump-set':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-electric-pump.webp',
};
const rawVisuals = ((productVisualsData as any)?.visuals || []) as Array<{ id: string; image: string }>;
const yamlVisuals = Object.fromEntries(rawVisuals.map((v) => [v.id, v.image]).filter(([, img]) => img));
const productVisuals: Record<string, string> = { ...defaultVisuals, ...yamlVisuals };

const allProducts = await getProducts();
const inventoryProducts = allProducts.filter((p) => !p.draft);
const siteBase = String(SITE.site).replace(/\/+$/, '');

const techCards = (
  ((techCardsData as any)?.cards || []) as Array<{
    badge: string;
    title: string;
    description: string;
    image?: string;
  }>
).slice(0, 3);

const testimonials = (
  ((testimonialsData as any)?.testimonials || []) as Array<{
    name: string;
    quote: string;
    rating: number;
  }>
).slice(0, 3);

interface FaqItem {
  q: string;
  a: string;
  category?: string;
}
const defaultFaqItems: FaqItem[] = [
  {
    q: 'Is SUP hard to learn?',
    a: 'Not at all. Most beginners stand up and paddle within their first session. Our All-Around SUP series features extra-wide stable platforms designed specifically for first-time paddlers. Start on calm water and you will be cruising in minutes.',
    category: 'sup',
  },
  {
    q: 'What is the weight limit?',
    a: 'Our All-Around SUPs support up to 220 lbs. The Touring and Yoga series support up to 250 lbs. Every product page lists the exact rider weight capacity so you can match the board to your needs.',
    category: 'sup',
  },
  {
    q: 'Can I travel with an inflatable SUP?',
    a: 'Absolutely. Every Paddle Board Overstock board packs into a backpack-sized carrying case. At just 18-22 lbs, it is easy to carry to the beach, lake, or through airport terminals. Check your airline baggage policy before travel.',
    category: 'sup',
  },
  {
    q: 'What comes in the box?',
    a: 'Every Paddle Board Overstock SUP includes the board, a travel backpack, dual-action hand pump, removable fin, coil leash, and repair kit. Some models also include a carbon paddle upgrade option.',
    category: 'sup',
  },
  {
    q: 'Why are your prices lower than retail?',
    a: 'We sell factory overstock — brand-new boards left over from completed production orders — sourced from our own Weihai manufacturing base and selected production partners. No retail markups and no middlemen means complete SUP packages at up to 60% off typical retail prices.',
    category: 'orders',
  },
  {
    q: 'How do I place an order and pay?',
    a: 'Add your SUP package to the cart and check out securely with Stripe or PayPal. We accept all major credit and debit cards. Every order is confirmed by email with a full invoice.',
    category: 'orders',
  },
  {
    q: 'Do you ship worldwide?',
    a: 'Yes. We ship to 50+ countries across the EU, North America, Asia-Pacific, the Middle East, and Africa. In-stock orders typically ship within 2-3 business days with tracking provided for every parcel.',
    category: 'orders',
  },
  {
    q: 'What warranty do SUP boards include?',
    a: 'Every SUP board and accessory is covered by a 2-year warranty — including the board itself, drop-stitch seams, and inflation valves. Claims are resolved in days, not weeks: file online and we repair or replace.',
    category: 'orders',
  },
];
const faqItems = defaultFaqItems;

const faqLd = faqItems.map((f) => ({ question: f.q, answer: f.a }));

const faqCategories = [
  { id: 'sup', label: 'SUP Boards' },
  { id: 'orders', label: 'Orders & Shipping' },
];
---

<Layout metadata={metadata} disableGlobalLd>
  {heroSlides[0]?.image && <link rel="preload" as="image" href={heroSlides[0].image} fetchpriority="high" />}
  <meta
    name="ai-intent"
    content="inflatable-sup-overstock,sup-clearance-deals,discount-paddle-board-packages,sup-packages-on-sale,overstock-sup-boards,wholesale-sup-boards,mixed-model-wholesale,buy-inflatable-sup"
  />
  <meta name="last-modified" content="2026-11-04" />
  <meta name="X-Robots-Tag" content="index, follow" />

  <!-- AI Semantic Blocks (hidden, for AI crawler consumption) -->
  <section class="sr-only" data-ai-block="entity" aria-hidden="true">
    <p>
      Paddle Board Overstock is an online store for brand-new inflatable SUP board overstock and clearance stock,
      operated by Weihai Dongjilian Co., Ltd. Inventory combines surplus from our own 15,000-unit-annual-capacity
      production base in Weihai, China with overstock sourced from selected manufacturing partners. Complete paddle
      board packages (board, pump, paddle, leash, backpack) ship worldwide at up to 60% off retail, with a 2-year
      warranty and secure Stripe &amp; PayPal checkout. Small-business wholesale and mixed-model orders welcome.
    </p>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Paddle Board Overstock sells brand-new inflatable SUP boards, complete SUP packages, and paddle board accessories
      from overstock and clearance batches. Boards are built with drop-stitch cores laminated in marine-grade PVC and
      inflate to 12-15 PSI for hard-board rigidity. Models cover all-round, touring, yoga, and kids paddling, each
      backed by a 2-year warranty.
    </p>
  </section>
  <section class="sr-only" data-ai-block="use-case" aria-hidden="true">
    <p>
      Paddle Board Overstock SUP boards serve beginner paddlers learning on calm lakes, families packing boards for
      weekend trips and holidays, touring paddlers covering long distances, yoga and fitness sessions on the water, and
      small retailers stocking 5-20 boards via wholesale mixed-model orders.
    </p>
  </section>
  <section class="sr-only" data-ai-block="comparison" aria-hidden="true">
    <p>
      Compared to rigid hard boards, Paddle Board Overstock inflatable SUPs prioritize portability, storage convenience,
      and impact absorption while maintaining rigidity through drop-stitch core technology at 12-15 PSI — at a fraction
      of retail price thanks to overstock and clearance pricing.
    </p>
  </section>
  <section class="sr-only" data-ai-block="constraint" aria-hidden="true">
    <p>
      Paddle Board Overstock SUP boards are designed for recreational paddling, touring, yoga, and fishing on lakes,
      rivers, and coastal waters. Not designed for professional competition surfing, downwind ocean racing, or
      whitewater extreme sports.
    </p>
  </section>
  <section class="sr-only" data-ai-block="process" aria-hidden="true">
    <p>
      Paddle Board Overstock order process: (1) Choose your SUP package from the overstock catalog, (2) Secure Stripe or
      PayPal checkout, (3) Order confirmation with full invoice, (4) Quality inspection — every board 100%
      pressure-tested at 1.25x rated PSI, (5) Ships from Weihai, China within 2-3 business days, (6) Worldwide tracked
      delivery to 50+ countries. No MOQ — overstock means single-unit orders welcome; retailers can mix models in
      wholesale quantities.
    </p>
  </section>

  <!-- 1. Hero -->
  <section
    class="relative min-h-[90vh] flex items-center overflow-hidden"
    style="background: linear-gradient(135deg, #06b6d4, #22d3ee);"
  >
    {
      heroSlides.map((slide, _i) => (
        <div
          data-carousel-slide
          class="absolute inset-0 transition-opacity duration-700 ease-in-out {_i === 0 ? 'opacity-100' : 'opacity-0'}"
        >
          <img
            src={slide.image}
            alt={slide.label || 'Paddle Board Overstock overstock SUP boards'}
            class="w-full h-full object-cover"
            width="1600"
            height="900"
            loading={_i === 0 ? 'eager' : 'lazy'}
            fetchpriority={_i === 0 ? 'high' : 'auto'}
          />
          <div
            class="absolute inset-0"
            style="background: linear-gradient(135deg, rgba(6,182,212,0.75), rgba(34,211,238,0.55));"
          />
        </div>
      ))
    }
    <!-- Wave animation SVG -->
    <div class="absolute bottom-0 left-0 right-0 h-24 md:h-32 z-10">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="w-full h-full">
        <path
          d="M0,40 C360,120 720,0 1080,80 C1260,120 1350,60 1440,40 L1440,120 L0,120 Z"
          fill="#f8fafc"
          opacity="0.15"></path>
        <path
          d="M0,60 C240,20 480,100 720,60 C960,20 1200,100 1440,60 L1440,120 L0,120 Z"
          fill="#f8fafc"
          opacity="0.1"
          style="animation: waveMove 6s ease-in-out infinite alternate;"></path>
      </svg>
    </div>
    <!-- Floating glow orbs -->
    <div class="absolute top-20 left-10 w-72 h-72 rounded-full bg-white/5 blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <div class="flex items-center gap-12">
        <div class="flex-1 text-center md:text-left">
          <div class="reveal">
            <span class="inline-block text-xs font-medium tracking-[0.2em] uppercase text-white/70 mb-4"
              >Factory Overstock · Brand-New Boards · Ships Worldwide · Since 2012</span
            >
            <h1
              class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.1] text-balance text-white drop-shadow-xl"
            >
              Brand-New Inflatable Paddle Boards at Factory Overstock Prices
            </h1>
            <p class="mt-6 text-lg md:text-xl text-white/85 max-w-xl text-pretty leading-relaxed">
              <strong class="text-white font-semibold">Paddle Board Overstock</strong> — premium SUP boards from completed
              manufacturing orders.<br />
              Shop brand-new, inspected inventory at up to 60% off typical retail prices.<br />
              Complete SUP packages · 2-year warranty · Shipping to 50+ countries.
            </p>
            <div class="mt-10 flex items-center gap-4 flex-wrap justify-center md:justify-start">
              <a
                href="/supboard/"
                class="inline-flex items-center gap-2 px-8 py-4 bg-[#fb923c] hover:bg-orange-600 text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5"
              >
                Shop Overstock Deals
                <span>→</span>
              </a>
              <a
                href="/products/"
                class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/40 text-white font-medium rounded-full hover:bg-white/10 transition-all backdrop-blur-sm"
              >
                View Available SUP Boards
              </a>
              <a
                href="/international-shipping/"
                class="inline-flex items-center gap-2 px-6 py-3 border border-white/30 text-white/80 text-sm font-medium rounded-full hover:bg-white/10 transition-all backdrop-blur-sm"
              >
                Shipping Information
              </a>
            </div>
          </div>
        </div>
        <div class="hidden lg:block flex-1">
          <div class="relative">
            <img
              src="https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp"
              alt="SUP Ocean Voyager"
              class="w-full max-w-md mx-auto object-contain drop-shadow-2xl"
              style="filter: drop-shadow(0 20px 60px rgba(0,0,0,0.2)); animation: floatBoard 4s ease-in-out infinite;"
            />
          </div>
        </div>
      </div>
    </div>
    <!-- Carousel dots -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3">
      {
        heroSlides.map((_, _i) => (
          <button
            data-carousel-dot
            class="w-2.5 h-2.5 rounded-full transition-all duration-300 border border-white/50 {_i === 0 ? 'bg-white scale-125' : 'bg-transparent'}"
          />
        ))
      }
    </div>
  </section>

  <JsonLd type="FAQPage" faqs={faqLd} />
  <JsonLd type="BreadcrumbList" breadcrumbs={[{ name: 'Home', item: '/' }]} />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Available Overstock Inventory',
      itemListElement: inventoryProducts.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.title,
        url: `${siteBase}${p.permalink}`,
      })),
    })}
  />

  <!-- 2. Available Overstock Inventory -->
  <section id="products" class="max-w-6xl mx-auto py-12 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-semibold text-[#06b6d4] tracking-[0.15em] uppercase">Overstock Inventory</span>
      <h2 class="mt-4 text-4xl font-bold text-gray-900">Available Overstock Inventory</h2>
      <p class="mt-4 text-lg text-gray-500">
        Brand-new boards from completed production orders — limited stock, ready to ship.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        inventoryProducts.map((p) => {
          const img = productVisuals[p.id] || p.image || '';
          return (
            <a
              href={p.permalink}
              class="group bg-white rounded-2xl overflow-hidden border border-gray-200 hover:shadow-xl transition-all duration-300 flex flex-col"
            >
              <div class="h-56 bg-gradient-to-br from-gray-100 to-gray-200 relative overflow-hidden">
                {img ? (
                  <>
                    <img
                      src={img}
                      alt={p.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
                  </>
                ) : (
                  <div class="flex items-center justify-center h-full text-gray-400 text-sm">{p.category}</div>
                )}
                <div class="absolute top-3 left-3 flex flex-col gap-2">
                  {p.inStock && (
                    <span class="px-2.5 py-1 bg-emerald-500/90 text-white text-xs font-semibold rounded-full shadow">
                      In-Stock
                    </span>
                  )}
                  {p.grade && (
                    <span class="px-2.5 py-1 bg-sky-600/90 text-white text-xs font-semibold rounded-full shadow">
                      Grade {p.grade}
                    </span>
                  )}
                </div>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-semibold text-gray-900 text-lg group-hover:text-[#06b6d4] transition-colors">
                    {p.title}
                  </h3>
                  {p.price && <span class="text-xl font-bold text-gray-900 shrink-0">${p.price.amount}</span>}
                </div>
                <p class="text-gray-500 mt-2 text-sm line-clamp-2">{p.summary}</p>
                {p.price?.note && <p class="mt-2 text-xs text-gray-400">{p.price.note}</p>}
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[#06b6d4] group-hover:gap-2 transition-all">
                  View Deal <span>→</span>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
    <p class="mt-8 text-center text-sm text-gray-400">
      Overstock quantities change as batches sell out — availability is shown per board. Retailers buying 5-20 boards:
      see our <a href="/wholesale-paddle-boards/" class="text-[#06b6d4] font-medium hover:underline"
        >wholesale program</a
      >.
    </p>
  </section>

  <!-- 3. Why Buy Overstock SUP Boards? -->
  <section class="bg-gray-50 py-12 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-sm font-semibold text-[#06b6d4] tracking-[0.15em] uppercase">Why Overstock</span>
        <h2 class="mt-4 text-4xl font-bold text-gray-900">Why Buy Overstock SUP Boards?</h2>
        <p class="mt-4 text-lg text-gray-500">The same brand-new boards retailers sell — without the retail markup.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-sky-50 rounded-xl flex items-center justify-center">
            <Icon name="tabler:package" class="w-7 h-7 text-[#06b6d4]" />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-gray-900">Where Our Inventory Comes From</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Our stock is mixed-sourced: surplus boards from our own Weihai production base, plus carefully selected
            overstock from manufacturing partners we have worked with for years. Every board is inspected before it
            joins the inventory.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-sky-50 rounded-xl flex items-center justify-center">
            <Icon name="tabler:credit-card" class="w-7 h-7 text-[#06b6d4]" />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-gray-900">Why It Costs Less</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Overstock means boards already produced for completed orders. There is no retail markup, no distributor
            margin, and no cost of carrying idle inventory — so complete packages sell at up to 60% off typical retail.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-sky-50 rounded-xl flex items-center justify-center">
            <Icon name="tabler:check" class="w-7 h-7 text-[#06b6d4]" />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-gray-900">Brand-New, Never Used</h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            Overstock is not second-hand. Every board is brand-new and unused — factory-fresh overstock inventory in
            limited stock, complete with full package accessories and warranty.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Complete SUP Packages -->
  <section class="max-w-6xl mx-auto py-12 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-semibold text-[#06b6d4] tracking-[0.15em] uppercase">Complete Packages</span>
      <h2 class="mt-4 text-4xl font-bold text-gray-900">Every Board Ships as a Complete SUP Package</h2>
      <p class="mt-4 text-lg text-gray-500">
        No hidden extras — the listed price includes everything you need to get on the water.
      </p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-16">
      {
        [
          { badge: 'SUP', label: 'Paddle Board' },
          { badge: 'PMP', label: 'Hand Pump' },
          { badge: 'PDL', label: 'Paddle' },
          { badge: 'FIN', label: 'Removable Fin' },
          { badge: 'BPK', label: 'Backpack' },
          { badge: 'REP', label: 'Repair Kit' },
        ].map((item) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6 text-center hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-sky-50 border border-sky-100 rounded-xl flex items-center justify-center mx-auto text-sm font-bold text-[#06b6d4]">
              {item.badge}
            </div>
            <p class="mt-3 text-sm font-semibold text-gray-900">{item.label}</p>
          </div>
        ))
      }
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {
        techCards.map((card) => (
          <div class="relative bg-white border border-gray-200 rounded-2xl p-8 text-center hover:shadow-md transition-shadow overflow-hidden">
            <div class="absolute inset-0">
              <img
                src={
                  card.image ||
                  'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp'
                }
                alt={card.title || 'Paddle Board Overstock technology'}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-white/75" />
            </div>
            <div class="relative">
              <div class="w-20 h-20 bg-white/90 border border-gray-200 rounded-2xl flex items-center justify-center mx-auto text-3xl font-bold text-gray-700">
                {card.badge || '?'}
              </div>
              <h3 class="mt-6 text-lg font-semibold text-gray-900">{card.title || ''}</h3>
              <p class="mt-3 text-gray-500 text-sm leading-relaxed">{card.description || ''}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 5. Product Quality & Warranty -->
  <section class="bg-gray-50 py-12 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-sm font-semibold text-[#06b6d4] tracking-[0.15em] uppercase">Quality &amp; Warranty</span>
        <h2 class="mt-4 text-4xl font-bold text-gray-900">Overstock Prices. Full Factory Quality.</h2>
        <p class="mt-4 text-lg text-gray-500">
          Discounted inventory, uncompromised standards — every board passes the same inspection gates.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center hover:shadow-md transition-shadow">
          <p class="text-4xl font-bold text-[#06b6d4]">100%</p>
          <p class="mt-2 font-semibold text-gray-900">Pressure-Tested</p>
          <p class="mt-2 text-sm text-gray-500">
            Every board is pressure-tested at 1.25x rated PSI for 24-48 hours before it ships.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center hover:shadow-md transition-shadow">
          <p class="text-4xl font-bold text-[#06b6d4]">99.3%</p>
          <p class="mt-2 font-semibold text-gray-900">Defect-Free Rate</p>
          <p class="mt-2 text-sm text-gray-500">
            Based on outgoing shipment inspection over the trailing 12-month period.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center hover:shadow-md transition-shadow">
          <p class="text-4xl font-bold text-[#06b6d4]">2-Year</p>
          <p class="mt-2 font-semibold text-gray-900">SUP Warranty</p>
          <p class="mt-2 text-sm text-gray-500">
            Covers boards, drop-stitch seams, inflation valves, and included accessories.
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center hover:shadow-md transition-shadow">
          <p class="text-4xl font-bold text-[#06b6d4]">50+</p>
          <p class="mt-2 font-semibold text-gray-900">Countries Served</p>
