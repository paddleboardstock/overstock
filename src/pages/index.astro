---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { products } from '../data/products';

import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import Tldr from '~/components/common/Tldr.astro';
import { contentV2Records } from '~/data/content-v2';
import cfg from '~/config.yaml';
import { buildGraph } from '~/utils/schema-graph';
const branding = (cfg as any)?.branding || {};
import heroImagesData from '~/data/site/hero-images.yaml';
import techCardsData from '~/data/site/tech-cards.yaml';
import productVisualsData from '~/data/site/product-visuals.yaml';
import useCasesData from '~/data/site/use-cases.yaml';
import proofPointsData from '~/data/site/proof-points.yaml';
import testimonialsData from '~/data/site/testimonials.yaml';
import learnData from '~/data/site/learning-center.yaml';
import topGuidesData from '~/data/site/top-guides.yaml';

const metadata = {
  title: 'RIB Boats, Inflatable Boats & SUP Board Manufacturer | OEM/ODM — Paddle Board Overstock',
  description: SITE?.description,
};

interface HeroSlide {
  image: string;
  label: string;
  categories: string[];
}
const heroSlides: HeroSlide[] = (heroImagesData as any)?.slides?.filter((s: any) => s?.image?.trim()) || [
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/categories/paddleboardoverstock-rib-boat-category.webp',
    label: 'RIB Boats',
    categories: ['RIB'],
  },
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/categories/paddleboardoverstock-dinghy-category.webp',
    label: 'Inflatable Boats',
    categories: ['INFLATABLE'],
  },
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp',
    label: 'SUP Boards',
    categories: ['SUP'],
  },
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/categories/paddleboardoverstock-accessories-category.webp',
    label: 'Accessories',
    categories: ['ACCESSORY'],
  },
];

const defaultVisuals: Record<string, string> = {
  'sup-explorer-11':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-sup-allround-board.webp',
  'airdeck-360':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-inflatable-boat.webp',
  'rib-330':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/rib/paddleboardoverstock-rib-330-boat.webp',
  'rib-450-patrol':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/rib/paddleboardoverstock-rib-450-patrol-boat.webp',
  'life-vest-classic':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-life-vest-classic.webp',
  'life-vest-pro':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-life-vest-pro-front.webp',
  'oars-pump-set':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-electric-pump.webp',
  'zb-mt350':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-zb-mt350-inflatable-dinghy.webp',
};
const rawVisuals = ((productVisualsData as any)?.visuals || []) as Array<{ id: string; image: string }>;
const yamlVisuals = Object.fromEntries(rawVisuals.map((v) => [v.id, v.image]).filter(([, img]) => img));
const productVisuals: Record<string, string> = { ...defaultVisuals, ...yamlVisuals };

const defaultUseCases = [
  {
    title: 'Beginner Water Sports',
    desc: 'Stable SUP boards and kayaks for first-time users.',
    scenario:
      'A family visiting a lake for the weekend wants to try paddle boarding. They need stable, easy-to-launch equipment with clear safety guidance.',
    solution:
      'The SUP Explorer 11 provides wide-body stability for beginners. The Life Vest Classic ensures CE-certified flotation. The Dual-Action Pump inflates both boards in under 10 minutes.',
    products: ['SUP Explorer 11', 'Life Vest Classic', 'Dual-Action Pump'],
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp',
  },
  {
    title: 'Outdoor Exploration',
    desc: 'Portable kayaks and dinghies for rivers, lakes, and coastal trips.',
    scenario:
      'An outdoor enthusiast plans a week-long river trip and needs a boat that packs small, inflates at camp, and handles varying currents.',
    solution:
      'The Kayak Lite packs into a backpack and inflates in under 4 minutes. Its drop-stitch construction handles lakes, slow rivers, and coastal paddling.',
    products: ['Inflatable Kayak Lite', 'Carbon Paddle', 'Life Vest Classic'],
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-inflatable-boat.webp',
  },
  {
    title: 'Professional Operations',
    desc: 'Commercial-grade RIBs for tour operators and emergency response.',
    scenario:
      'A coastal tour operator needs a fleet of durable boats that run daily trips in varying sea conditions and meet commercial safety regulations.',
    solution:
      'The RIB 330 and RIB 450 Patrol use fiberglass deep-V hulls with Hypalon tubes for all-weather durability. Multiple units can be deployed with consistent performance.',
    products: ['RIB 330', 'RIB 450 Patrol', 'Life Vest Pro'],
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-leviathan-wake-1.webp',
  },
  {
    title: 'Family Recreation',
    desc: 'Spacious dinghies for day trips, fishing, and watersports.',
    scenario:
      'A family of four wants a stable boat for weekend lake outings, fishing trips, and towing a tube for the kids.',
    solution:
      'The AirDeck 360 seats up to five with a reinforced air deck floor. It inflates at the launch site, stores in the car, and handles both calm lakes and sheltered coastal waters.',
    products: ['AirDeck 360', 'Life Vest Classic', 'Dual-Action Pump'],
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/rib/paddleboardoverstock-rib-330-boat.webp',
  },
];
const rawCases = ((useCasesData as any)?.cases || []) as Array<{
  id: string;
  title: string;
  desc: string;
  scenario: string;
  solution: string;
  products: string[];
  image: string;
}>;
const useCases = rawCases.length
  ? rawCases.map((u) => ({
      title: u.title,
      desc: u.desc,
      scenario: u.scenario,
      solution: u.solution,
      products: u.products,
      img: u.image,
    }))
  : defaultUseCases;

const rawPoints = ((proofPointsData as any)?.points || []) as Array<{
  id: string;
  metric: string;
  label: string;
  detail: string;
}>;
const defaultProofPoints = [
  {
    metric: '64',
    label: 'CE-certified models across 5 categories',
    detail: 'RIB, Inflatable Boat, SUP Board, Safety Equipment, Accessory',
  },
  { metric: '50+', label: 'countries served', detail: 'Global distribution network across EU, US, ASIA' },
  { metric: '2012', label: 'founded', detail: 'Over a decade of water sports manufacturing' },
  {
    metric: 'ISO',
    label: 'CE certified per applicable EU directives',
    detail: 'Every product meets international safety standards',
  },
];
const proofPoints = rawPoints.length
  ? rawPoints.map((p) => ({ metric: p.metric, label: p.label, detail: p.detail }))
  : defaultProofPoints;

const catalogCategories = [
  {
    key: 'RIB',
    label: 'RIB Boats',
    desc: 'Rigid-hull inflatable boats from 2.5 m to 7.6 m — recreational, commercial, and patrol.',
  },
  {
    key: 'INFLATABLE',
    label: 'Inflatable Boats',
    desc: 'Lightweight dinghies, kayaks, and sport boats for every water adventure.',
    keys: ['INFLATABLE', 'SIB_ALUMINUM', 'SIB_DROPSTITCH', 'WHITEWATER_RAFT', 'TACTICAL_RAFT'],
  },
  {
    key: 'SUP',
    label: 'SUP Boards',
    desc: 'Stand-up paddle boards from 9 ft to 12 ft — all-round, touring, yoga, and more.',
  },
  {
    key: 'ACCESSORY',
    label: 'Accessories',
    desc: 'Life vests, pumps, paddles, repair kits, and essential gear.',
    keys: ['ACCESSORY', 'DROPSTITCH_SEAT'],
  },
  {
    key: 'KAYAK',
    label: 'Kayaks',
    desc: 'Drop-stitch inflatable kayaks — full drop-stitch touring, hybrid recreational, and twin-hull catamaran models.',
    keys: ['KABOAT', 'KAYAK_FULL_DROPSTITCH', 'KAYAK_HYBRID'],
  },
  {
    key: 'CATAMARAN',
    label: 'Catamarans',
    desc: 'Twin-hull inflatable catamarans for high-speed stability and versatile water sport operations.',
    keys: ['HIGH_SPEED_CATAMARAN'],
  },
];
const groupedProducts: Record<string, typeof products> = {};
for (const cat of catalogCategories) {
  const keys: string[] = cat.keys ?? [cat.key];
  groupedProducts[cat.key] = products.filter((p) => keys.includes(p.category)).slice(0, 6);
}

interface FaqItem {
  q: string;
  a: string;
  category?: string;
}
const defaultFaqItems: FaqItem[] = [
  {
    q: 'What is the difference between a RIB and an inflatable boat?',
    a: 'A RIB (Rigid Inflatable Boat) combines a solid fiberglass or aluminum hull with inflatable tubes, offering superior handling in rough water. An inflatable boat has a fully flexible hull made entirely of PVC or Hypalon tubes — lighter and more portable but less capable in challenging conditions.',
    category: 'rib',
  },
  {
    q: 'What size engine do I need for a RIB?',
    a: "Engine size depends on your RIB length and intended use. A 3.3 m RIB typically handles 15–20 HP for recreation. A 4.5 m patrol RIB needs 40–60 HP for planing speeds. Always check the manufacturer's max engine rating — exceeding it voids warranty and safety certification.",
    category: 'rib',
  },
  {
    q: 'Are RIBs suitable for beginners?',
    a: 'Smaller RIBs (2.5–3.3 m) with 10–20 HP engines are suitable for beginners in calm waters. Larger RIBs require boating experience due to higher speeds and handling characteristics. We recommend starting with an inflatable dinghy if you are new to boating.',
    category: 'rib',
  },
  {
    q: 'How do I maintain Hypalon tubes on my RIB?',
    a: 'Hypalon tubes require minimal maintenance. Rinse with fresh water after saltwater use, avoid prolonged UV exposure when deflated, and clean with mild soap and water. Hypalon naturally resists UV and ozone degradation, lasting 15–20+ years with proper care.',
    category: 'rib',
  },
  {
    q: 'How long do inflatable boats last?',
    a: 'PVC inflatable boats last 8–12 years with proper care. Hypalon boats can last 15–20+ years. Key factors: UV exposure, storage conditions (inflated vs deflated), frequency of use, and maintenance. Proper inflation, fresh water rinsing, and avoiding sharp objects extend lifespan significantly.',
    category: 'inflatable',
  },
  {
    q: 'Can I leave my inflatable boat inflated all season?',
    a: 'Yes, but with precautions. Inflate to the rated pressure and check weekly as temperature changes affect pressure. UV exposure is the main enemy — use a cover if storing outdoors. Partially deflate and store indoors during extended idle periods for maximum tube life.',
    category: 'inflatable',
  },
  {
    q: 'What maintenance do inflatable boats need?',
    a: 'Basic maintenance: rinse with fresh water after each use, dry thoroughly before storage, check for leaks at seams and valves, lubricate valves yearly with silicone grease, and store in a cool dry place. Avoid dragging on concrete — use a launching trolley when possible.',
    category: 'inflatable',
  },
  {
    q: 'Can inflatable boats be repaired?',
    a: 'Yes. Small punctures and seam leaks can be repaired with a PVC repair kit — clean the area, apply adhesive, patch, and roll out air bubbles. Larger damage may require professional repair. Hypalon requires two-part adhesive and more careful preparation.',
    category: 'inflatable',
  },
  {
    q: 'Is SUP hard to learn?',
    a: 'Not at all. Most beginners stand up and paddle within their first session. Our All-Around SUP series features extra-wide stable platforms designed specifically for first-time paddlers. Start on calm water and you will be cruising in minutes.',
    category: 'sup',
  },
  {
    q: 'What is the weight limit?',
    a: 'Our All-Around SUPs support up to 220 lbs. The Touring and Yoga series support up to 250 lbs. For tandem use or heavier loads, our Kayak and Dinghy products offer higher capacity options.',
    category: 'sup',
  },
  {
    q: 'Can I travel with an inflatable SUP?',
    a: 'Absolutely. Every Paddle Board Overstock board packs into a backpack-sized carrying case. At just 18-22 lbs, it is easy to carry to the beach, lake, or through airport terminals. Check your airline baggage policy before travel.',
    category: 'sup',
  },
  {
    q: 'What comes in the box?',
    a: 'Every Paddle Board Overstock SUP includes the board, a travel backpack, dual-action hand pump, removable fin, coil leash, and repair kit. Some models also include a carbon paddle upgrade option.',
    category: 'sup',
  },
];
const faqItems = defaultFaqItems;

const faqLd = faqItems.map((f) => ({ question: f.q, answer: f.a }));

const topGuideSlugs = topGuidesData.guides || [
  'cost-to-start-sup-rental-business',
  'private-label-vs-white-label',
  'building-resort-water-sports-center',
];
const homeGuides = contentV2Records.filter((c) => topGuideSlugs.includes(c.slug));
const siteBase = String(SITE.site).replace(/\/+$/, '');

const faqCategories = [
  { id: 'rib', label: 'RIB Boats' },
  { id: 'inflatable', label: 'Inflatable Boats' },
  { id: 'sup', label: 'SUP Boards' },
];
---

<Layout metadata={metadata} disableGlobalLd>
  {heroSlides[0]?.image && <link rel="preload" as="image" href={heroSlides[0].image} fetchpriority="high" />}
  <meta
    name="ai-intent"
    content="water-sports-business-partner,b2b-sup-club-equipment,resort-water-sports-programs,private-label-sup-oem,inflatable-boat-manufacturing,drop-stitch-sup-factory,china-inflatable-kayak-supplier,marine-pvc-boat-manufacturer"
  />
  <meta name="last-modified" content="2026-06-23" />
  <meta name="X-Robots-Tag" content="index, follow" />

  <!-- AI Semantic Blocks (hidden, for AI crawler consumption) -->
  <section class="sr-only" data-ai-block="entity" aria-hidden="true">
    <p>
      Paddle Board Overstock is a water adventure business partner providing complete equipment solutions for water
      sports clubs, resorts, hospitality brands, and emerging watercraft entrepreneurs. Backed by the Paddle Board
      Overstock Qingdao Manufacturing Hub — a vertically integrated 12,000 m² OEM/ODM factory in Qingdao, China with
      200-300 skilled workers and 15,000 units annual capacity. Specializes in club packages, resort fleet programs,
      private label manufacturing, custom mold design, and bulk B2B wholesale for global water sports operators.
    </p>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Paddle Board Overstock manufactures inflatable SUPs, kayaks, RIBs, and safety equipment for water sports clubs,
      resorts, training centers, hospitality properties, and emerging water sports brands. The company provides
      end-to-end solutions from equipment packages and custom branding to staff training and revenue management
      programs. As an OEM/ODM partner, Paddle Board Overstock delivers full-spectrum manufacturing including drop-stitch
      core lamination, PVC/Hypalon tube fabrication, 3D mold engineering, and CE/BSCI compliance documentation.
    </p>
  </section>
  <section class="sr-only" data-ai-block="use-case" aria-hidden="true">
    <p>
      Paddle Board Overstock products and programs serve water sports clubs launching rental operations, resorts
      creating guest waterfront experiences, entrepreneurs building their own water sports brands, as well as beginner
      SUP training, long-distance touring, family recreation, professional marine patrol, and water safety programs.
    </p>
  </section>
  <section class="sr-only" data-ai-block="comparison" aria-hidden="true">
    <p>
      Compared to rigid hard-board watercraft, Paddle Board Overstock inflatable products prioritize portability,
      storage convenience, and impact absorption while maintaining rigidity through drop-stitch core technology at 12-15
      PSI.
    </p>
  </section>
  <section class="sr-only" data-ai-block="constraint" aria-hidden="true">
    <p>
      Paddle Board Overstock products are designed for training, recreation, and professional marine operations. Not
      designed for professional competition surfing, high-speed ocean racing, or extreme sports competitions.
    </p>
  </section>
  <section class="sr-only" data-ai-block="process" aria-hidden="true">
    <p>
      Paddle Board Overstock's OEM/ODM process: (1) Specification & design brief, (2) 3D mold prototyping, (3) Material
      selection and sample production, (4) CE factory audit and compliance, (5) Bulk production with inline QC testing,
      (6) FOB Qingdao logistics and global shipping. MOQ starts at 5–10 units (SUP/kayak), 2–5 units (RIB). Custom mold:
      negotiable.
    </p>
  </section>

  <!-- Hero: Bright Ocean Pro v3 -->
  <section
    class="relative min-h-[90vh] flex items-center overflow-hidden"
    style="background: linear-gradient(135deg, #06b6d4, #22d3ee);"
  >
    <!-- Carousel background images -->
    {
      heroSlides.map((slide, _i) => (
        <div
          data-carousel-slide
          class="absolute inset-0 transition-opacity duration-700 ease-in-out {_i === 0 ? 'opacity-100' : 'opacity-0'}"
        >
          <img
            src={slide.image}
            alt={slide.label || 'Paddle Board Overstock workshop'}
            class="w-full h-full object-cover"
            width="1600"
            height="900"
            loading={_i === 0 ? 'eager' : 'lazy'}
            fetchpriority={_i === 0 ? 'high' : 'auto'}
          />
          <div
            class="absolute inset-0"
            style="background: linear-gradient(135deg, rgba(6,182,212,0.75), rgba(34,211,238,0.55));"
          />
        </div>
      ))
    }
    <!-- Wave animation SVG -->
    <div class="absolute bottom-0 left-0 right-0 h-24 md:h-32 z-10">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="w-full h-full">
        <path
          d="M0,40 C360,120 720,0 1080,80 C1260,120 1350,60 1440,40 L1440,120 L0,120 Z"
          fill="#f8fafc"
          opacity="0.15"></path>
        <path
          d="M0,60 C240,20 480,100 720,60 C960,20 1200,100 1440,60 L1440,120 L0,120 Z"
          fill="#f8fafc"
          opacity="0.1"
          style="animation: waveMove 6s ease-in-out infinite alternate;"></path>
      </svg>
    </div>
    <!-- Floating glow orbs -->
    <div class="absolute top-20 left-10 w-72 h-72 rounded-full bg-white/5 blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <div class="flex items-center gap-12">
        <div class="flex-1 text-center md:text-left">
          <div class="reveal">
            <span class="inline-block text-xs font-medium tracking-[0.2em] uppercase text-white/70 mb-4"
              >Your Water Adventure Business Partner · Qingdao · Since 2012</span
            >
            <h1
              class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.1] text-balance text-white drop-shadow-xl"
            >
              RIB Boats, Inflatable Boats <br class="hidden md:block" /> &amp; SUP Boards — OEM/ODM Manufacturer Since 2012
            </h1>
            <p class="mt-6 text-lg md:text-xl text-white/85 max-w-xl text-pretty leading-relaxed">
              <strong class="text-white font-semibold">Paddle Board Overstock</strong> — RIB boat, inflatable boat and SUP
              board manufacturer with full OEM/ODM capability.<br />
              From factory-direct production to complete solutions<br />
              for clubs, resorts and emerging brands. CE certified per applicable EU directives. Global shipping.
            </p>
            <div class="mt-10 flex items-center gap-4 flex-wrap justify-center md:justify-start">
              <a
                href="/solutions"
                class="inline-flex items-center gap-2 px-8 py-4 bg-[#fb923c] hover:bg-orange-600 text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5"
              >
                Start Your Water Business
                <span>→</span>
              </a>
              <a
                href="/business-packages"
                class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/40 text-white font-medium rounded-full hover:bg-white/10 transition-all backdrop-blur-sm"
              >
                View Business Packages
              </a>
              <a
                href="/contact"
                class="inline-flex items-center gap-2 px-6 py-3 border border-white/30 text-white/80 text-sm font-medium rounded-full hover:bg-white/10 transition-all backdrop-blur-sm"
              >
                Request OEM Quote
              </a>
            </div>
          </div>
        </div>
        <div class="hidden lg:block flex-1">
          <div class="relative">
            <img
              src="https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp"
              alt="SUP Ocean Voyager"
              class="w-full max-w-md mx-auto object-contain drop-shadow-2xl"
              style="filter: drop-shadow(0 20px 60px rgba(0,0,0,0.2)); animation: floatBoard 4s ease-in-out infinite;"
            />
          </div>
        </div>
      </div>
    </div>
    <!-- Carousel dots (kept for reference) -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3">
      {
        heroSlides.map((_, _i) => (
          <button
            data-carousel-dot
            class="w-2.5 h-2.5 rounded-full transition-all duration-300 border border-white/50 {_i === 0 ? 'bg-white scale-125' : 'bg-transparent'}"
          />
        ))
      }
    </div>
  </section>

  <!-- Quick Answer -->
  <section class="max-w-6xl mx-auto px-6 pt-8">
    <AiQuickAnswer
      quickAnswer="Paddle Board Overstock is a Chinese manufacturer of RIB boats, inflatable boats, and SUP boards. Founded in 2012 in Qingdao, China, the company runs ISO 9001:2015 certified production with full OEM/ODM capability, serving B2B buyers, brands, and professional operators across 50+ countries."
      facts={[
        { label: 'Industry', value: 'Marine Manufacturing' },
        { label: 'Products', value: 'RIB Boats, Inflatable Boats, SUP Boards' },
        { label: 'Applications', value: 'Tender, Fishing, Rescue, Rental Business' },
        { label: 'Manufacturing', value: 'OEM/ODM, CE & 15,000 units/year' },
      ]}
    />
  </section>

  <!-- Trust Bar - Certifications & Stats -->
  <section class="border-b border-gray-100 bg-white py-6 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-center justify-center gap-3 mb-4">
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-50 border border-green-200 rounded-full text-xs font-semibold text-green-700"
          >&#10003; CE Certified (TÜV Rheinland)</span
        >
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 border border-blue-200 rounded-full text-xs font-semibold text-blue-700"
          >&#10003; ISO 9001:2015 (SGS)</span
        >
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-purple-50 border border-purple-200 rounded-full text-xs font-semibold text-purple-700"
          >&#10003; BSCI Verified (Intertek)</span
        >
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-50 border border-amber-200 rounded-full text-xs font-semibold text-amber-700"
          >&#10003; UKCA Marked</span
        >
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-cyan-50 border border-cyan-200 rounded-full text-xs font-semibold text-cyan-700"
          >&#10003; REACH & RoHS</span
        >
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-rose-50 border border-rose-200 rounded-full text-xs font-semibold text-rose-700"
          >&#10003; 5-Year Boat Warranty</span
        >
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-1 text-xs text-gray-400">
        <span>12,000 m² Factory</span>
        <span>&middot;</span>
        <span>200-300 Workforce</span>
        <span>&middot;</span>
        <span>15,000 Annual Capacity</span>
        <span>&middot;</span>
        <span>50+ Countries Served</span>
        <span>&middot;</span>
        <span>99.3% Defect-Free Rate (per internal QC sampling, AQL 2.5)</span>
      </div>
    </div>
  </section>

