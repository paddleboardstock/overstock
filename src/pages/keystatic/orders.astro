---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { ORDER_STATUSES, SHIPMENT_STATUSES } from '../../../workers/shared/schema';
export const prerender = true;

const statuses = ORDER_STATUSES as readonly string[];
const shipmentStatuses = SHIPMENT_STATUSES as readonly string[];
---

<AdminLayout title="Shop Orders" active="orders">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <h1 class="text-xl font-bold">Shop Orders</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
        Stripe &amp; PayPal orders stored in Cloudflare D1. Webhooks keep payment status in sync.
      </p>
    </div>
    <a
      href="/api/admin/orders.csv"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md bg-green-600 hover:bg-green-700 text-white"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M7 10l5 5 5-5M12 15V3"></path></svg
      >
      Export CSV
    </a>
  </div>

  <div class="mb-4 flex flex-wrap gap-2" id="status-tabs">
    <button class="status-tab px-3 py-1.5 text-sm rounded-full border" data-status=""> All </button>
    {
      statuses.map((s) => (
        <button class="status-tab px-3 py-1.5 text-sm rounded-full border capitalize" data-status={s}>
          {s}
        </button>
      ))
    }
  </div>

  <div class="mb-4 text-sm text-gray-500 dark:text-gray-400">
    <span id="total-label">Loading…</span>
  </div>

  <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-800">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800 text-sm">
      <thead class="bg-gray-50 dark:bg-gray-900">
        <tr>
          <th class="px-4 py-3 text-left font-medium">Date</th>
          <th class="px-4 py-3 text-left font-medium">Order</th>
          <th class="px-4 py-3 text-left font-medium">Customer</th>
          <th class="px-4 py-3 text-left font-medium">Items</th>
          <th class="px-4 py-3 text-left font-medium">Total</th>
          <th class="px-4 py-3 text-left font-medium">Payment</th>
          <th class="px-4 py-3 text-left font-medium">Status</th>
          <th class="px-4 py-3 text-left font-medium">Actions</th>
        </tr>
      </thead>
      <tbody id="order-rows" class="divide-y divide-gray-200 dark:divide-gray-800">
        <tr>
          <td colspan="8" class="px-4 py-8 text-center text-gray-400">Loading…</td>
        </tr>
      </tbody>
    </table>
  </div>

  <script type="application/json" id="order-statuses" set:html={JSON.stringify(statuses)} />
  <script type="application/json" id="shipment-statuses" set:html={JSON.stringify(shipmentStatuses)} />

  <script is:inline>
    (function () {
      let status = '';
      var STATUSES = JSON.parse(document.getElementById('order-statuses').textContent);
      var SHIPMENT_STATUSES = JSON.parse(document.getElementById('shipment-statuses').textContent);

      function money(cents, currency) {
        try {
          return new Intl.NumberFormat('en-US', { style: 'currency', currency: currency || 'USD' }).format(cents / 100);
        } catch (e) {
          return '$' + (cents / 100).toFixed(2);
        }
      }

      function statusBadge(s) {
        const colors = {
          paid: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300',
          pending: 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-300',
          failed: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300',
          refunded: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300',
          cancelled: 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300',
        };
        return (
          '<span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold ' +
          (colors[s] || colors.pending) +
          '">' +
          s +
          '</span>'
        );
      }

      function shipmentBadge(s) {
        if (!s) return '';
        return (
          '<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-300 ml-1">' +
          s +
          '</span>'
        );
      }

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function detailRowHtml(r) {
        var ship = r.shipment || {};
        var statusOptions = STATUSES.map(function (s) {
          return '<option value="' + s + '"' + (s === r.status ? ' selected' : '') + '>' + s + '</option>';
        }).join('');
        var shipmentOptions = SHIPMENT_STATUSES.map(function (s) {
          return (
            '<option value="' + s + '"' + (s === (ship.status || 'pending') ? ' selected' : '') + '>' + s + '</option>'
          );
        }).join('');
        return (
          '<td colspan="8" class="px-4 py-4 bg-gray-50 dark:bg-gray-900/60">' +
          '<div class="grid gap-4 md:grid-cols-2">' +
          '<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-3 bg-white dark:bg-gray-900">' +
          '<div class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">Order status</div>' +
          '<div class="flex gap-2">' +
          '<select class="detail-status flex-1 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm">' +
          statusOptions +
          '</select>' +
          '<button class="detail-status-apply px-3 py-1.5 text-sm font-medium rounded-md bg-blue-600 hover:bg-blue-700 text-white">Apply</button>' +
          '</div>' +
          '<p class="text-xs text-gray-400 mt-2">Marking paid fulfils stock; cancelling a pending order releases its reservations.</p>' +
          '</div>' +
          '<div class="rounded-lg border border-gray-200 dark:border-gray-800 p-3 bg-white dark:bg-gray-900">' +
          '<div class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">Shipment</div>' +
          '<div class="grid grid-cols-2 gap-2 text-sm">' +
          '<input class="detail-carrier rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2 py-1.5 col-span-1" placeholder="Carrier (DHL…)" value="' +
          escapeHtml(ship.carrier || '') +
          '">' +
          '<input class="detail-tracking rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2 py-1.5 col-span-1" placeholder="Tracking #" value="' +
          escapeHtml(ship.trackingNumber || '') +
          '">' +
          '<input class="detail-tracking-url rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2 py-1.5 col-span-2" placeholder="Tracking URL (https://…)" value="' +
          escapeHtml(ship.trackingUrl || '') +
          '">' +
          '<select class="detail-shipment-status rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2 py-1.5 col-span-1">' +
          shipmentOptions +
          '</select>' +
          '<button class="detail-shipment-save col-span-1 px-3 py-1.5 text-sm font-medium rounded-md bg-blue-600 hover:bg-blue-700 text-white">Save Shipment</button>' +
          '</div>' +
          '</div>' +
          '</div>' +
          '</td>'
        );
      }

      async function load() {
        const tbody = document.getElementById('order-rows');
        tbody.innerHTML = '<tr><td colspan="8" class="px-4 py-8 text-center text-gray-400">Loading…</td></tr>';
        const params = new URLSearchParams();
        if (status) params.set('status', status);
        try {
          const res = await fetch('/api/admin/orders?' + params, { credentials: 'same-origin' });
          if (res.status === 401) {
            window.location.replace('/login');
            return;
          }
          if (!res.ok) throw new Error(await res.text());
          const data = await res.json();
          const rows = data.rows || [];
          const paidRevenue = data.paidRevenueCents || 0;
          document.getElementById('total-label').textContent =
            rows.length +
            ' orders · paid revenue ' +
            money(paidRevenue, 'USD') +
            ' · ' +
            (data.status === 'all' ? 'all statuses' : 'status: ' + data.status);

          if (rows.length === 0) {
            tbody.innerHTML =
              '<tr><td colspan="8" class="px-4 py-8 text-center text-gray-400">No orders yet.</td></tr>';
            return;
          }

          tbody.innerHTML = '';
          for (const r of rows) {
            const tr = document.createElement('tr');
            tr.setAttribute('data-order', JSON.stringify(r));
            const created = new Date(r.createdAt).toLocaleString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
            });
            const items = (r.items || [])
              .map(function (i) {
                return escapeHtml(i.title) + ' × ' + i.qty;
              })
              .join('<br>');
            var totalHtml = '<span class="font-semibold whitespace-nowrap">' + money(r.total, r.currency) + '</span>';
            if (r.discountCents > 0) {
              totalHtml +=
                '<div class="text-xs text-green-600 dark:text-green-400">' +
                escapeHtml(r.discountCode) +
                ' −' +
                money(r.discountCents, r.currency) +
                '</div>';
            }
            const cell = function (html, extraClass) {
              return '<td class="px-4 py-3 ' + (extraClass || '') + '">' + html + '</td>';
            };
            tr.innerHTML =
              cell('<span class="whitespace-nowrap">' + created + '</span>') +
              cell(
                '<span class="font-mono text-xs">' +
                  r.id.slice(0, 8) +
                  '</span><br>' +
                  '<span class="text-xs text-gray-400">' +
                  (r.provider || '') +
                  '</span>'
              ) +
              cell(
                '<div class="font-medium">' +
                  escapeHtml(r.email) +
                  '</div>' +
                  '<div class="text-xs text-gray-400">' +
                  escapeHtml(r.shippingName) +
                  '<br>' +
                  escapeHtml(r.shippingCity) +
                  ' ' +
                  escapeHtml(r.shippingPostal) +
                  ', ' +
                  escapeHtml(r.shippingCountry) +
                  '</div>'
              ) +
              cell(items) +
              cell(totalHtml) +
              cell(
                escapeHtml((r.provider || '') + (r.providerRef ? '<br>' : '')) +
                  (r.providerRef
                    ? '<span class="text-xs text-gray-400">' + escapeHtml(r.providerRef.slice(0, 24)) + '</span>'
                    : '')
              ) +
              cell(statusBadge(r.status) + shipmentBadge(r.shipment && r.shipment.status)) +
              cell(
                '<button class="manage-btn px-2 py-1 text-xs font-medium rounded-md border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800">Manage</button>'
              );
            tbody.appendChild(tr);

            const detail = document.createElement('tr');
            detail.className = 'detail-row hidden';
            detail.innerHTML = detailRowHtml(r);
            tbody.appendChild(detail);

            tr.querySelector('.manage-btn').addEventListener('click', function () {
              detail.classList.toggle('hidden');
            });

            detail.querySelector('.detail-status-apply').addEventListener('click', async function () {
              const newStatus = detail.querySelector('.detail-status').value;
              const res2 = await fetch('/api/admin/orders/status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ id: r.id, status: newStatus }),
              });
              const body = await res2.json();
              if (!res2.ok) {
                window.__adminToast(body.error || 'Failed to update status', 'error');
                return;
              }
              window.__adminToast('Status updated to ' + newStatus, 'success');
              load();
            });

            detail.querySelector('.detail-shipment-save').addEventListener('click', async function () {
              const res2 = await fetch('/api/admin/orders/shipment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({
                  orderId: r.id,
                  carrier: detail.querySelector('.detail-carrier').value,
                  trackingNumber: detail.querySelector('.detail-tracking').value,
                  trackingUrl: detail.querySelector('.detail-tracking-url').value,
                  status: detail.querySelector('.detail-shipment-status').value,
                }),
              });
              const body = await res2.json();
              if (!res2.ok) {
                window.__adminToast(body.error || 'Failed to save shipment', 'error');
                return;
              }
              window.__adminToast('Shipment saved', 'success');
              load();
            });
          }
        } catch (e) {
          tbody.innerHTML =
            '<tr><td colspan="8" class="px-4 py-8 text-center text-red-500">Failed to load orders.</td></tr>';
        }
      }

      document.querySelectorAll('.status-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
          status = tab.getAttribute('data-status') || '';
          document.querySelectorAll('.status-tab').forEach(function (t) {
            t.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
          });
          tab.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
          load();
        });
      });
      document.querySelector('.status-tab').classList.add('bg-blue-600', 'text-white', 'border-blue-600');

      load();
    })();
  </script>
</AdminLayout>
