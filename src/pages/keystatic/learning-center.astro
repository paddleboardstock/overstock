---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { readTokenFromCookies } from '~/lib/token-store';
import { GitHubClient } from '~/lib/github';
import { ADMIN_LOCALES, ADMIN_LOCALE_CODES, siteFileForLocale } from '~/lib/i18n-admin';
export const prerender = true;

const token = readTokenFromCookies(Astro.cookies);

const locale = (Astro.url.searchParams.get('locale') || 'en').toLowerCase();
const isDefault = locale === 'en';
const file = siteFileForLocale('src/data/site/learning-center.yaml', locale);

interface CardEntry {
  href: string;
  image: string;
  title: string;
}

const defaultCards: CardEntry[] = [
  {
    href: '/guides/how-to-choose-your-sup',
    image: 'https://assets.aquafarer.com/images/aquafarer/products/sup-series/sup-flowing-lotus-1.webp',
    title: 'How to Choose Your SUP',
  },
  {
    href: '/guides/beginner-guide',
    image: 'https://assets.aquafarer.com/images/aquafarer/use-cases/aquafarer-beginner-use-case.webp',
    title: "Beginner's Guide to Paddling",
  },
  {
    href: '/guides/inflatable-vs-hard',
    image: 'https://assets.aquafarer.com/images/aquafarer/products/sup-series/sup-tropical-breeze-1.webp',
    title: 'Inflatable vs Hard Board',
  },
  {
    href: '/guides/safety-tips',
    image: 'https://assets.aquafarer.com/images/aquafarer/products/aquafarer-life-vest-classic.webp',
    title: 'Water Safety Tips',
  },
];

let tagline = 'Learn';
let title = 'New to SUP?';
let subtitle = 'Everything you need to know before you hit the water.';
let cards: CardEntry[] = defaultCards.map((c) => ({ ...c }));
let sha = '';
let loadError: string | null = null;

if (token) {
  try {
    const client = new GitHubClient(token);
    let f: { sha: string; content: string; downloadUrl: string } | undefined;
    try {
      f = await client.readFile(file, 'draft');
    } catch {
      try {
        f = await client.readFile(file);
      } catch {
        if (!isDefault) {
          f = await client.readFile('src/data/site/learning-center.yaml');
        }
      }
    }
    if (f) {
      const { load } = await import('js-yaml');
      const parsed = load(f.content) as Record<string, any>;
      if (parsed) {
        tagline = typeof parsed.tagline === 'string' ? parsed.tagline : tagline;
        title = typeof parsed.title === 'string' ? parsed.title : title;
        subtitle = typeof parsed.subtitle === 'string' ? parsed.subtitle : subtitle;
        if (parsed.cards && Array.isArray(parsed.cards)) {
          cards = parsed.cards.map((item: any, i: number) => ({
            href: item.href || defaultCards[i]?.href || '',
            image: item.image || defaultCards[i]?.image || '',
            title: item.title || defaultCards[i]?.title || '',
          }));
        }
      }
      sha = f.sha;
    }
  } catch (err) {
    loadError = err instanceof Error ? err.message : 'Failed to read';
  }
}
---

<AdminLayout title="Learning Center" active="learning">
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-semibold">Learning Center</h1>
    </div>
    <div class="flex items-center gap-2">
      <label class="text-xs text-gray-500">Locale:</label>
      <select
        id="locale-select"
        class="px-3 py-1.5 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm"
      >
        {
          ADMIN_LOCALE_CODES.map((l) => (
            <option value={l} selected={l === locale}>
              {ADMIN_LOCALES[l]}
            </option>
          ))
        }
      </select>
    </div>
  </div>
  <p class="mt-1 text-sm text-gray-500">
    File: <code class="font-mono">{file}</code>
    {!isDefault && <span class="text-amber-600 dark:text-amber-400"> — locale override</span>}
  </p>

  {
    loadError && (
      <div class="mb-4 rounded-md border border-red-200 bg-red-50 dark:bg-red-950/40 dark:border-red-900 p-3 text-sm text-red-700 dark:text-red-300">
        Failed to read: {loadError}
      </div>
    )
  }

  <form
    id="learn-form"
    class="space-y-6 pb-32"
    data-file={file}
    data-sha={sha}
    data-locale={locale}
    onsubmit="arguments[0].preventDefault()"
  >
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 space-y-4">
      <h2 class="text-base font-semibold">Section Headings</h2>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tagline</label>
        <input
          type="text"
          name="tagline"
          value={tagline}
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Title</label>
        <input
          type="text"
          name="title"
          value={title}
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Subtitle</label>
        <input
          type="text"
          name="subtitle"
          value={subtitle}
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm"
        />
      </div>
    </div>

    {
      cards.map((card, i) => (
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 space-y-4">
          <h2 class="text-base font-semibold">Card #{i + 1}</h2>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Link URL</label>
            <input
              type="text"
              name={'c' + i + '.href'}
              value={card.href}
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm font-mono"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Background Image URL</label>
            <input
              type="text"
              name={'c' + i + '.image'}
              value={card.image}
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm font-mono"
            />
            {card.image && card.image.trim() && (
              <div
                class="mt-2 h-16 w-32 rounded bg-cover bg-center border border-gray-200"
                style={"background-image: url('" + card.image + "')"}
              />
            )}
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Title</label>
            <input
              type="text"
              name={'c' + i + '.title'}
              value={card.title}
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm"
            />
          </div>
        </div>
      ))
    }

    <div
      class="fixed bottom-0 left-0 right-0 bg-white dark:bg-gray-950 border-t border-gray-200 dark:border-gray-800 z-40"
    >
      <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between gap-4">
        <div class="text-xs text-gray-500">File: <code class="font-mono">{file}</code></div>
        <div class="flex gap-2">
          <a href="/keystatic" class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 hover:underline"
            >Cancel</a
          >
          <button
            id="save-draft-btn"
            type="button"
            class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md">Save Draft</button
          >
          <button
            id="publish-btn"
            type="button"
            class="px-5 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-md">Publish</button
          >
        </div>
      </div>
    </div>
  </form>

  <script is:inline>
    (function () {
      const form = document.getElementById('learn-form');
      if (!form) return;
      const saveBtn = document.getElementById('save-draft-btn');
      const publishBtn = document.getElementById('publish-btn');
      const file = form.dataset.file;
      let sha = form.dataset.sha;

      const localeSelect = document.getElementById('locale-select');
      localeSelect?.addEventListener('change', () => {
        const loc = localeSelect.value;
        const base = window.location.pathname;
        window.location.href = loc === 'en' ? base : base + '?locale=' + loc;
      });

      function collectData() {
        const fd = new FormData(form);
        const cards = [];
        for (let i = 0; i < 4; i++) {
          cards.push({
            href: String(fd.get('c' + i + '.href') || '').trim(),
            image: String(fd.get('c' + i + '.image') || '').trim(),
            title: String(fd.get('c' + i + '.title') || '').trim(),
          });
        }
        return {
          tagline: String(fd.get('tagline') || '').trim(),
          title: String(fd.get('title') || '').trim(),
          subtitle: String(fd.get('subtitle') || '').trim(),
          cards,
        };
      }

      saveBtn?.addEventListener('click', async () => {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        try {
          const data = collectData();
          const res = await fetch('/api/admin/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              format: 'yaml',
              path: file,
              sha,
              data,
              branch: 'draft',
              commitMessage: 'Draft: Update learning center',
            }),
          });
          const result = await res.json();
          if (!res.ok || !result.success) {
            window.__adminToast?.(result.error || 'Save failed', 'error');
            return;
          }
          if (result?.content?.sha) {
            sha = result.content.sha;
            form.dataset.sha = sha;
          }
          window.__adminToast?.('Draft saved', 'success');
        } catch {
          window.__adminToast?.('Network error', 'error');
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Draft';
        }
      });

      publishBtn?.addEventListener('click', async () => {
        publishBtn.disabled = true;
        publishBtn.textContent = 'Publishing...';
        try {
          const data = collectData();
          const res = await fetch('/api/admin/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ format: 'yaml', path: file, sha, data, commitMessage: 'Update learning center' }),
          });
          const result = await res.json();
          if (!res.ok || !result.success) {
            window.__adminToast?.(result.error || 'Publish failed', 'error');
            return;
          }
          window.__adminToast?.('Published, Cloudflare is redeploying...', 'success');
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } catch {
          window.__adminToast?.('Network error', 'error');
        } finally {
          publishBtn.disabled = false;
          publishBtn.textContent = 'Publish';
        }
      });
    })();
  </script>
</AdminLayout>
