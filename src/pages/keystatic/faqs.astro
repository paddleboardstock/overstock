---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { readTokenFromCookies } from '~/lib/token-store';
import { GitHubClient } from '~/lib/github';
import { ADMIN_LOCALES, ADMIN_LOCALE_CODES, siteFileForLocale } from '~/lib/i18n-admin';
export const prerender = true;

const token = readTokenFromCookies(Astro.cookies);

const locale = (Astro.url.searchParams.get('locale') || 'en').toLowerCase();
const isDefault = locale === 'en';
const file = siteFileForLocale('src/data/site/faqs.yaml', locale);

interface FaqEntry {
  q: string;
  a: string;
}

const defaultFaqs: FaqEntry[] = [
  {
    q: 'Is SUP hard to learn?',
    a: 'Not at all. Most beginners stand up and paddle within their first session. Our All-Around SUP series features extra-wide stable platforms designed specifically for first-time paddlers. Start on calm water and you will be cruising in minutes.',
  },
  {
    q: 'Can I use it in the ocean?',
    a: 'Yes. Paddle Board Overstock SUP boards are built for ocean, lake, and river use. Our Touring series handles coastal chop, and all boards use marine-grade PVC that resists saltwater corrosion. Rinse with fresh water after ocean use.',
  },
  {
    q: 'How long does it take to inflate?',
    a: 'With the included dual-action pump, most boards inflate to 12-15 PSI in under 5 minutes. Our electric pump option cuts that to under 2 minutes. Deflation and packing take about 3 minutes.',
  },
  {
    q: 'Can I travel with an inflatable SUP?',
    a: "Absolutely. Every Paddle Board Overstock board packs into a backpack-sized carrying case. At just 18-22 lbs, it is easy to carry to the beach, lake, or through airport terminals. Check your airline's baggage policy before travel.",
  },
  {
    q: 'What is the weight limit?',
    a: 'Our All-Around SUPs support up to 220 lbs. The Touring and Yoga series support up to 250 lbs. For tandem use or heavier loads, our Kayak and Dinghy products offer higher capacity options.',
  },
  {
    q: 'What comes in the box?',
    a: 'Every Paddle Board Overstock SUP includes the board, a travel backpack, dual-action hand pump, removable fin, coil leash, and repair kit. Some models also include a carbon paddle upgrade option.',
  },
  {
    q: 'Do you offer bundle deals?',
    a: 'Yes. We offer curated bundles like the Explorer Starter Pack and Family Fun Pack that save you up to $198 compared to buying items separately. Browse all bundles at the Bundle Deals page.',
  },
];

let faqs: FaqEntry[] = defaultFaqs.map((f) => ({ ...f }));
let sha = '';
let loadError: string | null = null;

if (token) {
  try {
    const client = new GitHubClient(token);
    let f: { sha: string; content: string; downloadUrl: string } | undefined;
    try {
      f = await client.readFile(file, 'draft');
    } catch {
      try {
        f = await client.readFile(file);
      } catch {
        if (!isDefault) {
          f = await client.readFile('src/data/site/faqs.yaml');
        }
      }
    }
    if (f) {
      const { load } = await import('js-yaml');
      const parsed = load(f.content) as Record<string, any>;
      if (parsed?.faqs && Array.isArray(parsed.faqs)) {
        faqs = parsed.faqs.map((item: any, i: number) => ({
          q: item.q || defaultFaqs[i]?.q || '',
          a: item.a || defaultFaqs[i]?.a || '',
        }));
      }
      sha = f.sha;
    }
  } catch (err) {
    loadError = err instanceof Error ? err.message : 'Failed to read';
  }
}
---

<AdminLayout title="FAQs" active="faqs">
  <div class="mb-6">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl font-semibold">Homepage FAQs</h1>
      </div>
      <div class="flex items-center gap-2">
        <label class="text-xs text-gray-500">Locale:</label>
        <select
          id="locale-select"
          class="px-3 py-1.5 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm"
        >
          {
            ADMIN_LOCALE_CODES.map((l) => (
              <option value={l} selected={l === locale}>
                {ADMIN_LOCALES[l]}
              </option>
            ))
          }
        </select>
      </div>
    </div>
    <p class="mt-1 text-sm text-gray-500">
      File: <code class="font-mono">{file}</code>
      {!isDefault && <span class="text-amber-600 dark:text-amber-400"> — locale override</span>}
    </p>
  </div>

  {
    loadError && (
      <div class="mb-4 rounded-md border border-red-200 bg-red-50 dark:bg-red-950/40 dark:border-red-900 p-3 text-sm text-red-700 dark:text-red-300">
        Failed to read: {loadError}
      </div>
    )
  }

  <form
    id="faqs-form"
    class="space-y-6 pb-32"
    data-file={file}
    data-sha={sha}
    data-locale={locale}
    onsubmit="arguments[0].preventDefault()"
  >
    {
      faqs.map((item, i) => (
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 space-y-4">
          <h2 class="text-base font-semibold">FAQ #{i + 1}</h2>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Question</label>
            <input
              type="text"
              name={'faq' + i + '.q'}
              value={item.q}
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Answer</label>
            <textarea
              name={'faq' + i + '.a'}
              rows="4"
              class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-900 text-sm"
            >
              {item.a}
            </textarea>
          </div>
        </div>
      ))
    }

    <div
      class="fixed bottom-0 left-0 right-0 bg-white dark:bg-gray-950 border-t border-gray-200 dark:border-gray-800 z-40"
    >
      <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between gap-4">
        <div class="text-xs text-gray-500">File: <code class="font-mono">{file}</code></div>
        <div class="flex gap-2">
          <a href="/keystatic" class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 hover:underline"
            >Cancel</a
          >
          <button
            id="save-draft-btn"
            type="button"
            class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md">Save Draft</button
          >
          <button
            id="publish-btn"
            type="button"
            class="px-5 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-md">Publish</button
          >
        </div>
      </div>
    </div>
  </form>

  <script is:inline>
    (function () {
      const localeSelect = document.getElementById('locale-select');
      localeSelect?.addEventListener('change', () => {
        const loc = localeSelect.value;
        const base = window.location.pathname;
        window.location.href = loc === 'en' ? base : base + '?locale=' + loc;
      });

      const form = document.getElementById('faqs-form');
      if (!form) return;
      const saveBtn = document.getElementById('save-draft-btn');
      const publishBtn = document.getElementById('publish-btn');
      const file = form.dataset.file;
      let sha = form.dataset.sha;

      function collectData() {
        const fd = new FormData(form);
        const faqs = [];
        for (let i = 0; i < 7; i++) {
          faqs.push({
            q: String(fd.get('faq' + i + '.q') || '').trim(),
            a: String(fd.get('faq' + i + '.a') || '').trim(),
          });
        }
        return { faqs };
      }

      saveBtn?.addEventListener('click', async () => {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        try {
          const data = collectData();
          const res = await fetch('/api/admin/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              format: 'yaml',
              path: file,
              sha,
              data,
              branch: 'draft',
              commitMessage: 'Draft: Update homepage FAQs',
            }),
          });
          const result = await res.json();
          if (!res.ok || !result.success) {
            window.__adminToast?.(result.error || 'Save failed', 'error');
            return;
          }
          if (result?.content?.sha) {
            sha = result.content.sha;
            form.dataset.sha = sha;
          }
          window.__adminToast?.('Draft saved', 'success');
        } catch {
          window.__adminToast?.('Network error', 'error');
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Draft';
        }
      });

      publishBtn?.addEventListener('click', async () => {
        publishBtn.disabled = true;
        publishBtn.textContent = 'Publishing...';
        try {
          const data = collectData();
          const res = await fetch('/api/admin/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ format: 'yaml', path: file, sha, data, commitMessage: 'Update homepage FAQs' }),
          });
          const result = await res.json();
          if (!res.ok || !result.success) {
            window.__adminToast?.(result.error || 'Publish failed', 'error');
            return;
          }
          window.__adminToast?.('Published, Cloudflare is redeploying...', 'success');
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } catch {
          window.__adminToast?.('Network error', 'error');
        } finally {
          publishBtn.disabled = false;
          publishBtn.textContent = 'Publish';
        }
      });
    })();
  </script>
</AdminLayout>
