---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Wholesale Stock Catalog — ${SITE.name}`,
  description:
    'Live overstock paddle board inventory with wholesale B2B pricing. Sign in with an approved account to browse current sizes, colors, quantities and prices.',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <main class="min-h-[70vh] px-4 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-sm font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-2">B2B Wholesale</p>
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">Wholesale Stock Catalog</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-3 max-w-2xl mx-auto">
          Our current overstock paddle board inventory with wholesale prices. Access is limited to approved wholesale
          accounts — register or sign in, and we will enable your catalog access after a quick review.
        </p>
      </div>

      <!-- Access gate states -->
      <div id="gate-loading" class="text-center text-gray-500 dark:text-gray-400 py-16">
        <div
          class="inline-block w-8 h-8 border-2 border-sky-600 border-t-transparent rounded-full animate-spin"
          role="status"
          aria-label="Loading"
        >
        </div>
        <p class="mt-4">Checking your access…</p>
      </div>

      <div
        id="gate-signin"
        class="hidden mx-auto max-w-lg bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700 p-8 text-center"
      >
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Sign in to view the catalog</h2>
        <p class="text-gray-500 dark:text-gray-400 mt-2 text-sm">
          The stock catalog shows live quantities and wholesale prices (bare board, USD, excl. freight). Prices are
          visible to approved wholesale accounts only.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center mt-6">
          <a
            href="/login?redirect=/wholesale-stock"
            class="py-2.5 px-6 bg-sky-600 hover:bg-sky-700 text-white font-medium rounded-lg transition"
          >
            Sign in
          </a>
          <a
            href="/register?redirect=/wholesale-stock"
            class="py-2.5 px-6 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-200 font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition"
          >
            Create an account
          </a>
        </div>
        <p class="text-xs text-gray-400 mt-5">
          New wholesale accounts are reviewed manually. After registering, contact us to speed up access.
        </p>
      </div>

      <div
        id="gate-pending"
        class="hidden mx-auto max-w-lg bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700 p-8 text-center"
      >
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Catalog access pending</h2>
        <p class="text-gray-500 dark:text-gray-400 mt-2 text-sm">
          You are signed in, but your account does not have wholesale catalog access yet. We review each wholesale
          account manually — send us a short message with your company details and we will enable it right away.
        </p>
        <a
          href="/contact/?subject=Wholesale%20catalog%20access"
          class="inline-block mt-6 py-2.5 px-6 bg-sky-600 hover:bg-sky-700 text-white font-medium rounded-lg transition"
        >
          Contact us to enable access
        </a>
      </div>

      <div
        id="gate-error"
        class="hidden mx-auto max-w-lg text-center bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-lg p-4"
      >
        <p>Could not load the stock catalog. Please refresh the page or contact us if the problem persists.</p>
      </div>

      <!-- Catalog (client-rendered after auth + whitelist check) -->
      <div id="catalog" class="hidden">
        <div id="catalog-content"></div>
        <div class="mt-12 text-center">
          <p class="text-gray-500 dark:text-gray-400 text-sm">
            Prices are per bare board in USD, excluding freight and accessories. Quantities are per color variant.
          </p>
          <a
            href="/contact/?subject=Wholesale%20order"
            class="inline-block mt-4 py-2.5 px-8 bg-sky-600 hover:bg-sky-700 text-white font-medium rounded-lg transition"
          >
            Request a quote
          </a>
        </div>
      </div>
    </div>
  </main>

  <script>
    interface CatalogItem {
      id: string;
      dimensions: string;
      dimsCm: number[];
      priceUsd: number;
      quantity: number;
      note: string;
      images: string[];
    }

    interface CatalogSection {
      id: string;
      title: string;
      priceUpdated: string;
      items: CatalogItem[];
    }

    interface StockCatalog {
      currency: string;
      updatedAt: string;
      sections: CatalogSection[];
    }

    function show(id: string): void {
      document.getElementById(id)?.classList.remove('hidden');
    }

    function hide(id: string): void {
      document.getElementById(id)?.classList.add('hidden');
    }

    function escapeHtml(s: string): string {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function fmtDims(dimsCm: number[]): string {
      return `${dimsCm.join(' × ')} cm`;
    }

    function fmtPrice(priceUsd: number): string {
      return `$${priceUsd.toLocaleString('en-US')}`;
    }

    function renderCatalog(catalog: StockCatalog): void {
      const container = document.getElementById('catalog-content');
      if (!container) return;
      const parts: string[] = [];
      for (const section of catalog.sections) {
        parts.push(`
        <section class="mb-14">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-6 border-b border-gray-200 dark:border-gray-700 pb-3">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">${escapeHtml(section.title)}</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">Prices updated ${escapeHtml(section.priceUpdated)}</p>
          </div>`);

        // Group variants (same dimensions + price) so color options read as one product.
        const groups: { key: string; dimsCm: number[]; priceUsd: number; items: CatalogItem[] }[] = [];
        const groupByKey = new Map<string, (typeof groups)[number]>();
        for (const item of section.items) {
          const key = `${item.dimensions}|${item.priceUsd}`;
          let group = groupByKey.get(key);
          if (!group) {
            group = { key, dimsCm: item.dimsCm, priceUsd: item.priceUsd, items: [] };
            groupByKey.set(key, group);
            groups.push(group);
          }
          group.items.push(item);
        }

        for (const group of groups) {
          const totalQty = group.items.reduce((sum, it) => sum + it.quantity, 0);
          const variantsLabel = group.items.length > 1 ? `${group.items.length} color variants` : '1 color';
          parts.push(`
          <div class="mb-8">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">${fmtDims(group.dimsCm)}</h3>
              <span class="text-lg font-bold text-sky-700 dark:text-sky-400">${fmtPrice(group.priceUsd)} <span class="text-xs font-normal text-gray-500">USD / board</span></span>
              <span class="text-xs text-gray-500 dark:text-gray-400">${variantsLabel} · ${totalQty.toLocaleString('en-US')} pcs in stock</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">`);
          for (const item of group.items) {
            const img = item.images[0] || '';
            const extra = item.images.slice(1);
            parts.push(`
              <figure class="rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden bg-white dark:bg-gray-800">
                ${img ? `<img src="${escapeHtml(img)}" alt="${escapeHtml(fmtDims(item.dimsCm))} paddle board" loading="lazy" class="w-full aspect-square object-cover" width="900" height="900" />` : ''}
                <figcaption class="p-3 text-xs text-gray-500 dark:text-gray-400 space-y-1">
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">${escapeHtml(item.note) || 'Bare board'}</div>
                  <div>Qty: ${item.quantity.toLocaleString('en-US')} pcs</div>
                  <div>Item ${escapeHtml(item.id)}</div>
                  ${extra.length ? `<div class="flex gap-1 pt-1">${extra.map((e) => `<img src="${escapeHtml(e)}" alt="" loading="lazy" class="w-10 h-10 object-cover rounded border border-gray-200 dark:border-gray-600" />`).join('')}</div>` : ''}
                </figcaption>
              </figure>`);
          }
          parts.push(`
            </div>
          </div>`);
        }
        parts.push(`</section>`);
      }
      container.innerHTML = parts.join('');
      hide('gate-loading');
      show('catalog');
    }

    async function boot(): Promise<void> {
      let signedIn: boolean;
      try {
        const res = await fetch('/api/auth/get-session', { credentials: 'same-origin' });
        const data = await res.json();
        signedIn = Boolean(data?.user || data?.session?.user);
      } catch {
        signedIn = false;
      }
      if (!signedIn) {
        hide('gate-loading');
        show('gate-signin');
        return;
      }
      let res: Response;
      try {
        res = await fetch('/api/stock-catalog', { credentials: 'same-origin' });
      } catch {
        hide('gate-loading');
        show('gate-error');
        return;
      }
      if (res.status === 401) {
        hide('gate-loading');
        show('gate-signin');
        return;
      }
      if (res.status === 403) {
        hide('gate-loading');
        show('gate-pending');
        return;
      }
      if (!res.ok) {
        hide('gate-loading');
        show('gate-error');
        return;
      }
      const catalog = (await res.json()) as StockCatalog;
      renderCatalog(catalog);
    }

    boot();
  </script>
</Layout>
