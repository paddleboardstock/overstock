---
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/engineering-capability.ts';
import { localizePageTitle } from '~/i18n/page-title';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'engineering-capability');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const capability = page.content_capability ?? {};
const process = page.content_process ?? {};
const stages = process.stages ?? [];
const customization = page.content_customization ?? {};
const industries = page.content_industries ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));

const metadata = {
  title: localizePageTitle(
    page,
    `Engineering & Product Development — ${SITE.name} | OEM/ODM RIB Design & Manufacturing`
  ),
  description:
    'Aquafarer engineering team: 25+ R&D engineers, 78+ years combined experience, 40+ product platforms, 1,200+ OEM projects. Full-spectrum product development from concept to production.',
};
const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: 'Engineering' }];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What engineering capabilities does Aquafarer have?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '3D CAD design, CNC mold engineering, RF welding, hand gluing, Drop-Stitch lamination, and prototype production in-house.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can Aquafarer develop custom products?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Full custom engineering from concept sketches to production-ready prototypes with 25+ engineers averaging 7+ years experience.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the prototyping process?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '3D CAD (3-5 days) to CNC mold (7-14 days) to prototype production (7-14 days) to 1.25x pressure testing and quality verification.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />
  <Stats title={stats.title} stats={stats.stats} />

  {
    capability.items?.length > 0 && (
      <section class="px-6 py-16 mx-auto max-w-6xl">
        <div class="text-center mb-10">
          <span class="text-sm font-semibold text-sky-600 uppercase tracking-wider">{capability.tagline}</span>
          <h2 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{capability.title}</h2>
          {capability.subtitle && (
            <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-3xl mx-auto">{capability.subtitle}</p>
          )}
        </div>
        <div class="space-y-8">
          {capability.items.map((item: any) => (
            <div class="p-6 md:p-8 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">{item.title}</h3>
              <p class="mt-3 text-gray-600 dark:text-gray-400 leading-relaxed">{item.description}</p>
              {item.features?.length > 0 && (
                <ul class="mt-4 grid md:grid-cols-2 gap-2">
                  {item.features.map((f: string) => (
                    <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                      <span class="text-sky-500 mt-0.5">•</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    stages.length > 0 && (
      <section class="px-6 py-16 mx-auto max-w-6xl bg-gray-50 dark:bg-gray-900/50">
        <div class="text-center mb-10">
          <span class="text-sm font-semibold text-sky-600 uppercase tracking-wider">{process.tagline}</span>
          <h2 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{process.title}</h2>
          {process.subtitle && (
            <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-3xl mx-auto">{process.subtitle}</p>
          )}
        </div>
        <div class="space-y-6">
          {stages.map((s: any) => (
            <div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
              <div class="flex items-start gap-4">
                <span class="w-12 h-12 rounded-lg bg-sky-600 text-white flex items-center justify-center font-bold text-lg flex-shrink-0">
                  {s.stage}
                </span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 flex-wrap">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">{s.title}</h3>
                    {s.duration && (
                      <span class="text-xs px-2 py-0.5 bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400 rounded-full font-medium">
                        {s.duration}
                      </span>
                    )}
                  </div>
                  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{s.description}</p>
                  {s.deliverables && (
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-500">
                      <span class="font-medium">Deliverables:</span> {s.deliverables}
                    </p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    customization.items?.length > 0 && (
      <Features3
        tagline={customization.tagline}
        title={customization.title}
        subtitle={customization.subtitle}
        columns={customization.columns}
        items={customization.items}
      />
    )
  }

  {
    industries.items?.length > 0 && (
      <Features3
        tagline={industries.tagline}
        title={industries.title}
        subtitle={industries.subtitle}
        columns={industries.columns}
        items={industries.items}
      />
    )
  }

  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />

  <JsonLd
    type="Service"
    service={{
      name: 'Aquafarer Engineering & Product Development',
      description:
        'Full-spectrum product engineering for RIB boats, inflatable watercraft, and water sports equipment. From concept design to mass production.',
      serviceType: 'Product Engineering',
      areaServed: ['Global'],
      url: `/${lang}/engineering-capability`,
      items: [
        { name: 'Industrial Design', description: 'Concept development, 3D rendering, DFM analysis' },
        { name: 'Structural Engineering', description: 'Hull design, tube configuration, drop-stitch engineering' },
        { name: 'Prototyping', description: 'Rapid prototype tooling, functional samples, iterative refinement' },
        { name: 'Custom Manufacturing', description: 'Custom colors, graphics, consoles, seating, accessories' },
      ],
    }}
  />
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
