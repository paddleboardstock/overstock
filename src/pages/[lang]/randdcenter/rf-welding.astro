const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is RF welding?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Radio Frequency welding uses electromagnetic energy to fuse PVC molecules at the molecular level, creating seams that are often stronger than the base material.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is RF welding better than hand gluing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'RF welding produces more consistent, stronger seams on PVC materials. Hand gluing is required for Hypalon/CSM which cannot be RF welded.',
      },
    },
    {
      '@type': 'Question',
      name: 'How are welds tested?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Peel testing (measuring force to separate), backlight seam inspection (detecting voids), and weld width verification per ISO standards.',
      },
    },
    {
      '@type': 'Question',
      name: 'What materials can be RF welded?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Marine-grade PVC (0.9-1.2mm), Drop-Stitch core fabrics, and EVA deck pad materials. Hypalon/CSM requires hand gluing.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the weld strength compared to base material?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Properly executed RF welds achieve 90-100% of the base material tensile strength, making the seam as strong as the surrounding material.',
      },
    },
  ],
});
