    {
      de: RDe,
      es: REs,
      fr: RFr,
      it: RIt,
      cs: RCs,
      sv: RSv,
      da: RDa,
      el: REl,
      no: RNo,
      ru: RRu,
      nl: RNl,
      fi: RFi,
      pl: RPl,
      ar: RAr,
