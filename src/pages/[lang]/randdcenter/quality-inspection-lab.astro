const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: 'R&D Center', href: `/${lang}/randdcenter` },
  { name: 'Quality & Inspection Lab' },
];

const meta = META[lang] || META.en;

const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
};

const RanddBody: any =
  (
    {
      de: RDe,
      es: REs,
      fr: RFr,
      it: RIt,
      cs: RCs,
      sv: RSv,
      da: RDa,
      el: REl,
      no: RNo,
      ru: RRu,
      nl: RNl,
      fi: RFi,
      pl: RPl,
      ar: RAr,
      pt: RPt,
      ja: RJa,
      bg: RBg,
      et: REt,
      he: RHe,
      hr: RHr,
      hu: RHu,
      id: RId,
      ko: RKo,
      lt: RLt,
      lv: RLv,
      ms: RMs,
      ro: RRo,
      sk: RSk,
      sl: RSl,
      sr: RSr,
      th: RTh,
      tl: RTl,
      tr: RTr,
    } as Record<string, any>
  )[lang] || REn;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What testing does the quality inspection lab perform?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Tensile strength, tear resistance, UV aging (ASTM G154), abrasion (ASTM D751), cold crack (ISO 4646), and pressure hold testing at 1.25x rated.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is the lab independent from production?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The quality lab operates independently from production and reports directly to management. No batch ships without signed quality release.',
      },
    },
    {
      '@type': 'Question',
      name: 'What standards does the lab follow?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 9001:2015 quality management, ASTM G154 UV testing, ASTM D751 abrasion, ISO 6185 buoyancy, ISO 2859/AQL 2.5 sampling.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the defect-free rate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '99.3% defect-free rate per AQL 2.5 / ISO 2859 statistical sampling methodology.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I request test reports?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Material test reports, pressure test logs, and QC certificates are available upon request for OEM/ODM partners.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  {RanddBody && <RanddBody lang={lang} />}
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
