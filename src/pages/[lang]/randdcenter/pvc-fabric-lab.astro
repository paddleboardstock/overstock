const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: 'R&D Center', href: `/${lang}/randdcenter` },
  { name: 'PVC Fabric Lab' },
];

const meta = META[lang] || META.en;

const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
};

const RanddBody: any =
  (
    {
      de: RDe,
      es: REs,
      fr: RFr,
      it: RIt,
      cs: RCs,
      sv: RSv,
      da: RDa,
      el: REl,
      no: RNo,
      ru: RRu,
      nl: RNl,
      fi: RFi,
      pl: RPl,
      ar: RAr,
      pt: RPt,
      ja: RJa,
      bg: RBg,
      et: REt,
      he: RHe,
      hr: RHr,
      hu: RHu,
      id: RId,
      ko: RKo,
      lt: RLt,
      lv: RLv,
      ms: RMs,
      ro: RRo,
      sk: RSk,
      sl: RSl,
      sr: RSr,
      th: RTh,
      tl: RTl,
      tr: RTr,
    } as Record<string, any>
  )[lang] || REn;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What PVC testing is performed?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Tensile strength (N/5cm), tear resistance, coating adhesion, UV stability (ASTM G154), cold crack resistance (ISO 4646), and coating weight verification.',
      },
    },
    {
      '@type': 'Question',
      name: 'What PVC grades does Aquafarer use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '0.9mm PVC (1,100 DTEX) for standard models, 1.2mm PVC (1,680 DTEX) for premium/commercial, and custom specifications for OEM orders.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are materials REACH compliant?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. All PVC and adhesive materials comply with EU REACH regulation. Material safety data sheets available upon request.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is UV resistance tested?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Per ASTM G154 accelerated weathering standard — concentrated UV exposure simulating years of sunlight, measuring tensile strength retention.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the cold crack test?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Per ISO 4646, materials are tested at -20°C to verify flexibility and seam integrity in cold conditions.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  {RanddBody && <RanddBody lang={lang} />}
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
