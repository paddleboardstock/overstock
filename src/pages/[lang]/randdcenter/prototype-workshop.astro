const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: 'R&D Center', href: `/${lang}/randdcenter` },
  { name: 'Prototype Workshop' },
];

const meta = META[lang] || META.en;

const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
};

const RanddBody: any =
  (
    {
      de: RDe,
      es: REs,
      fr: RFr,
      it: RIt,
      cs: RCs,
      sv: RSv,
      da: RDa,
      el: REl,
      no: RNo,
      ru: RRu,
      nl: RNl,
      fi: RFi,
      pl: RPl,
      ar: RAr,
      pt: RPt,
      ja: RJa,
      bg: RBg,
      et: REt,
      he: RHe,
      hr: RHr,
      hu: RHu,
      id: RId,
      ko: RKo,
      lt: RLt,
      lv: RLv,
      ms: RMs,
      ro: RRo,
      sk: RSk,
      sl: RSl,
      sr: RSr,
      th: RTh,
      tl: RTl,
      tr: RTr,
    } as Record<string, any>
  )[lang] || REn;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does prototype production take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '7-14 working days after design approval for standard prototypes. Rush samples available at 5-7 days for an additional fee.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I request a custom prototype?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Share your target specs, reference product, or concept. Our engineering team develops CAD drawings and produces pre-production samples for your approval.',
      },
    },
    {
      '@type': 'Question',
      name: 'What testing do prototypes undergo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '1.25x rated pressure hold for 24-48h, seam peel testing, dimensional verification, and full 100-point quality checklist.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the cost of a prototype?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Prototype pricing depends on complexity and materials. Sample costs are often credited toward production orders. Contact us for a specific quote.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I get samples in my brand colors?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Pre-production samples include your brand colors, logo placement, and specified materials for full approval before production.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  {RanddBody && <RanddBody lang={lang} />}
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
