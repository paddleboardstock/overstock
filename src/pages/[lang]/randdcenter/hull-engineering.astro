const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: 'R&D Center', href: `/${lang}/randdcenter` },
  { name: 'Hull Engineering Studio' },
];

const meta = META[lang] || META.en;

const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
};

const RanddBody: any =
  (
    {
      de: RDe,
      es: REs,
      fr: RFr,
      it: RIt,
      cs: RCs,
      sv: RSv,
      da: RDa,
      el: REl,
      no: RNo,
      ru: RRu,
      nl: RNl,
      fi: RFi,
      pl: RPl,
      ar: RAr,
      pt: RPt,
      ja: RJa,
      bg: RBg,
      et: REt,
      he: RHe,
      hr: RHr,
      hu: RHu,
      id: RId,
      ko: RKo,
      lt: RLt,
      lv: RLv,
      ms: RMs,
      ro: RRo,
      sk: RSk,
      sl: RSl,
      sr: RSr,
      th: RTh,
      tl: RTl,
      tr: RTr,
    } as Record<string, any>
  )[lang] || REn;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What hull designs does Aquafarer offer?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Planing hulls for RIB boats, displacement hulls for kayaks, flat/wide platforms for SUP boards, and V-hull configurations for performance RIBs.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I get a custom hull design?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our engineering team develops custom hull shapes using 3D CAD and produces CNC-machined aluminum molds for precision.',
      },
    },
    {
      '@type': 'Question',
      name: 'What CAD formats are available?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'PDF GA drawings (free), DXF/DWG (light form), STEP/IGES (project application). See the Technical Drawings page for details.',
      },
    },
    {
      '@type': 'Question',
      name: 'How are hulls tested?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hydrostatic pressure testing, stability testing per ISO 12217, and buoyancy verification per ISO 6185 before production approval.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the typical design-to-mold timeline?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '3-5 days for 3D CAD modeling, 7-14 days for CNC mold machining, 3-5 days for prototype production and testing.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  {RanddBody && <RanddBody lang={lang} />}
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
