const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: 'R&D Center', href: `/${lang}/randdcenter` },
  { name: 'Hydrodynamic Test Tank' },
];

const meta = META[lang] || META.en;

const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
};

const RanddBody: any =
  (
    {
      de: RDe,
      es: REs,
      fr: RFr,
      it: RIt,
      cs: RCs,
      sv: RSv,
      da: RDa,
      el: REl,
      no: RNo,
      ru: RRu,
      nl: RNl,
      fi: RFi,
      pl: RPl,
      ar: RAr,
      pt: RPt,
      ja: RJa,
      bg: RBg,
      et: REt,
      he: RHe,
      hr: RHr,
      hu: RHu,
      id: RId,
      ko: RKo,
      lt: RLt,
      lv: RLv,
      ms: RMs,
      ro: RRo,
      sk: RSk,
      sl: RSl,
      sr: RSr,
      th: RTh,
      tl: RTl,
      tr: RTr,
    } as Record<string, any>
  )[lang] || REn;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What hydrodynamic testing is performed?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hull efficiency testing, stability verification per ISO 12217, buoyancy testing per ISO 6185, and maneuverability assessment under various load conditions.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this testing required for CE certification?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Stability and buoyancy testing per ISO 12217 and ISO 6185 are required for CE certification of recreational craft per 2013/53/EU.',
      },
    },
    {
      '@type': 'Question',
      name: 'What size vessels can be tested?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Testing covers all Aquafarer product sizes from 8ft dinghies to 22ft RIB boats, and SUP boards from 9ft to 15ft.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are test results documented?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. All test results are documented, traceable, and retained for 10 years. Available for OEM partners upon NDA.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can third-party testing be arranged?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We accommodate SGS, BV, TÜV, and other third-party inspection agencies for independent verification.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  {RanddBody && <RanddBody lang={lang} />}
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
