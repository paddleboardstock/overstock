export const prerender = true;

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: any) => getUiForLang(lang || defaultLang)?.[key] || '';

