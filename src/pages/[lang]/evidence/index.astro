---
const PAGE_META: Record<string, { title: string }> = {
  de: { title: 'Nachweise & Belege' },
  es: { title: 'Evidencia y pruebas' },
  fr: { title: 'Preuves et justifications' },
  it: { title: 'Prove e verifiche' },
  pt: { title: 'Evidências e provas' },
  ar: { title: 'الأدلة والإثباتات' },
  ru: { title: 'Доказательства и подтверждения' },
  pl: { title: 'Dowody i potwierdzenia' },
  nl: { title: 'Bewijzen en onderbouwing' },
  th: { title: 'หลักฐานและการพิสูจน์' },
  tr: { title: 'Kanıtlar ve Belgeler' },
  id: { title: 'Bukti & Verifikasi' },
  hu: { title: 'Bizonyítékok és igazolások' },
  ro: { title: 'Dovezi și verificări' },
  bg: { title: 'Доказателства и проверки' },
  ms: { title: 'Bukti & Pengesahan' },
  tl: { title: 'Ebidensya at Patunay' },
};
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { pageContentData } from '~/i18n/generated/site-data';

interface CaseStudy {
  id: string;
  client: string;
  product: string;
  industry: string;
  challenge: string;
  solution: string;
  result: string;
  image: string;
  tags: string[];
  outcome_metrics: { label: string; value: string }[];
}

interface TestResult {
  metric: string;
  value: string;
  detail: string;
}
interface SpecSheet {
  name: string;
  href: string;
}
interface DeploymentPhoto {
  image: string;
  caption: string;
  context: string;
}

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const d = pageContentData[`${lang}/site-evidence`] || pageContentData['en/site-evidence'] || {};
const caseStudies: CaseStudy[] = d.case_studies ?? [];
const testResults: TestResult[] = d.test_results ?? [];
const specSheets: SpecSheet[] = d.spec_sheets ?? [];
const deploymentPhotos: DeploymentPhoto[] = d.deployment_photos ?? [];

const metadata = {
  title: PAGE_META[lang]?.title || `Evidence & Proof | ${SITE.name}`,
  description:
    t('home.evidence.subtitle') ||
    'Real quality stories, test data, and factory photos that show how every clearance board ships at retail-grade quality.',
  ignoreTitleTemplate: true,
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What evidence supports Paddle Board Overstock quality claims?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '99.3% defect-free rate on outgoing shipments, 100% pressure testing with a 24-48h hold at 1.25x rated pressure, and 2-year warranty coverage.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I review test reports?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Material test reports, pressure test logs, and QC reports are available on request.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are third-party inspections accepted?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Independent third-party inspectors are welcome at our Weihai facility.',
      },
    },
  ],
});
---

<Layout metadata={metadata}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: 'Evidence & Proof',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Paddle Board Overstock Product Test Results',
      description:
        'Quality control test results for inflatable SUP boards including pressure testing, defect thresholds, and safety margins.',
      about: 'Marine Equipment Quality Testing',
      measurementTechnique: '24-48h pressure hold at 1.25x rated pressure',
      variableMeasured: testResults.map((t) => t.metric),
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />

  <div class="max-w-6xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={`/${lang}/`} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('home.evidence.title')}</span>
    </nav>

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{t('home.evidence.tagline')}</span>
      <h1 class="mt-4 text-4xl font-bold text-gray-900">{t('home.evidence.title')}</h1>
      <p class="mt-4 text-lg text-gray-500">
        {
          t('home.evidence.subtitle') ||
            'Real quality stories, test data, and factory photos that show how every clearance board ships at retail-grade quality.'
        }
      </p>
    </div>

    <!-- Case Studies -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">{t('home.evidence.caseStudies')}</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {
          caseStudies.map((cs) => (
            <a
              href={`/${lang}/evidence/case-studies/${cs.id}`}
              class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-0.5 flex flex-col"
            >
              <div class="h-48 bg-gray-100 overflow-hidden">
                <img
                  src={cs.image}
                  alt={cs.product}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full">
                    {cs.industry}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 group-hover:text-sky-700 transition-colors mb-2">
                  {cs.client}
                </h3>
                <p class="text-sm text-gray-500 mb-1">{cs.product}</p>
                <p class="text-xs text-gray-400 line-clamp-3 mt-1">{cs.challenge}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {cs.outcome_metrics.slice(0, 3).map((m) => (
                    <span class="text-xs bg-gray-50 border border-gray-200 rounded-lg px-2 py-1">
                      <strong class="text-gray-900">{m.value}</strong>
                      <span class="text-gray-500"> {m.label}</span>
                    </span>
                  ))}
                </div>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-sky-700">
                  {t('home.evidence.read')}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Test Results -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">{t('home.evidence.testResults')}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          testResults.map((tr) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-sky-600 mb-2">{tr.value}</div>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">{tr.metric}</h3>
              <p class="text-xs text-gray-500">{tr.detail}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Spec Sheets -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">{t('product.specifications')}</h2>
      <div class="grid md:grid-cols-4 gap-4">
        {
          specSheets.map((s) => (
            <a
              href={`/${lang}${s.href}`}
              class="bg-white border border-gray-200 rounded-2xl p-6 text-center hover:shadow-md transition-all hover:-translate-y-0.5 group"
            >
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-sky-600 transition-colors">{s.name}</h3>
              <span class="mt-2 inline-block text-xs font-medium text-sky-600">
                {t('product.specifications')} &rarr;
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Deployment Gallery -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">{t('home.evidence.deployment')}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          deploymentPhotos.map((p) => (
            <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden group">
              <div class="h-48 bg-gray-100 overflow-hidden">
                <img
                  src={p.image}
                  alt={p.caption}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-4">
                <p class="text-xs text-gray-500 mb-1">{p.caption}</p>
                <span class="text-xs font-medium text-sky-600">{p.context}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-sky-600 to-blue-700 rounded-2xl p-10 text-center text-white">
      <h2 class="text-2xl font-bold mb-3">{t('home.evidence.ctaTitle')}</h2>
      <p class="text-sky-100 max-w-xl mx-auto mb-6">
        {t('home.evidence.ctaDesc') || 'Contact our team for detailed test reports and case study references.'}
      </p>
      <a
        href={`/${lang}/contact`}
        class="inline-block bg-white text-sky-700 font-semibold px-8 py-3 rounded-xl hover:bg-sky-50 transition-colors"
        >{t('home.evidence.ctaButton')}</a
      >
    </section>
  </div>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
