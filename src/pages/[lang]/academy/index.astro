---
const PAGE_DESC: Record<string, { description: string }> = {
  de: {
    description:
      'Ratgeber und Tutorials für jedes Könnensniveau — von SUP-Grundlagen bis zu fortgeschrittenen Rettungstechniken. Lernen Sie in Ihrem eigenen Tempo mit der Paddle Board Overstock Academy.',
  },
  es: {
    description:
      'Guías y tutoriales para todos los niveles — desde los fundamentos del SUP hasta técnicas avanzadas de rescate. Aprenda a su ritmo con Paddle Board Overstock Academy.',
  },
  fr: {
    description:
      'Guides et tutoriels pour tous les niveaux — des bases du SUP aux techniques avancées de sauvetage. Apprenez à votre rythme avec Paddle Board Overstock Academy.',
  },
  it: {
    description:
      'Guide e tutorial per ogni livello di abilità: dalle basi del SUP alle tecniche di soccorso avanzate. Impara al tuo ritmo con Paddle Board Overstock Academy.',
  },
  cs: {
    description:
      'Příručky a výukové programy pro každou úroveň dovedností – od základů SUP po pokročilé záchranné techniky. Učte se svým vlastním tempem s Paddle Board Overstock Academy.',
  },
  sv: {
    description:
      'Guider och handledningar för alla färdighetsnivåer — från SUP grunderna till avancerade räddningstekniker. Lär dig i din egen takt med Paddle Board Overstock Academy.',
  },
  da: {
    description:
      'Guider og tutorials for alle færdighedsniveauer - fra SUP grundlæggende til avancerede redningsteknikker. Lær i dit eget tempo med Paddle Board Overstock Academy.',
  },
  el: {
    description:
      'Οδηγοί και σεμινάρια για κάθε επίπεδο δεξιοτήτων — από SUP βασικά έως προηγμένες τεχνικές διάσωσης. Μάθετε με τον δικό σας ρυθμό με το Paddle Board Overstock Academy.',
  },
  no: {
    description:
      'Veiledninger og opplæringsprogrammer for alle ferdighetsnivåer – fra SUP grunnleggende til avanserte redningsteknikker. Lær i ditt eget tempo med Paddle Board Overstock Academy.',
  },
  ru: {
    description:
      'Руководства и учебные пособия для любого уровня навыков — от основ SUP до продвинутых методов спасения. Учитесь в удобном для вас темпе с Paddle Board Overstock Academy.',
  },
  nl: {
    description:
      'Gidsen en tutorials voor elk vaardigheidsniveau — van SUP basis tot geavanceerde reddingstechnieken. Leer in je eigen tempo met de Paddle Board Overstock Academy.',
  },
  fi: {
    description:
      'Oppaita ja opetusohjelmia jokaiselle taitotasolle – SUP-perusasioista edistyneisiin pelastustekniikoihin. Opi omaan tahtiisi Paddle Board Overstock Academyn avulla.',
  },
  pl: {
    description:
      'Przewodniki i samouczki na każdym poziomie umiejętności — od podstaw SUP po zaawansowane techniki ratownicze. Ucz się we własnym tempie z Paddle Board Overstock Academy.',
  },
  ar: {
    description:
      'أدلة وبرامج تعليمية لكل مستوى من مستويات المهارة — بدءًا من أساسيات SUP وحتى تقنيات الإنقاذ المتقدمة. تعلم بالسرعة التي تناسبك مع أكاديمية Paddle Board Overstock.',
  },
  pt: {
    description:
      'Guias e tutoriais para todos os níveis de habilidade — desde o básico do SUP até técnicas avançadas de resgate. Aprenda no seu próprio ritmo com a Paddle Board Overstock Academy.',
  },
  ja: {
    description:
      'SUP の基本から高度な救助技術まで、あらゆるスキル レベルに対応したガイドとチュートリアル。 Paddle Board Overstock アカデミーで自分のペースで学びましょう。',
  },
};
const PAGE_META: Record<string, { title: string }> = {
  de: { title: 'Akademie' },
  es: { title: 'Academia' },
  fr: { title: 'Académie' },
  it: { title: 'Accademia' },
  pt: { title: 'Academia' },
  ar: { title: 'الأكاديمية' },
  ru: { title: 'Академия' },
  pl: { title: 'Akademia' },
  nl: { title: 'Academie' },
  sv: { title: 'Akademin' },
  no: { title: 'Akademiet' },
  el: { title: 'Ακαδημία' },
  fi: { title: 'Akatemia' },
  da: { title: 'Akademiet' },
  cs: { title: 'akademie' },
  ja: { title: 'アカデミー' },
};
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import { V2_CONVERGED_SLUGS } from '~/utils/v2-converged';
import __pageData from '~/i18n/generated/pages/academy.ts';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'academy') || {};
const hero = page.hero || {};
const categories = (page.categories || []).map((cat: any) => ({
  ...cat,
  guides: (cat.guides || []).filter((g: any) => !V2_CONVERGED_SLUGS.has(g.slug)),
}));
const cta = page.cta || {};
const knowledgeSections = page.knowledge_sections || [];
const kcTagline = page.knowledge_center_tagline || 'Knowledge Center';
const kcTitle = page.knowledge_center_title || 'Marine Equipment & Industry Guides';
const kcSubtitle =
  page.knowledge_center_subtitle ||
  'Expert knowledge and buying guides for marine professionals, fleet operators, and water sports enthusiasts.';

const metadata = {
  title: t('academy.metaTitle') || PAGE_META[lang]?.title || 'Learning Center — Paddle Board Overstock Academy',
  description:
    t('academy.metaDesc') ||
    PAGE_DESC[lang]?.description ||
    'Guides and tutorials for every skill level — from SUP basics to advanced rescue techniques. Learn at your own pace with Paddle Board Overstock Academy.',
};

const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: t('academy.title') || 'Academy' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-6 sm:px-6 py-16 sm:py-20 lg:py-24 mx-auto max-w-5xl text-center">
    <p class="text-sm font-semibold text-primary uppercase tracking-wider">{hero.tagline}</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">{hero.title}</h1>
    <p class="mt-3 text-lg text-muted">{hero.subtitle}</p>
  </section>

  {
    knowledgeSections.length > 0 && (
      <section class="px-6 sm:px-6 pb-8 mx-auto max-w-6xl">
        <div class="mb-8">
          <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider">{kcTagline}</span>
          <h2 class="mt-1 text-3xl font-bold text-gray-900">{kcTitle}</h2>
          <p class="mt-2 text-gray-500">{kcSubtitle}</p>
        </div>
        {knowledgeSections.map((sec: any) => (
          <section class="mb-12" data-ai-block="knowledge-section">
            <div class="flex items-center gap-3 mb-4">
              <h3 class="text-xl font-bold text-gray-900">{sec.title}</h3>
              <span class="text-xs text-sky-600 font-medium uppercase tracking-wider">{sec.tagline}</span>
            </div>
            <p class="text-sm text-gray-500 mb-5 max-w-3xl">{sec.desc}</p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {sec.guides.map((g: any) => (
                <a
                  href={`/${lang}${g.href}`}
                  class="group block bg-white border border-gray-200 rounded-xl p-5 hover:shadow-md hover:border-sky-200 transition-all hover:-translate-y-0.5"
                >
                  <h4 class="font-semibold text-gray-900 group-hover:text-sky-600 transition-colors text-sm">
                    {g.title}
                  </h4>
                  <p class="mt-2 text-xs text-gray-500 leading-relaxed line-clamp-3">{g.desc}</p>
                  <span class="mt-3 inline-flex text-xs font-medium text-sky-600 group-hover:text-sky-700">
                    {page.read_guide}
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </section>
    )
  }
  {
    categories.length > 0 && (
      <section class="px-6 sm:px-6 pb-4 mx-auto max-w-6xl">
        <div class="mb-8">
          <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider">
            {t('academy.skillPaths') || 'Skill Paths'}
          </span>
          <h2 class="mt-1 text-3xl font-bold text-gray-900">
            {hero.title || t('academy.learningCenter') || 'Learning Center'}
          </h2>
          <p class="mt-2 text-gray-500">
            {hero.subtitle ||
              t('academy.learningCenterDesc') ||
              'Step-by-step guides and tutorials organized by skill level — from SUP basics to advanced rescue techniques.'}
          </p>
        </div>
      </section>
    )
  }

  {
    categories.map((cat: any) => (
      <section class="px-6 sm:px-6 pb-16 mx-auto max-w-6xl" data-ai-block="learning-category">
        <div class="flex items-center gap-4 mb-8">
          <div
            class={`h-10 w-10 rounded-lg bg-gradient-to-br ${cat.color} flex items-center justify-center text-white font-bold text-sm`}
          >
            {cat.level.charAt(0)}
          </div>
          <div>
            <span class={`text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded ${cat.badge}`}>
              {cat.level}
            </span>
            <h2 class="mt-1 text-2xl font-bold text-gray-900">
              {cat.level} {t('academy.guides') || 'Guides'}
            </h2>
          </div>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {cat.guides.map((g: any) => (
            <a
              href={`/${lang}/v2/${g.slug}`}
              class="group block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
            >
              <h3 class="font-semibold text-gray-900 group-hover:text-sky-600 transition-colors">{g.title}</h3>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{g.desc}</p>
              <span class="mt-4 inline-flex text-sm font-medium text-sky-600 group-hover:text-sky-700">
                {page.read_guide}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <section class="px-6 sm:px-6 py-20 mx-auto max-w-4xl text-center">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
      <h2 class="text-xl font-bold">{cta.title}</h2>
      <p class="mt-2 text-sm text-muted">{cta.desc}</p>
      <a
        href={`/${lang}${cta.link || '/contact'}`}
        class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
      >
        {cta.label}
      </a>
    </div>
  </section>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Paddle Board Overstock Academy — Learning Center',
      description: 'Guides and tutorials for every skill level from SUP basics to advanced rescue techniques.',
      url: `https://paddleboardoverstock.com/${lang}/academy`,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: categories.flatMap((cat: any) =>
          cat.guides.map((g: any, i: any) => ({
            '@type': 'ListItem',
            position: i + 1,
            item: {
              '@type': 'Article',
              headline: g.title,
              description: g.desc,
              url: `https://paddleboardoverstock.com/${lang}/v2/${g.slug}`,
            },
          }))
        ),
      },
    })}
  />
</Layout>
