---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';

import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getLocalizedProducts } from '~/utils/product-i18n';
import { pageContentData } from '~/i18n/generated/site-data';
import { urlSlugToCategory, CATEGORY_SLUG_TO_URL } from '~/utils/products';
import { breadcrumbNode, collectionNode } from '~/utils/schema-graph';
import type { MetaData } from '~/types';

export async function getStaticPaths() {
  const slugs = Object.values(CATEGORY_SLUG_TO_URL);
  const paths: Array<{ params: { lang: string; category: string } }> = [];
  Object.keys(languages).forEach((lang) => {
    slugs.forEach((slug) => {
      paths.push({ params: { lang, category: slug } });
    });
  });
  return paths;
}

const { lang = defaultLang, category: urlSlug } = Astro.params;
const activeCategory = urlSlugToCategory(urlSlug || '')!;

if (!activeCategory) {
  Astro.redirect('/' + lang + '/404');
}

const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
const categoryKey = (cat: string) =>
  ({
    SUP: 'sups',
    ACCESSORY: 'accessories',
    sup: 'sups',
    accessory: 'accessories',
  })[cat] || cat.toLowerCase();

const localizedProducts = getLocalizedProducts(lang!);
const filteredProducts = localizedProducts.filter((p) => p.category.toLowerCase() === activeCategory);

const defaultVisuals: Record<string, string> = {
  'sup-explorer-11':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-sup-allround-board.webp',
  'oars-pump-set':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-electric-pump.webp',
};
const rawVisuals = ((
  pageContentData[`${lang}/site-product-visuals`] ||
  pageContentData['en/site-product-visuals'] ||
  {}
)?.visuals || []) as Array<{ id: string; image: string }>;
const yamlVisuals = Object.fromEntries(rawVisuals.map((v) => [v.id, v.image]).filter(([, img]) => img));
const productVisuals: Record<string, string> = { ...defaultVisuals, ...yamlVisuals };

const categories = [...new Set(localizedProducts.map((p) => p.category))].filter(
  (cat) => CATEGORY_SLUG_TO_URL[cat.toLowerCase() as keyof typeof CATEGORY_SLUG_TO_URL]
);

const pageLabel = t('home.category.' + categoryKey(activeCategory)) || urlSlug;

const metadata: MetaData = {
  title: `${pageLabel} — ${SITE.name}`,
  description: t('product.pageDesc') || `Browse ${SITE.name} ${pageLabel} products.`,
};

const catalogUrl = `/${lang}/${urlSlug}/`;
const categoryGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    ...collectionNode({
      path: catalogUrl,
      name: `Paddle Board Overstock ${pageLabel}`,
      description: t('product.pageDesc') || `Browse ${SITE.name} ${pageLabel} products.`,
      items: filteredProducts.map((p) => ({
        name: p.name,
        path: `/${lang}/products/${p.id}/`,
        ...(productVisuals[p.id] ? { image: productVisuals[p.id] } : {}),
      })),
    }),
    breadcrumbNode([
      { name: t('nav.home') || 'Home', path: `/${lang}/` },
      { name: pageLabel, path: catalogUrl },
    ]),
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(categoryGraph)} />
  <section class="max-w-6xl mx-auto py-24 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{t('product.catalog')}</span>
      <h1 class="mt-4 text-4xl font-semibold text-gray-900 capitalize">
        Paddle Board Overstock {t('home.category.' + categoryKey(activeCategory)) || urlSlug}
      </h1>
      <p class="mt-4 text-lg text-gray-500">Premium {pageLabel} — {t('product.pageDesc')}</p>
    </div>

    {
      categories.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-2 mb-4">
          <a
            href={`/${lang}/products`}
            class:list={[
              'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold border transition-colors',
              'bg-white border-gray-200 text-gray-600 hover:bg-gray-50',
            ]}
          >
            {t('product.all') || 'All'} ({localizedProducts.length})
          </a>
          {categories.map((cat) => {
            const catUrl = CATEGORY_SLUG_TO_URL[cat.toLowerCase() as keyof typeof CATEGORY_SLUG_TO_URL];
            return (
              <a
                href={`/${lang}/${catUrl}`}
                class:list={[
                  'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold border transition-colors',
                  activeCategory === cat.toLowerCase()
                    ? 'bg-gray-900 text-white border-gray-900'
                    : 'bg-white border-gray-200 text-gray-600 hover:bg-gray-50',
                ]}
              >
                {t('home.category.' + categoryKey(cat)) || cat}(
                {localizedProducts.filter((p) => p.category === cat).length})
              </a>
            );
          })}
        </div>
      )
    }

    {
      activeCategory === 'sup' && (
        <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
          <a
            href="/catalogs/paddleboardoverstock-sup-catalog.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-sky-50 border border-sky-200 text-sky-700 text-sm font-medium rounded-full hover:bg-sky-100 transition-colors"
          >
            <Icon name="tabler:download" class="w-4 h-4" />
            {t('product.downloadSupCatalog')}
          </a>
        </div>
      )
    }

    {
      filteredProducts.length === 0 ? (
        <div class="text-center py-16 text-gray-400">
          <p class="text-lg">{t('product.noResults') || 'No products in this category.'}</p>
          <a href={`/${lang}/products`} class="text-sky-600 hover:underline mt-2 inline-block">
            {t('product.viewAll') || 'View all products'}
          </a>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="product-grid">
          {filteredProducts.map((p) => {
            return (
              <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 hover:shadow-md transition-shadow product-card">
                <a
                  href={`/${lang}/products/${p.id}`}
                  class="block aspect-[3/4] bg-gradient-to-br from-gray-100 to-gray-200 relative overflow-hidden group"
                >
                  {productVisuals[p.id] ? (
                    <img
                      src={productVisuals[p.id]}
                      alt={p.name}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex items-center justify-center h-full text-gray-400 text-sm">
                      {t('home.category.' + categoryKey(p.category)) || p.category}
                    </div>
                  )}
                </a>
                <div class="p-6">
                  <h3 class="font-semibold text-gray-900 text-lg">{p.name}</h3>
                  <p class="text-gray-500 mt-2 text-sm">{p.desc}</p>
                  <div class="mt-4 space-y-2">
                    <a
                      href={`/${lang}/contact?product=${encodeURIComponent(p.name)}`}
                      class="block text-center px-4 py-2.5 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary/90 transition-colors"
                    >
                      {t('product.requestQuote') || 'Request Factory Quote'}
                    </a>
                    <a
                      href={`/${lang}/contact?product=${encodeURIComponent(p.name)}&custom=1`}
                      class="block text-center px-4 py-2 border border-primary text-primary text-sm font-medium rounded-lg hover:bg-primary/5 transition-colors"
                    >
                      {t('product.oemDetails') || 'Get Product Details'}
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>{SITE.name} {t('product.catalog')} — {pageLabel}.</p>
  </section>
</Layout>
