---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/learn-content.ts';

export function getStaticPaths() {
  const slugs = [
    'sup',
    'inflatable-boat',
    'water-safety',
    'sup-basics',
    'drop-stitch-core',
    'inflatable-technology',
    'intermediate-techniques',
    'materials',
    'safety-in-water-sports',
    'sup-size-guide',
  ];
  const paths: Array<{ params: { lang: string; slug: string } }> = [];
  for (const lang of Object.keys(languages)) {
    for (const slug of slugs) {
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
setPageContentData(__pageData);
const content = getPageContent(lang || defaultLang, 'learn-content');

