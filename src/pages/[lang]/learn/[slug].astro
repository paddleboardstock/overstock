const page = LEARN_PAGES[slug];
const pageMeta = LEARN_META[lang]?.[slug];
const pageTitle = pageMeta ? pageMeta.title : t('learn.' + slug + '.title') || page.title;
const pageDesc = pageMeta ? pageMeta.description : t('learn.' + slug + '.description') || page.description;
const artL10n = content.articles?.[slug];
const lArticles = (page.articles || []).map((a, idx) => ({
  ...a,
  title: artL10n?.[idx]?.title || a.title,
  desc: artL10n?.[idx]?.desc || a.desc,
  href: a.href.startsWith('/guides/')
    ? `/${lang}${a.href}`
    : a.href.startsWith('/learn/')
      ? `/${lang}${a.href}`
      : a.href.startsWith('/') && !a.href.startsWith('//')
        ? `/${lang}${a.href}`
        : a.href,
}));
const readGuide = content.ui?.read_guide || 'Read guide →';
const cardTech = content.ui?.card_tech || 'Safety engineering and material testing';
const cardProducts = content.ui?.card_products || 'Explore the full Paddle Board Overstock product catalog';
const cardTrust = content.ui?.card_trust || 'Factory-tested quality with a 2-year warranty';
const mat = slug === 'materials' ? content.materials : undefined;
const MATERIAL_IMAGES = [
  'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/tech/tech-pvc-material.webp',
  'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/tech/tech-drop-stitch.webp',
  'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-medusa-glow-1.webp',
];
const TOPIC_HREFS = [
  '/v2/how-to-choose-inflatable-sup',
  '/factory/process',
  '/learn/drop-stitch-core',
  '/learn/inflatable-technology',
  '/v2/sup-pump-guide',
  '/quality',
  '/learn/sup-size-guide',
  '/v2/inflatable-sup-storage',
];
const deepDive: Array<{ title: string; desc: string; href: string }> = (mat?.deep_dive?.topics || []).map(
  (tp: { title: string; desc: string }, i: number) => ({
    title: tp.title,
    desc: tp.desc,
    href: `/${lang}${TOPIC_HREFS[i] || TOPIC_HREFS[0]}`,
  })
);

const metadata = {
  title: pageTitle,
  description: pageDesc,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    type="BreadcrumbList"
    breadcrumbs={[
      { name: t('nav.home') || 'Home', href: `/${lang}` },
      { name: t('nav.learn') || 'Learn', href: `/${lang}/knowledge` },
      { name: pageTitle },
    ]}
  />

  <section class="max-w-5xl mx-auto px-6 pt-24 pb-4" data-ai-block="definition">
    <h1 class="text-4xl font-semibold text-gray-900 dark:text-slate-100">{pageTitle}</h1>
    <p class="mt-4 text-lg text-gray-500 dark:text-slate-400 max-w-3xl">{pageDesc}</p>

    {
      lArticles.length > 0 && (
        <div class="mt-16 grid md:grid-cols-2 gap-6">
          {lArticles.map((a) => (
            <a
              href={a.href}
              class="group block p-6 rounded-2xl border border-gray-200 dark:border-slate-700 hover:shadow-lg hover:border-sky-300 dark:hover:border-sky-600 transition-all"
            >
              <h2 class="font-semibold text-gray-900 dark:text-slate-100 group-hover:text-sky-600 transition-colors">
                {a.title}
              </h2>
              <p class="mt-2 text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{a.desc}</p>
              <span class="mt-3 inline-block text-sm font-medium text-sky-600">{readGuide}</span>
            </a>
          ))}
        </div>
      )
    }
  </section>

  {
    slug === 'materials' && mat && (
      <>
        <section class="px-6 pb-8 max-w-5xl mx-auto">
          <div class="prose prose-gray dark:prose-invert max-w-none">
            <p class="text-lg leading-relaxed">{mat.intro_p1}</p>
            <p class="text-lg leading-relaxed">{mat.intro_p2}</p>
          </div>
        </section>

        <section class="px-6 pb-16 max-w-5xl mx-auto space-y-16">
          {mat.items.map((m: any, i: number) => (
            <div class="grid md:grid-cols-2 gap-8 items-start">
              <div class={i % 2 === 1 ? 'md:order-2' : ''}>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-slate-100">{m.name}</h2>
                <p class="mt-3 text-gray-600 dark:text-slate-300 leading-relaxed">{m.summary}</p>
                <div class="mt-4 grid grid-cols-2 gap-4">
                  <div>
                    <h4 class="text-sm font-semibold text-green-700 uppercase tracking-wide">
                      {mat.labels.advantages}
                    </h4>
                    <ul class="mt-2 space-y-1">
                      {m.pros.map((pro: string) => (
                        <li class="text-sm text-gray-600 dark:text-slate-300 flex items-start gap-1.5">
                          <span class="text-green-500 mt-0.5 shrink-0">+</span>
                          {pro}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="text-sm font-semibold text-red-600 uppercase tracking-wide">{mat.labels.limitations}</h4>
                    <ul class="mt-2 space-y-1">
                      {m.cons.map((con: string) => (
                        <li class="text-sm text-gray-600 dark:text-slate-300 flex items-start gap-1.5">
                          <span class="text-red-400 mt-0.5 shrink-0">-</span>
                          {con}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                <p class="mt-4 text-sm text-gray-500 dark:text-slate-400">
                  <strong class="text-gray-700 dark:text-slate-200">{mat.labels.best_for}</strong> {m.best_for}
                </p>
              </div>
              <div class={i % 2 === 1 ? 'md:order-1' : ''}>
                <img
                  src={MATERIAL_IMAGES[i]}
                  alt={m.name}
                  class="w-full rounded-xl"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </div>
            </div>
          ))}
        </section>

        <section class="px-6 pb-16 max-w-5xl mx-auto">
          <div class="rounded-xl bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700 p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-slate-100 text-center">{mat.selection.title}</h2>
            <p class="mt-3 text-gray-600 dark:text-slate-300 text-center max-w-2xl mx-auto">{mat.selection.subtitle}</p>
            <div class="mt-8 overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-gray-300 dark:border-slate-600">
                    {mat.selection.headers.map((h: string) => (
                      <th class="text-left py-3 px-4 font-semibold text-gray-900 dark:text-slate-100">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {mat.selection.rows.map((row: string[]) => (
                    <tr class="border-b border-gray-200 dark:border-slate-700">
                      <td class="py-3 px-4 text-gray-700 dark:text-slate-300">{row[0]}</td>
                      <td class="py-3 px-4">
                        <span class="font-medium text-gray-900 dark:text-slate-100">{row[1]}</span>
                      </td>
                      <td class="py-3 px-4 text-gray-600 dark:text-slate-300">{row[2]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="px-6 pb-20 max-w-6xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-slate-100 text-center mb-10">{mat.deep_dive.title}</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {deepDive.map((tp) => (
              <a
                href={tp.href}
                class="group block bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
              >
                <h3 class="font-semibold text-gray-900 dark:text-slate-100 group-hover:text-sky-600 transition-colors">
                  {tp.title}
                </h3>
                <p class="mt-2 text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{tp.desc}</p>
                <span class="mt-4 inline-flex text-sm font-medium text-sky-600 group-hover:text-sky-700">
                  {readGuide}
                </span>
              </a>
            ))}
          </div>
        </section>
      </>
    )
  }

  <section class="max-w-5xl mx-auto px-6 pb-16">
    <div class="grid md:grid-cols-3 gap-4 text-sm">
      <a
        href={`/${lang}/technology`}
        class="block p-4 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-sky-300 dark:hover:border-sky-600 transition"
      >
        <span class="font-medium text-sky-600">{t('nav.technology') || 'Technology'}</span>
        <p class="mt-1 text-gray-500 dark:text-slate-400">
          {cardTech}
        </p>
      </a>
      <a
        href={`/${lang}/products`}
        class="block p-4 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-sky-300 dark:hover:border-sky-600 transition"
      >
        <span class="font-medium text-sky-600">{t('product.pageTitle') || 'Products'}</span>
        <p class="mt-1 text-gray-500 dark:text-slate-400">
          {cardProducts}
        </p>
      </a>
      <a
        href={`/${lang}/trust`}
        class="block p-4 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-sky-300 dark:hover:border-sky-600 transition"
      >
        <span class="font-medium text-sky-600">{t('nav.trust') || 'Trust'}</span>
        <p class="mt-1 text-gray-500 dark:text-slate-400">{cardTrust}</p>
      </a>
    </div>
  </section>
</Layout>
