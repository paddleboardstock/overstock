---
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import Tldr from '~/components/common/Tldr.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/quality-control.ts';
import { localizePageTitle } from '~/i18n/page-title';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'quality-control');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const system = page.content_system ?? {};
const inspection = page.content_inspection ?? {};
const stages = inspection.stages ?? [];
const equipment = page.content_equipment ?? {};
const metrics = page.content_metrics ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));

const metadata = {
  title: localizePageTitle(page, `Quality Control System — ${SITE.name} | OEM Marine Manufacturing QC Process`),
  description:
    'Six-stage quality control system for OEM marine manufacturing: material inspection, in-process QC, welding verification, pressure testing, final inspection. ISO 9001 certified. 100% of units tested.',
};
const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: 'Quality Control' }];

const tldrSummary =
  'Six-stage quality control system: material inspection, in-process QC, welding verification, assembly QC, pressure testing at 1.25x rated, and final inspection. ISO 9001:2015 certified. 100% unit pressure testing. 99.3% defect-free rate per AQL 2.5 / ISO 2859.';

const tldrPoints = [
  'Six-stage QC: material inspection, in-process QC, welding verification, assembly QC, 1.25x pressure testing, and 100-point final inspection',
  'ISO 9001:2015 quality management system certified by SGS',
  '100% of units undergo 24-48h hold at 1.25x rated pressure with max 5% drop tolerance',
  'AQL 2.5 sampling per ISO 2859 ensuring 99.3% defect-free rate',
  'Welding QC: peel testing, weld width verification, and backlight seam inspection on every welded joint',
];

const directAnswerHtml =
  '<div class="direct-answer border-l-4 border-blue-600 bg-blue-50 dark:bg-slate-800/50 rounded-r-xl px-6 py-5 my-8"><p class="text-sm text-gray-700 dark:text-slate-300 leading-relaxed">' +
  tldrSummary +
  '</p></div>';

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the Aquafarer quality control process?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Six-stage QC: material inspection, in-process QC, welding verification, assembly QC, 1.25x pressure testing, and 100-point final inspection.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is AQL 2.5 sampling?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Acceptable Quality Level per ISO 2859 \u2014 statistically valid sampling method ensuring 99.3% defect-free rate.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is every unit pressure tested?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. 100% of units undergo 24-48h hold at 1.25x rated pressure with max 5% drop tolerance.',
      },
    },
    {
      '@type': 'Question',
      name: 'What welding QC is performed?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Peel testing, weld width verification, and backlight seam inspection on every welded joint.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does the final inspection include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '100-point checklist, AQL 2.5 sampling, zero-tolerance safety defects, and signed quality release.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />
  <Stats title={stats.title} stats={stats.stats} />

  <div class="px-6 mx-auto max-w-5xl py-10">
    <Tldr summary={tldrSummary} points={tldrPoints} />
  </div>

  <div class="px-6 mx-auto max-w-5xl" set:html={directAnswerHtml} />

  {
    system.items?.length > 0 && (
      <section class="px-6 py-16 mx-auto max-w-6xl">
        <div class="text-center mb-10">
          <span class="text-sm font-semibold text-sky-600 uppercase tracking-wider">{system.tagline}</span>
          <h2 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{system.title}</h2>
          {system.subtitle && <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-3xl mx-auto">{system.subtitle}</p>}
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {system.items.map((item: any) => (
            <div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
              <h3 class="text-lg font-bold text-gray-900 dark:text-white">{item.title}</h3>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{item.description}</p>
              {item.features?.length > 0 && (
                <ul class="mt-4 space-y-1">
                  {item.features.map((f: string) => (
                    <li class="flex items-start gap-2 text-xs text-gray-600 dark:text-gray-400">
                      <span class="text-sky-500 mt-0.5">•</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    stages.length > 0 && (
      <section class="px-6 py-16 mx-auto max-w-6xl bg-gray-50 dark:bg-gray-900/50">
        <div class="text-center mb-10">
          <span class="text-sm font-semibold text-sky-600 uppercase tracking-wider">{inspection.tagline}</span>
          <h2 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">{inspection.title}</h2>
          {inspection.subtitle && (
            <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-3xl mx-auto">{inspection.subtitle}</p>
          )}
        </div>
        <div class="space-y-6">
          {stages.map((s: any) => (
            <div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
              <div class="flex items-start gap-4">
                <span class="w-10 h-10 rounded-full bg-sky-600 text-white flex items-center justify-center font-bold flex-shrink-0">
                  {s.stage}
                </span>
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white">{s.title}</h3>
                  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{s.description}</p>
                  <div class="mt-3 grid md:grid-cols-2 gap-4">
                    {s.checks && (
                      <div class="p-3 rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800">
                        <span class="text-xs font-semibold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
                          Checks
                        </span>
                        <p class="mt-1 text-sm text-amber-700 dark:text-amber-400">{s.checks}</p>
                      </div>
                    )}
                    {s.threshold && (
                      <div class="p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800">
                        <span class="text-xs font-semibold text-red-800 dark:text-red-300 uppercase tracking-wider">
                          Threshold
                        </span>
                        <p class="mt-1 text-sm text-red-700 dark:text-red-400">{s.threshold}</p>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    equipment.items?.length > 0 && (
      <Features3
        tagline={equipment.tagline}
        title={equipment.title}
        subtitle={equipment.subtitle}
        columns={equipment.columns}
        items={equipment.items}
      />
    )
  }

  {
    metrics.items?.length > 0 && (
      <Features3
        tagline={metrics.tagline}
        title={metrics.title}
        subtitle={metrics.subtitle}
        columns={metrics.columns}
        items={metrics.items}
      />
    )
  }

  <TrustBadges layout="row" bg="max-w-6xl mx-auto px-6 py-12" />

  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />

  <JsonLd
    type="Service"
    service={{
      name: 'Aquafarer Quality Control System',
      description:
        'Six-stage quality control system: material inspection, in-process QC, welding verification, assembly QC, pressure testing, final inspection. ISO 9001 certified. 100% unit pressure testing.',
      serviceType: 'Quality Control',
      areaServed: ['Global'],
      url: `/${lang}/quality-control`,
      items: [
        { name: 'Material Inspection', description: 'Tensile, tear, and UV testing of all incoming materials' },
        { name: 'Welding QC', description: 'Peel testing, weld width verification, backlight seam inspection' },
        { name: 'Pressure Testing', description: '24-48h hold at 1.25x rated pressure. Max 5% drop tolerance' },
        {
          name: 'Final Inspection',
          description: '100-point checklist, AQL 2.5 sampling, zero-tolerance safety defects',
        },
      ],
    }}
  />

  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
