---
const PAGE_DESC: Record<string, { description: string }> = {
  de: {
    description:
      'Tiefgehende technische Forschung zu Schlauchbooten: Drop-Stitch-Technik, PVC vs. Hypalon, CE-Zertifizierung, SUP-Dickenratgeber und OEM-Beschaffung.',
  },
  es: {
    description:
      'Investigación técnica en profundidad sobre embarcaciones inflables: ingeniería drop stitch, materiales PVC vs. Hypalon, certificación CE, guía de grosor de SUP y abastecimiento OEM.',
  },
  fr: {
    description:
      "Recherche technique approfondie sur les embarcations gonflables : ingénierie drop stitch, matériaux PVC vs Hypalon, certification CE, guide d'épaisseur de SUP et approvisionnement OEM.",
  },
  it: {
    description:
      'Ricerca tecnica approfondita sulle imbarcazioni gonfiabili: ingegneria drop stitch, materiali PVC vs Hypalon, certificazione CE, guida allo spessore dei SUP e approvvigionamento OEM.',
  },
  cs: {
    description:
      'Hloubkový technický výzkum nafukovacích člunů: Drop-Stitch inženýrství, PVC vs. Hypalon, CE certifikace, SUP průvodce tloušťkou a OEM nákup.',
  },
  sv: {
    description:
      'Djupgående teknisk forskning om uppblåsbara båtar: Drop-Stitch teknik, PVC vs. Hypalon, CE certifiering, SUP tjockleksguide och OEM upphandling.',
  },
  da: {
    description:
      'Dybdegående teknisk forskning i gummibåde: Drop-Stitch teknik, PVC vs. Hypalon, CE certificering, SUP tykkelse guide og OEM indkøb.',
  },
  el: {
    description:
      'Σε βάθος τεχνική έρευνα για φουσκωτά σκάφη: Drop-Stitch μηχανική, PVC έναντι Hypalon, CE πιστοποίηση, SUP οδηγός πάχους και OEM προμήθεια.',
  },
  no: {
    description:
      'Inngående teknisk forskning på gummibåter: Drop-Stitch engineering, PVC vs. Hypalon, CE sertifisering, SUP tykkelsesguide og OEM anskaffelse.',
  },
  ru: {
    description:
      'Углубленные технические исследования надувных лодок: проектирование Drop-Stitch, сравнение PVC и Hypalon, сертификация CE, руководство по толщине SUP и закупки OEM.',
  },
  nl: {
    description:
      'Diepgaand technisch onderzoek naar opblaasbare boten: Drop-Stitch engineering, PVC vs. Hypalon, CE certificering, SUP diktegids en OEM inkoop.',
  },
  fi: {
    description:
      'Kumiveneiden syvällinen tekninen tutkimus: Drop-Stitch suunnittelu, PVC vs. Hypalon, CE sertifiointi, SUP paksuusopas ja OEM hankinta.',
  },
  pl: {
    description:
      'Dogłębne badania techniczne pontonów: inżynieria Drop-Stitch, PVC vs. Hypalon, certyfikacja CE, przewodnik grubości SUP i zaopatrzenie OEM.',
  },
  ar: {
    description:
      'بحث تقني متعمق حول القوارب القابلة للنفخ: Drop-Stitch الهندسة، PVC مقابل Hypalon، شهادة CE، دليل السمك SUP والمشتريات OEM.',
  },
  pt: {
    description:
      'Pesquisa técnica aprofundada sobre barcos infláveis: engenharia Drop-Stitch, PVC vs. Hypalon, certificação CE, guia de espessura SUP e aquisição de OEM.',
  },
  ja: {
    description:
      'インフレータブルボートに関する詳細な技術調査: Drop-Stitch エンジニアリング、PVC と Hypalon の比較、CE 認証、SUP の厚さガイド、および OEM の調達。',
  },
};
const PAGE_META: Record<string, { title: string }> = {
  de: { title: 'Forschungs- und Wissenszentrum' },
  es: { title: 'Centro de Investigación y Conocimiento' },
  fr: { title: 'Centre de recherche et de connaissances' },
  it: { title: 'Centro di ricerca e conoscenza' },
  pt: { title: 'Centro de Pesquisa e Conhecimento' },
  ar: { title: 'مركز البحث والمعرفة' },
  ru: { title: 'Центр исследований и знаний' },
  pl: { title: 'Centrum badań i wiedzy' },
  nl: { title: 'Onderzoeks- en kenniscentrum' },
  sv: { title: 'Forsknings- och kunskapscentrum' },
  no: { title: 'Forsknings- og kunnskapssenter' },
  el: { title: 'Κέντρο έρευνας και γνώσης' },
  fi: { title: 'Tutkimus- ja tietokeskus' },
  da: { title: 'Forsknings- og videnscenter' },
  cs: { title: 'Výzkumné a znalostní centrum' },
  ja: { title: '研究および知識センター' },
};
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { pageContentData } from '~/i18n/generated/site-data';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const metadata = {
  title: PAGE_META[lang]?.title || `Research & Knowledge Center | ${SITE.name}`,
  description:
    PAGE_DESC[lang]?.description ||
    'In-depth technical research on inflatable watercraft: drop stitch engineering, PVC vs Hypalon materials, CE certification, SUP thickness guide, and OEM sourcing.',
  ignoreTitleTemplate: true,
};

interface ResearchTopic {
  slug: string;
  category: string;
  readTime: string;
}

const topics: ResearchTopic[] =
  (pageContentData[`${lang}/site-research`] || pageContentData['en/site-research'] || {})?.topics ?? [];

const topicMeta: Record<string, { titleKey: string; descKey: string }> = {
  'drop-stitch-technology': { titleKey: 'home.research.dropStitch', descKey: 'home.research.dropStitch.desc' },
  'pvc-vs-hypalon': { titleKey: 'home.research.pvcHypalon', descKey: 'home.research.pvcHypalon.desc' },
  'ce-certification-guide': {
    titleKey: 'home.research.ceCertification',
    descKey: 'home.research.ceCertification.desc',
  },
  'sup-thickness-guide': { titleKey: 'home.research.supThickness', descKey: 'home.research.supThickness.desc' },
  'oem-buyer-guide': { titleKey: 'home.research.oemBuyer', descKey: 'home.research.oemBuyer.desc' },
  'rcd-technical-file-guide': { titleKey: 'home.research.rcdTechFile', descKey: 'home.research.rcdTechFile.desc' },
  'hin-win-hull-identification': { titleKey: 'home.research.hinWin', descKey: 'home.research.hinWin.desc' },
  'rcd-design-categories': { titleKey: 'home.research.rcdCategories', descKey: 'home.research.rcdCategories.desc' },
};
---

<Layout metadata={metadata}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: 'Research & Knowledge Center',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />

  <div class="max-w-6xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={`/${lang}/`} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('home.research.title')}</span>
    </nav>

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{t('home.research.tagline')}</span>
      <h1 class="mt-4 text-4xl font-bold text-gray-900">{t('home.research.title')}</h1>
      <p class="mt-4 text-lg text-gray-500">{t('home.research.subtitle')}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        topics.map((tpc) => {
          const meta = topicMeta[tpc.slug];
          if (!meta) return null;
          return (
            <a
              href={`/${lang}/research/${tpc.slug}`}
              class="group bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5 flex flex-col"
            >
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full">
                  {tpc.category}
                </span>
                <span class="text-xs text-gray-400">{tpc.readTime}</span>
              </div>
              <h2 class="text-xl font-semibold text-gray-900 group-hover:text-sky-700 transition-colors mb-2">
                {t(meta.titleKey)}
              </h2>
              <p class="text-sm text-gray-500 line-clamp-3 flex-1">{t(meta.descKey)}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-sky-700">
                {t('home.research.read')}
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</Layout>
