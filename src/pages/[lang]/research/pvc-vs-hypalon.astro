                    <td class="p-3 border">850 – 1,200 g</td>
                    <td class="p-3 border">1,100 – 1,500 g</td>
                  </>
                </tr>
                <tr>
                  <>
                    <td class="p-3 border font-medium">Cold flex (low temp)</td>
                    <td class="p-3 border">-30&deg;C</td>
                    <td class="p-3 border">-20&deg;C</td>
                  </>
                </tr>
                <tr>
                  <>
                    <td class="p-3 border font-medium">Repairability</td>
                    <td class="p-3 border">Easy (heat weld or adhesive)</td>
