      es: LEs,
      fr: LFr,
      it: LIt,
      cs: LCs,
      sv: LSv,
      da: LDa,
      el: LEl,
      no: LNo,
      ru: LRu,
      nl: LNl,
      fi: LFi,
      pl: LPl,
      ar: LAr,
      pt: LPt,
      ja: LJa,
      ms: LMs,
      ro: LRo,
      sk: LSk,
      sl: LSl,
      sr: LSr,
      th: LTh,
      tl: LTl,
      tr: LTr,
      bg: LBg,
      et: LEt,
      he: LHe,
      hr: LHr,
      hu: LHu,
      id: LId,
