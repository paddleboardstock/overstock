const meta = META[lang] || META.en;
const ResearchBody: any =
  (
    {
      de: LDe,
      es: LEs,
      fr: LFr,
      it: LIt,
      cs: LCs,
      sv: LSv,
      da: LDa,
      el: LEl,
      no: LNo,
      ru: LRu,
      nl: LNl,
      fi: LFi,
      pl: LPl,
      ar: LAr,
      pt: LPt,
      ja: LJa,
      ms: LMs,
      ro: LRo,
      sk: LSk,
      sl: LSl,
      sr: LSr,
      th: LTh,
      tl: LTl,
      tr: LTr,
      bg: LBg,
      et: LEt,
      he: LHe,
      hr: LHr,
      hu: LHu,
      id: LId,
      ko: LKo,
      lt: LLt,
      lv: LLv,
    } as Record<string, any>
  )[lang] || null;

const metadata = {
  title: meta.title + ' | ' + SITE.name,
  description: meta.description,
  ignoreTitleTemplate: true,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: metadata.description,
  author: { '@type': 'Organization', name: SITE.name },
  datePublished: '2024-06-15',
  dateModified: '2025-06-01',
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What must be in an RCD technical file for RIB boats?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Product identity, compliance strategy, design drawings, structural calculations, material specifications, system diagrams, stability/buoyancy calculations, test reports, supplier documentation, HIN/WIN records, builder plate layout, owner manual, production conformity plan, and NB certification records. Per RCD 2013/53/EU Annex IX.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long must RCD technical files be retained?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'At least 10 years after the last unit of that model is placed on the EU market, per RCD II Article 7(3).',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the three-tier document system for RCD compliance?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Master Technical File proves the design type complies, Model Variant Pack proves variants stay within the certification boundary, and Single-Boat Traceability Pack proves each actual boat matches the approved type. All linked by HIN/WIN and model version.',
      },
    },
  ],
});
---

<Layout metadata={metadata}>
  <JsonLd data={jsonLd} />

  <article class="max-w-4xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={'/' + lang + '/'} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <a href={'/' + lang + '/research'} class="hover:text-sky-600">{t('home.research.title')}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('home.research.rcdTechFile')}</span>
    </nav>

    <div class="mb-4">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full"
        >Compliance</span
      >
      <span class="ml-3 text-sm text-gray-400">12 min read</span>
    </div>

    <h1 class="text-4xl font-bold text-gray-900 mb-6">{t('home.research.rcdTechFile')}</h1>
    <p class="text-xl text-gray-500 mb-12 leading-relaxed">{t('home.research.rcdTechFile.desc')}</p>

    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
      {
        ResearchBody ? (
          <ResearchBody lang={lang} />
        ) : (
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
            <h2>What Is the RCD Technical File?</h2>
            <p>
              The RCD technical file is not a product manual or marketing brochure. It is a complete evidence chain
              proving the boat complies with the Recreational Craft Directive (2013/53/EU) from initial design through
              manufacturing to final verification. It must demonstrate that every requirement of the applicable Annex
              has been addressed, that the methods and standards used are appropriate, and that production processes
              consistently reproduce the approved type.
            </p>
            <p>
              Per RCD II Article 7(3), the technical file must be retained for at least 10 years after the last unit of
              that model is placed on the EU market. This retention period applies to the manufacturer or the authorized
              representative established within the EU.
            </p>

            <h2>Three-Tier Document System</h2>
            <p>
              A well-structured RCD technical file operates on three tiers, each answering a distinct compliance
              question and linked together by model identification and HIN/WIN traceability.
            </p>
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-gray-100">
                  <th class="p-3 text-left font-semibold text-gray-900 border">Tier</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Object</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Core Question</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="p-3 border">Master Technical File</td>
                  <td class="p-3 border">Approved design type</td>
                  <td class="p-3 border">Does the design comply with RCD requirements?</td>
                </tr>
                <tr>
                  <td class="p-3 border">Model Variant Pack</td>
                  <td class="p-3 border">Certified variants within the type</td>
                  <td class="p-3 border">Do variants stay within the certification boundary?</td>
                </tr>
                <tr>
                  <td class="p-3 border">Single-Boat Traceability Pack</td>
                  <td class="p-3 border">Each individual boat produced</td>
                  <td class="p-3 border">Does each boat match the approved type?</td>
                </tr>
              </tbody>
            </table>

            <h2>12-Module File Directory</h2>
            <p>
              The technical file should be organized into discrete modules, each covering a specific compliance domain.
              This modular structure simplifies audits, change control, and variant management.
            </p>

            <h3>01 Product Identity</h3>
            <p>
              Model definition, certification boundary, design category, hull identification, and variant register.
              Establishes what is and is not covered by the file.
            </p>

            <h3>02 RCD Compliance Strategy</h3>
            <p>
              Applicable conformity assessment modules, notified body information, list of applied harmonized standards,
              and rationale for any deviations or alternative solutions.
            </p>

            <h3>03 General Design</h3>
            <p>
              General arrangement drawings, principal dimensions, weight and center of gravity data, and design category
              justification per ISO 8666.
            </p>

            <h3>04 Structural Design</h3>
            <p>
              Hull, deck, transom, bulkheads, and structural connections. Includes scantling calculations or test-based
              evidence per ISO 12215 or equivalent.
            </p>

            <h3>05 Materials and Processes</h3>
            <p>
              Bill of Materials, material specifications, lamination cards (for GRP), adhesive system specifications,
              and process control records for critical bonds.
            </p>

            <h3>06 System Drawings</h3>
            <p>
              Electrical system, fuel system, drainage, steering system, and engine installation drawings with
              applicable ISO compliance references.
            </p>

            <h3>07 Safety and Performance</h3>
            <p>
              Stability calculations, buoyancy calculations, freeboard measurements, maximum load determination, and
              maximum engine power calculations per ISO 12217 and ISO 8666.
            </p>

            <h3>08 Testing and Inspection</h3>
            <p>
              Prototype test records, production test records, third-party test reports, and calibration certificates
              for test equipment.
            </p>

            <h3>09 Supplier Compliance</h3>
            <p>
              Critical component list, supplier Declarations of Conformity, incoming inspection procedures, and material
              certificate traceability.
            </p>

            <h3>10 Marking and Consumer Information</h3>
            <p>
              HIN/WIN coding and placement, builder plate layout and content, CE marking application, and owner manual
              compliance checklist.
            </p>

            <h3>11 Production Conformity</h3>
            <p>
              Quality control plan, inspection procedures at key production stages, change control procedure, and
              non-conformance handling.
            </p>

            <h3>12 Certification Records</h3>
            <p>
              Notified body contracts, type examination certificates, audit reports, and Declaration of Conformity
              archive.
            </p>

            <h2>RIB-Specific Focus Areas</h2>

            <h3>Tube Material and Bonding</h3>
            <p>
              For RIB manufacturers, the tube assembly is the most compliance-critical subsystem. The technical file
              must include PVC or CSM material specifications with tensile strength, tear resistance, and UV stability
              data; adhesive system specifications including pot life, cure schedule, and peel strength requirements;
              bonding procedure cards detailing surface preparation, ambient conditions, adhesive application, and
              roll-out sequence; chamber arrangement drawings showing individual chamber volumes, partition positions,
              and pressure relief valve locations; and pressure test methods with acceptance criteria per ISO 6185 or
              equivalent.
            </p>

            <h3>Transom and Maximum Power</h3>
            <p>
              The technical file must document maximum engine power and weight as determined per ISO 8666 and ISO 11592;
              transom structure drawings including core material, laminate schedule, and engine mounting bolt pattern;
              and engine mounting requirements including transom reinforcement, through-bolt specifications, and load
              distribution analysis.
            </p>

            <h3>HIN/WIN and Builder Plate</h3>
            <p>
              HIN/WIN coding must follow ISO 10087 format. The file must document coding rules including manufacturer
              code, model year, and serial number allocation; visible and hidden marking positions with photographs or
              drawings; and material and permanency requirements ensuring the mark survives the service life of the
              craft. The RCD requires CE marking on the builder plate, separate from the HIN/WIN. The builder plate must
              display design category, maximum persons, maximum load, and engine power per ISO 14945.
            </p>

            <h2>Essential Requirements Compliance Matrix</h2>
            <p>
              The compliance matrix maps each RCD Annex I essential requirement to the standard used and the evidence
              document that demonstrates compliance. It is the single most important navigation tool in the technical
              file.
            </p>
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-gray-100">
                  <th class="p-3 text-left font-semibold text-gray-900 border">RCD Clause</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Applicable?</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Standard Used</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Evidence Document</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="p-3 border">Annex I 3.1 Stability</td>
                  <td class="p-3 border">Yes</td>
                  <td class="p-3 border">ISO 12217-1</td>
                  <td class="p-3 border">Module 07 Stability Report</td>
                </tr>
                <tr>
                  <td class="p-3 border">Annex I 3.3 Buoyancy</td>
                  <td class="p-3 border">Yes</td>
                  <td class="p-3 border">ISO 12217-1</td>
                  <td class="p-3 border">Module 07 Buoyancy Report</td>
                </tr>
                <tr>
                  <td class="p-3 border">Annex I 5.1 Electrical</td>
                  <td class="p-3 border">Conditional</td>
                  <td class="p-3 border">ISO 10133</td>
                  <td class="p-3 border">Module 06 Electrical Drawing</td>
                </tr>
                <tr>
                  <td class="p-3 border">Annex I 3.5 Load capacity</td>
                  <td class="p-3 border">Yes</td>
                  <td class="p-3 border">ISO 8666</td>
                  <td class="p-3 border">Module 07 Load Calculation</td>
                </tr>
              </tbody>
            </table>

            <h2>Change Control</h2>
            <p>
              Any change that could affect compliance must be assessed for impact before implementation. The following
              changes always require a compliance impact assessment:
            </p>
            <ul>
              <li>Hull mold changes (new plug, modified lines)</li>
              <li>Material supplier changes (resin, gelcoat, core, tube fabric)</li>
              <li>Engine power changes (different max power rating)</li>
              <li>Maximum persons or load changes</li>
              <li>New T-top, hardtop, or fuel tank installation</li>
              <li>Tube chamber arrangement changes (addition, removal, repositioning)</li>
              <li>Standard updates (when a cited harmonized standard is superseded)</li>
            </ul>

            <h2>What This Means for B2B Buyers</h2>
            <p>
              For distributors, fleet operators, and OEM buyers, the technical file is your assurance that the product
              you are purchasing is legally compliant and traceable. Verify the following before placing an order:
            </p>
            <ul>
              <li>A model-specific Declaration of Conformity exists for the exact configuration you are purchasing</li>
              <li>HIN/WIN is traceable to the technical file and production records</li>
              <li>The technical file covers the actual configuration including any options or modifications</li>
              <li>Production conformity is documented with inspection records and change control logs</li>
            </ul>
          </div>
        )
      }
    </div>

    <div class="mt-16 pt-8 border-t border-gray-200">
      <a href={'/' + lang + '/research'} class="text-sky-600 hover:text-sky-700 font-medium"
        >&larr; {t('home.research.tagline')}</a
      >
    </div>
  </article>
