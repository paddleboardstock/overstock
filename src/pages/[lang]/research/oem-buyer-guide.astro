const meta = META[lang] || META.en;
const ResearchBody: any =
  (
    {
      de: LDe,
      es: LEs,
      fr: LFr,
      it: LIt,
      cs: LCs,
      sv: LSv,
      da: LDa,
      el: LEl,
      no: LNo,
      ru: LRu,
      nl: LNl,
      fi: LFi,
      pl: LPl,
      ar: LAr,
      pt: LPt,
      ja: LJa,
      ms: LMs,
      ro: LRo,
      sk: LSk,
      sl: LSl,
      sr: LSr,
      th: LTh,
      tl: LTl,
      tr: LTr,
      bg: LBg,
      et: LEt,
      he: LHe,
      hr: LHr,
      hu: LHu,
      id: LId,
      ko: LKo,
      lt: LLt,
      lv: LLv,
    } as Record<string, any>
  )[lang] || null;

const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
  ignoreTitleTemplate: true,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: metadata.description,
  author: { '@type': 'Organization', name: SITE.name },
  datePublished: '2024-05-08',
  dateModified: '2025-06-10',
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What should I look for in an OEM inflatable boat manufacturer?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Direct factory (not trading company), ISO 9001 certification, CE compliance, transparent QC process, low MOQs, and willingness to accommodate factory audits.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the typical OEM process?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Design brief, material selection, prototyping, pressure testing, CE/ISO inspection, and FOB shipping. 30-45 days standard lead time.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I verify manufacturer claims?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Request ISO certificates, CE Declarations of Conformity, BSCI audit reports, and schedule a factory audit. Third-party inspection (SGS/BV) recommended.',
      },
    },
  ],
});
---

<Layout metadata={metadata}>
  <JsonLd data={jsonLd} />

  <article class="max-w-4xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={`/${lang}/`} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <a href={`/${lang}/research`} class="hover:text-sky-600">{t('home.research.title')}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('home.research.oemBuyer')}</span>
    </nav>

    <div class="mb-4">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full"
        >Sourcing</span
      >
      <span class="ml-3 text-sm text-gray-400">12 min read</span>
    </div>

    <h1 class="text-4xl font-bold text-gray-900 mb-6">{t('home.research.oemBuyer')}</h1>
    <p class="text-xl text-gray-500 mb-12 leading-relaxed">{t('home.research.oemBuyer.desc')}</p>

    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
      {
        ResearchBody ? (
          <ResearchBody lang={lang} />
        ) : (
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
            <h2>1. Pre-Qualification: What to Look for in a Factory</h2>

            <h3>Compliance Certificates</h3>
            <ul>
              <li>
                <strong>ISO 9001:2015</strong> – Quality management system
              </li>
              <li>
                <strong>CE certification</strong> – Verify the Notified Body number
              </li>
              <li>
                <strong>BSCI / SMETA / SEDEX</strong> – Social compliance audits
              </li>
              <li>
                <strong>REACH / RoHS</strong> – Material compliance declarations
              </li>
            </ul>

            <h3>Manufacturing Capabilities</h3>
            <ul>
              <li>Drop-stitch core weaving in-house vs. outsourced</li>
              <li>PVC coating / lamination line</li>
              <li>RF welding and hot air welding equipment</li>
              <li>In-house mold making (CNC machining)</li>
              <li>Testing lab (pressure testing, UV aging, tensile testing)</li>
            </ul>

            <h3>Experience Verification</h3>
            <ul>
              <li>Years in inflatable watercraft manufacturing (5+ years minimum)</li>
              <li>Number of engineers on staff</li>
              <li>Existing OEM/ODM clients (request references)</li>
              <li>Export destinations – are they already shipping to your target market?</li>
            </ul>

            <h2>2. Quality Control Protocols</h2>
            <p>
              Material incoming QC: tensile strength (ASTM D751 or ISO 1421), tear resistance (ASTM D2261 or ISO 4674),
              adhesion strength, UV aging spot checks.
            </p>
            <p>
              In-process QC: seam strength monitoring every 50 units, valve torque verification, drop-stitch thread
              density checks, dimensional checks against CAD drawings.
            </p>
            <p>
              Final inspection: 100% inflation hold test (24 hours, max 5% drop), visual inspection, valve function
              test, random sample testing (AQL 2.5 or 4.0 per ISO 2859).
            </p>

            <h2>3. Compliance Documentation Checklist</h2>
            <ul>
              <li>Declaration of Conformity (DoC) referencing correct EU directive</li>
              <li>CE certificate from notified body</li>
              <li>Test report from accredited lab</li>
              <li>Material safety data sheets (MSDS)</li>
              <li>REACH compliance declaration</li>
              <li>Bill of Materials with supplier traceability</li>
              <li>Factory inspection report</li>
            </ul>

            <h2>4. MOQ Negotiation</h2>
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-gray-100">
                  <th class="p-3 text-left font-semibold text-gray-900 border">Product Type</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Standard MOQ</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Negotiable Range</th>
                </tr>
              </thead>
              <tbody>
