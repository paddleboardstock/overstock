    {
      de: LDe,
      es: LEs,
      fr: LFr,
      it: LIt,
      cs: LCs,
      sv: LSv,
      da: LDa,
      el: LEl,
      no: LNo,
      ru: LRu,
      nl: LNl,
      fi: LFi,
      pl: LPl,
      ar: LAr,
      pt: LPt,
      ja: LJa,
      ms: LMs,
      ro: LRo,
      sk: LSk,
      sl: LSl,
      sr: LSr,
      th: LTh,
      tl: LTl,
      tr: LTr,
      bg: LBg,
      et: LEt,
      he: LHe,
      hr: LHr,
      hu: LHu,
      id: LId,
      ko: LKo,
      lt: LLt,
      lv: LLv,
    } as Record<string, any>
  )[lang] || null;

const metadata = {
  title: meta.title + ' | ' + SITE.name,
  description: meta.description,
  ignoreTitleTemplate: true,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: metadata.description,
  author: { '@type': 'Organization', name: SITE.name },
  datePublished: '2024-06-01',
  dateModified: '2025-04-20',
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is a HIN/WIN number on a boat?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HIN (Hull Identification Number) or WIN (Watercraft Identification Number) is a unique code permanently marked on every recreational craft per RCD 2013/53/EU. It includes country code, manufacturer code (MIC), serial number, production date and model year.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where must the HIN/WIN be marked on a RIB?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The primary HIN/WIN must be on the starboard side of the transom, upper area, readable without disassembly. A second hidden mark must be placed internally for anti-theft and traceability. Both must be permanent and match the DoC.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use adhesive stickers for HIN/WIN marking?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. RCD and EN ISO 10087 require permanent marking methods appropriate to the hull material — such as stamping, laser etching, mold-formed characters, or welded/fixed metal plates. Adhesive labels, removable plates, and easily fading ink are not acceptable as the sole identification.',
      },
    },
  ],
});
---

<Layout metadata={metadata}>
  <JsonLd data={jsonLd} />

  <article class="max-w-4xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={'/' + lang + '/'} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <a href={'/' + lang + '/research'} class="hover:text-sky-600">{t('home.research.title')}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('home.research.hinWin')}</span>
    </nav>

    <div class="mb-4">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full"
        >Compliance</span
      >
      <span class="ml-3 text-sm text-gray-400">8 min read</span>
    </div>

    <h1 class="text-4xl font-bold text-gray-900 mb-6">{t('home.research.hinWin')}</h1>
    <p class="text-xl text-gray-500 mb-12 leading-relaxed">{t('home.research.hinWin.desc')}</p>

    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
      {
        ResearchBody ? (
          <ResearchBody lang={lang} />
        ) : (
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
            <h2>What Is HIN/WIN?</h2>
            <p>
              Every recreational craft from 2.5 m to 24 m placed on the EU market must have a unique Watercraft
              Identification Number (WIN). The industry still commonly uses HIN (Hull Identification Number) or CIN
              (Craft Identification Number). RCD II (Directive 2013/53/EU, in force since 18 January 2016) requires
              this. It is NOT the same as a Chinese ship identification number, IMO number, or vessel registration
              number.
            </p>

            <h2>Number Composition</h2>
            <p>Per RCD II Annex I Part A 2.1, the ID must contain at minimum:</p>
            <ul>
              <li>Country of manufacture code (2-letter ISO, e.g. CN)</li>
              <li>
                Manufacturer Identification Code (MIC) — assigned by EU member state authority, cannot be self-invented
              </li>
              <li>Unique serial number (5 digits, manufacturer-managed, must be unique per MIC)</li>
              <li>Month of manufacture (A–L = Jan–Dec)</li>
              <li>Year of manufacture (last 2 digits)</li>
              <li>Model year (1 digit)</li>
            </ul>
            <p>Common 14-character format: CC + MIC + SSSSS + M + YY + Y</p>
            <p>Example: CNABC12345D526 = China, MIC ABC, serial 12345, April 2026, model year 2026</p>

            <h2>Marking and Installation Requirements</h2>

            <h3>Visible primary mark</h3>
            <p>
              Starboard side of transom, upper area. Must be readable without disassembly. Avoid obstruction by outboard
              motor, ladders, or fenders.
            </p>

            <h3>Hidden secondary mark</h3>
            <p>
              Internal/hidden location for anti-theft and traceability. Position recorded in production records but not
              publicly disclosed.
            </p>

            <h3>Permanency requirements by hull material</h3>
            <ul>
              <li>
                <strong>FRP/GRP:</strong> Mold-formed raised/sunken characters, laminated-in plate, or resin-sealed
                durable mark
              </li>
              <li>
                <strong>Aluminum:</strong> Stamping, mechanical engraving, laser etching, or reliably fixed metal ID
                plate
              </li>
              <li>
                <strong>Steel:</strong> Stamping, engraving, or welded steel number plate
              </li>
              <li>
                <strong>Wood:</strong> Deep engraving, embedded durable plate, or epoxy-sealed
              </li>
              <li>
                <strong>PE/thermoplastic:</strong> In-mold forming, laser etching, or verified permanent embedded mark
              </li>
              <li>
                <strong>Inflatable boats:</strong> Durable nameplate or structural fixed marking per manufacturer
                specification — plain adhesive stickers are NOT acceptable
              </li>
            </ul>

            <p>Methods that should NOT be used as the sole HIN/WIN:</p>
            <ul>
              <li>Ordinary adhesive labels, easy-peel stickers</li>
              <li>Simply removable screw-on plates</li>
              <li>Easily fading ink or paint</li>
              <li>Only printed in manual/invoice/DoC without physical hull marking</li>
            </ul>

            <h2>HIN/WIN vs CE Builder Plate</h2>
            <p>
              These are TWO SEPARATE requirements. RCD requires them to be installed separately. CE marking goes on the
              builder plate, NOT on the HIN/WIN.
            </p>
            <p>Typical arrangement:</p>
            <ul>
              <li>Starboard transom exterior: Permanent HIN/WIN</li>
              <li>Internal hidden location: Second permanent HIN/WIN</li>
              <li>Cockpit/interior visible location: Independently fixed CE builder plate</li>
            </ul>

            <h2>Manufacturing and Certification Notes</h2>
            <ul>
              <li>
                <strong>MIC first:</strong> Must obtain valid MIC before marking — cannot invent a 3-character code for
                export batches
              </li>
              <li>
                <strong>One boat one code:</strong> Same HIN/WIN must never be used for two boats
              </li>
              <li>
                <strong>Data consistency:</strong> Hull mark, hidden mark, builder plate, EU DoC, owner manual,
                technical file, and sales materials must all match
              </li>
              <li>
                <strong>Do not re-mark casually:</strong> If HIN/WIN is incorrectly marked, create a controlled
                nonconformance and correction record
              </li>
              <li>
                <strong>PCA vessels:</strong> Post-Construction Assessment boats need special handling — builder plate
                must include "post-construction assessment" text
              </li>
              <li>
                <strong>Record retention:</strong> Keep technical files and DoC at least 10 years; HIN allocation,
                marking photos, positions, serial number register and hidden mark positions should be in the
                traceability archive
              </li>
            </ul>

            <h2>What This Means for B2B Buyers</h2>
            <p>Verify that:</p>
            <ul>
              <li>Each boat has a unique, permanently marked HIN/WIN</li>
              <li>The HIN/WIN on the hull matches the DoC and production records</li>
              <li>The manufacturer has a valid MIC from an EU authority</li>
              <li>Hidden secondary marks exist and are documented</li>
            </ul>
          </div>
        )
      }
