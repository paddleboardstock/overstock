const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
  ignoreTitleTemplate: true,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: metadata.description,
  author: { '@type': 'Organization', name: SITE.name },
  datePublished: '2024-04-12',
  dateModified: '2025-06-01',
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What thickness SUP should I choose?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '4-inch (10cm) for all-around recreational use at 15 PSI. 6-inch (15cm) for larger riders or performance at up to 20 PSI.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does thickness affect stability?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Thicker boards sit higher in the water, offering more volume and stability for heavier riders. Thinner boards are more responsive for experienced paddlers.',
      },
    },
    {
      '@type': 'Question',
      name: 'What pressure should I inflate to?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '4-inch: 15 PSI. 6-inch: up to 20 PSI. Always test at 1.25x rated pressure per Aquafarer QC standards.',
      },
    },
  ],
});
