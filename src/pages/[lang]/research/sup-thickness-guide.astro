---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import LDe from '~/components/research/sup-thickness-guide.de.astro';
import LEs from '~/components/research/sup-thickness-guide.es.astro';
import LFr from '~/components/research/sup-thickness-guide.fr.astro';
import LIt from '~/components/research/sup-thickness-guide.it.astro';
import LRu from '~/components/research/sup-thickness-guide.ru.astro';
import LNl from '~/components/research/sup-thickness-guide.nl.astro';
import LPl from '~/components/research/sup-thickness-guide.pl.astro';
import LAr from '~/components/research/sup-thickness-guide.ar.astro';
import LPt from '~/components/research/sup-thickness-guide.pt.astro';
import LMs from '~/components/research/sup-thickness-guide.ms.astro';
import LRo from '~/components/research/sup-thickness-guide.ro.astro';
import LTh from '~/components/research/sup-thickness-guide.th.astro';
import LTl from '~/components/research/sup-thickness-guide.tl.astro';
import LTr from '~/components/research/sup-thickness-guide.tr.astro';
import LBg from '~/components/research/sup-thickness-guide.bg.astro';
import LHu from '~/components/research/sup-thickness-guide.hu.astro';
import LId from '~/components/research/sup-thickness-guide.id.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const META: Record<string, { title: string; description: string }> = {
  en: {
    title: 'How to Choose SUP Thickness — Engineering Analysis',
    description:
      'Technical guide to inflatable SUP board thickness: how 4", 5", and 6" boards differ in rigidity, weight, stability, tracking, and performance. Thickness recommendations for touring, yoga, surfing, racing, and all-around paddling.',
  },
  de: {
    title: 'So wählen Sie die richtige SUP-Dicke — technische Analyse',
    description:
      'Technischer Leitfaden zur Dicke aufblasbarer SUP-Boards: Wie sich Boards mit 4", 5" und 6" in Steifigkeit, Gewicht, Stabilität, Spurverhalten und Leistung unterscheiden. Dickenempfehlungen für Touring, Yoga, Surfen, Rennen und Allround-Paddeln.',
  },
  es: {
    title: 'Cómo elegir el grosor del SUP — análisis técnico',
    description:
      'Guía técnica sobre el grosor de las tablas de SUP hinchables: cómo difieren las tablas de 4", 5" y 6" en rigidez, peso, estabilidad, derrota y rendimiento. Recomendaciones de grosor para touring, yoga, surf, carreras y remo polivalente.',
  },
  fr: {
    title: "Comment choisir l'épaisseur de votre SUP — analyse technique",
    description:
      'Guide technique sur l\'épaisseur des planches de SUP gonflables : différences entre les planches de 4", 5" et 6" en rigidité, poids, stabilité, tenue de cap et performances. Recommandations d\'épaisseur pour le touring, le yoga, le surf, la course et la pagaie polyvalente.',
  },
  it: {
    title: 'Come scegliere lo spessore del SUP — analisi tecnica',
    description:
      'Guida tecnica allo spessore delle tavole SUP gonfiabili: come le tavole da 4", 5" e 6" differiscono per rigidità, peso, stabilità, deriva e prestazioni. Consigli sullo spessore per touring, yoga, surf, gara e pagaiata polivalente.',
  },
  ru: {
    title: 'Как выбрать толщину SUP — инженерный анализ',
    description:
      'Техническое руководство по толщине надувной доски SUP: чем доски размером 4, 5 и 6 дюймов отличаются по жесткости, весу, устойчивости, управляемости и характеристикам. Рекомендации по толщине для туризма, йоги, серфинга, гонок и гребли.',
  },
  nl: {
    title: 'Hoe u een dikte van SUP kiest: technische analyse',
    description:
      'Technische gids voor opblaasbare SUP boarddikte: hoe boards van 4", 5" en 6" verschillen in stijfheid, gewicht, stabiliteit, tracking en prestaties. Aanbevelingen voor dikte voor toeren, yoga, surfen, racen en allround peddelen.',
  },
  pl: {
    title: 'Jak wybrać grubość SUP — analiza inżynierska',
    description:
      'Przewodnik techniczny dotyczący grubości nadmuchiwanych desek SUP: czym różnią się deski 4”, 5” i 6” pod względem sztywności, wagi, stabilności, prowadzenia i wydajności. Zalecenia dotyczące grubości dla turystyki, jogi, surfingu, wyścigów i wszechstronnego wiosłowania.',
  },
  ar: {
    title: 'كيفية اختيار سمك SUP - التحليل الهندسي',
    description:
      'الدليل الفني لسمك لوح SUP القابل للنفخ: كيف تختلف الألواح مقاس 4 و5 و6 بوصات من حيث الصلابة والوزن والثبات والتتبع والأداء. توصيات السُمك للتجول واليوجا وركوب الأمواج والسباق والتجديف الشامل.',
  },
  pt: {
    title: 'Como escolher a espessura SUP - Análise de engenharia',
    description:
      'Guia técnico para espessura de prancha inflável SUP: como as pranchas de 4", 5" e 6" diferem em rigidez, peso, estabilidade, rastreamento e desempenho. Recomendações de espessura para passeios, ioga, surf, corrida e remo versátil.',
  },
  ms: {
    title: 'Bagaimana Memilih Ketebalan SUP — Analisis Kejuruteraan',
    description:
      'Panduan teknikal mengenai ketebalan papan tiup SUP: bagaimana papan 4", 5", dan 6" berbeza dari segi kekuatan, berat, kestabilan, penjejakan, dan prestasi. Cadangan ketebalan untuk jelajah, yoga, berselancar, perlumbaan, dan kayuhan serba guna.',
  },
  ro: {
    title: 'Cum să Alegi Grosimea SUP — Analiză Tehnică',
    description:
      'Ghid tehnic pentru grosimea plăcilor gonflabile SUP: cum diferă plăcile de 4", 5" și 6" în ceea ce privește rigiditatea, greutatea, stabilitatea, urmărirea traseului și performanța. Recomandări de grosime pentru touring, yoga, surfing, curse și paddling general.',
  },
  th: {
    title: 'วิธีการเลือกความหนา SUP — การวิเคราะห์วิศวกรรม',
    description:
      'คู่มือทางเทคนิคเกี่ยวกับความหนาของกระดาน SUP แบบพอง: ความแตกต่างของกระดาน 4 นิ้ว, 5 นิ้ว และ 6 นิ้ว ในด้านความแข็ง น้ำหนัก ความมั่นคง การควบคุมทิศทาง และประสิทธิภาพ คำแนะนำเกี่ยวกับความหนาสำหรับการทัวร์ โยคะ โต้คลื่น แข่ง และพายโดยรอบ',
  },
  tl: {
    title: 'Paano Pumili ng SUP na Kapal — Pagsusuri ng Inhinyeriya',
    description:
      'Teknikal na gabay sa kapal ng inflatable SUP na board: kung paano nagkakaiba ang 4", 5", at 6" na mga board sa tigas, timbang, katatagan, pagpapanatili ng direksyon, at pagganap. Mga rekomendasyon sa kapal para sa touring, yoga, surfing, karera, at pangkalahatang pagpaddle.',
  },
  tr: {
    title: 'SUP Kalınlığını Nasıl Seçmeli — Mühendislik Analizi',
    description:
      'Şişme SUP tahta kalınlıkları hakkında teknik rehber: 4", 5" ve 6" tahtaların rijitlik, ağırlık, stabilite, iz takip ve performans açısından farkları. Tur, yoga, sörf, yarış ve genel kullanım için kalınlık önerileri.',
  },
  bg: {
    title: 'Как да изберем SUP дебелина — инженерно проучване',
    description:
      'Техническо ръководство за дебелината на надуваемата SUP дъска: как дъските с 4", 5" и 6" се различават по твърдост, тегло, стабилност, тракция и производителност. Препоръки за дебелина за туризъм, йога, сърф, състезания и универсално гребане.',
  },
  hu: {
    title: 'Hogyan válasszuk ki a SUP vastagságot – Műszaki elemzés',
    description:
      'Műszaki útmutató felfújható SUP deszkák vastagságához: hogyan különböznek a 4", 5" és 6" deszkák merevségben, súlyban, stabilitásban, nyomvonalban és teljesítményben. Vastagsági ajánlások túrázásra, jógára, szörfözésre, versenyzésre és minden típusú evezéshez.',
  },
  id: {
    title: 'Cara Memilih Ketebalan SUP — Analisis Teknik',
    description:
      'Panduan teknis untuk ketebalan papan SUP yang dapat dipompa: bagaimana papan 4", 5", dan 6" berbeda dalam kekakuan, berat, stabilitas, pelacakan, dan performa. Rekomendasi ketebalan untuk touring, yoga, selancar, balap, dan dayung serba guna.',
  },
};
const meta = META[lang] || META.en;
const ResearchBody: any =
  (
    {
      de: LDe,
      es: LEs,
      fr: LFr,
      it: LIt,
      ru: LRu,
      nl: LNl,
      pl: LPl,
      ar: LAr,
      pt: LPt,
      ms: LMs,
      ro: LRo,
      th: LTh,
      tl: LTl,
      tr: LTr,
      bg: LBg,
      hu: LHu,
      id: LId,
    } as Record<string, any>
  )[lang] || null;

const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
  ignoreTitleTemplate: true,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: metadata.description,
  author: { '@type': 'Organization', name: SITE.name },
  datePublished: '2024-04-12',
  dateModified: '2025-06-01',
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What thickness SUP should I choose?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '4-inch (10cm) for all-around recreational use at 15 PSI. 6-inch (15cm) for larger riders or performance at up to 20 PSI.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does thickness affect stability?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Thicker boards sit higher in the water, offering more volume and stability for heavier riders. Thinner boards are more responsive for experienced paddlers.',
      },
    },
    {
      '@type': 'Question',
      name: 'What pressure should I inflate to?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '4-inch: 15 PSI. 6-inch: up to 20 PSI. Always test at 1.25x rated pressure per Paddle Board Overstock QC standards.',
      },
    },
  ],
});
---

<Layout metadata={metadata}>
  <JsonLd data={jsonLd} />

  <article class="max-w-4xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={`/${lang}/`} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <a href={`/${lang}/research`} class="hover:text-sky-600">{t('home.research.title')}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('home.research.supThickness')}</span>
    </nav>

    <div class="mb-4">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full"
        >Engineering</span
      >
      <span class="ml-3 text-sm text-gray-400">6 min read</span>
    </div>

    <h1 class="text-4xl font-bold text-gray-900 mb-6">{t('home.research.supThickness')}</h1>
    <p class="text-xl text-gray-500 mb-12 leading-relaxed">{t('home.research.supThickness.desc')}</p>

    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
      {
        ResearchBody ? (
          <ResearchBody lang={lang} />
        ) : (
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
            <h2>The Three Standard Thicknesses</h2>

            <h3>4" (10 cm) – Touring & Performance</h3>
            <ul>
              <li>Highest rigidity – less flex under load</li>
              <li>Lightest – less material, less air volume</li>
              <li>Excellent tracking – reduced side-to-side rocking</li>
              <li>Fastest – reduced drag, easier glide</li>
              <li>Best for: Touring, racing, fitness paddling, experienced paddlers</li>
            </ul>

            <h3>5" (12.7 cm) – All-Around</h3>
            <ul>
              <li>Good rigidity – balanced flex-to-stiffness ratio</li>
              <li>Moderate weight – standard material usage</li>
              <li>Good primary + secondary stability</li>
              <li>Best for: Recreational paddling, beginners, casual lake and river use</li>
            </ul>

            <h3>6" (15.2 cm) – Stability & Yoga</h3>
            <ul>
              <li>Highest primary stability – massive buoyancy</li>
              <li>Heaviest – more PVC material, larger air volume</li>
              <li>Slowest – more drag, harder to maintain glide</li>
              <li>Best for: Yoga/fitness, heavy paddlers (100+ kg), very choppy conditions</li>
            </ul>

            <h2>Engineering Analysis</h2>
            <p>
              The stiffness of an inflatable SUP is governed by internal air pressure and the moment of inertia of the
              board's cross-section. At 20 PSI, a 4" board shows approximately 30% less deflection under load than a 6"
              board of the same width and length. Primary stability comes from waterline width and buoyancy; secondary
              stability is influenced by rail shape and board width.
            </p>

            <h2>Thickness by Paddler Weight</h2>
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-gray-100">
                  <th class="p-3 text-left font-semibold text-gray-900 border">Paddler Weight</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Recommended Thickness</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <>
                    <td class="p-3 border">Under 65 kg (143 lbs)</td>
                    <td class="p-3 border">4"</td>
                  </>
                </tr>
                <tr>
                  <>
                    <td class="p-3 border">65 – 90 kg (143 – 198 lbs)</td>
                    <td class="p-3 border">5"</td>
                  </>
                </tr>
                <tr>
                  <>
                    <td class="p-3 border">90 – 115 kg (198 – 253 lbs)</td>
                    <td class="p-3 border">5" or 6"</td>
                  </>
                </tr>
                <tr>
                  <>
                    <td class="p-3 border">Over 115 kg (253 lbs)</td>
                    <td class="p-3 border">6"</td>
                  </>
                </tr>
              </tbody>
            </table>

            <h2>Thickness vs. PSI Trade-off</h2>
            <p>
              A common misconception is that higher PSI can compensate for excessive thickness. At 25 PSI, a 6" board
              shows more flex than a 4" board at 15 PSI because the geometric moment of inertia dominates the stiffness
              equation. For performance-oriented paddlers, a thinner board at lower pressure outperforms a thicker board
              at higher pressure.
            </p>

            <h2>Paddle Board Overstock Lineup</h2>
            <ul>
              <li>
                <strong>4" boards:</strong> Cheetah Touring series – 12' x 30" x 4" touring SUPs for fitness and
                distance paddling
              </li>
              <li>
                <strong>5" boards:</strong> Cheetah All-Round series – 10'6" x 32" x 5" for recreational use
              </li>
              <li>
                <strong>6" boards:</strong> Cheetah Ultra-Stable series – 10' x 34" x 6" for yoga, large paddlers, and
                photography platforms
              </li>
            </ul>
            <p>All boards utilize 1,680 DTEX drop-stitch cores with 20 PSI rated pressure and 1.2 mm PVC laminates.</p>
          </div>
        )
      }
    </div>

    <div class="mt-16 pt-8 border-t border-gray-200">
      <a href={`/${lang}/research`} class="text-sky-600 hover:text-sky-700 font-medium"
        >&larr; {t('home.research.tagline')}</a
      >
    </div>
  </article>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
