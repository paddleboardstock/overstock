const metadata = {
  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
  ignoreTitleTemplate: true,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: metadata.description,
  author: { '@type': 'Organization', name: SITE.name },
  datePublished: '2024-06-15',
  dateModified: '2025-04-20',
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the difference between RCD design category A and C?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Category A is designed for ocean conditions exceeding Beaufort 8 wind and 4 m significant wave height. Category C is for inshore use up to Beaufort 6 and 2 m waves. Category A requires substantially stronger structure, stability, and systems verification.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I label my RIB as Category B for marketing purposes?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Design category must be supported by design calculations, prototype testing, and applicable standard evidence. Labeling a Category C boat as Category B without engineering verification violates RCD and creates liability risk.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does significant wave height (Hs) mean?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Significant wave height is the average height of the highest one-third of waves, not the maximum individual wave. Individual waves can be much higher than Hs. This is the standard measure used in RCD design category definitions.',
      },
    },
  ],
});
---

<Layout metadata={metadata}>
  <JsonLd data={jsonLd} />

  <article class="max-w-4xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={'/' + lang + '/'} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <a href={'/' + lang + '/research'} class="hover:text-sky-600">{t('home.research.title')}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('home.research.rcdCategories')}</span>
    </nav>

    <div class="mb-4">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full"
        >Compliance</span
      >
      <span class="ml-3 text-sm text-gray-400">6 min read</span>
    </div>

    <h1 class="text-4xl font-bold text-gray-900 mb-6">{t('home.research.rcdCategories')}</h1>
    <p class="text-xl text-gray-500 mb-12 leading-relaxed">{t('home.research.rcdCategories.desc')}</p>

    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
      {
        ResearchBody ? (
          <ResearchBody lang={lang} />
        ) : (
          <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
            <h2>What Are RCD Design Categories?</h2>
            <p>
              Design categories (A&ndash;D) under RCD 2013/53/EU define the environmental conditions a boat is designed
              to handle. They are NOT quality grades or marketing levels&mdash;they represent specific wind and wave
              design parameters. Selecting the wrong category creates compliance and liability risk.
            </p>

            <h2>Category Comparison Table</h2>
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-gray-100">
                  <th class="p-3 text-left font-semibold text-gray-900 border">Category</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Navigation Environment</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Wind Limit</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Significant Wave Height (Hs)</th>
                  <th class="p-3 text-left font-semibold text-gray-900 border">Typical Products</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="p-3 border">A</td>
                  <td class="p-3 border">Ocean</td>
                  <td class="p-3 border">Exceeds Beaufort 8</td>
                  <td class="p-3 border">Exceeds 4 m</td>
                  <td class="p-3 border">Blue water cruising vessels</td>
                </tr>
                <tr>
                  <td class="p-3 border">B</td>
                  <td class="p-3 border">Offshore</td>
                  <td class="p-3 border">Up to Beaufort 8</td>
                  <td class="p-3 border">Up to 4 m</td>
                  <td class="p-3 border">Offshore cruising, larger sea-going RIBs</td>
                </tr>
                <tr>
                  <td class="p-3 border">C</td>
                  <td class="p-3 border">Inshore</td>
                  <td class="p-3 border">Up to Beaufort 6</td>
                  <td class="p-3 border">Up to 2 m</td>
                  <td class="p-3 border">Most recreational RIBs, near-shore fishing boats</td>
                </tr>
                <tr>
                  <td class="p-3 border">D</td>
                  <td class="p-3 border">Sheltered waters</td>
                  <td class="p-3 border">Up to Beaufort 4</td>
                  <td class="p-3 border">Up to 0.3 m (occasional 0.5 m)</td>
                  <td class="p-3 border">Inland waterway, lake, harbor craft</td>
                </tr>
              </tbody>
            </table>

            <h2>What Is Significant Wave Height?</h2>
            <p>
              Hs is NOT the tallest individual wave. It is the average height of the highest one-third of waves
              observed. Individual maximum waves can be significantly higher than Hs. Example: If forecast says Hs 1.8 m
              with wind force 5&ndash;6, this is still within Category C. If Hs is 2.3 m even with only force 4&ndash;5
              wind, it exceeds Category C limits.
            </p>

            <h2>Impact on RIB Design</h2>
            <p>Upgrading from C to A affects the entire boat:</p>
            <ul>
              <li>
                <strong>Hull &amp; deck structure:</strong> Higher wave impact loads affect shell, deck, bulkheads,
                connections, handrails, seat bases
              </li>
              <li>
                <strong>Stability &amp; buoyancy:</strong> Must meet requirements under all load conditions for the
                target category
              </li>
              <li>
                <strong>Water ingress &amp; drainage:</strong> Hatches, openings, side doors, and self-draining capacity
                must handle more severe conditions
              </li>
              <li>
                <strong>Tube system:</strong> Chamber division, airtightness, valves, materials, bonding&mdash;all must
                support the target category safety conclusions
              </li>
              <li>
                <strong>Systems &amp; operating limits:</strong> Fuel, electrical, steering, max power, max load, max
                persons&mdash;all must match the target category
              </li>
              <li>
                For 8&ndash;24 m RIBs with larger engines, EN ISO 6185-4 also distinguishes between sheltered/inshore
                (Category C/D) and more exposed waters (Category B)
              </li>
            </ul>

            <h2>Which Category Is Right for Your RIB?</h2>
            <p>Practical guidance:</p>
            <ul>
              <li>
                Lakes, rivers, harbors, near-shore short recreation, dive shuttle: Category C is usually appropriate
              </li>
              <li>Cross-sea, further offshore, more open conditions: Consider Category B at minimum</li>
              <li>
                Category A is a high-level ocean/open-sea designation&mdash;do not assign it just because "the boat is
                big and has a powerful engine"
              </li>
              <li>
                Design category must be consistent across: sales contract, dealer marketing, builder plate, owner
                manual, max persons/load, and test/calculation reports
              </li>
              <li>
                Marketing a Category C RIB as "ocean-going all-weather boat" creates significant compliance and product
                liability risk
              </li>
            </ul>

            <h2>Compliance Module Selection</h2>
            <p>Which modules apply based on category:</p>
            <ul>
              <li>
                Category C, LH &lt; 12 m, full harmonized standard compliance: Module A (self-declaration) may be
                possible
              </li>
              <li>Category C, LH &lt; 12 m, NOT full standard compliance: Module A1, or B+C/B+D</li>
              <li>Category A/B, any length: NB involvement required (B+D recommended for volume production)</li>
              <li>Category D: Module A possible but must still have complete technical file</li>
            </ul>

            <h2>What This Means for B2B Buyers</h2>
            <p>Verify that:</p>
            <ul>
              <li>Design category matches intended use</li>
              <li>Builder plate category matches DoC and manual</li>
              <li>The boat was actually tested/calculated for the stated category (not just labeled higher)</li>
              <li>Dealer marketing does not overstate the design category</li>
            </ul>
          </div>
        )
      }
    </div>

