  title: `${meta.title} | ${SITE.name}`,
  description: meta.description,
  ignoreTitleTemplate: true,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: metadata.description,
  author: { '@type': 'Organization', name: SITE.name },
  datePublished: '2024-01-15',
  dateModified: '2025-06-01',
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is Drop-Stitch technology?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Drop-Stitch uses thousands of internal polyester threads connecting top and bottom PVC layers, creating a rigid flat structure when pressurized. This allows inflatable boards to perform like hard boards.',
      },
    },
    {
      '@type': 'Question',
      name: 'What thickness options are available?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '4-inch (10cm) core for standard SUP boards at 15 PSI. 6-inch (15cm) core for premium boards at up to 20 PSI.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is Drop-Stitch quality tested?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '1.25x rated pressure hold for 24-48h, tensile strength testing, UV aging per ASTM G154, and cold crack resistance per ISO 4646.',
      },
    },
    {
      '@type': 'Question',
      name: 'What are the advantages over traditional construction?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Lighter weight, packable/portable, no dings or cracks, lower manufacturing cost, and consistent wall thickness through RF welding.',
      },
    },
    {
      '@type': 'Question',
      name: 'Who invented Drop-Stitch?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Originally developed for military inflatable boats in the 1950s, modern Drop-Stitch was refined for SUP boards and has become the industry standard for high-performance inflatables.',
      },
    },
  ],
});
