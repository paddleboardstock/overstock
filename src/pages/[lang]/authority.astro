---
export const prerender = true;

import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/authority.ts';
import { localizePageTitle, localizePageDescription } from '~/i18n/page-title';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'authority');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const brand = page.features3_brand ?? {};
const trust = page.features3_trust ?? {};
const leadership = page.features3_leadership ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));
const localizedBrandItems = brand.items?.map((item: any) => ({
  ...item,
  link: item.link ? `/${lang}${item.link}` : item.link,
}));
const localizedTrustItems = trust.items?.map((item: any) => ({
  ...item,
  link: item.link ? `/${lang}${item.link}` : item.link,
}));

const metadata = {
  title: localizePageTitle(
    page,
    `Authority Center — ${SITE.name} | Why Industry Professionals Trust Paddle Board Overstock`
  ),
  description: localizePageDescription(
    page,
    'Team expertise, manufacturing capabilities, and proof of quality. Everything that makes Paddle Board Overstock a trusted inflatable SUP board manufacturer.'
  ),
};
const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: t('nav.authority') || 'Authority Center' },
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What authority does Paddle Board Overstock have in the marine industry?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '12+ years manufacturing, 14+ R&D engineers, 200-300 workers, 15,000 annual units shipped to 50+ countries.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the defect-free rate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '99.3% defect-free rate across trailing 12-month shipments.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can customers visit the factory?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Customers and inspection agencies are welcome at our Weihai facility.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />
  <Stats title={stats.title} stats={stats.stats} />
  <Features3
    tagline={brand.tagline}
    title={brand.title}
    subtitle={brand.subtitle}
    columns={brand.columns}
    items={localizedBrandItems}
  />
  <Features3
    tagline={trust.tagline}
    title={trust.title}
    subtitle={trust.subtitle}
    columns={trust.columns}
    items={localizedTrustItems}
  />
  <Features3
    tagline={leadership.tagline}
    title={leadership.title}
    subtitle={leadership.subtitle}
    columns={leadership.columns}
    items={leadership.items}
  />
  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
  <JsonLd
    type="Service"
    service={{
      name: 'Paddle Board Overstock Authority Center — Trust & Proof',
      description:
        'Team expertise, manufacturing capabilities, and quality evidence for inflatable SUP board manufacturing.',
      serviceType: 'Brand Authority',
      areaServed: ['Global'],
      url: `/${lang}/authority`,
      items: [
        { name: 'About Paddle Board Overstock', description: 'Company history and manufacturing story since 2012' },
        { name: 'Marine Expertise', description: 'Material science and engineering capabilities' },
        { name: 'Global Presence', description: '50+ countries served worldwide' },
        { name: 'Factory Testing', description: '8-protocol testing with 99.3% defect-free rate' },
        { name: 'Quality & Testing', description: 'Rigorous testing for every production batch' },
        { name: 'Team & Leadership', description: '14+ R&D engineers and industry experts' },
      ],
    }}
  />
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
