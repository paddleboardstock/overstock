---
const PAGE_DESC: Record<string, { description: string }> = {
  de: {
    description:
      'Laden Sie Produktkataloge, Käuferleitfäden und technische Dokumentationen für aufblasbare SUP Boards herunter.',
  },
  es: {
    description:
      'Descargue catálogos de productos, guías para compradores y documentación técnica para tablas de paddle inflables.',
  },
  fr: {
    description:
      'Téléchargez des catalogues produits, des guides pour acheteurs et la documentation technique pour planches de paddle gonflables.',
  },
  it: {
    description:
      'Scarica cataloghi di prodotti, guide per gli acquirenti e documentazione tecnica per tavole di paddle gonfiabili.',
  },
  ru: {
    description:
      'Загрузите каталоги продукции, руководства для покупателей и техническую документацию по надувным SUP доскам.',
  },
  nl: {
    description: 'Download productcatalogi, kopersgidsen en technische documentatie voor opblaasbare SUP boards.',
  },
  pl: {
    description:
      'Pobierz katalogi produktów, przewodniki dla kupujących i dokumentację techniczną dotyczącą desek SUP.',
  },
  ar: {
    description: 'قم بتنزيل كتالوجات المنتجات وأدلة المشترين والوثائق الفنية لألواح التجديف القابلة للنفخ.',
  },
  pt: {
    description:
      'Baixe catálogos de produtos, guias para compradores e documentação técnica para pranchas de paddle infláveis.',
  },
};
const PAGE_META: Record<string, { title: string }> = {
  de: { title: 'Ressourcen' },
  es: { title: 'Recursos' },
  fr: { title: 'Ressources' },
  it: { title: 'Risorse' },
  pt: { title: 'Recursos' },
  ar: { title: 'الموارد' },
  ru: { title: 'Ресурсы' },
  pl: { title: 'Zasoby' },
  nl: { title: 'Bronnen' },
  th: { title: 'ทรัพยากร' },
  tr: { title: 'Kaynaklar' },
  id: { title: 'Sumber daya' },
  hu: { title: 'Források' },
  ro: { title: 'Resurse' },
  bg: { title: 'Ресурси' },
  ms: { title: 'Sumber' },
  tl: { title: 'Mga mapagkukunan' },
};
export const prerender = true;

import Features3 from '~/components/widgets/Features3.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/resources.ts';
import { localizePageTitle } from '~/i18n/page-title';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'resources');

const hero = page.hero_text ?? {};
const downloads = page.features3_downloads ?? {};
const faqs = page.faqs ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));

const metadata = {
  title: localizePageTitle(
    page,
    PAGE_META[lang]?.title || `Resources — ${SITE.name} | Product Catalogs & Buyer Guides`
  ),
  description:
    PAGE_DESC[lang]?.description ||
    'Download product catalogs, buyer guides, and technical documentation for inflatable SUP boards.',
};
const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: t('nav.resources') || 'Resources' }];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What resources are available?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The 2026 SUP product catalog, inflatable SUP buyer guide, size and fit guide, board care and maintenance guide, materials guide, and getting-started paddling basics.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are resources free to access?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. All catalogs and guides are free to download.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I request additional documentation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Material test reports and pressure test logs are available upon request.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <HeroText tagline={hero.tagline} title={hero.title} subtitle={hero.subtitle} />
  <Features3
    tagline={downloads.tagline}
    title={downloads.title}
    subtitle={downloads.subtitle}
    columns={downloads.columns}
    items={downloads.items}
  />
  <FAQs title={faqs.title} subtitle={faqs.subtitle} columns={faqs.columns} items={faqs.items} />
  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
