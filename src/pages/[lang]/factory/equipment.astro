---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/factory-equipment.ts';
import { localizePageTitle, localizePageDescription } from '~/i18n/page-title';
import { getUiForLang } from '~/i18n/generated/ui-all';
import Tldr from '~/components/common/Tldr.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';

interface EquipmentItem {
  name: string;
  spec: string;
  desc: string;
}

interface CategoryItem {
  title: string;
  items: EquipmentItem[];
}

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';

setPageContentData(__pageData);
const page = getPageContent(lang, 'factory-equipment');
const hero: Record<string, string> = page.hero ?? {};
const categories: CategoryItem[] = page.categories ?? [];
const cta: Record<string, string> = page.cta ?? {};
const tldr: { summary?: string; points?: string[] } = page.tldr ?? {};
const tldrSummary: string = tldr.summary ?? '';
const tldrPoints: string[] = tldr.points ?? [];

const crumbs = [
  { name: t('nav.home') || 'Home', href: '/' + lang + '/' },
  { name: t('nav.factory') || 'Factory', href: '/' + lang + '/factory' },
  { name: hero.tagline || 'Equipment' },
];

const metadata = {
  title: localizePageTitle(page, 'Manufacturing Equipment \u2014 Cutting, Welding, Printing & Assembly | ' + SITE.name),
  description: localizePageDescription(
    page,
    SITE.name +
      ' factory equipment: automatic PVC cutting machines, high-frequency RF welders, EVA deck cutting stations, heat sealing presses, final assembly rigs, and pressure test rigs.'
  ),
};

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: t('faq.factoryEquipment.q1.q') || 'What manufacturing equipment does Paddle Board Overstock use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          t('faq.factoryEquipment.q1.a') ||
          'Automatic PVC cutting machines, high-frequency RF welders, EVA deck cutting and finishing stations, heat sealing presses, final assembly rigs, and pressure test rigs in a 12,000 m\u00B2 facility.',
      },
    },
    {
      '@type': 'Question',
      name: t('faq.factoryEquipment.q2.q') || 'What welding technology is used?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          t('faq.factoryEquipment.q2.a') ||
          'High-frequency RF welding for PVC seams and drop-stitch bonding, with peel testing and backlight seam inspection.',
      },
    },
    {
      '@type': 'Question',
      name: t('faq.factoryEquipment.q3.q') || 'How are the art-series deck designs made?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          t('faq.factoryEquipment.q3.a') ||
          'Multi-color EVA foam blocks are precision die-cut and hand-assembled into pieced deck art — no printing, so the artwork is designed to resist fading and peeling.',
      },
    },
    {
      '@type': 'Question',
      name: t('faq.factoryEquipment.q4.q') || 'How are valves and fins installed?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          t('faq.factoryEquipment.q4.a') ||
          'Valves are installed at calibrated torque stations, fin boxes and D-rings are set with dedicated assembly rigs, and every board gets a function test before packing.',
      },
    },
    {
      '@type': 'Question',
      name: t('faq.factoryEquipment.q5.q') || 'Is every board tested?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          t('faq.factoryEquipment.q5.a') ||
          'Yes. 100% of boards are inflated to 1.25x rated pressure and held for 24-48 hours before they leave the factory.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-6 sm:px-6 py-16 sm:py-20 mx-auto max-w-5xl">
    <a href={'/' + lang + (hero.back_link || '/factory')} class="text-sm text-gray-500 hover:underline"
      >&larr; {hero.back_label}</a
    >
    <div class="mt-4 max-w-3xl">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">{hero.tagline}</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold">{hero.title}</h1>
      <p class="mt-3 text-lg text-muted">{hero.subtitle}</p>
    </div>
  </section>

  {
    tldrSummary && (
      <section class="px-6 sm:px-6 pb-8 mx-auto max-w-4xl">
        <Tldr summary={tldrSummary} points={tldrPoints} />
      </section>
    )
  }

  {
    tldrSummary && (
      <section class="px-6 sm:px-6 pb-12 mx-auto max-w-4xl">
        <div
          class="bg-blue-50/60 dark:bg-slate-800/40 border-l-4 border-blue-500 rounded-r-xl px-6 py-4"
          data-ai-block="direct-answer"
        >
          <p class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-2">
            Quick Answer &mdash; AI Summary
          </p>
          <p class="text-sm text-gray-700 dark:text-slate-300 leading-relaxed">{tldrSummary}</p>
        </div>
      </section>
    )
  }

  <section class="px-6 sm:px-6 pb-20 mx-auto max-w-5xl space-y-16">
    {
      categories.map((cat: CategoryItem) => (
        <div>
          <h2 class="text-2xl font-bold mb-6">{cat.title}</h2>
          <div class="grid gap-4">
            {cat.items.map((eq: EquipmentItem) => (
              <div class="p-5 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1">
                    <h3 class="font-bold">{eq.name}</h3>
                    <p class="text-sm text-primary font-medium mt-0.5">{eq.spec}</p>
                    <p class="text-sm text-muted mt-2">{eq.desc}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <TrustBadges layout="row" />

  <section class="px-6 sm:px-6 pb-20 mx-auto max-w-4xl text-center">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
      <h2 class="text-xl font-bold">{cta.title}</h2>
      <p class="mt-2 text-sm text-muted">{cta.desc}</p>
      <a
        href={'/' + lang + (cta.link || '/contact')}
        class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
      >
        {cta.label}
      </a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
