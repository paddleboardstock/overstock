---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import Tldr from '~/components/common/Tldr.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/factory-capacity.ts';
import { localizePageTitle } from '~/i18n/page-title';

interface HighlightItem {
  value: string;
  label: string;
  detail: string;
}

interface WorkshopItem {
  title: string;
  output?: string;
  description: string;
}

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'factory-capacity');

const hero: Record<string, string> = page.hero ?? {};
const intro: string = page.intro ?? '';
const highlights: HighlightItem[] = page.highlights ?? [];
const workshops: WorkshopItem[] = page.workshops ?? [];
const crumbs = [
  { name: t('nav.home') || 'Home', href: '/' + lang + '/' },
  { name: 'Factory', href: '/' + lang + '/factory' },
  { name: hero.title },
];

const metadata = {
  title: localizePageTitle(page, hero.title + ' \u2014 ' + SITE.name),
  description: intro?.slice(0, 160) || SITE.name + ' factory capacity and production output.',
};

const tldrSummary =
  'Paddle Board Overstock operates a 12,000 m\u00B2 ISO 9001:2015 certified facility with 15,000 units annual output across SUP, RIB, kayak, and inflatable boat product lines. 200-300 skilled workers across 2 shifts.';

const tldrPoints: string[] = [
  '12,000 m\u00B2 production campus in Qingdao',
  '15,000 units annual capacity',
  '200-300 skilled workers, 2 shifts/day',
  'SUP: 8,000+ units/year, RIB: 2,000+ units/year',
  'ISO 9001:2015 certified quality management system',
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the annual production capacity?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '15,000 units per year across all product lines: 8,000+ SUP boards, 2,000+ RIB boats, 3,000+ inflatable boats and kayaks, and 2,000+ accessories.',
      },
    },
    {
      '@type': 'Question',
      name: 'How large is the factory?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '12,000 m\u00B2 of ISO 9001:2015 certified production space at the Paddle Board Overstock Qingdao Manufacturing Hub in Qingdao, China.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can you handle large volume orders?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. With 2-shift operation and optional night shift, we can scale to 20,000+ units annually for surge orders.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the typical lead time?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '30-45 days FOB Qingdao for standard orders. Rush orders available at 15-20 days with priority surcharge.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you have separate production lines?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Dedicated workshops for SUP boards, RIB boats, inflatable boats/kayaks, and accessories, each with specialized equipment and QC checkpoints.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <meta name="ai-intent" content="inflatable-boat-factory-capacity,rib-boat-manufacturer-china,oem-boat-production" />
  <script is:inline type="application/ld+json" set:html={faqSchema} />
  <section class="px-6 sm:px-6 py-16 sm:py-20 lg:py-24 mx-auto max-w-5xl text-center">
    <a href={'/' + lang + '/factory'} class="text-sm text-gray-500 hover:underline">&larr; {hero.tagline}</a>
    <p class="mt-4 text-sm font-semibold text-primary uppercase tracking-wider">{SITE.name}</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">{hero.title}</h1>
    <p class="mt-3 text-lg text-muted">{hero.subtitle}</p>
  </section>

  <section class="px-6 sm:px-6 pb-8 mx-auto max-w-4xl">
    <Tldr summary={tldrSummary} points={tldrPoints} />
  </section>

  <section class="px-6 sm:px-6 pb-12 mx-auto max-w-4xl">
    <div class="bg-blue-50/60 dark:bg-slate-800/40 border-l-4 border-blue-500 rounded-r-xl px-6 py-4">
      <p class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-2">
        Quick Answer &mdash; AI Summary
      </p>
      <p class="text-sm text-gray-700 dark:text-slate-300 leading-relaxed">{tldrSummary}</p>
    </div>
  </section>

  {
    intro && (
      <section class="px-6 sm:px-6 pb-16 mx-auto max-w-4xl">
        <p class="text-muted leading-relaxed">{intro}</p>
      </section>
    )
  }

  {
    highlights.length > 0 && (
      <section class="px-6 sm:px-6 pb-8 mx-auto max-w-6xl">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
          {highlights.map((s: HighlightItem) => (
            <div class="text-center p-6 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
              <span class="block text-3xl font-bold text-primary">{s.value}</span>
              <span class="block text-sm text-muted mt-1">{s.label}</span>
              <span class="block text-xs text-muted mt-1">{s.detail}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    workshops.length > 0 && (
      <section class="px-6 sm:px-6 py-16 mx-auto max-w-6xl">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold text-primary uppercase tracking-wider">
            {t('factory.byProductLine') || 'By Product Line'}
          </p>
          <h2 class="mt-2 text-3xl font-bold">
            {t('factory.capacityByCategory') || 'Production Capacity by Category'}
          </h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {workshops.map((w: WorkshopItem) => (
            <div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-bold">{w.title}</h3>
                {w.output && <span class="text-sm font-semibold text-primary">{w.output}</span>}
              </div>
              <p class="text-sm text-muted leading-relaxed">{w.description}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <TrustBadges layout="row" />

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-4xl text-center">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
      <h2 class="text-xl font-bold">{t('factory.interestedCapacity') || 'Interested in our production capacity?'}</h2>
      <p class="mt-2 text-sm text-muted">
        {
          t('factory.interestedCapacityDesc') ||
            'Contact our sales team for current lead times and available production slots.'
        }
      </p>
      <a
        href={'/' + lang + '/contact'}
        class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
        >{t('factory.contactSales') || 'Contact sales'} &rarr;</a
      >
    </div>
  </section>
</Layout>
