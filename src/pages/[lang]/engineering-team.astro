---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { TEAM_MEMBERS, RESEARCH_AREAS } from '~/lib/engineering-team-l10n';
import { TEAM_MEMBERS_MT, RESEARCH_AREAS_MT, DISCIPLINES_MT } from '~/lib/engineering-team-l10n-mt';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const metadata = {
  title: `${t('engineeringTeam.title') || 'Engineering & R&D Team — Inflatable Boat Design & Manufacturing'} | ${SITE.name}`,
  description:
    t('engineeringTeam.desc') ||
    `${SITE.name}'s 25+ R&D engineers and production specialists. Expertise in drop-stitch core technology, PVC/Hypalon fabrication, RIB hull design, and CE compliance engineering. Based in Qingdao, China.`,
  ignoreTitleTemplate: true,
};

const teamMembers = (TEAM_MEMBERS[lang] || TEAM_MEMBERS_MT[lang] || TEAM_MEMBERS.en) as any[];

const researchAreas = (RESEARCH_AREAS[lang] || RESEARCH_AREAS_MT[lang] || RESEARCH_AREAS.en) as any[];

const disciplines: string[] = DISCIPLINES_MT[lang] || [
  'Materials Science',
  'Product Design',
  'Quality Engineering',
  'OEM Programs',
  'RIB Fabrication',
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How large is the Aquafarer engineering team?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '25+ engineers with an average of 7+ years in inflatable manufacturing, covering hull design, materials science, and production engineering.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can Aquafarer design custom hull shapes?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our R&D team develops custom hull shapes using 3D CAD modeling and CNC-machined aluminum molds for precision and consistency.',
      },
    },
    {
      '@type': 'Question',
      name: 'What CAD software is used?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Industry-standard 3D CAD tools for hull design, mold engineering, and structural analysis. Technical drawings available in PDF, DXF, and STEP formats.',
      },
    },
    {
      '@type': 'Question',
      name: 'What testing capabilities does the team have?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pressure testing (1.25x rated, 24-48h), UV aging (ASTM G154), abrasion (ASTM D751), tensile/tear strength, buoyancy (ISO 6185), and cold crack resistance.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I request technical drawings?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. PDF GA drawings are freely available. DXF/DWG require a light form submission. STEP/IGES require project application. See the Technical Drawings page.',
      },
    },
  ],
});
---

<Layout metadata={metadata}>
  <JsonLd
    type="Article"
    article={{
      headline: t('engineeringTeam.heading') || 'Engineering & R&D Team — Inflatable Boat Design & Manufacturing',
      description:
        t('engineeringTeam.desc') ||
        "Meet the 25+ R&D engineers and production specialists behind Aquafarer's inflatable watercraft manufacturing.",
      datePublished: '2026-07-07',
    }}
    data={{ url: `https://aquafarer.com/${lang}/engineering-team` }}
  />
  <JsonLd
    type="BreadcrumbList"
    breadcrumbs={[
      { name: t('nav.home') || 'Home', href: `/${lang}/` },
      { name: 'About', href: `/${lang}/about` },
      { name: t('engineeringTeam.heading') || 'Engineering Team' },
    ]}
  />

  <section class="bg-gradient-to-br from-[#001830] via-[#002d4a] to-[#003355] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-sky-300"
        >{t('engineeringTeam.badge') || 'R&D & Engineering'}</span
      >
      <h1 class="mt-4 text-4xl md:text-5xl font-bold tracking-tight">
        {t('engineeringTeam.heading') || 'The People Behind the Product'}
      </h1>
      <p class="mt-4 text-lg text-white/70">
        {
          t('engineeringTeam.subtitle') ||
            '25+ engineers and specialists across materials science, product design, quality engineering, and production management.'
        }
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {
          disciplines.map((tag) => (
            <span class="px-4 py-2 border border-white/20 text-white/80 text-sm rounded-full">{tag}</span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Trust Stats Strip -->
  <section class="bg-white dark:bg-gray-950 border-b border-gray-100 dark:border-gray-800 py-12 px-6">
    <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-3xl font-bold text-sky-600">78+</div>
        <div class="text-sm text-gray-500 mt-1">
          {t('engineeringTeam.experienceYears') || 'Combined R&D Experience (Years)'}
        </div>
      </div>
      <div>
        <div class="text-3xl font-bold text-sky-600">40+</div>
        <div class="text-sm text-gray-500 mt-1">{t('engineeringTeam.platforms') || 'Product Platforms Developed'}</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-sky-600">12</div>
        <div class="text-sm text-gray-500 mt-1">
          {t('engineeringTeam.certifications') || 'International Certifications'}
        </div>
      </div>
      <div>
        <div class="text-3xl font-bold text-sky-600">1,200+</div>
        <div class="text-sm text-gray-500 mt-1">{t('engineeringTeam.projects') || 'OEM/ODM Projects Delivered'}</div>
      </div>
    </div>
  </section>

  <!-- Certification Badges -->
  <section class="bg-gray-50 dark:bg-gray-950 py-12 px-6">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-6">
        {t('engineeringTeam.certBadge') || 'Certified & Compliant'}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {
          ['CE 6185', 'ISO 9001', 'BSCI', 'REACH', 'UKCA', 'USCG'].map((cert) => (
            <span class="px-5 py-2.5 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-full text-sm font-semibold text-gray-700 dark:text-gray-300 shadow-sm">
              {cert}
            </span>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-gray-400">
        {
          t('engineeringTeam.certDesc') ||
            'Products independently tested and certified for international markets including EU, US, UK, and Middle East.'
        }
      </p>
    </div>
  </section>

  <!-- Global Presence -->
  <section class="bg-white dark:bg-gray-950 border-b border-gray-100 dark:border-gray-800 py-12 px-6">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-6">
        {t('engineeringTeam.global') || 'Global Engineering Footprint'}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-4">
          <div class="text-lg font-bold text-gray-900 dark:text-gray-100">
            {t('engineeringTeam.globalHQ') || 'Qingdao, China'}
          </div>
          <div class="text-sm text-gray-500">
            {t('engineeringTeam.globalHQlabel') || 'Headquarters & Manufacturing'}
          </div>
          <div class="text-xs text-gray-400 mt-1">
            {t('engineeringTeam.globalHQdesc') || '12,000 m² factory · 6 production lines · R&D lab'}
          </div>
        </div>
        <div class="p-4">
          <div class="text-lg font-bold text-gray-900 dark:text-gray-100">
            {t('engineeringTeam.globalUS') || 'California, USA'}
          </div>
          <div class="text-sm text-gray-500">{t('engineeringTeam.globalUSlabel') || 'North American Warehouse'}</div>
          <div class="text-xs text-gray-400 mt-1">
            {t('engineeringTeam.globalUSdesc') || 'Local stock · Faster delivery · USCG compliance'}
          </div>
        </div>
        <div class="p-4">
          <div class="text-lg font-bold text-gray-900 dark:text-gray-100">
            {t('engineeringTeam.globalSupport') || 'Global Support'}
          </div>
          <div class="text-sm text-gray-500">
            {t('engineeringTeam.globalSupportlabel') || 'Technical & Sales Offices'}
          </div>
          <div class="text-xs text-gray-400 mt-1">
            {t('engineeringTeam.globalSupportdesc') || 'Europe · Middle East · Southeast Asia · Oceania'}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto py-24 px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-semibold text-gray-900 dark:text-gray-100">
        {t('engineeringTeam.leadership') || 'Engineering Leadership'}
      </h2>
      <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">
        {t('engineeringTeam.leadershipDesc') || 'Key members of our R&D and production engineering team.'}
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        teamMembers.map((m) => (
          <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 hover:shadow-lg transition-shadow">
            <div class="w-14 h-14 rounded-full bg-sky-100 dark:bg-sky-900 flex items-center justify-center mb-4">
              <span class="text-2xl font-bold text-sky-600 dark:text-sky-400">{m.name.charAt(0)}</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{m.name}</h3>
            <p class="text-sm text-sky-600 dark:text-sky-400 font-medium">{m.role}</p>
            <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">{m.experience}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {m.expertise.map((e: string) => (
                <span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 px-2 py-1 rounded">
                  {e}
                </span>
              ))}
            </div>
            <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-800">
              <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">{m.area}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-gray-50 dark:bg-gray-950 py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-semibold text-gray-900 dark:text-gray-100">
          {t('engineeringTeam.research') || 'Active Research & Development'}
        </h2>
        <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">
          {
            t('engineeringTeam.researchDesc') ||
              'Current engineering projects focused on material performance, manufacturing quality, and product innovation.'
          }
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {
          researchAreas.map((r) => (
            <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 mb-2">
                <div class="w-2 h-2 rounded-full bg-sky-500" />
                <h3 class="font-semibold text-gray-900 dark:text-gray-100">{r.title}</h3>
              </div>
              <p class="text-sm text-gray-500 dark:text-gray-400">{r.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto py-24 px-6 text-center">
    <h2 class="text-3xl font-semibold text-gray-900 dark:text-gray-100">
      {t('engineeringTeam.join') || 'Join the Engineering Team'}
    </h2>
    <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">
      {
        t('engineeringTeam.joinDesc') ||
          'We are always looking for talented engineers in materials science, product design, and quality engineering.'
      }
    </p>
    <div class="mt-10 flex justify-center gap-4">
      <a
        href={`/${lang}/contact`}
        class="px-10 py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-full font-semibold hover:bg-gray-800 dark:hover:bg-gray-100 transition"
        >{t('engineeringTeam.cta') || 'Contact Us'}</a
      >
      <a
        href={`/${lang}/about/aquafarer`}
        class="px-10 py-4 border-2 border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 rounded-full font-semibold hover:border-gray-400 transition"
        >{t('engineeringTeam.about') || 'About Aquafarer'}</a
      >
    </div>
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Aquafarer R&D and engineering team: 25+ engineers across materials science, product design, quality assurance, and
      production engineering. Key personnel include Peng Zhang (Director of Engineering, 18 years), Lina Chen (Senior
      Materials Engineer, PVC/Hypalon specialist), Wei Liu (Product Design Lead, 40+ platforms), James Huang (Quality
      Systems Manager, lead auditor), Mei Wang (RIB/Hypalon fabrication specialist, 14 years), and Dong Li (OEM/ODM
      Project Engineer, 9 years). Active research areas: drop-stitch core density optimization, low-volatile PVC
      formulation, Hypalon-to-aluminum bond reliability, and automated QC vision systems. Based in Qingdao, China. CE
      and certified facility.
    </p>
  </section>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
