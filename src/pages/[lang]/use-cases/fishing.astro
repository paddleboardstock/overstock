---
export const prerender = true;

import PageLayout from '~/layouts/PageLayout.astro';
import { getLangFromUrl } from '~/i18n/utils';
import { languages } from '~/i18n/config';
import { articleSchema } from '~/lib/seo/schema';
import { nodes } from '~/content/graph/nodes';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/fishing.ts';
import { getUiForLang } from '~/i18n/generated/ui-all';
const t = (key: string) => getUiForLang(lang)?.[key] || '';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
setPageContentData(__pageData);
const page = getPageContent(lang, 'fishing');
const fishingNode = nodes.find((n) => n.id === 'fishing');

const graphJsonLd = fishingNode
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        articleSchema({
          headline: page.seo?.headline || 'Fishing from an Inflatable SUP: Complete Guide',
          description:
            page.seo?.description ||
            'Learn why inflatable paddle boards are excellent fishing platforms — stability, portability, gear compatibility, and recommended board types.',
          datePublished: page.seo?.datePublished || '2024-03-01',
          dateModified: page.seo?.dateModified || '2026-06-01',
          author: 'Paddle Board Overstock',
          publisher: 'Paddle Board Overstock',
        }),
        {
          '@type': 'Product',
          name: fishingNode.name.en,
          description: fishingNode.description.en,
          brand: { '@type': 'Brand', name: 'Paddle Board Overstock' },
          category: 'Water Sports Equipment',
        },
      ],
    }
  : null;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: t('faq.useCasesFishing.q1.q') || 'What inflatable fishing paddle boards are available?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          t('faq.useCasesFishing.q1.a') ||
          'Stable, wide fishing SUP boards with fishing accessories. Rod holders, fish finder mounts, and reinforced decking for fishing applications.',
      },
    },
    {
      '@type': 'Question',
      name: t('faq.useCasesFishing.q2.q') || 'Are these suitable for saltwater fishing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          t('faq.useCasesFishing.q2.a') ||
          'Yes. Our UV-resistant PVC boards handle recreational coastal and saltwater fishing; rinse with fresh water after use.',
      },
    },
    {
      '@type': 'Question',
      name: t('faq.useCasesFishing.q3.q') || 'Can fishing-specific features be added?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          t('faq.useCasesFishing.q3.a') ||
          'Yes. Rod holders, live wells, fish finder mounts, and custom seating configurations for fishing applications.',
      },
    },
  ],
});
---

<PageLayout
  metadata={{ title: page.seo?.headline || page.headline, description: page.seo?.description || page.subtitle }}
>
  <script
    slot="before"
    is:inline
    type="application/ld+json"
    set:html={graphJsonLd ? JSON.stringify(graphJsonLd) : ''}
  />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{page.label || 'Use Case'}</span>
    <h1 class="font-semibold text-gray-900 dark:text-gray-100 mt-4 text-4xl">
      {page.headline || 'Fishing from an Inflatable SUP'}
    </h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mt-3">
      {
        page.subtitle ||
          'Why inflatable paddle boards are becoming the go-to choice for anglers who want quiet, shallow-water access to the best fishing spots.'
      }
    </p>

    <div class="mt-12 prose prose-gray dark:prose-invert max-w-none" set:html={page.body || ''} />
  </section>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</PageLayout>
