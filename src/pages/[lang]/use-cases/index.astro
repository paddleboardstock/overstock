---
const PAGE_META: Record<string, { title: string }> = {
  de: { title: 'Anwendungsfälle & Einsatzgebiete' },
  es: { title: 'Casos de uso y aplicaciones' },
  fr: { title: "Cas d'utilisation et applications" },
  it: { title: 'Casi d’uso e applicazioni' },
  pt: { title: 'Casos de uso e aplicações' },
  ar: { title: 'حالات الاستخدام والتطبيقات' },
  ru: { title: 'Сценарии использования и области применения' },
  pl: { title: 'Przypadki użycia i zastosowania' },
  nl: { title: 'Use cases en toepassingen' },
  sv: { title: 'Användningsfall och tillämpningar' },
  no: { title: 'Bruksområder og anvendelser' },
  el: { title: 'Περιπτώσεις χρήσης και εφαρμογές' },
  fi: { title: 'Käyttötapaukset ja sovellukset' },
  da: { title: 'Brugsscenarier og anvendelser' },
  cs: { title: 'Případy použití a oblasti použití' },
  ja: { title: 'ユースケースと応用分野' },
};
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { pageContentData } from '~/i18n/generated/site-data';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const d = pageContentData[`${lang}/site-use-cases`] || pageContentData['en/site-use-cases'] || {};
const yamlCases: any[] = d.cases ?? [];

const staticUseCases = [
  { id: 'tourism-recreation', title: t('useCase.tourismRecreation'), desc: t('useCase.tourismRecreation.desc') },
  { id: 'search-and-rescue', title: t('useCase.searchAndRescue'), desc: t('useCase.searchAndRescue.desc') },
  { id: 'maritime-safety-defense', title: t('useCase.maritimeSafety'), desc: t('useCase.maritimeSafety.desc') },
  { id: 'fishing', title: t('useCase.fishing'), desc: t('useCase.fishing.desc') },
  { id: 'disaster-relief', title: t('useCase.disasterRelief'), desc: t('useCase.disasterRelief.desc') },
  { id: 'commercial-workboats', title: t('useCase.commercialWorkboats'), desc: t('useCase.commercialWorkboats.desc') },
];

const allUseCases = [
  ...yamlCases.map((c: any) => ({
    id: c.id,
    title: t(`home.useCases.${c.id}.title`) || c.title,
    desc: t(`home.useCases.${c.id}.desc`) || c.desc,
    image: c.image,
  })),
  ...staticUseCases.map((s) => ({
    ...s,
    image:
      s.id === 'tourism-recreation'
        ? 'https://assets.aquafarer.com/images/aquafarer/use-cases/aquafarer-professional-use-case.webp'
        : s.id === 'search-and-rescue'
          ? 'https://assets.aquafarer.com/images/aquafarer/categories/aquafarer-rescue-operations.webp'
          : s.id === 'maritime-safety-defense'
            ? 'https://assets.aquafarer.com/images/aquafarer/products/rib/aquafarer-rib-600.webp'
            : s.id === 'fishing'
              ? 'https://assets.aquafarer.com/images/aquafarer/products/aquafarer-inflatable-boat.webp'
              : s.id === 'disaster-relief'
                ? 'https://assets.aquafarer.com/images/aquafarer/products/rib/aquafarer-rib-330-boat.webp'
                : 'https://assets.aquafarer.com/images/aquafarer/factory/aquafarer-stock-boat-inventory.webp',
  })),
];

const metadata = {
  title: PAGE_META[lang]?.title || `Use Cases & Applications | ${SITE.name}`,
  description: t('useCase.hubDesc'),
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: 'Use Cases & Applications',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />

  <div class="max-w-6xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href={`/${lang}/`} class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{t('useCase.label')}</span>
    </nav>

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{t('home.useCases.tagline')}</span>
      <h1 class="mt-4 text-4xl font-bold text-gray-900">{t('useCase.hubTitle')}</h1>
      <p class="mt-4 text-lg text-gray-500">{t('useCase.hubDesc')}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        allUseCases.map((uc) => (
          <a
            href={`/${lang}/use-cases/${uc.id}`}
            class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-0.5 flex flex-col"
          >
            <div class="h-44 bg-gray-100 overflow-hidden">
              <img
                src={uc.image}
                alt={uc.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h2 class="text-lg font-semibold text-gray-900 group-hover:text-sky-700 transition-colors mb-2">
                {uc.title}
              </h2>
              <p class="text-sm text-gray-500 line-clamp-3 flex-1">{uc.desc}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-sky-700">
                {t('useCase.view')}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
