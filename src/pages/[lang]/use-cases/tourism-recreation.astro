---
export const prerender = true;

import PageLayout from '~/layouts/PageLayout.astro';
import { getLangFromUrl } from '~/i18n/utils';
import { languages } from '~/i18n/config';
import { articleSchema } from '~/lib/seo/schema';
import { nodes } from '~/content/graph/nodes';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/tourism-recreation.ts';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
setPageContentData(__pageData);
const page = getPageContent(lang, 'tourism-recreation');
const tourismNode = nodes.find((n) => n.id === 'tourism-recreation');

const graphJsonLd = tourismNode
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        articleSchema({
          headline: page.seo?.headline || 'Inflatable Boats for Tourism & Recreation — OEM Manufacturing',
          description:
            page.seo?.description ||
            'Paddle Board Overstock manufactures premium inflatable boats for tourism and recreation: whitewater rafts, fishing boats, dinghies, SUP boards. OEM/ODM with CE certification.',
          datePublished: page.seo?.datePublished || '2024-06-01',
          dateModified: page.seo?.dateModified || '2026-06-01',
          author: 'Paddle Board Overstock',
          publisher: 'Paddle Board Overstock',
        }),
        {
          '@type': 'Product',
          name: tourismNode?.name?.en || 'Tourism & Recreation Inflatable Boats',
          description:
            tourismNode?.description?.en || 'Premium inflatable boats for tourism and recreation applications.',
          brand: { '@type': 'Brand', name: 'Paddle Board Overstock' },
          category: 'Tourism & Recreation Equipment',
        },
      ],
    }
  : null;

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What products are best for tourism and recreation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SUP boards for beach rental, kayaks for guided tours, and inflatable boats for island hopping. Commercial-grade for daily use.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the MOQ for tourism operators?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '5-10 units per SKU for SUP and kayaks. Mixed-model containers available for complete tourism packages.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can tourism products be branded?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Full resort or tour operator branding on tubes, deck pads, and packaging for professional presentation.',
      },
    },
  ],
});
---

<PageLayout
  metadata={{ title: page.seo?.headline || page.headline, description: page.seo?.description || page.subtitle }}
>
  <script
    slot="before"
    is:inline
    type="application/ld+json"
    set:html={graphJsonLd ? JSON.stringify(graphJsonLd) : ''}
  />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{page.label || 'Use Case'}</span>
    <h1 class="font-semibold text-gray-900 dark:text-gray-100 mt-4 text-4xl">
      {page.headline || 'Engineering Perfection in Inflatable Boat Manufacturing'}
    </h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mt-3">
      {
        page.subtitle ||
          'From whitewater rafting to yacht tenders, Paddle Board Overstock sets the benchmark for durability and performance.'
      }
    </p>

    <div class="mt-12 prose prose-gray dark:prose-invert max-w-none" set:html={page.body || ''} />
  </section>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</PageLayout>
