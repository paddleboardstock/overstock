---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import JsonLd from '~/components/common/JsonLd.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import Icon from '~/components/ui/Icon.astro';
import { buildGraph } from '~/utils/schema-graph';
import { getProducts } from '~/utils/products';
import { getLocalizedProducts } from '~/utils/product-i18n';
import { pageContentData } from '~/i18n/generated/site-data';
import { languages as langMap, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/home.ts';

export async function getStaticPaths() {
  return Object.keys(langMap).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const L = (p: string) => `/${lang}${p || '/'}`;
setPageContentData(__pageData);
const page = getPageContent(lang);
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const heroTitle = String(page?.hero?.title || SITE.name)
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const truncateTo = (s: string, max: number): string => {
  if (s.length <= max) return s;
  const cut = s.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > max * 0.6 ? cut.slice(0, lastSpace) : cut) + '…';
};
const heroSubtitle = truncateTo(
  String(page?.hero?.subtitle || SITE?.description || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim(),
  155
);
const metadata = {
  title: heroTitle || SITE.name,
  description: heroSubtitle || SITE?.description,
};

interface HeroSlide {
  image: string;
  label: string;
  categories: string[];
}
const heroImagesData = pageContentData[`${lang}/site-hero-images`] || pageContentData['en/site-hero-images'] || {};
const heroSlides: HeroSlide[] = (heroImagesData as any)?.slides?.filter((s: any) => s?.image?.trim()) || [
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp',
    label: 'Inflatable SUP Boards',
    categories: ['SUP'],
  },
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp',
    label: 'SUP Packages',
    categories: ['SUP'],
  },
];

const techCardsData = pageContentData[`${lang}/site-tech-cards`] || pageContentData['en/site-tech-cards'] || {};
const productVisualsData =
  pageContentData[`${lang}/site-product-visuals`] || pageContentData['en/site-product-visuals'] || {};
const testimonialsData = pageContentData[`${lang}/site-testimonials`] || pageContentData['en/site-testimonials'] || {};

const siteBase = String(SITE.site).replace(/\/+$/, '');

const defaultVisuals: Record<string, string> = {
  'sup-explorer-11':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-sup-allround-board.webp',
  'oars-pump-set':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-electric-pump.webp',
};
const rawVisuals = ((productVisualsData as any)?.visuals || []) as Array<{ id: string; image: string }>;
const yamlVisuals = Object.fromEntries(rawVisuals.map((v) => [v.id, v.image]).filter(([, img]) => img));
const productVisuals: Record<string, string> = { ...defaultVisuals, ...yamlVisuals };

const rawTestimonials = ((testimonialsData as any)?.testimonials || []) as Array<{
  name: string;
  quote: string;
  rating: number;
}>;
const testimonials = [0, 1, 2]
  .map((i) => ({
    quote: t(`home.community.review${i + 1}`) || rawTestimonials[i]?.quote || '',
    name: t(`home.community.review${i + 1}.author`) || rawTestimonials[i]?.name || '',
    rating: rawTestimonials[i]?.rating || 5,
  }))
  .filter((x) => x.quote);

const techCards = (
  ((techCardsData as any)?.cards || []) as Array<{
    badge: string;
    title: string;
    description: string;
    image?: string;
  }>
).slice(0, 3);

const allProducts = await getProducts();
const inventoryProducts = allProducts.filter((p) => !p.draft);
const localizedProducts = getLocalizedProducts(lang || defaultLang);
const localizedById = new Map(localizedProducts.map((lp) => [lp.id, lp]));

interface FaqItem {
  q: string;
  a: string;
  category?: string;
}
const defaultFaqItems: FaqItem[] = [
  {
    q: 'Is SUP hard to learn?',
    a: 'Not at all. Most beginners stand up and paddle within their first session. Our All-Around SUP series features extra-wide stable platforms designed specifically for first-time paddlers. Start on calm water and you will be cruising in minutes.',
    category: 'sup',
  },
  {
    q: 'What is the weight limit?',
    a: 'Our All-Around SUPs support up to 220 lbs. The Touring and Yoga series support up to 250 lbs. Every product page lists the exact rider weight capacity so you can match the board to your needs.',
    category: 'sup',
  },
  {
    q: 'Can I travel with an inflatable SUP?',
    a: 'Absolutely. Every Paddle Board Overstock board packs into a backpack-sized carrying case. At just 18-22 lbs, it is easy to carry to the beach, lake, or through airport terminals. Check your airline baggage policy before travel.',
    category: 'sup',
  },
  {
    q: 'What comes in the box?',
    a: 'Every Paddle Board Overstock SUP includes the board, a travel backpack, dual-action hand pump, removable fin, coil leash, and repair kit. Some models also include a carbon paddle upgrade option.',
    category: 'sup',
  },
  {
    q: 'Why are your prices lower than retail?',
    a: 'We sell factory overstock — brand-new boards left over from completed production orders — sourced from our own Weihai manufacturing base and selected production partners. No retail markups and no middlemen means complete SUP packages at up to 60% off typical retail prices.',
    category: 'orders',
  },
  {
    q: 'How do I place an order and pay?',
    a: 'Add your SUP package to the cart and check out securely with Stripe or PayPal. We accept all major credit and debit cards. Every order is confirmed by email with a full invoice.',
    category: 'orders',
  },
  {
    q: 'Do you ship worldwide?',
    a: 'Yes. We ship to 50+ countries across the EU, North America, Asia-Pacific, the Middle East, and Africa. In-stock orders typically ship within 2-3 business days with tracking provided for every parcel.',
    category: 'orders',
  },
  {
    q: 'What warranty do SUP boards include?',
    a: 'Every SUP board and accessory is covered by a 2-year warranty — including the board itself, drop-stitch seams, and inflation valves. Claims are resolved in days, not weeks: file online and we repair or replace.',
    category: 'orders',
  },
];
const faqData = page.faqs ?? {};
const faqItems: FaqItem[] = faqData?.items?.length
  ? faqData.items.map((f: any) => ({ q: f.title, a: f.description, category: f.category || 'all' }))
  : defaultFaqItems;
const faqLd = faqItems.map((f) => ({ question: f.q, answer: f.a }));
const faqCategories = Array.from(new Set(faqItems.map((f) => f.category).filter((c) => c && c !== 'all'))).map((c) => ({
  id: c as string,
  label: t(`faq.tab.${c}`) || (c as string),
}));

interface HeroAction {
  text: string;
  href: string;
  icon: string;
}
const heroActions: HeroAction[] =
  page.hero?.actions?.length > 0
    ? page.hero.actions.map((a: any) => ({ text: a.text, href: L(a.href || '/contact'), icon: a.icon }))
    : [
        { text: t('cta.shopOverstock') || 'Shop Overstock Deals', href: L('/supboard/'), icon: '' },
        { text: t('cta.browseSup') || 'View Available SUP Boards', href: L('/products/'), icon: '' },
        { text: t('cta.shippingInfo') || 'Shipping Information', href: L('/international-shipping/'), icon: '' },
      ];
---

<Layout metadata={metadata} disableGlobalLd>
  {heroSlides[0]?.image && <link rel="preload" as="image" href={heroSlides[0].image} fetchpriority="high" />}
  <meta
    name="ai-intent"
    content="inflatable-sup-overstock,sup-clearance-deals,discount-paddle-board-packages,sup-packages-on-sale,overstock-sup-boards,wholesale-sup-boards,mixed-model-wholesale,buy-inflatable-sup"
  />
  <meta name="last-modified" content="2026-11-04" />

  <!-- 1. Hero -->
  <section
    class="relative min-h-[90vh] flex items-center overflow-hidden"
    style="background: linear-gradient(135deg, #06b6d4, #22d3ee);"
  >
    {
      heroSlides.map((slide, _i) => (
        <div
          data-carousel-slide
          class="absolute inset-0 transition-opacity duration-700 ease-in-out {_i === 0 ? 'opacity-100' : 'opacity-0'}"
        >
          <img
            src={slide.image}
            alt={slide.label || 'Paddle Board Overstock overstock SUP boards'}
            class="w-full h-full object-cover"
            width="1600"
            height="900"
            loading={_i === 0 ? 'eager' : 'lazy'}
            fetchpriority={_i === 0 ? 'high' : 'auto'}
          />
          <div
            class="absolute inset-0"
            style="background: linear-gradient(135deg, rgba(6,182,212,0.75), rgba(34,211,238,0.55));"
          />
        </div>
      ))
    }
    <!-- Wave animation SVG -->
    <div class="absolute bottom-0 left-0 right-0 h-24 md:h-32 z-10">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="w-full h-full">
        <path
          d="M0,40 C360,120 720,0 1080,80 C1260,120 1350,60 1440,40 L1440,120 L0,120 Z"
          fill="#f8fafc"
          opacity="0.15"></path>
        <path
          d="M0,60 C240,20 480,100 720,60 C960,20 1200,100 1440,60 L1440,120 L0,120 Z"
          fill="#f8fafc"
          opacity="0.1"
          style="animation: waveMove 6s ease-in-out infinite alternate;"></path>
      </svg>
    </div>
    <!-- Floating glow orbs -->
    <div class="absolute top-20 left-10 w-72 h-72 rounded-full bg-white/5 blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <div class="flex items-center gap-12">
        <div class="flex-1 text-center md:text-left">
          <div class="reveal">
            <span class="inline-block text-xs font-medium tracking-[0.2em] uppercase text-white/70 mb-4"
              >{
                page.hero?.tagline ||
                  t('hero.taglineSection') ||
                  'Overstock &amp; Clearance · Brand-New Boards · Ships Worldwide · Since 2012'
              }</span
            >
            <h1
              class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.1] text-balance text-white drop-shadow-xl"
              set:html={page.hero?.title || 'Inflatable SUP Boards at Overstock &amp; Clearance Prices — Up to 60% Off'}
            />
            <p
              class="mt-6 text-lg md:text-xl text-white/85 max-w-xl text-pretty leading-relaxed"
              set:html={page.hero?.subtitle ||
                `<strong class="text-white font-semibold">Paddle Board Overstock</strong> — brand-new inflatable SUP packages from completed production orders.<br /> Every package includes board, pump, paddle, leash &amp; backpack.<br /> 2-year warranty. Secure checkout. Shipping to 50+ countries.`}
            />
            <div class="mt-10 flex items-center gap-4 flex-wrap justify-center md:justify-start">
              {
                heroActions.map((action, i) =>
                  i < 2 ? (
                    <a
                      href={action.href}
                      class:list={[
                        'inline-flex items-center gap-2 rounded-full font-semibold transition-all',
                        i === 0
                          ? 'px-8 py-4 bg-[#fb923c] hover:bg-orange-600 text-white shadow-lg hover:shadow-xl hover:-translate-y-0.5'
                          : 'px-8 py-4 border-2 border-white/40 text-white font-medium hover:bg-white/10 backdrop-blur-sm',
                      ]}
                    >
                      {action.icon && <Icon name={action.icon} class="w-5 h-5" />}
                      {action.text}
                      {i === 0 && <span>→</span>}
                    </a>
                  ) : (
                    <a
                      href={action.href}
                      class="inline-flex items-center gap-2 px-6 py-3 border border-white/30 text-white/80 text-sm font-medium rounded-full hover:bg-white/10 transition-all backdrop-blur-sm"
                    >
                      {action.icon && <Icon name={action.icon} class="w-5 h-5" />}
                      {action.text}
                    </a>
                  )
                )
              }
            </div>
          </div>
        </div>
        <div class="hidden lg:block flex-1">
          <div class="relative">
            <img
              src="https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp"
              alt={page.hero?.image?.alt || 'SUP Ocean Voyager'}
              class="w-full max-w-md mx-auto object-contain drop-shadow-2xl"
              style="filter: drop-shadow(0 20px 60px rgba(0,0,0,0.2)); animation: floatBoard 4s ease-in-out infinite;"
            />
          </div>
        </div>
      </div>
    </div>
    <!-- Carousel dots -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-3">
      {
        heroSlides.map((_, _i) => (
          <button
            data-carousel-dot
            class="w-2.5 h-2.5 rounded-full transition-all duration-300 border border-white/50 {_i === 0 ? 'bg-white scale-125' : 'bg-transparent'}"
          />
        ))
      }
    </div>
  </section>

  <JsonLd type="FAQPage" faqs={faqLd} />
  <JsonLd type="BreadcrumbList" breadcrumbs={[{ name: t('nav.home') || 'Home', item: L('/') }]} />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: t('home.overstock.inventory.title') || 'Available Overstock Inventory',
      itemListElement: inventoryProducts.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: localizedById.get(p.id)?.name || p.title,
        url: `${siteBase}${L(p.permalink)}`,
      })),
    })}
  />

  <!-- 2. Available Overstock Inventory -->
  <section id="products" class="max-w-6xl mx-auto py-12 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-semibold text-[#06b6d4] tracking-[0.15em] uppercase"
        >{t('home.overstock.inventory.badge') || 'Overstock Inventory'}</span
      >
      <h2 class="mt-4 text-4xl font-bold text-gray-900">
        {t('home.overstock.inventory.title') || 'Available Overstock Inventory'}
      </h2>
      <p class="mt-4 text-lg text-gray-500">
        {
          t('home.overstock.inventory.subtitle') ||
            'Brand-new boards from completed production orders — limited stock, ready to ship.'
        }
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        inventoryProducts.map((p) => {
          const loc = localizedById.get(p.id);
          const img = productVisuals[p.id] || p.image || '';
          return (
            <a
              href={L(p.permalink)}
              class="group bg-white rounded-2xl overflow-hidden border border-gray-200 hover:shadow-xl transition-all duration-300 flex flex-col"
            >
              <div class="h-56 bg-gradient-to-br from-gray-100 to-gray-200 relative overflow-hidden">
                {img ? (
                  <>
                    <img
                      src={img}
                      alt={loc?.name || p.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
                  </>
                ) : (
                  <div class="flex items-center justify-center h-full text-gray-400 text-sm">{p.category}</div>
                )}
                <div class="absolute top-3 left-3 flex flex-col gap-2">
                  {p.inStock && (
                    <span class="px-2.5 py-1 bg-emerald-500/90 text-white text-xs font-semibold rounded-full shadow">
                      {t('home.overstock.inventory.inStock') || 'In-Stock'}
                    </span>
                  )}
                  {p.grade && (
                    <span class="px-2.5 py-1 bg-sky-600/90 text-white text-xs font-semibold rounded-full shadow">
                      {t('home.overstock.inventory.grade') || 'Grade'} {p.grade}
                    </span>
                  )}
                </div>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-semibold text-gray-900 text-lg group-hover:text-[#06b6d4] transition-colors">
                    {loc?.name || p.title}
                  </h3>
                  {p.price && <span class="text-xl font-bold text-gray-900 shrink-0">${p.price.amount}</span>}
                </div>
                <p class="text-gray-500 mt-2 text-sm line-clamp-2">{loc?.desc || p.summary}</p>
                {p.price?.note && <p class="mt-2 text-xs text-gray-400">{p.price.note}</p>}
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[#06b6d4] group-hover:gap-2 transition-all">
                  {t('home.overstock.inventory.viewDeal') || 'View Deal'} <span>→</span>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
    <p class="mt-8 text-center text-sm text-gray-400">
      {
        t('home.overstock.inventory.retailerNote') ||
          'Overstock quantities change as batches sell out — availability is shown per board. Retailers buying 5-20 boards: see our wholesale program.'
      }
    </p>
  </section>

  <!-- 3. Why Buy Overstock SUP Boards? -->
  <section class="bg-gray-50 py-12 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-sm font-semibold text-[#06b6d4] tracking-[0.15em] uppercase"
          >{t('home.overstock.why.badge') || 'Why Overstock'}</span
        >
        <h2 class="mt-4 text-4xl font-bold text-gray-900">
          {t('home.overstock.why.title') || 'Why Buy Overstock SUP Boards?'}
        </h2>
        <p class="mt-4 text-lg text-gray-500">
          {t('home.overstock.why.subtitle') || 'The same brand-new boards retailers sell — without the retail markup.'}
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-sky-50 rounded-xl flex items-center justify-center">
            <Icon name="tabler:package" class="w-7 h-7 text-[#06b6d4]" />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-gray-900">
            {t('home.overstock.why.source.title') || 'Where Our Inventory Comes From'}
          </h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              t('home.overstock.why.source.desc') ||
                'Our stock is mixed-sourced: surplus boards from our own Weihai production base, plus carefully selected overstock from manufacturing partners we have worked with for years. Every board is inspected before it joins the inventory.'
            }
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-sky-50 rounded-xl flex items-center justify-center">
            <Icon name="tabler:credit-card" class="w-7 h-7 text-[#06b6d4]" />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-gray-900">
            {t('home.overstock.why.cost.title') || 'Why It Costs Less'}
          </h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              t('home.overstock.why.cost.desc') ||
                'Overstock means boards already produced for completed orders. There is no retail markup, no distributor margin, and no cost of carrying idle inventory — so complete packages sell at up to 60% off typical retail.'
            }
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-sky-50 rounded-xl flex items-center justify-center">
            <Icon name="tabler:check" class="w-7 h-7 text-[#06b6d4]" />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-gray-900">
            {t('home.overstock.why.new.title') || 'Brand-New, Never Used'}
          </h3>
          <p class="mt-3 text-sm text-gray-500 leading-relaxed">
            {
              t('home.overstock.why.new.desc') ||
                'Overstock is not second-hand. Every board is brand-new and unused — factory-fresh overstock inventory in limited stock, complete with full package accessories and warranty.'
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Complete SUP Packages -->
  <section class="max-w-6xl mx-auto py-12 px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-semibold text-[#06b6d4] tracking-[0.15em] uppercase"
        >{t('home.overstock.packages.badge') || 'Complete Packages'}</span
      >
      <h2 class="mt-4 text-4xl font-bold text-gray-900">
        {t('home.overstock.packages.title') || 'Every Board Ships as a Complete SUP Package'}
      </h2>
      <p class="mt-4 text-lg text-gray-500">
        {
          t('home.overstock.packages.subtitle') ||
            'No hidden extras — the listed price includes everything you need to get on the water.'
        }
      </p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-16">
      {
        [
          { badge: 'SUP', key: 'board' },
          { badge: 'PMP', key: 'pump' },
          { badge: 'PDL', key: 'paddle' },
          { badge: 'FIN', key: 'fin' },
          { badge: 'BPK', key: 'backpack' },
          { badge: 'REP', key: 'repairKit' },
        ].map((item) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6 text-center hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-sky-50 border border-sky-100 rounded-xl flex items-center justify-center mx-auto text-sm font-bold text-[#06b6d4]">
              {item.badge}
            </div>
            <p class="mt-3 text-sm font-semibold text-gray-900">
              {t(`home.overstock.packages.${item.key}`) ||
                (item.key === 'board'
                  ? 'Paddle Board'
                  : item.key === 'pump'
                    ? 'Hand Pump'
                    : item.key === 'paddle'
                      ? 'Paddle'
                      : item.key === 'fin'
                        ? 'Removable Fin'
                        : item.key === 'backpack'
                          ? 'Backpack'
                          : 'Repair Kit')}
            </p>
          </div>
        ))
      }
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {
        techCards.map((card) => (
          <div class="relative bg-white border border-gray-200 rounded-2xl p-8 text-center hover:shadow-md transition-shadow overflow-hidden">
            <div class="absolute inset-0">
              <img
                src={
                  card.image ||
                  'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp'
                }
                alt={card.title || 'Paddle Board Overstock technology'}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-white/75" />
            </div>
            <div class="relative">
              <div class="w-20 h-20 bg-white/90 border border-gray-200 rounded-2xl flex items-center justify-center mx-auto text-3xl font-bold text-gray-700">
                {card.badge || '?'}
              </div>
              <h3 class="mt-6 text-lg font-semibold text-gray-900">{card.title || ''}</h3>
