---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { getLocalizedProducts } from '~/utils/product-i18n';

import AiQuickAnswer from '~/components/common/AiQuickAnswer.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import Tldr from '~/components/common/Tldr.astro';
import Icon from '~/components/ui/Icon.astro';
import { guides } from '~/data/guides';
import cfg from '~/config.yaml';
const branding = (cfg as any)?.branding || {};
import { pageContentData } from '~/i18n/generated/site-data';
import { languages as langMap, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/home.ts';

export async function getStaticPaths() {
  return Object.keys(langMap).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const L = (p: string) => `/${lang}${p || '/'}`;
setPageContentData(__pageData);
const page = getPageContent(lang);
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const heroTitle = String(page?.hero?.title || SITE.name)
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const truncateTo = (s: string, max: number): string => {
  if (s.length <= max) return s;
  const cut = s.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > max * 0.6 ? cut.slice(0, lastSpace) : cut) + '…';
};
const heroSubtitle = truncateTo(
  String(page?.hero?.subtitle || SITE?.description || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim(),
  155
);
const metadata = {
  title: heroTitle || SITE.name,
  description: heroSubtitle || SITE?.description,
};

interface HeroSlide {
  image: string;
  label: string;
  categories: string[];
}
const heroImagesData = pageContentData[`${lang}/site-hero-images`] || pageContentData['en/site-hero-images'] || {};
const heroSlides: HeroSlide[] = (heroImagesData as any)?.slides?.filter((s: any) => s?.image?.trim()) || [
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp',
    label: 'Inflatable SUP Boards',
    categories: ['SUP'],
  },
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp',
    label: 'SUP Packages',
    categories: ['SUP'],
  },
  {
    image:
      'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/categories/paddleboardoverstock-accessories-category.webp',
    label: 'Accessories',
    categories: ['ACCESSORY'],
  },
];

const topGuidesData = pageContentData[`${lang}/site-top-guides`] || pageContentData['en/site-top-guides'] || {};
const techCardsData = pageContentData[`${lang}/site-tech-cards`] || pageContentData['en/site-tech-cards'] || {};
const productVisualsData =
  pageContentData[`${lang}/site-product-visuals`] || pageContentData['en/site-product-visuals'] || {};
const useCasesData = pageContentData[`${lang}/site-use-cases`] || pageContentData['en/site-use-cases'] || {};
const proofPointsData = pageContentData[`${lang}/site-proof-points`] || pageContentData['en/site-proof-points'] || {};
const testimonialsData = pageContentData[`${lang}/site-testimonials`] || pageContentData['en/site-testimonials'] || {};
const learnData = pageContentData[`${lang}/site-learning-center`] || pageContentData['en/site-learning-center'] || {};

const topGuideSlugs = topGuidesData.guides || ['how-to-choose-your-sup', 'beginner-guide', 'safety-tips'];
const homeGuides = guides.filter((g) => topGuideSlugs.includes(g.slug));
const siteBase = String(SITE.site).replace(/\/+$/, '');

const defaultVisuals: Record<string, string> = {
  'sup-explorer-11':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-sup-allround-board.webp',
  'life-vest-classic':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-life-vest-classic.webp',
  'life-vest-pro':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-life-vest-pro-front.webp',
  'oars-pump-set':
    'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/paddleboardoverstock-electric-pump.webp',
};
const rawVisuals = ((productVisualsData as any)?.visuals || []) as Array<{ id: string; image: string }>;
const yamlVisuals = Object.fromEntries(rawVisuals.map((v) => [v.id, v.image]).filter(([, img]) => img));
const productVisuals: Record<string, string> = { ...defaultVisuals, ...yamlVisuals };

const defaultUseCases = [
  {
    title: 'Beginner Paddling',
    desc: 'Stable inflatable SUP boards for first-time paddlers.',
    scenario:
      'A family visiting a lake for the weekend wants to try paddle boarding. They need stable, easy-to-launch equipment with clear safety guidance.',
    solution:
      'The SUP Explorer 11 provides wide-body stability for beginners. The Life Vest Classic ensures CE-certified flotation. The Oars & Pump Set inflates the board in under 10 minutes.',
    products: ['SUP Explorer 11', 'Life Vest Classic', 'Oars & Pump Set'],
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp',
  },
  {
    title: 'Touring & Exploration',
    desc: 'Long-distance inflatable SUP boards for lakes, rivers, and coastal trips.',
    scenario:
      'An outdoor enthusiast plans a week-long paddling trip and needs a board that packs small, inflates at camp, and tracks straight on open water.',
    solution:
      'The Ocean Voyager Series glides efficiently with a touring outline and holds course in wind and chop. Its drop-stitch construction inflates to 15 PSI for hard-board rigidity.',
    products: ['Ocean Voyager Series', 'Oars & Pump Set', 'Life Vest Classic'],
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp',
  },
  {
    title: 'SUP Yoga & Fitness',
    desc: 'Extra-wide, stable platforms for yoga, fitness, and relaxation.',
    scenario:
      'A yoga practitioner wants a floating studio for morning sessions on calm water, with enough deck space to hold every pose.',
    solution:
      'The Flowing Lotus Series features a full-length deck pad and a wide beam for wobble-free poses. It doubles as a stable platform for light fitness workouts.',
    products: ['Flowing Lotus Series', 'Oars & Pump Set', 'Life Vest Classic'],
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-flowing-lotus-1.webp',
  },
  {
    title: 'Family Recreation',
    desc: 'Complete SUP packages for weekend lake days and holidays.',
    scenario:
      'A family of four wants stable boards for weekend lake outings and beach holidays, gear that packs into the car and inflates in minutes.',
    solution:
      'The Tropical Breeze Series is a stable all-around board the whole family can share, while the Medusa Glow Series is lighter and shorter for kids. Both pack into backpacks for easy travel.',
    products: ['Tropical Breeze Series', 'Medusa Glow Series', 'Life Vest Classic'],
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-tropical-breeze-1.webp',
  },
];
const rawCases = ((useCasesData as any)?.cases || []) as Array<{
  id: string;
  title: string;
  desc: string;
  scenario: string;
  solution: string;
  products: string[];
  image: string;
}>;
const useCases = rawCases.length
  ? rawCases.map((u) => ({
      title: u.title,
      desc: u.desc,
      scenario: u.scenario,
      solution: u.solution,
      products: u.products,
      img: u.image,
    }))
  : defaultUseCases;

const rawPoints = ((proofPointsData as any)?.points || []) as Array<{
  id: string;
  metric: string;
  label: string;
  detail: string;
}>;
const defaultProofPoints = [
  {
    metric: '13',
    label: 'CE-certified models',
    detail: 'SUP boards and accessories certified per applicable EU directives',
  },
  { metric: '50+', label: 'countries served', detail: 'Worldwide shipping across EU, North America, Asia-Pacific' },
  {
    metric: '60%',
    label: 'off retail',
    detail: 'Factory-direct overstock and clearance pricing on complete SUP packages',
  },
  {
    metric: '2-Year',
    label: 'SUP warranty',
    detail: 'Covers boards, drop-stitch seams, inflation valves, and accessories',
  },
];
const proofPoints = rawPoints.length
  ? rawPoints.map((p) => ({ metric: p.metric, label: p.label, detail: p.detail }))
  : defaultProofPoints;

const rawTestimonials = ((testimonialsData as any)?.testimonials || []) as Array<{
  name: string;
  quote: string;
  rating: number;
}>;
const testimonials = [0, 1, 2]
  .map((i) => ({
    quote: t(`home.community.review${i + 1}`) || rawTestimonials[i]?.quote || '',
    name: t(`home.community.review${i + 1}.author`) || rawTestimonials[i]?.name || '',
    rating: rawTestimonials[i]?.rating || 5,
  }))
  .filter((x) => x.quote);

const catalogCategories = [
  {
    key: 'SUP',
    label: t('home.catalog.sup') || 'SUP Boards',
    desc:
      t('home.catalog.sup.desc') ||
      'Inflatable stand-up paddle boards from 9 ft to 12 ft — all-round, touring, yoga, and more.',
  },
  {
    key: 'ACCESSORY',
    label: t('home.catalog.accessory') || 'Accessories',
    desc: t('home.catalog.accessory.desc') || 'Pumps, paddles, life vests, repair kits, and essential gear.',
    keys: ['ACCESSORY', 'DROPSTITCH_SEAT'],
  },
];
const localizedProducts = getLocalizedProducts(lang || defaultLang);
const groupedProducts: Record<string, typeof localizedProducts> = {};
for (const cat of catalogCategories) {
  const keys: string[] = cat.keys ?? [cat.key];
  groupedProducts[cat.key] = localizedProducts.filter((p) => keys.includes(p.category)).slice(0, 6);
}

const catLabelKeys: Record<string, string> = {
  SUP: 'home.catalog.sup',
  ACCESSORY: 'home.catalog.accessory',
  DROPSTITCH_SEAT: 'home.catalog.accessory',
};

const RULE_L10N_KEYS: Record<string, string> = {
  'CE certified per EN ISO 12402': 'ceEnIso',
  'all crew in PFDs at all times': 'crewPfds',
  'carry VHF radio for coastal touring': 'vhfCoastal',
  'check mounting straps for wear': 'checkStraps',
  'check weather before departure': 'weatherDeparture',
  'check weather before paddling': 'weatherPaddling',
  'communications check before departure': 'commsCheck',
  'crew must be trained': 'crewTrained',
  'daily safety inspection required': 'dailyInspection',
  'distribute load evenly': 'distributeLoad',
  'do not exceed max load': 'maxLoad',
  'do not exceed max pressure rating': 'maxPressure',
  'do not exceed weight rating': 'weightRating',
  'emergency beacon required for sea operations': 'beaconSea',
  'emergency kit required': 'emergencyKit',
  'engine kill switch required': 'killSwitch',
  'ensure pump is properly connected before use': 'pumpConnected',
  'guide certification mandatory': 'guideCertMandatory',
  'guide must be certified': 'guideCertified',
  'helmets required for all occupants': 'helmets',
  'leash recommended': 'leashRecommended',
  'leash recommended in wind': 'leashWind',
  'leash required': 'leashRequired',
  'life vest recommended': 'vestRecommended',
  'life vest required': 'vestRequired',
  'life vest required for all occupants': 'vestOccupants',
  'life vest required for all passengers': 'vestPassengers',
  'professional crew recommended': 'proCrew',
  'secure all gear for capsize recovery': 'secureGear',
  'secure seat before use': 'secureSeat',
  'spray skirt recommended for cold water': 'spraySkirt',
  'throw rope accessible at all times': 'throwRope',
  'VHF radio recommended': 'vhfRecommended',
  'VHF radio required': 'vhfRequired',
};
const localizeRule = (rule: string): string => t(`home.rules.${RULE_L10N_KEYS[rule] || ''}`) || rule;

const boards = [
  {
    label: t('home.boards.allAround') || 'All-Around',
    desc: t('home.boards.allAround.desc') || 'Versatile SUP boards for paddlers of all skill levels.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-cheetah-surge-1.webp',
  },
  {
    label: t('home.boards.touringSup') || 'Touring SUP',
    desc: t('home.boards.touringSup.desc') || 'Long-distance boards for exploration and adventure.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-voyager-1.webp',
  },
  {
    label: t('home.boards.ultraCompact') || 'Ultra-Compact',
    desc: t('home.boards.ultraCompact.desc') || 'Short, portable boards for easy travel and storage.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-tropical-breeze-1.webp',
  },
  {
    label: t('home.boards.ultraStable') || 'Ultra-Stable',
    desc: t('home.boards.ultraStable.desc') || 'Extra-wide platforms for maximum balance and confidence.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-leviathan-wake-1.webp',
  },
  {
    label: t('home.boards.whitewater') || 'Whitewater',
    desc: t('home.boards.whitewater.desc') || 'Rugged boards engineered for river rapids.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-dolphin-wave-1.webp',
  },
  {
    label: t('home.boards.sports') || 'Sports',
    desc: t('home.boards.sports.desc') || 'Performance boards for racing and athletic paddling.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-ocean-pulse-1.webp',
  },
  {
    label: t('home.boards.yoga') || 'Yoga',
    desc: t('home.boards.yoga.desc') || 'Spacious decks designed for yoga and fitness.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-flowing-lotus-1.webp',
  },
  {
    label: t('home.boards.surf') || 'Surf',
    desc: t('home.boards.surf.desc') || 'Agile boards for catching waves and surf riding.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-jungle-mandala-1.webp',
  },
  {
    label: t('home.boards.kidsSups') || 'Kids SUPs',
    desc: t('home.boards.kidsSups.desc') || 'Smaller, lighter boards designed for children.',
    img: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/products/sup-series/sup-medusa-glow-1.webp',
  },
];

const researchCards = [
  {
    href: L('/research/drop-stitch-technology'),
    category: t('home.research.cat.technology') || 'Technology',
    title: t('home.research.dropStitch') || 'How Drop Stitch Works',
    desc:
      t('home.research.dropStitch.desc') ||
      'The engineering behind thousands of internal threads that transform flexible PVC into a rigid high-pressure core.',
  },
  {
    href: L('/research/ce-certification-guide'),
    category: t('home.research.cat.compliance') || 'Compliance',
    title: t('home.research.ceCertification') || 'How CE Certification Works',
    desc:
      t('home.research.ceCertification.desc') ||
      'Full CE certification process for inflatable watercraft: directives, testing, notified bodies.',
  },
  {
    href: L('/research/sup-thickness-guide'),
    category: t('home.research.cat.engineering') || 'Engineering',
    title: t('home.research.supThickness') || 'How to Choose SUP Thickness',
    desc:
      t('home.research.supThickness.desc') ||
      'How board thickness affects rigidity, weight, stability, tracking, and performance.',
  },
  {
    href: L('/research/engineering-whitepaper'),
    category: t('home.research.cat.engineering') || 'Engineering',
    title: t('home.research.engineeringWhitepaper') || 'Engineering Whitepaper',
    desc:
      t('home.research.engineeringWhitepaper.desc') ||
      'Materials, construction methods, and test results behind a durable inflatable SUP.',
  },
];

interface FaqItem {
  q: string;
  a: string;
  category?: string;
}
const defaultFaqItems: FaqItem[] = [
  {
    q: 'Is SUP hard to learn?',
    a: 'Not at all. Most beginners stand up and paddle within their first session. Our All-Around SUP series features extra-wide stable platforms designed specifically for first-time paddlers. Start on calm water and you will be cruising in minutes.',
    category: 'sup',
  },
  {
    q: 'What is the weight limit?',
    a: 'Our All-Around SUPs support up to 220 lbs. The Touring and Yoga series support up to 250 lbs. Every product page lists the exact rider weight capacity so you can match the board to your needs.',
    category: 'sup',
  },
  {
    q: 'Can I travel with an inflatable SUP?',
    a: 'Absolutely. Every Paddle Board Overstock board packs into a backpack-sized carrying case. At just 18-22 lbs, it is easy to carry to the beach, lake, or through airport terminals. Check your airline baggage policy before travel.',
    category: 'sup',
  },
  {
    q: 'What comes in the box?',
    a: 'Every Paddle Board Overstock SUP includes the board, a travel backpack, dual-action hand pump, removable fin, coil leash, and repair kit. Some models also include a carbon paddle upgrade option.',
    category: 'sup',
  },
  {
    q: 'Why are your prices lower than retail?',
    a: 'We sell factory overstock and clearance batches direct from our own production facility in Weihai, China — no middlemen, no retail markup. That means complete SUP packages at up to 60% off typical retail prices, with the same CE-certified quality.',
    category: 'orders',
  },
  {
    q: 'How do I place an order and pay?',
    a: 'Add your SUP package to the cart and check out securely with Stripe or PayPal. We accept all major credit and debit cards. Every order is confirmed by email with a full invoice.',
    category: 'orders',
  },
  {
    q: 'Do you ship worldwide?',
    a: 'Yes. We ship to 50+ countries across the EU, North America, Asia-Pacific, the Middle East, and Africa. In-stock orders typically ship within 2-3 business days with tracking provided for every parcel.',
    category: 'orders',
  },
  {
    q: 'What warranty do SUP boards include?',
    a: 'Every SUP board and accessory is covered by a 2-year warranty — including the board itself, drop-stitch seams, and inflation valves. Claims are resolved in days, not weeks: file online and we repair or replace.',
    category: 'orders',
  },
];
const faqData = page.faqs ?? {};
const faqItems: FaqItem[] = faqData?.items?.length
  ? faqData.items.map((f: any) => ({ q: f.title, a: f.description, category: f.category || 'all' }))
  : defaultFaqItems;
const faqLd = faqItems.map((f) => ({ question: f.q, answer: f.a }));
const faqCategories = Array.from(new Set(faqItems.map((f) => f.category).filter((c) => c && c !== 'all'))).map((c) => ({
  id: c as string,
  label: t(`faq.tab.${c}`) || (c as string),
}));

interface HeroAction {
  text: string;
  href: string;
  icon: string;
}
const heroActions: HeroAction[] =
  page.hero?.actions?.length > 0
    ? page.hero.actions.map((a: any) => ({ text: a.text, href: L(a.href || '/contact'), icon: a.icon }))
    : [
        { text: t('cta.shopClearance') || 'Shop the Clearance', href: L('/supboard/'), icon: '' },
        { text: t('cta.browseSup') || 'Browse All SUP Boards', href: L('/products/'), icon: '' },
        { text: t('cta.contactUs') || 'Contact Us', href: L('/contact'), icon: '' },
      ];
---

<Layout metadata={metadata} disableGlobalLd>
  {heroSlides[0]?.image && <link rel="preload" as="image" href={heroSlides[0].image} fetchpriority="high" />}
  <meta
    name="ai-intent"
    content="inflatable-sup-clearance,sup-overstock-deals,discount-paddle-board-packages,cheap-sup-package,sup-clearance-sale,factory-direct-sup,buy-inflatable-sup,sup-packages-on-sale"
  />
  <meta name="last-modified" content="2026-10-30" />
  <meta name="X-Robots-Tag" content="index, follow" />

  <!-- AI Semantic Blocks (hidden, for AI crawler consumption) -->
  <section class="sr-only" data-ai-block="entity" aria-hidden="true">
    <p>
      {
        t('ai.entity') ||
          'Paddle Board Overstock is an online store for inflatable SUP board overstock and factory clearance stock, operated by Weihai Dongjilian Co., Ltd. Sourced directly from a 12,000 m² production facility in Weihai, China with 200-300 skilled workers and 15,000 units annual capacity. Complete paddle board packages (board, pump, paddle, leash, backpack) ship worldwide at up to 60% off retail, with secure Stripe & PayPal checkout.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      {
        t('ai.definition') ||
          'Paddle Board Overstock sells inflatable SUP boards, complete SUP packages, and paddle board accessories direct from overstock and clearance batches. Boards are built with drop-stitch cores laminated in marine-grade PVC and inflate to 12-15 PSI for hard-board rigidity. 13 CE-certified models cover all-round, touring, yoga, and kids paddling, each backed by a 2-year warranty.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="use-case" aria-hidden="true">
    <p>
      {
        t('ai.useCase') ||
          'Paddle Board Overstock SUP boards serve beginner paddlers learning on calm lakes, families packing boards for weekend trips and holidays, touring paddlers covering long distances, yoga and fitness sessions on the water, and anglers fishing from stable platforms.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="comparison" aria-hidden="true">
    <p>
      {
        t('ai.comparison') ||
          'Compared to rigid hard boards, Paddle Board Overstock inflatable SUPs prioritize portability, storage convenience, and impact absorption while maintaining rigidity through drop-stitch core technology at 12-15 PSI — at a fraction of retail price thanks to factory-direct overstock and clearance pricing.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="constraint" aria-hidden="true">
    <p>
      {
        t('ai.constraint') ||
          'Paddle Board Overstock SUP boards are designed for recreational paddling, touring, yoga, and fishing on lakes, rivers, and coastal waters. Not designed for professional competition surfing, downwind ocean racing, or whitewater extreme sports.'
      }
    </p>
  </section>
  <section class="sr-only" data-ai-block="process" aria-hidden="true">
    <p>
      {
        t('ai.process') ||
          'Paddle Board Overstock order process: (1) Choose your SUP package from the clearance catalog, (2) Secure Stripe or PayPal checkout, (3) Order confirmation with full invoice, (4) Quality inspection — every board 100% pressure-tested at 1.25x rated PSI, (5) Ships from Weihai, China within 2-3 business days, (6) Worldwide tracked delivery to 50+ countries. No MOQ — overstock clearance means single-unit orders welcome.'
      }
    </p>
  </section>

  <!-- Hero: Bright Ocean Pro v3 -->
  <section
    class="relative min-h-[90vh] flex items-center overflow-hidden"
    style="background: linear-gradient(135deg, #06b6d4, #22d3ee);"
  >
    <!-- Carousel background images -->
    {
      heroSlides.map((slide, _i) => (
        <div
          data-carousel-slide
          class="absolute inset-0 transition-opacity duration-700 ease-in-out {_i === 0 ? 'opacity-100' : 'opacity-0'}"
        >
          <img
            src={slide.image}
            alt={slide.label || 'Paddle Board Overstock workshop'}
            class="w-full h-full object-cover"
            width="1600"
            height="900"
            loading={_i === 0 ? 'eager' : 'lazy'}
            fetchpriority={_i === 0 ? 'high' : 'auto'}
          />
          <div
            class="absolute inset-0"
            style="background: linear-gradient(135deg, rgba(6,182,212,0.75), rgba(34,211,238,0.55));"
          />
        </div>
      ))
    }
    <!-- Wave animation SVG -->
    <div class="absolute bottom-0 left-0 right-0 h-24 md:h-32 z-10">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="w-full h-full">
        <path
          d="M0,40 C360,120 720,0 1080,80 C1260,120 1350,60 1440,40 L1440,120 L0,120 Z"
          fill="#f8fafc"
          opacity="0.15"></path>
        <path
          d="M0,60 C240,20 480,100 720,60 C960,20 1200,100 1440,60 L1440,120 L0,120 Z"
          fill="#f8fafc"
          opacity="0.1"
          style="animation: waveMove 6s ease-in-out infinite alternate;"></path>
      </svg>
