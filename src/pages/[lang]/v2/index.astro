---
const PAGE_DESC: Record<string, { description: string }> = {
  de: {
    description:
      'Aquafarer-Inhaltsbibliothek — Ratgeber, Vergleiche, Problemlösungen und Markengeschichten für Wassersportbegeisterte.',
  },
  es: {
    description:
      'Biblioteca de contenido de Aquafarer: guías, comparativas, soluciones y historias de marca para los aficionados a los deportes acuáticos.',
  },
  fr: {
    description:
      'Bibliothèque de contenu Aquafarer — guides, comparatifs, solutions pratiques et histoires de marque pour les amateurs de sports nautiques.',
  },
  it: {
    description:
      'Libreria di contenuti Aquafarer: guide, confronti, soluzioni a problemi e storie di marca per gli appassionati di sport acquatici.',
  },
  cs: {
    description:
      'Aquafarer Knihovna obsahu — Příručky, srovnání, řešení problémů a příběhy značek pro milovníky vodních sportů.',
  },
  sv: {
    description:
      'Aquafarer Innehållsbibliotek — Guider, jämförelser, problemlösningar och varumärkesberättelser för vattensportsentusiaster.',
  },
  da: {
    description:
      'Aquafarer Indholdsbibliotek — Vejledninger, sammenligninger, problemløsninger og brandhistorier for vandsportsentusiaster.',
  },
  el: {
    description:
      'Aquafarer Βιβλιοθήκη περιεχομένου — Οδηγοί, συγκρίσεις, λύσεις προβλημάτων και ιστορίες επωνυμιών για τους λάτρεις των θαλάσσιων σπορ.',
  },
  no: {
    description:
      'Aquafarer Innholdsbibliotek — Guider, sammenligninger, problemløsninger og merkevarehistorier for vannsportentusiaster.',
  },
  ru: {
    description:
      'Aquafarer Библиотека контента — руководства, сравнения, решения проблем и истории брендов для любителей водных видов спорта.',
  },
  nl: {
    description:
      'Aquafarer Inhoudsbibliotheek — Gidsen, vergelijkingen, probleemoplossingen en merkverhalen voor watersportliefhebbers.',
  },
  fi: {
    description:
      'Aquafarer Sisältökirjasto — Oppaita, vertailuja, ongelmaratkaisuja ja bränditarinoita vesiurheilun harrastajille.',
  },
  pl: {
    description:
      'Aquafarer Biblioteka treści — przewodniki, porównania, rozwiązania problemów i historie marek dla entuzjastów sportów wodnych.',
  },
  ar: {
    description:
      'Aquafarer مكتبة المحتوى — الأدلة والمقارنات وحلول المشكلات وقصص العلامات التجارية لعشاق الرياضات المائية.',
  },
  pt: {
    description:
      'Aquafarer Biblioteca de Conteúdo — Guias, comparações, soluções de problemas e histórias de marcas para entusiastas de esportes aquáticos.',
  },
  ja: {
    description:
      'Aquafarer コンテンツ ライブラリ — ウォーター スポーツ愛好家向けのガイド、比較、問題解決策、ブランド ストーリー。',
  },
};
const PAGE_META: Record<string, { title: string }> = {
  de: { title: 'Inhaltsbibliothek' },
  es: { title: 'Biblioteca de contenido' },
  fr: { title: 'Bibliothèque de contenu' },
  it: { title: 'Libreria di contenuti' },
  pt: { title: 'Biblioteca de conteúdo' },
  ar: { title: 'مكتبة المحتوى' },
  ru: { title: 'Библиотека материалов' },
  pl: { title: 'Biblioteka treści' },
  nl: { title: 'Contentbibliotheek' },
  sv: { title: 'Innehållsbibliotek' },
  no: { title: 'Innholdsbibliotek' },
  el: { title: 'Βιβλιοθήκη περιεχομένου' },
  fi: { title: 'Sisältökirjasto' },
  da: { title: 'Indholdsbibliotek' },
  cs: { title: 'Knihovna obsahu' },
  ja: { title: 'コンテンツライブラリ' },
};
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import JsonLd from '~/components/common/JsonLd.astro';
import { getContentV2Records, type ContentV2Record } from '~/data/content-v2';
import { V2_CONVERGED_SLUGS } from '~/utils/v2-converged';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';
const metadata = {
  title: PAGE_META[lang]?.title || `Content Library — ${SITE.name}`,
  description:
    PAGE_DESC[lang]?.description ||
    'Aquafarer content library — guides, comparisons, problem solvers, and brand stories for water sports enthusiasts.',
};

const categories = [
  { key: 'problem', label: t('v2.category.problem'), desc: t('v2.category.problemDesc') },
  { key: 'guide', label: t('v2.category.guide'), desc: t('v2.category.guideDesc') },
  { key: 'comparison', label: t('v2.category.comparison'), desc: t('v2.category.comparisonDesc') },
  { key: 'product', label: t('v2.category.product'), desc: t('v2.category.productDesc') },
  { key: 'authority', label: t('v2.category.authority'), desc: t('v2.category.authorityDesc') },
] as const;

function groupBy<T>(items: T[], key: (item: T) => string): Record<string, T[]> {
  const map: Record<string, T[]> = {};
  for (const item of items) {
    const k = key(item);
    if (!map[k]) map[k] = [];
    map[k].push(item);
  }
  return map;
}

const records = getContentV2Records(lang || defaultLang).filter((r) => !V2_CONVERGED_SLUGS.has(r.slug));
const grouped = groupBy(records, (c) => c.category);
---

<Layout metadata={metadata}>
  <meta name="ai-intent" content="water-sports-content-library,surfing-guides,gear-comparisons,brand-story" />
  <JsonLd
    type="WebSite"
    data={{
      name: 'Aquafarer Content Library',
      description: 'Guides, comparisons, and brand stories',
    }}
  />

  <section class="max-w-4xl mx-auto py-24 px-6" data-ai-block="definition">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{t('v2.index.label')}</span>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">{t('v2.index.title')}</h1>
    <p class="mt-4 text-lg text-gray-500">{t('v2.index.desc')}</p>
    <div class="mt-6 flex flex-wrap gap-2 text-xs">
      <span class="px-3 py-1.5 bg-gray-100 text-gray-600 rounded-full font-medium"
        >{t('v2.index.articles').replace('{count}', String(records.length))}</span
      >
      <span class="px-3 py-1.5 bg-gray-100 text-gray-600 rounded-full font-medium"
        >{t('v2.index.categories').replace('{count}', String(categories.length))}</span
      >
    </div>
  </section>

  {
    categories.map((cat) => {
      const entries = grouped[cat.key] || [];
      if (entries.length === 0) return null;
      return (
        <section class="max-w-4xl mx-auto pb-16 px-6">
          <div class="mb-6">
            <h2 class="text-lg font-semibold text-gray-900">{cat.label}</h2>
            <p class="text-sm text-gray-500 mt-1">{cat.desc}</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {entries.map((c: ContentV2Record) => (
              <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow">
                <span class="text-xs font-medium text-sky-600 uppercase tracking-wide">{c.type.replace('-', ' ')}</span>
                <h3 class="mt-2 text-xl font-semibold text-gray-900">{c.title}</h3>
                <p class="mt-2 text-gray-500 text-sm">{c.description}</p>
                <div class="mt-3 flex items-center gap-2 text-xs">
                  <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full capitalize">{c.difficulty}</span>
                </div>
                <a
                  href={`/${lang}/v2/${c.slug}`}
                  class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 hover:text-sky-700"
                >
                  {t('v2.index.read')}
                </a>
              </div>
            ))}
          </div>
        </section>
      );
    })
  }
</Layout>
