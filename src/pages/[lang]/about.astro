---
export const prerender = true;

import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import TrustBadges from '~/components/common/TrustBadges.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import { pageContentData } from '~/i18n/generated/site-data';
import __pageData from '~/i18n/generated/pages/about.ts';
import { localizePageTitle, localizePageDescription } from '~/i18n/page-title';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'about');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const wwb = page.features3_what_we_build ?? {};
const more = page.features3_more ?? {};
const values = page.steps2_values ?? {};
const milestones = page.steps2_milestones ?? {};
const locations = page.features2_locations ?? {};

const brandTagline = page.brand_hub_tagline ?? 'Brand';
const brandTitle = page.brand_hub_title ?? 'Explore Our Brand';
const brandSubtitle = page.brand_hub_subtitle ?? '';
const brandCards = page.brand_hub_cards ?? [];

const about = pageContentData[`${lang}/site-about`] || pageContentData['en/site-about'] || {};
const sections = [
  about.business_model,
  about.sourcing,
  about.manufacturing,
  about.inspection,
  about.why_prices_lower,
  about.shipping_network,
  about.warranty_support,
].filter(Boolean);

const metadata = {
  title: localizePageTitle(page, `About ${SITE.name} 鈥?Overstock Inflatable SUP Boards & Weihai Manufacturing`),
  description: localizePageDescription(
    page,
    `${SITE.name} sells brand-new inflatable SUP boards at overstock and clearance prices 鈥?backed by our own Weihai manufacturing since 2012, mixed-model wholesale, and worldwide shipping.`
  ),
  openGraph: {
    type: 'website',
    ...(hero?.image?.src ? { images: [{ url: hero.image.src, width: 1200, height: 630 }] } : {}),
  },
};
const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: 'About' }];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who is Paddle Board Overstock?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Paddle Board Overstock is operated by Weihai Dongjilian Co., Ltd. We sell brand-new inflatable SUP boards at overstock and clearance prices, backed by our own Weihai manufacturing operations since 2012.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where does the overstock inventory come from?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'From two sources: surplus production batches from our own Weihai manufacturing operations, and selected excess inventory sourced from other production partners we audit. Every board is brand-new, unused, and 100% pressure-tested.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you serve wholesale buyers?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Small retailers can order 5-20 boards with mixed models in one shipment, priced by total quantity, shipped from Weihai by express air or consolidated sea freight.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />

  <Stats title={stats.title} stats={stats.stats} />

  {
    sections.map((section: any, i: number) => (
      <section class:list={[i % 2 === 1 && 'bg-gray-50 dark:bg-slate-900/50']}>
        <div class="max-w-4xl mx-auto px-6 py-16">
          <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{section.tagline}</span>
          <h2 class="mt-4 text-3xl md:text-4xl font-semibold text-gray-900 dark:text-slate-100 leading-tight">
            {section.heading}
          </h2>
          <div class="mt-6 space-y-5 text-gray-600 dark:text-slate-400 leading-relaxed">
            {(section.paragraphs ?? []).map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
          {section.stats && (
            <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
              {section.stats.map((stat: any) => (
                <div class="text-center p-4 bg-gray-50 dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700">
                  <div class="text-2xl font-bold text-sky-600">{stat.value}</div>
                  <div class="text-xs text-gray-500 dark:text-slate-400 mt-1">{stat.label}</div>
                </div>
              ))}
            </div>
          )}
          {section.cards && (
            <div class="mt-8 grid md:grid-cols-2 gap-6">
              {section.cards.map((card: any) => (
                <div class="p-6 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700">
                  <h3 class="font-semibold text-gray-900 dark:text-slate-100">{card.title}</h3>
                  <p class="mt-2 text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{card.description}</p>
                </div>
              ))}
            </div>
          )}
        </div>
        {section.image && (
          <div class="max-w-4xl mx-auto px-6 pb-16">
            <img
              src={section.image}
              alt={section.image_alt || ''}
              class="rounded-2xl w-full object-cover"
              loading="lazy"
            />
          </div>
        )}
      </section>
    ))
  }

  <TrustBadges
    title={t('about.trustBadgesTitle') || 'Built to standards that matter'}
    subtitle={t('about.trustBadgesSubtitle') ||
      '11 product models, every unit factory-tested, and a warranty that means something.'}
  />

  <Features3
    title={wwb.title}
    subtitle={wwb.subtitle}
    columns={wwb.columns}
    isBeforeContent={wwb.isBeforeContent}
    items={wwb.items}
  />

  <Features3 columns={more.columns} isAfterContent={more.isAfterContent} items={more.items} image={more.image} />

  <Steps2 title={values.title} subtitle={values.subtitle} items={values.items} />

  <Steps2
    title={milestones.title}
    subtitle={milestones.subtitle}
    isReversed={milestones.isReversed}
    items={milestones.items}
  />

  <Features2 title={locations.title} tagline={locations.tagline} columns={locations.columns} items={locations.items} />

  <!-- Brand Hub -->
  <section class="px-6 sm:px-6 py-20 mx-auto max-w-6xl bg-gray-50 dark:bg-gray-900 rounded-2xl">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">{brandTagline}</p>
      <h2 class="mt-2 text-3xl font-bold">{brandTitle}</h2>
      <p class="mt-3 text-muted max-w-2xl mx-auto">{brandSubtitle}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {
        brandCards.map((card: any) => (
          <a
            href={`/${lang}${card.link}`}
            class="p-6 rounded-xl bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 hover:shadow-md transition-shadow"
          >
            <h3 class="text-lg font-bold">{card.title}</h3>
            <p class="mt-2 text-sm text-muted leading-relaxed">{card.desc}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-primary">{card.link_label}</span>
          </a>
        ))
      }
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
