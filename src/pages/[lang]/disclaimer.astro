---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
import DisclaimerDe from '~/components/legal/disclaimer.de.astro';
import DisclaimerEs from '~/components/legal/disclaimer.es.astro';
import DisclaimerFr from '~/components/legal/disclaimer.fr.astro';
import DisclaimerIt from '~/components/legal/disclaimer.it.astro';
import DisclaimerRu from '~/components/legal/disclaimer.ru.astro';
import DisclaimerNl from '~/components/legal/disclaimer.nl.astro';
import DisclaimerPl from '~/components/legal/disclaimer.pl.astro';
import DisclaimerAr from '~/components/legal/disclaimer.ar.astro';
import DisclaimerPt from '~/components/legal/disclaimer.pt.astro';
import DisclaimerBg from '~/components/legal/disclaimer.bg.astro';
import DisclaimerHu from '~/components/legal/disclaimer.hu.astro';
import DisclaimerId from '~/components/legal/disclaimer.id.astro';
import DisclaimerMs from '~/components/legal/disclaimer.ms.astro';
import DisclaimerRo from '~/components/legal/disclaimer.ro.astro';
import DisclaimerTh from '~/components/legal/disclaimer.th.astro';
import DisclaimerTl from '~/components/legal/disclaimer.tl.astro';
import DisclaimerTr from '~/components/legal/disclaimer.tr.astro';
const Body: any =
  (
    {
      de: DisclaimerDe,
      es: DisclaimerEs,
      fr: DisclaimerFr,
      it: DisclaimerIt,
      ru: DisclaimerRu,
      nl: DisclaimerNl,
      pl: DisclaimerPl,
      ar: DisclaimerAr,
      pt: DisclaimerPt,
      bg: DisclaimerBg,
      hu: DisclaimerHu,
      id: DisclaimerId,
      ms: DisclaimerMs,
      ro: DisclaimerRo,
      th: DisclaimerTh,
      tl: DisclaimerTl,
      tr: DisclaimerTr,
    } as Record<string, any>
  )[lang] || null;

const META: Record<string, { title: string; description: string }> = {
  en: {
    title: `Medical Disclaimer — ${SITE.name}`,
    description:
      'Medical disclaimer for Paddle Board Overstock products and services. Information for informational and educational purposes only.',
  },
  de: {
    title: 'Medizinischer Haftungsausschluss — Paddle Board Overstock',
    description:
      'Die Inhalte dieser Website, einschließlich Text, Grafiken, Bildern und anderem Material, dienen nur zu',
  },
  es: {
    title: 'Aviso Médico — Paddle Board Overstock',
    description:
      'El contenido de este sitio web, incluidos textos, gráficos, imágenes y otro material, tiene únicamente fines',
  },
  fr: {
    title: 'Avis de non-responsabilité médical — Paddle Board Overstock',
    description: 'Le contenu de ce site web, y compris les textes, graphiques, images et autres éléments, est fourni',
  },
  it: {
    title: 'Dichiarazione di Non Responsabilità Medica — Paddle Board Overstock',
    description: 'I contenuti di questo sito web, inclusi testi, grafiche, immagini e altro materiale, hanno',
  },
  ru: {
    title: `Отказ от медицинской ответственности — ${SITE.name}`,
    description:
      'Медицинский отказ от ответственности за продукты и услуги Paddle Board Overstock. Информация только для информационных и образовательных целей.',
  },
  nl: {
    title: `Medische disclaimer — ${SITE.name}`,
    description:
      'Medische disclaimer voor Paddle Board Overstock producten en diensten. Informatie uitsluitend voor informatieve en educatieve doeleinden.',
  },
  pl: {
    title: `Zastrzeżenie medyczne — ${SITE.name}`,
    description:
      'Zastrzeżenie medyczne dotyczące produktów i usług Paddle Board Overstock. Informacje wyłącznie w celach informacyjnych i edukacyjnych.',
  },
  ar: {
    title: `إخلاء المسؤولية الطبية — ${SITE.name}`,
    description:
      'إخلاء المسؤولية الطبية عن منتجات وخدمات Paddle Board Overstock. المعلومات لأغراض إعلامية وتعليمية فقط.',
  },
  pt: {
    title: `Isenção de responsabilidade médica — ${SITE.name}`,
    description:
      'Isenção de responsabilidade médica para produtos e serviços Paddle Board Overstock. Informações apenas para fins informativos e educacionais.',
  },
  bg: {
    title: 'Медицински отказ — Paddle Board Overstock',
    description:
      'Медицински отказ от отговорност за продуктите и услугите на Paddle Board Overstock. Информацията е само за информационни и образователни цели.',
  },
  hu: {
    title: 'Orvosi nyilatkozat — Paddle Board Overstock',
    description:
      'Orvosi felelősségkizárás a Paddle Board Overstock termékek és szolgáltatások esetében. Az információ kizárólag tájékoztatási és oktatási céllal szolgál.',
  },
  id: {
    title: 'Penafian Medis — Paddle Board Overstock',
    description:
      'Penafian medis untuk produk dan layanan Paddle Board Overstock. Informasi hanya untuk tujuan informasi dan edukasi.',
  },
  ms: {
    title: 'Penafian Perubatan — Paddle Board Overstock',
    description:
      'Penafian perubatan untuk produk dan perkhidmatan Paddle Board Overstock. Maklumat untuk tujuan maklumat dan pendidikan sahaja.',
  },
  ro: {
    title: 'Avertisment medical — Paddle Board Overstock',
    description:
      'Declinare de responsabilitate medicală pentru produsele și serviciile Paddle Board Overstock. Informațiile sunt destinate numai scopurilor informaționale și educaționale.',
  },
  th: {
    title: 'ข้อจำกัดความรับผิดทางการแพทย์ — Paddle Board Overstock',
    description:
      'ข้อจำกัดความรับผิดทางการแพทย์สำหรับผลิตภัณฑ์และบริการ Paddle Board Overstock ข้อมูลนี้จัดทำขึ้นเพื่อวัตถุประสงค์ด้านข้อมูลและการศึกษาเท่านั้น',
  },
  tl: {
    title: 'Pagsasawalang-bisa Medikal — Paddle Board Overstock',
    description:
      'Pagsisiwalat medikal para sa mga produkto at serbisyo ng Paddle Board Overstock. Impormasyon para sa layuning impormasyonal at pang-edukasyon lamang.',
  },
  tr: {
    title: 'Tıbbi Feragatname — Paddle Board Overstock',
    description:
      'Paddle Board Overstock ürün ve hizmetleri için tıbbi feragatname. Bilgi yalnızca bilgilendirme ve eğitim amaçlıdır.',
  },
};
const meta = META[lang] || META.en;

const metadata = {
  title: meta.title,
  description: meta.description,
  ignoreTitleTemplate: true,
};
const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: t('nav.disclaimer') || 'Medical Disclaimer' },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  {
    Body ? (
      <Body lang={lang} />
    ) : (
      <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
        <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter">Medical Disclaimer</h1>
        <div class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8">
          <p>
            <em>Last updated: June 18, 2026</em>
          </p>
          <h2 id="general-information-only">General Information Only</h2>
          <p>
            The content on this website, including text, graphics, images, and other material, is for{' '}
            <strong>informational and educational purposes only</strong>. It is not intended to be a substitute for
            professional medical advice, diagnosis, or treatment.
          </p>
          <h2 id="no-doctor-patient-relationship">No Doctor-Patient Relationship</h2>
          <p>
            Use of this website, including access to product descriptions, blog articles, or technical documentation,
            does not create a physician-patient, clinician-patient, or any other healthcare provider relationship
            between you and Paddle Board Overstock or any of its affiliates.
          </p>
          <h2 id="not-for-clinical-use">Not for Clinical Use</h2>
          <p>
            Our products are designed for <strong>research, informational, and wellness purposes only</strong>. They are{' '}
            <strong>not cleared or approved by the FDA, EMA, or any other regulatory body</strong> for use in clinical
            diagnosis, disease prevention, or treatment decisions.
          </p>
          <p>
            You should <strong>not</strong> make any medical or health-related decisions based on the data, reports, or
            information provided through our products or website without consulting a qualified healthcare professional.
          </p>
          <h2 id="no-warranties">No Warranties</h2>
          <p>
            Paddle Board Overstock makes no representation or warranty, express or implied, regarding the accuracy,
            completeness, or reliability of the information provided on this website or through its products. All
            content and products are provided <strong>"as is"</strong> without warranty of any kind.
          </p>
          <h2 id="limitation-of-liability">Limitation of Liability</h2>
          <p>
            To the fullest extent permitted by applicable law, Paddle Board Overstock shall not be liable for any
            direct, indirect, incidental, special, or consequential damages arising from the use of or inability to use
            this website, its products, or any content therein.
          </p>
          <h2 id="data-privacy-genetic-information">Data Privacy & Genetic Information</h2>
          <p>
            Any genetic or health-related data you submit or generate through our services is handled in accordance with
            our <a href={`/${lang}/privacy`}>Privacy Policy</a>. We implement industry-standard encryption and access
            controls. However, no data transmission over the internet can be guaranteed as 100% secure.
          </p>
          <h2 id="external-links">External Links</h2>
          <p>
            This website may contain links to third-party websites. Paddle Board Overstock does not endorse, control, or
            assume responsibility for the content, privacy policies, or practices of any third-party sites.
          </p>
          <h2 id="changes-to-this-disclaimer">Changes to This Disclaimer</h2>
          <p>
            We reserve the right to update this Medical Disclaimer at any time. Changes will be posted on this page with
            an updated revision date.
          </p>
          <h2 id="contact">Contact</h2>
          <p>If you have questions about this disclaimer, please contact us at:</p>
          <ul>
            <li>
              <strong>Email</strong>: info@paddleboardoverstock.com
            </li>
            <li>
              <strong>Address</strong>: Economic Development Zone, Weihai, Shandong, China, 264200
            </li>
          </ul>
          <hr />
          <p>
            <strong>
              By using this website and its products, you acknowledge that you have read, understood, and agree to be
              bound by this Medical Disclaimer.
            </strong>
          </p>
        </div>
      </section>
    )
  }
</Layout>
