import DisclaimerSk from '~/components/legal/disclaimer.sk.astro';
import DisclaimerSl from '~/components/legal/disclaimer.sl.astro';
import DisclaimerSr from '~/components/legal/disclaimer.sr.astro';
import DisclaimerTh from '~/components/legal/disclaimer.th.astro';
import DisclaimerTl from '~/components/legal/disclaimer.tl.astro';
import DisclaimerTr from '~/components/legal/disclaimer.tr.astro';
const Body: any =
