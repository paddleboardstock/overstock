const meta = META[lang] || META.en;

const metadata = {
  title: meta.title,
  description: meta.description,
  ignoreTitleTemplate: true,
};
const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: 'Medical Disclaimer' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
