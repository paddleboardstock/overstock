---
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/knowledge.ts';
import { localizePageTitle, localizePageDescription } from '~/i18n/page-title';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'knowledge');

const hero = page.hero ?? {};
const clusters = page.clusters ?? {};
const featured = page.featured_guides ?? {};
const cta = page.cta ?? {};

const metadata = {
  title: localizePageTitle(page, `Water Exploration Knowledge — ${SITE.name}`),
  description: localizePageDescription(
    page,
    `Structured knowledge base on inflatable SUP technology, water safety, gear guides, and adventure planning. Guides, comparisons, and deep dives.`
  ),
};
const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: t('nav.knowledge') || 'Knowledge', href: `/${lang}/knowledge` },
];

const knowledgeSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('jsonld.knowledge.name') || 'Paddle Board Overstock Water Exploration Knowledge',
  description:
    t('jsonld.knowledge.description') || 'Structured knowledge base on inflatable SUP, gear, and safety topics.',
  about: {
    '@type': 'Thing',
    name: t('jsonld.knowledge.aboutName') || 'Stand-Up Paddle Boarding',
    description:
      t('jsonld.knowledge.aboutDescription') ||
      'Knowledge about inflatable SUP boards, paddles, and water-sports accessories.',
  },
  hasPart: [
    {
      '@type': 'Article',
      name: t('jsonld.knowledge.article1.name') || 'SUP Knowledge',
      about: t('jsonld.knowledge.article1.about') || 'Stand-up paddle boarding guides and tutorials',
    },
    {
      '@type': 'Article',
      name: t('jsonld.knowledge.article2.name') || 'Gear Knowledge',
      about: t('jsonld.knowledge.article2.about') || 'Paddle, pump, and accessory buying guides',
    },
    {
      '@type': 'Article',
      name: t('jsonld.knowledge.article3.name') || 'Safety Knowledge',
      about: t('jsonld.knowledge.article3.about') || 'Water safety and PFD guides',
    },
    {
      '@type': 'Article',
      name: t('jsonld.knowledge.article4.name') || 'Technology',
      about: t('jsonld.knowledge.article4.about') || 'Inflatable SUP engineering and materials',
    },
  ],
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: {
          '@type': 'Product',
          name: t('jsonld.knowledge.item1.name') || 'Inflatable SUP Board',
          category: t('jsonld.knowledge.item1.category') || 'Stand-Up Paddle Board',
          audience: {
            '@type': 'Audience',
            audienceType: t('jsonld.knowledge.item1.audience') || 'Beginner to Intermediate',
          },
          application: {
            '@type': 'Thing',
            name: t('jsonld.knowledge.item1.application') || 'Lake paddling, touring, recreation',
          },
        },
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: {
          '@type': 'Product',
          name: t('jsonld.knowledge.item2.name') || 'SUP Paddle',
          category: t('jsonld.knowledge.item2.category') || 'Paddle',
          audience: { '@type': 'Audience', audienceType: t('jsonld.knowledge.allLevels') || 'All levels' },
          application: {
            '@type': 'Thing',
            name: t('jsonld.knowledge.item2.application') || 'Touring, fishing, family paddling',
          },
        },
      },
      {
        '@type': 'ListItem',
        position: 3,
        item: {
          '@type': 'Product',
          name: t('jsonld.knowledge.item3.name') || 'SUP Accessories',
          category: t('jsonld.knowledge.item3.category') || 'Accessories',
          audience: { '@type': 'Audience', audienceType: t('jsonld.knowledge.allLevels') || 'All levels' },
          application: {
            '@type': 'Thing',
            name: t('jsonld.knowledge.item3.application') || 'Pumps, leashes, repair kits',
          },
        },
      },
      {
        '@type': 'ListItem',
        position: 4,
        item: {
          '@type': 'Product',
          name: t('jsonld.knowledge.item4.name') || 'Safety Equipment',
          category: t('jsonld.knowledge.item4.category') || 'Water Safety Gear',
          audience: { '@type': 'Audience', audienceType: t('jsonld.knowledge.allLevels') || 'All levels' },
          application: {
            '@type': 'Thing',
            name: t('jsonld.knowledge.item4.application') || 'PFDs, leashes, whistle and light',
          },
        },
      },
    ],
  },
});

const knowledgeGraph = JSON.stringify({
  '@context': {
    rdf: 'http://www.w3.org/1999/02/22-rdf-syntax-ns#',
    rdfs: 'http://www.w3.org/2000/01/rdf-schema#',
    schema: 'https://schema.org/',
    aqua: 'https://paddleboardoverstock.com/kg/',
  },
  '@graph': [
    {
      '@id': 'aqua:paddleboardoverstock',
      '@type': 'schema:Brand',
      'schema:name': 'Paddle Board Overstock',
      'schema:description':
        t('jsonld.knowledge.brandDescription') ||
        'Inflatable stand-up paddle boards, paddles, and accessories — factory-direct overstock store',
      'schema:manufactures': [
        { '@id': 'aqua:product-sup' },
        { '@id': 'aqua:product-paddle' },
        { '@id': 'aqua:product-accessory' },
      ],
    },
    {
      '@id': 'aqua:product-paddle',
      '@type': 'schema:Product',
      'schema:name': t('jsonld.knowledge.item2.name') || 'SUP Paddle',
    },
    {
      '@id': 'aqua:product-accessory',
      '@type': 'schema:Product',
      'schema:name': t('jsonld.knowledge.item3.name') || 'SUP Accessories',
    },
    {
      '@id': 'aqua:technology-dropstitch',
      '@type': 'schema:Thing',
      'schema:name': t('jsonld.knowledge.tech1.name') || 'Drop-Stitch Core Technology',
      'schema:description':
        t('jsonld.knowledge.tech1.description') ||
        'Construction method creating rigid inflatable platforms at 12-15 PSI',
      'aqua:usedIn': [{ '@id': 'aqua:product-sup' }],
    },
    {
      '@id': 'aqua:technology-pvc',
      '@type': 'schema:Thing',
      'schema:name': t('jsonld.knowledge.tech2.name') || 'Marine-Grade PVC',
      'schema:description':
        t('jsonld.knowledge.tech2.description') || 'High-density PVC fabric with UV-resistant coating',
      'aqua:usedIn': [{ '@id': 'aqua:product-sup' }],
    },
    {
      '@id': 'aqua:use-beginner',
      '@type': 'schema:Audience',
      'schema:name': t('jsonld.knowledge.audience1.name') || 'Beginners',
      'schema:description': t('jsonld.knowledge.audience1.description') || 'First-time paddlers learning water sports',
      'aqua:recommendedProduct': [{ '@id': 'aqua:product-sup' }],
    },
    {
      '@id': 'aqua:use-family',
      '@type': 'schema:Audience',
      'schema:name': t('jsonld.knowledge.audience2.name') || 'Families',
      'schema:description':
        t('jsonld.knowledge.audience2.description') || 'Family groups seeking recreational water activities',
      'aqua:recommendedProduct': [{ '@id': 'aqua:product-sup' }],
    },
    {
      '@id': 'aqua:use-fishing',
      '@type': 'schema:Audience',
      'schema:name': t('jsonld.knowledge.audience3.name') || 'Anglers',
      'schema:description': t('jsonld.knowledge.audience3.description') || 'Anglers who want a stable casting platform',
      'aqua:recommendedProduct': [{ '@id': 'aqua:product-sup' }],
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} title={hero.title} subtitle={hero.subtitle} />

  <!-- Knowledge Clusters -->
  <section class="max-w-6xl mx-auto py-20 px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase"
        >{clusters.tagline || 'Knowledge Clusters'}</span
      >
      <h2 class="mt-4 text-4xl font-semibold text-gray-900 dark:text-slate-100">
        {clusters.title || 'Explore by topic'}
      </h2>
      <p class="mt-4 text-lg text-gray-500 dark:text-slate-400">{clusters.subtitle || ''}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-8">
      {
        (clusters.items || []).map((cluster: any) => (
          <div class="p-8 rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
            <div class="w-12 h-12 bg-sky-50 dark:bg-sky-900/30 rounded-xl flex items-center justify-center text-sky-600">
              {cluster.icon && <Icon name={cluster.icon} class="w-6 h-6" />}
            </div>
            <h3 class="mt-5 text-xl font-bold text-gray-900 dark:text-slate-100">{cluster.title || ''}</h3>
            <p class="mt-2 text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{cluster.description || ''}</p>
            <ul class="mt-5 space-y-2">
              {(cluster.topics || []).map((topic: string) => (
                <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-slate-400">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-sky-500 flex-shrink-0" />
                  {topic}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Featured Guides -->
  <section class="bg-gray-50 dark:bg-slate-900/50 py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-sm font-medium text-sky-600 tracking-wide uppercase"
          >{featured.tagline || 'Featured Guides'}</span
        >
        <h2 class="mt-4 text-3xl font-semibold text-gray-900 dark:text-slate-100">
          {featured.title || 'Popular resources'}
        </h2>
      </div>
      <div class="grid md:grid-cols-3 lg:grid-cols-5 gap-4 max-w-4xl mx-auto">
        {
          (featured.items || []).map((item: any) => (
            <a
              href={item.href || '#'}
              class="block p-5 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 text-center hover:shadow-md transition-shadow"
            >
              <span class="text-sm font-medium text-gray-900 dark:text-slate-100">{item.title || ''}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- JSON-LD Knowledge Graph -->
  <script is:inline type="application/ld+json" set:html={knowledgeSchema} />

  <!-- Entity Relationship Graph for AI -->
  <script is:inline type="application/ld+json" set:html={knowledgeGraph} />

  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={cta.actions} />
</Layout>
