---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';
import ExperienceLayer from '~/components/content/ExperienceLayer.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const metadata = {
  title: `${t('engineeringPerfection.title') || 'Engineering Perfection — Inflatable Boat Manufacturing Excellence'} | ${SITE.name}`,
  description:
    t('engineeringPerfection.desc') ||
    `${SITE.name}'s engineering philosophy: precision manufacturing, premium material selection, rigorous quality control, and segment-specific design for whitewater, fishing, dinghies, and recreational inflatable boats.`,
};

const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: t('engineeringPerfection.nav') || 'Engineering Perfection' },
];

const pillars = [
  {
    title: t('engineeringPerfection.p1') || 'Superior Material Sourcing',
    content:
      t('engineeringPerfection.p1desc') ||
      'We invest considerable resources in identifying, testing, and procuring the finest fabrics, adhesives, and components available globally. We do not compromise on material specifications for cost savings. Our sourcing protocol includes batch testing for tensile strength, tear resistance, coating adhesion, and UV stability.',
  },
  {
    title: t('engineeringPerfection.p2') || 'Precision Engineering & Design',
    content:
      t('engineeringPerfection.p2desc') ||
      'Our design team comprises experienced naval architects who leverage advanced CAD software and real-world testing to create hulls that are hydrodynamically efficient, exceptionally stable, and robust. Every curve, seam, and attachment point is meticulously planned and analyzed.',
  },
  {
    title: t('engineeringPerfection.p3') || 'Craftsmanship & Manufacturing Excellence',
    content:
      t('engineeringPerfection.p3desc') ||
      'Paddle Board Overstock employs highly skilled technicians who are masters of their craft. Our production facility is equipped with state-of-the-art CNC cutting machines and thermo-welding equipment. We foster a culture of meticulousness, where attention to detail is paramount at every stage of assembly.',
  },
  {
    title: t('engineeringPerfection.p4') || 'Rigorous Quality Control & Testing',
    content:
      t('engineeringPerfection.p4desc') ||
      'Quality is built in from the very beginning. We implement a multi-layered QC system with stringent checks at each critical step, culminating in comprehensive final testing including 24-48 hour pressure holding tests, leak detection, dimensional verification, and functional tests.',
  },
];

const segments = [
  {
    name: t('engineeringPerfection.s1') || 'Whitewater Inflatables',
    desc:
      t('engineeringPerfection.s1desc') ||
      'High-denier PVC or premium Hypalon with heavy reinforcements, high rocker, self-bailing floors, large tube diameters for maximum buoyancy, and continuous grab lines.',
  },
  {
    name: t('engineeringPerfection.s2') || 'Fishing Inflatables',
    desc:
      t('engineeringPerfection.s2desc') ||
      'Exceptional stability and shallow draft. Features include rod holders, gear mounts, elevated seating, and quieter muted colors for stealth approach.',
  },
  {
    name: t('engineeringPerfection.s3') || 'Dinghies & Tenders',
    desc:
      t('engineeringPerfection.s3desc') ||
      'Lightweight and compact for easy storage and lifting. Efficient rowing and motoring performance with reinforced towing points and substantial rub strakes.',
  },
  {
    name: t('engineeringPerfection.s4') || 'General Recreational Craft',
    desc:
      t('engineeringPerfection.s4desc') ||
      'Versatile design for family boating with high priority on stability, safety, comfort, and ease of inflation, deflation, and transport.',
  },
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does engineering perfection mean at Paddle Board Overstock?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '1.25x rated pressure hold testing, 99.3% defect-free rate, ISO 9001 quality management, and 100-point quality checklist on every unit.',
      },
    },
    {
      '@type': 'Question',
      name: 'How are quality standards maintained?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ISO 9001:2015 quality system, AQL 2.5 / ISO 2859 sampling, independent quality lab, and final inspection before shipment.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I specify additional quality requirements?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Custom inspection protocols, third-party inspection, and specific test requirements can be added to OEM/ODM orders.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="px-6 sm:px-6 py-16 sm:py-20 lg:py-24 mx-auto max-w-5xl text-center">
    <p class="text-sm font-semibold text-primary uppercase tracking-wider">
      {t('engineeringPerfection.badge') || 'Manufacturing Philosophy'}
    </p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">
      {t('engineeringPerfection.heading') || 'Engineering Perfection'}
    </h1>
    <p class="mt-3 text-lg text-muted max-w-3xl mx-auto">
      {
        t('engineeringPerfection.subtitle') ||
          'Paddle Board Overstock was founded on a simple yet profound principle: to produce perfect products. This is not a marketing slogan — it is the bedrock of our operational philosophy, driving every material selection, design decision, and quality control protocol.'
      }
    </p>
  </section>

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-4xl space-y-12">
    {
      pillars.map((p, i) => (
        <div class={`grid md:grid-cols-2 gap-8 items-center ${i % 2 === 1 ? 'md:order-2' : ''}`}>
          <div class={i % 2 === 1 ? 'md:order-2' : ''}>
            <h2 class="text-xl font-bold">{p.title}</h2>
            <p class="mt-3 text-muted leading-relaxed">{p.content}</p>
          </div>
          <div
            class={`bg-gray-50 dark:bg-gray-900 rounded-xl p-8 border border-gray-200 dark:border-gray-800 ${i % 2 === 1 ? 'md:order-1' : ''}`}
          >
            <span class="text-4xl font-bold text-primary">0{i + 1}</span>
          </div>
        </div>
      ))
    }
  </section>

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-6xl bg-gray-50 dark:bg-gray-900">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">
        {t('engineeringPerfection.segBadge') || 'Specialized Segments'}
      </p>
      <h2 class="mt-2 text-3xl font-bold">{t('engineeringPerfection.segTitle') || 'Tailored for Adventure'}</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {
        segments.map((s) => (
          <div class="p-6 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-bold">{s.name}</h3>
            <p class="mt-2 text-muted text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-4xl">
    <div class="rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 p-8">
      <h2 class="text-2xl font-bold text-center">
        {t('engineeringPerfection.artTitle') || 'The Art & Science of Manufacturing'}
      </h2>
      <p class="mt-4 text-muted leading-relaxed text-center max-w-3xl mx-auto">
        {
          t('engineeringPerfection.artDesc') ||
            'From CNC-precision fabric cutting and advanced thermal welding to controlled-environment adhesive bonding and exhaustive multi-stage testing, every Paddle Board Overstock boat represents the pinnacle of inflatable craft manufacturing. Our production process is designed to prevent common defects — seam leaks, delamination, valve failures, dimensional inconsistencies — before they can occur.'
        }
      </p>
      <div class="text-center mt-8">
        <a
          href={`/${lang}/contact`}
          class="inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
        >
          {t('engineeringPerfection.cta') || 'Discuss your project'} →
        </a>
      </div>
    </div>
  </section>
  <ExperienceLayer
    title={t('engineeringPerfection.expTitle') || 'Engineering Philosophy in Practice'}
    subtitle={t('engineeringPerfection.expSub') ||
      'Real examples of how our engineering standards translate into field performance.'}
    stories={[
      {
        quote:
          "We tested five manufacturers' SUPs for our rental fleet. After 500 rentals, the Paddle Board Overstock boards had the lowest failure rate — less than 2% vs 8-15% for competitors.",
        narrative:
          'A European resort operator conducted a year-long comparative test of inflatable SUPs from five manufacturers for their 200-board rental fleet. After 500 rental cycles per board, the Paddle Board Overstock boards showed the least valve wear, the fewest seam leaks, and the best pressure retention.',
        context: 'Resort rental fleet comparison, Mediterranean, 2024',
        source: 'Resort Operations Director',
      },
      {
        quote:
          'When a customer reported a slow leak on a board after two years, we traced it to a valve core that had been cross-threaded during a field repair. The board itself was still structurally perfect.',
        narrative:
          "Paddle Board Overstock's quality team investigates every warranty claim thoroughly. In this case, a two-year-old board returned with a slow leak was found to have no manufacturing defects — the drop-stitch core, seams, and fabric were all within specification.",
        context: 'Warranty analysis, North America, 2024',
        source: 'Quality Assurance Team',
      },
    ]}
  />
  <RelatedPages
    title={t('engineeringPerfection.relatedTitle') || 'Explore More'}
    subtitle={t('engineeringPerfection.relatedSub') || 'Related engineering and manufacturing resources'}
    links={[
      {
        title: t('engineeringPerfection.rel1') || 'Quality Control & Testing',
        description:
          t('engineeringPerfection.rel1desc') ||
          'Multi-layered QC system with stringent checks at each critical manufacturing step.',
        href: `/${lang}/quality`,
        label: 'Quality',
      },
      {
        title: t('engineeringPerfection.rel2') || 'R&D Center',
        description:
          t('engineeringPerfection.rel2desc') ||
          'Our research facilities including PVC Fabric Lab, Hydrodynamic Test Tank, and Prototype Workshop.',
        href: `/${lang}/randdcenter`,
        label: 'R&D',
      },
      {
        title: t('engineeringPerfection.rel3') || 'Factory Overview',
        description:
          t('engineeringPerfection.rel3desc') ||
          '12,000 m² facility with RF welding, drop-stitch production, and custom assembly lines.',
        href: `/${lang}/factory`,
        label: 'Facility',
      },
      {
        title: t('engineeringPerfection.rel4') || 'Design & Innovation',
        description:
          t('engineeringPerfection.rel4desc') ||
          'Full-service design studio for custom ODM projects, from concept to production.',
        href: `/${lang}/design-powerhouse`,
        label: 'Design',
      },
    ]}
  />
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
