---
const PAGE_DESC: Record<string, { description: string }> = {
  de: {
    description:
      'Paddle Board Overstock 2-jährige eingeschränkte Garantie für aufblasbare SUP-Boards. Garantiebedingungen für Drop-Stitch-Nähte, Rails, Ventile und Zubehör.',
  },
  es: {
    description:
      'Garantía limitada de 2 años de Paddle Board Overstock para tablas de paddle board inflables. Condiciones de garantía para costuras drop-stitch, rieles, válvulas y accesorios.',
  },
  fr: {
    description:
      'Garantie limitée de 2 ans Paddle Board Overstock pour les planches de paddle gonflables. Conditions de garantie pour coutures drop-stitch, rails, valves et accessoires.',
  },
  it: {
    description:
      'Garanzia limitata di 2 anni Paddle Board Overstock per tavole SUP gonfiabili. Termini di garanzia per cuciture drop-stitch, bordi, valvole e accessori.',
  },
  ru: {
    description:
      'Paddle Board Overstock ограниченная гарантия 2 года на надувные сапы. Гарантийные условия на швы drop-stitch, рейлы, клапаны и аксессуары.',
  },
  nl: {
    description:
      'Paddle Board Overstock 2 jaar beperkte garantie op opblaasbare SUP boards. Garantievoorwaarden voor drop-stitch naden, rails, ventielen en accessoires.',
  },
  pl: {
    description:
      'Paddle Board Overstock 2-letnia ograniczona gwarancja na deski SUP. Warunki gwarancji na szwy drop-stitch, raily, zawory i akcesoria.',
  },
  ar: {
    description:
      'Paddle Board Overstock ضمان محدود لمدة عامين على ألواح التجديف القابلة للنفخ. شروط الضمان على درزات drop-stitch والحواف والصمامات والملحقات.',
  },
  pt: {
    description:
      'Paddle Board Overstock Garantia limitada de 2 anos para pranchas de paddle infláveis. Condições de garantia para costuras drop-stitch, bordas, válvulas e acessórios.',
  },
};
const PAGE_META: Record<string, { title: string }> = {
  de: { title: 'Garantie' },
  es: { title: 'Garantía' },
  fr: { title: 'Garantie' },
  it: { title: 'Garanzia' },
  pt: { title: 'Garantia' },
  ar: { title: 'الضمان' },
  ru: { title: 'Гарантия' },
  pl: { title: 'Gwarancja' },
  nl: { title: 'Garantie' },
};
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages } from '~/i18n/config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/warranty.ts';
import { localizePageTitle } from '~/i18n/page-title';
import { articleSchema } from '~/lib/seo/schema';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'warranty') || {};

const metadata = {
  title: localizePageTitle(page, PAGE_META[lang]?.title || `Warranty — ${SITE.name}`),
  description:
    PAGE_DESC[lang]?.description ||
    'Paddle Board Overstock offers a 2-year limited warranty covering drop-stitch seams, rail construction, inflation valves, and included accessories on every SUP board. Full terms and conditions.',
};

const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: 'Warranty' }];

const graphJsonLd = articleSchema({
  headline: page.headline || 'Paddle Board Overstock Manufacturer Limited Warranty',
  description: page.seo?.description || 'Paddle Board Overstock 2-year limited warranty on inflatable SUP boards.',
  datePublished: page.seo?.datePublished || '2024-01-01',
  dateModified: page.seo?.dateModified || '2026-06-01',
  author: SITE.name,
  publisher: SITE.name,
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What warranty does Paddle Board Overstock offer?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A 2-year limited warranty on SUP boards, covering manufacturing defects in materials and workmanship.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does the warranty cover?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Manufacturing defects in materials and workmanship including seam failures, valve defects, and material delamination under normal use.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is not covered by warranty?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Normal wear and tear, damage from misuse, improper storage, unauthorized modifications, and cosmetic issues that do not affect performance.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I make a warranty claim?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Contact Paddle Board Overstock via the contact page with your proof of purchase, product serial number, and photos of the defect.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does the warranty apply to commercial use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The same warranty terms apply to commercial and recreational use, provided the product is used within its rated specifications.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <script
    slot="before"
    is:inline
    type="application/ld+json"
    set:html={graphJsonLd ? JSON.stringify(graphJsonLd) : ''}
  />

  <section class="max-w-4xl mx-auto py-24 px-6">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{page.label || 'Warranty'}</span>
    <h1 class="mt-4 text-4xl font-semibold text-gray-900 dark:text-gray-100">
      {page.headline || 'Manufacturer Limited Warranty'}
    </h1>
    <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">
      {page.subtitle || 'Paddle Board Overstock stands behind the quality of every product we manufacture.'}
    </p>
  </section>

  <section class="max-w-4xl mx-auto pb-24 px-6">
    <div class="prose prose-gray dark:prose-invert max-w-none" set:html={page.body || ''} />
  </section>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
