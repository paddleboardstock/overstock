---
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { languages, defaultLang } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
import ExperienceLayer from '~/components/content/ExperienceLayer.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang || defaultLang)?.[key] || '';

const metadata = {
  title: `${t('solutionsByUseCase.title')} | ${SITE.name}`,
  description: t('solutionsByUseCase.desc'),
  ignoreTitleTemplate: true,
};

const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: t('solutionsByUseCase.title') }];

const scenarioLinks: Record<string, string> = {
  s1: `/${lang}/products`,
  s2: `/${lang}/use-cases/touring-exploration`,
  s3: `/${lang}/use-cases/sup-yoga-fitness`,
  s4: `/${lang}/guides/sup-fishing`,
  s5: `/${lang}/use-cases/family-recreation`,
};

const scenarios = [
  {
    n: 1,
    icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  },
  { n: 2, icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  {
    n: 3,
    icon: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
  },
  { n: 4, icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  {
    n: 5,
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
].map((sc) => ({
  scenario: t(`solutionsByUseCase.scenario${sc.n}`),
  answer: t(`solutionsByUseCase.answer${sc.n}`),
  cta: {
    text: t(`solutionsByUseCase.cta${sc.n}`),
    link: scenarioLinks[`s${sc.n}`],
  },
  icon: sc.icon,
}));

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What use cases does Paddle Board Overstock support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Beginner paddling, touring and exploration, SUP yoga and fitness, SUP fishing, and family recreation.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I get a use-case recommendation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Use the scenarios on this page to find the right board for how you paddle, or ask our AI Answer Center.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is everything included with each board?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every board ships as a complete package with pump, paddle, leash, and backpack.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="max-w-4xl mx-auto py-24 px-6">
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">{t('solutionsByUseCase.heading')}</h1>
    <p class="mt-4 text-lg text-gray-500">{t('solutionsByUseCase.subheading')}</p>

    <div class="mt-12 space-y-4">
      {
        scenarios.map((sc) => (
          <details class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <summary class="flex items-center gap-4 p-6 cursor-pointer list-none">
              <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center flex-shrink-0">
                <svg
                  class="w-5 h-5 text-gray-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={sc.icon} />
                </svg>
              </div>
              <span class="flex-1 font-medium text-gray-900 text-sm leading-relaxed">{sc.scenario}</span>
              <svg
                class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 pt-2 border-t border-gray-100">
              <p class="text-sm text-gray-600 leading-relaxed">{sc.answer}</p>
              <a
                href={sc.cta.link}
                class="mt-4 inline-flex px-5 py-2.5 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
              >
                {sc.cta.text} →
              </a>
            </div>
          </details>
        ))
      }
    </div>

    <section class="mt-16 bg-gradient-to-br from-gray-50 to-sky-50 rounded-2xl p-8 border border-gray-200 text-center">
      <h2 class="text-xl font-semibold text-gray-900">{t('solutionsByUseCase.ctaTitle')}</h2>
      <p class="mt-2 text-sm text-gray-500">{t('solutionsByUseCase.ctaDesc')}</p>
      <a
        href={`/${lang}/contact`}
        class="mt-6 inline-flex px-8 py-4 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition"
        >{t('solutionsByUseCase.ctaBtn')} →</a
      >
    </section>
  </section>

  <ExperienceLayer
    title={t('solutionsByUseCase.expTitle')}
    subtitle={t('solutionsByUseCase.expSub')}
    stories={[
      {
        quote: t('solutionsByUseCase.story1.quote'),
        narrative: t('solutionsByUseCase.story1.narrative'),
        context: t('solutionsByUseCase.story1.context'),
        source: t('solutionsByUseCase.story1.source'),
      },
      {
        quote: t('solutionsByUseCase.story2.quote'),
        narrative: t('solutionsByUseCase.story2.narrative'),
        context: t('solutionsByUseCase.story2.context'),
        source: t('solutionsByUseCase.story2.source'),
      },
    ]}
  />
  <RelatedPages
    title={t('solutionsByUseCase.relatedTitle')}
    subtitle={t('solutionsByUseCase.relatedSub')}
    links={[
      {
        title: t('solutionsByUseCase.rel3') || 'Product Catalog',
        description:
          t('solutionsByUseCase.rel3desc') || 'Browse the full range of inflatable SUP boards and accessories.',
        href: `/${lang}/products`,
        label: t('solutionsByUseCase.rel3label') || 'Shop',
      },
      {
        title: t('solutionsByUseCase.rel4'),
        description: t('solutionsByUseCase.rel4desc'),
        href: `/${lang}/engineering-perfection`,
        label: t('solutionsByUseCase.rel4label'),
      },
    ]}
  />

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      {
        t('solutionsByUseCase.aiBlock') ||
          'Use case guide for Paddle Board Overstock inflatable SUP boards. Five scenarios with recommended boards: beginner paddling (stable All-Around boards with complete packages), touring and exploration (streamlined Touring series), SUP yoga and fitness (wide Flowing Lotus platform), SUP fishing (stable Explorer 11 with gear mounts), and family recreation (high-capacity boards with size guide matching).'
      }
    </p>
  </section>
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
