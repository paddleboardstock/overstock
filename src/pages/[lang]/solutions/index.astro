---
export const prerender = true;

import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/solutions.ts';
import { localizePageTitle, localizePageDescription } from '~/i18n/page-title';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'solutions');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const solutions = page.features3_solutions ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));
const localizedItems = solutions.items?.map((item: any) => ({
  ...item,
  link: item.link ? `/${lang}${item.link}` : item.link,
}));

const metadata = {
  title: localizePageTitle(page, `Paddle Board Solutions for Clubs, Resorts & Rentals — ${SITE.name}`),
  description: localizePageDescription(
    page,
    'Water sports solutions for clubs, resorts, and rental operators. Purpose-built inflatable SUP boards for touring, yoga, fishing, and family paddling.'
  ),
};
const crumbs = [{ name: t('nav.home') || 'Home', href: `/${lang}/` }, { name: t('nav.solutions') || 'Solutions' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />
  <Stats title={stats.title} stats={stats.stats} />
  <Features3
    tagline={solutions.tagline}
    title={solutions.title}
    subtitle={solutions.subtitle}
    columns={solutions.columns}
    items={localizedItems}
  />
  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
  <JsonLd
    type="Service"
    service={{
      name: t('jsonld.solutions.name') || 'Paddle Board Solutions — Clubs, Resorts & Rentals',
      description:
        t('jsonld.solutions.description') ||
        'Equipment packages for water sports clubs, resorts, rental operators, and paddling programs.',
      serviceType: t('jsonld.solutions.serviceType') || 'Business Solutions',
      areaServed: [t('jsonld.global') || 'Global'],
      url: `/${lang}/solutions`,
      items: [
        {
          name: t('jsonld.solutions.item1.name') || 'Water Sports Clubs',
          description:
            t('jsonld.solutions.item1.description') || 'Equipment packages and branding for SUP clubs and surf schools',
        },
        {
          name: t('jsonld.solutions.item2.name') || 'Resorts & Hotels',
          description:
            t('jsonld.solutions.item2.description') || 'Premium water sports programs for hospitality properties',
        },
        {
          name: t('jsonld.solutions.item3.name') || 'Rental Businesses',
          description:
            t('jsonld.solutions.item3.description') || 'Fleet packages and support for paddle board rental operators',
        },
        {
          name: t('jsonld.solutions.item4.name') || 'Paddling Use Cases',
          description:
            t('jsonld.solutions.item4.description') || 'Touring, yoga, fishing, and fitness paddle boarding guides',
        },
      ],
    }}
  />
</Layout>
