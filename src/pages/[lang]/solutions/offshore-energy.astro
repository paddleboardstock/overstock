---
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/solutions-offshore-energy.ts';
import { localizePageTitle, localizePageDescription } from '~/i18n/page-title';
import { languages } from '~/i18n/config';
import { getUiForLang } from '~/i18n/generated/ui-all';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = (key: string) => getUiForLang(lang)?.[key] || '';
setPageContentData(__pageData);
const page = getPageContent(lang, 'solutions-offshore-energy');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const challenge = page.content_challenge ?? {};
const solution = page.content_solution ?? {};
const segments = page.content_segments ?? {};
const cta = page.cta ?? {};
const lh = (h: string) => (h ? `/${lang}${h}` : h);
const ctaActions = cta.actions?.map((a: any) => ({ ...a, href: lh(a.href) }));

const metadata = {
  title: localizePageTitle(page, `Offshore Energy RIBs — ${SITE.name} | Oil & Gas, Wind Farm, Subsea Support`),
  description: localizePageDescription(
    page,
    'Heavy-duty RIBs for offshore oil and gas platform support, wind farm crew transfer, subsea cable inspection, and marine engineering. Extreme-environment construction.'
  ),
};
const crumbs = [
  { name: t('nav.home') || 'Home', href: `/${lang}/` },
  { name: 'Solutions', href: `/${lang}/solutions/` },
  { name: 'Offshore Energy' },
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What products serve offshore energy?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Crew transfer RIBs, safety and rescue boats, and transport vessels in commercial-grade Hypalon/CSM with SOLAS compliance options.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are SOLAS-certified boats available?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SOLAS compliance requires project-specific certification. We work with classification societies to meet offshore safety requirements.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the typical lead time?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '45-60 days for offshore-spec vessels with custom certification. Contact us for project-specific timelines.',
      },
    },
  ],
});
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />
  <Stats title={stats.title} stats={stats.stats} />
  <Content
    tagline={challenge.tagline}
    title={challenge.title}
    subtitle={challenge.subtitle}
    content={challenge.paragraphs?.join('\n\n')}
  />
  <Content
    tagline={solution.tagline}
    title={solution.title}
    subtitle={solution.subtitle}
    content={solution.list?.map((i: string) => `- ${i}`).join('\n')}
  />
  {
    segments.items?.length > 0 && (
      <Content
        tagline={segments.tagline}
        title={segments.title}
        subtitle={segments.subtitle}
        content={segments.items
          ?.map(
            (i: any) =>
              `**${i.title}:** ${i.subtitle}\n\n${i.description}\n\nFeatures:\n${i.features?.map((f: string) => `- ${f}`).join('\n')}`
          )
          .join('\n\n')}
      />
    )
  }
  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={ctaActions} />
  <script is:inline type="application/ld+json" set:html={faqSchema} />
</Layout>
