---
export const prerender = true;

import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/solutions.ts';

setPageContentData(__pageData);
const page = getPageContent('en', 'solutions');

const hero = page.hero ?? {};
const stats = page.stats ?? {};
const solutions = page.features3_solutions ?? {};
const cta = page.cta ?? {};

const metadata = {
  title: `Paddle Board Solutions for Clubs, Resorts & Rentals — ${SITE.name}`,
  description:
    'Water sports solutions for clubs, resorts, and rental operators. Purpose-built inflatable SUP boards for touring, yoga, fishing, and family paddling.',
};
---

<Layout metadata={metadata}>
  <Hero tagline={hero.tagline} image={hero.image} title={hero.title} subtitle={hero.subtitle} />
  <Stats title={stats.title} stats={stats.stats} />
  <Features3
    tagline={solutions.tagline}
    title={solutions.title}
    subtitle={solutions.subtitle}
    columns={solutions.columns}
    items={solutions.items}
  />
  <CallToAction title={cta.title} subtitle={cta.subtitle} actions={cta.actions} />
  <JsonLd
    type="Service"
    service={{
      name: 'Paddle Board Solutions — Clubs, Resorts & Rentals',
      description: 'Equipment packages for water sports clubs, resorts, rental operators, and paddling programs.',
      serviceType: 'Business Solutions',
      areaServed: ['Global'],
      url: '/solutions',
      items: [
        {
          name: 'Water Sports Clubs',
          description: 'Equipment packages and branding for SUP clubs and surf schools',
        },
        { name: 'Resorts & Hotels', description: 'Premium water sports programs for hospitality properties' },
        { name: 'Rental Businesses', description: 'Fleet packages and support for paddle board rental operators' },
        { name: 'Paddling Use Cases', description: 'Touring, yoga, fishing, and fitness paddle boarding guides' },
      ],
    }}
  />
</Layout>
