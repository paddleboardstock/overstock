---
import Layout from '~/layouts/PageLayout.astro';
import ExperienceLayer from '~/components/content/ExperienceLayer.astro';
import RelatedPages from '~/components/content/RelatedPages.astro';

const metadata = {
  title: 'Solutions by Use Case — Find Your Paddle Board',
  description:
    'Match how you paddle to the right inflatable SUP board. Beginner, touring, yoga, fishing, or family — Paddle Board Overstock has the right board package.',
  ignoreTitleTemplate: true,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Solutions by Use Case' }];

const useCases = [
  {
    scenario: "I'm a beginner looking for my first board",
    icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
    answer:
      'Start with our stable All-Around boards. The SUP Explorer 11 is a wide, forgiving platform that ships as a complete package with pump, paddle, leash, and backpack — everything you need for your first session.',
    cta: { text: 'Shop All-Around Boards', link: '/products' },
  },
  {
    scenario: 'I want to explore and paddle long distances',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    answer:
      'Our Touring series is built for distance: streamlined outlines, cargo D-rings for dry bags, and tracking fins that hold a straight line on lakes and coastlines.',
    cta: { text: 'Touring Boards', link: '/use-cases/touring-exploration' },
  },
  {
    scenario: 'I want to do SUP yoga or fitness on the water',
    icon: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
    answer:
      'The Flowing Lotus Series offers a wide, full-deck traction platform that doubles as a floating yoga mat — stable enough for poses, smooth enough for morning stretches.',
    cta: { text: 'Yoga & Fitness Boards', link: '/use-cases/sup-yoga-fitness' },
  },
  {
    scenario: 'I want to fish from my paddle board',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
    answer:
      'The SUP Explorer 11 works great for casual fishing — stable enough to cast from, with D-rings for gear and the capacity for a cooler box. See our SUP fishing guide for setup tips.',
    cta: { text: 'SUP Fishing Guide', link: '/guides/sup-fishing' },
  },
  {
    scenario: "I'm shopping for the whole family",
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
    answer:
      'Durable, high-capacity boards the whole family can share. Start with our size guide to match riders, then add extra paddles and PFDs so everyone can join.',
    cta: { text: 'Family Guide', link: '/use-cases/family-recreation' },
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <section class="max-w-4xl mx-auto py-24 px-6">
    <h1 class="mt-4 text-4xl font-semibold text-gray-900">What Are You Looking For?</h1>
    <p class="mt-4 text-lg text-gray-500">
      Select your scenario below and get a direct recommendation for the right Paddle Board Overstock solution.
    </p>

    <div class="mt-12 space-y-4">
      {
        useCases.map((uc) => (
          <details class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-md transition-shadow">
            <summary class="flex items-center gap-4 p-6 cursor-pointer list-none">
              <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center flex-shrink-0">
                <svg
                  class="w-5 h-5 text-gray-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={uc.icon} />
                </svg>
              </div>
              <span class="flex-1 font-medium text-gray-900 text-sm leading-relaxed">{uc.scenario}</span>
              <svg
                class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 pt-2 border-t border-gray-100">
              <p class="text-sm text-gray-600 leading-relaxed">{uc.answer}</p>
              <a
                href={uc.cta.link}
                class="mt-4 inline-flex px-5 py-2.5 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-gray-800 transition"
              >
                {uc.cta.text} →
              </a>
            </div>
          </details>
        ))
      }
    </div>

    <section class="mt-16 bg-gradient-to-br from-gray-50 to-sky-50 rounded-2xl p-8 border border-gray-200 text-center">
      <h2 class="text-xl font-semibold text-gray-900">Still Not Sure?</h2>
      <p class="mt-2 text-sm text-gray-500">
        Contact our team for a personalized recommendation based on your specific requirements.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-flex px-8 py-4 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition"
        >Contact Us →</a
      >
    </section>
  </section>

  <ExperienceLayer
    title="Real-World Results"
    subtitle="How paddlers use Paddle Board Overstock boards on the water."
    stories={[
      {
        quote:
          'The Explorer 11 was the perfect first board — stable enough that I stood up on my first try, and the complete package meant I was on the water the day it arrived.',
        narrative:
          'A first-time paddler from Colorado chose the SUP Explorer 11 after comparing beginner boards. The 32-inch width and non-slip deck made the first session a success — standing up within minutes on a calm lake, with the included pump inflating the board in under five minutes.',
        context: 'Beginner paddler, Colorado, USA, 2025',
        source: 'First-Time SUP Owner',
      },
      {
        quote:
          'We bought two boards for family lake weekends — the kids paddle around the shallows while we tour the shoreline. Two seasons in, both boards still hold full pressure overnight.',
        narrative:
          'A family of four in Ontario added a Cheetah Surge Edition and an Ocean Voyager Series board to their lake house gear. Both boards pack into their backpacks for easy storage, and after two summers of weekend use — including rocky shoreline landings — both still pass the overnight pressure test.',
        context: 'Family recreation, Ontario, Canada, 2024-2025',
        source: 'Weekend Lake Family',
      },
    ]}
  />
  <RelatedPages
    title="Explore More"
    subtitle="Related solutions and resources"
    links={[
      {
        title: 'Product Catalog',
        description: 'Browse the full range of inflatable SUP boards and accessories.',
        href: '/products',
        label: 'Shop',
      },
      {
        title: 'Engineering Perfection',
        description: 'Our engineering philosophy — precision manufacturing and rigorous quality control.',
        href: '/engineering-perfection',
        label: 'Philosophy',
      },
    ]}
  />

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      Use case guide for Paddle Board Overstock inflatable SUP boards. Five scenarios with recommended boards: beginner
      paddling (stable All-Around boards with complete packages), touring and exploration (streamlined Touring series),
      SUP yoga and fitness (wide Flowing Lotus platform), SUP fishing (stable Explorer 11 with gear mounts), and family
      recreation (high-capacity boards with size guide matching).
    </p>
  </section>
</Layout>
