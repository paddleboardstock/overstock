---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { SITE } from 'astrowind:config';

import communityData from '~/data/pages/community.yaml';

const page = merge({}, communityData);

const metadata = {
  title: `Community — Join the Paddle Board Overstock Paddling Community — ${SITE.name}`,
  description:
    'Real adventures from real people. Join thousands of paddlers exploring lakes, rivers, and coastlines with Paddle Board Overstock.',
};
---

<Layout metadata={metadata}>
  <Hero {...page.hero} />
  <Stats {...page.stats} />
  <Testimonials {...page.stories} />
  <CallToAction {...page.cta} />
</Layout>
