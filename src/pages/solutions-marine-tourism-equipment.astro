---
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Commercial RIBs for Marine Tourism Operators — ${SITE.name}`,
  description:
    'Purpose-built RIB boats for island transfers, whale watching, dolphin watching, snorkeling tours, and adventure tourism. Durable, stable, passenger-ready — with fleet branding options.',
};
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Solutions', href: '/solutions/' }, { name: 'Marine Tourism' }];
const ctaActions = [
  { variant: 'primary' as const, text: 'Request fleet pricing', href: '/contact' },
  { text: 'View RIB models', href: '/products' },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero
    tagline="Marine Tourism"
    title={'Commercial RIB Solutions<br />For Marine Tourism Operators'}
    subtitle="Purpose-built RIB boats for island transfers, snorkeling tours, whale watching, dolphin watching, and adventure tourism — durable, stable, and passenger-ready for daily marine tourism operations."
    image={{
      src: 'https://assets.aquafarer.com/images/aquafarer/hero/aquafarer-hero-design-concept.webp',
      alt: 'Aquafarer commercial RIB boats for marine tourism and island transfer operations',
    }}
  />
  <Stats
    title="Fleet Solutions"
    stats={[
      { title: 'Tourism Operators', amount: '200+' },
      { title: 'Rental-Proven Models', amount: '10+' },
      { title: 'Warranty', amount: '2-5 years' },
      { title: 'Custom Branding', amount: 'Logo, colors, packaging' },
    ]}
  />
  <Content
    tagline="The Challenge"
    title={'Marine Tourism Demands<br />Reliable, Passenger-Ready Vessels'}
    subtitle="Tourism operators need boats that can handle daily passenger transfers, varying sea conditions, and high guest expectations — while keeping maintenance low and operations profitable."
    content={'Island tourism operators in destinations like the Maldives, Philippines, Indonesia, and Thailand run daily passenger transfers, snorkeling trips, and marine excursions. Their boats operate 300+ days per year in saltwater environments with minimal downtime for maintenance.\n\n**Island transfers** require quick, comfortable passenger transport between resorts, airports, and dive sites. Passengers expect a smooth ride, easy boarding, and protection from sun and spray. A slow or uncomfortable boat directly impacts guest satisfaction and repeat bookings.\n\n**Whale and dolphin watching** operators need boats that can reach wildlife quickly, maintain stable viewing platforms, and operate quietly to avoid disturbing marine life. Speed, stability, and maneuverability are critical — passengers expect close encounters without feeling seasick.\n\n**Adventure tourism** companies run coastal exploration tours, cave excursions, and marine wildlife experiences. Their boats navigate varied environments — from open ocean to shallow coves — requiring versatile hull designs and reliable construction.\n\nAcross all segments, corrosion resistance, fuel efficiency, and passenger comfort are the top concerns. A boat that fails or requires frequent repairs means lost revenue, cancelled tours, and damaged reputation.'}
  />
  <Content
    tagline="Our Solution"
    title="Tourism-Grade RIBs<br />& Fleet Equipment"
    subtitle="Aquafarer provides both commercial RIB boats for passenger operations and fleet equipment (SUPs, kayaks, inflatables) for resort activity programs — all from a single supplier."
    content={'- Commercial passenger RIBs from 4.8m to 8m — configured for island transfers, snorkeling tours, and wildlife watching\n- Comfortable seating with backrests and sunshade — passenger comfort for 1-2 hour tour durations\n- Wide beam and deep-V hull for stability — reduces seasickness and improves passenger confidence\n- Quiet engine options for wildlife watching — minimal disturbance to marine animals\n- Dive ladder and swim platform — essential for snorkeling and swimming excursions\n- Custom branding and color schemes — your company logo and fleet livery on every vessel\n- Fleet pricing for bulk RIB orders — consistent specifications across multi-boat operations\n- SUP boards, kayaks, and inflatable boats for resort-based guest activity programs\n- Spare parts and maintenance support — minimize downtime during peak tourist seasons'}
  />
  <Content
    tagline="Tourism Segments"
    title="Marine Tourism Solutions<br />By Operation Type"
    subtitle="Different tourism operations require different boat configurations. Aquafarer matches the right RIB to your specific application."
    content={'_Island Transfer Operators — Fast, comfortable passenger transport_\n\nRunning daily guest transfers between airports, resorts, and dive sites requires a boat that is fast enough to minimize travel time, comfortable enough for guests with luggage, and reliable enough to never miss a scheduled run. Aquafarer configures RIBs with comfortable bench seating, T-top or Bimini sunshade, easy boarding steps, and ample dry storage for guest belongings.\n\nFeatures:\n- Comfortable seating with backrests for 8-16 passengers\n- T-top or Bimini sunshade for tropical sun protection\n- Wide boarding platform for easy guest access\n- Dry storage compartments for luggage and guest items\n- Fuel-efficient outboard configurations for daily multi-trip operations\n\n_Whale & Dolphin Watching — Fast, stable wildlife viewing platforms_\n\nWhale and dolphin watching operators need boats that can reach offshore viewing areas quickly, maintain a stable platform for photography and observation, and operate quietly to avoid disturbing marine life. Passenger comfort is critical during extended periods at sea. Aquafarer offers larger RIB configurations (7-10m) optimized for stability at rest and quiet operation.\n\nFeatures:\n- 7-10m RIB configurations for offshore capability\n- Quiet engine operation for minimal wildlife disturbance\n- Excellent stability at rest for comfortable viewing\n- Bow observation platform for photography\n- Sun and weather protection for passenger comfort\n\n_Adventure & Eco Tourism — Versatile RIBs for varied marine environments_\n\nAdventure tourism companies operate in diverse environments — from open ocean crossings to shallow lagoon exploration and coastal cave access. Their boats need versatility, durability, and shallow draft capability. Aquafarer configures adventure tourism RIBs with reinforced hulls, adaptable seating layouts, and equipment mounting options for specialized gear.\n\nFeatures:\n- Shallow draft for lagoon and coastal access\n- Reinforced hull and tubes for varied conditions\n- Flexible seating configurations for different tour types\n- Equipment mounting points for photography and gear\n- Heavy-duty Hypalon tubes for durability in mixed environments\n\n_Resort Activity Fleets — Complete water sports equipment for guest programs_\n\nResorts that offer water sports as part of the guest experience need reliable equipment fleets — RIBs for excursions, SUPs and kayaks for self-guided exploration, and inflatable boats for group activities. Aquafarer supplies complete fleet packages with consistent branding, safety equipment, and staff training support.\n\nFeatures:\n- RIB tenders for guest excursions and transfers\n- SUP boards and kayaks for self-guided guest activities\n- Inflatable boats for group tours and snorkeling trips\n- Full custom branding on all equipment\n- Safety equipment, training materials, and ongoing support'}
  />
  <Content
    tagline="Key Benefits"
    title="Why Aquafarer for<br />Marine Tourism"
    subtitle="Commercial RIBs and fleet equipment trusted by tourism operators in 50+ countries for daily passenger operations."
    content={'- Built for 300+ operating days per year — commercial-grade durability for daily tourism operations\n- Wide range of vessel sizes (3.3m to 8m) — one supplier for all your marine tourism needs\n- Hypalon or PVC tube options — choose based on your operating environment and budget\n- Custom fleet branding — unified look across all vessels and equipment with your company identity\n- Passenger comfort features — comfortable seating, sunshade, easy boarding, stable ride\n- Fast turnaround: 30-45 days for standard RIB configurations\n- Volume pricing for fleet orders of 3+ boats or 10+ equipment units'}
  />
  <CallToAction
    title="Build your tourism fleet"
    subtitle="Tell us about your passenger capacity, operating routes, and branding requirements — we will recommend the optimal RIB configuration for your tourism business."
    actions={ctaActions}
  />
</Layout>
