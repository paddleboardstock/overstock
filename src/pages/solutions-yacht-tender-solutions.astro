---
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Premium RIB Tenders for Superyachts — ${SITE.name}`,
  description:
    'Compact, stylish RIB tenders for superyachts. Custom colors, premium Hypalon materials, and configurations for builders, management companies, charter operators, and dealers.',
};
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Solutions', href: '/solutions/' },
  { name: 'Yacht Tender Solutions' },
];
const ctaActions = [{ variant: 'primary' as const, text: 'Configure your tender', href: '/contact' }];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero
    tagline="Yacht Tenders"
    title={'Premium RIB Tenders<br />For Superyachts & Recreational Vessels'}
    subtitle="Compact, stylish, and high-performance — Paddle Board Overstock RIB tenders complement your vessel with custom colors, premium materials, and the quality that discerning owners and builders expect."
    image={{
      src: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/categories/paddleboardoverstock-rib-boat-category.webp',
      alt: 'Paddle Board Overstock RIB tender for superyacht and recreational vessel applications',
    }}
  />
  <Stats
    title="Popular Tender Models"
    stats={[
      { title: 'RIB 330', amount: '3.3m — 4 persons' },
      { title: 'RIB 360', amount: '3.6m — 5 persons' },
      { title: 'RIB 390', amount: '3.9m — 6 persons' },
      { title: 'RIB 430', amount: '4.3m — 7 persons' },
    ]}
  />
  <Content
    tagline="The Challenge"
    title={'Yacht Tenders Require<br />Performance & Presentation'}
    subtitle="A yacht tender is more than a dinghy — it is an extension of the mother vessel and a statement of quality."
    content={'Yacht owners and captains need tenders that perform well, store compactly, and present beautifully. The tender should complement the yacht aesthetics while providing reliable transportation for guests and crew.\n\n**Storage is critical** — The tender must fit on deck, in a garage, or on davits. Weight matters for launch and recovery systems. Paddle Board Overstock RIBs offer excellent power-to-weight ratios with compact storage profiles.\n\n**Performance expectations are high** — Guests expect a smooth, dry ride when being transferred to shore. Engine options must balance speed, range, and noise levels for a premium experience. For charter operations, the tender runs daily and must withstand frequent use.\n\n**Appearance matters** — A mismatched or worn tender detracts from the overall yacht presentation. Custom tube colors, upholstery, and branding ensure the tender looks like it belongs.'}
  />
  <Content
    tagline="Our Solution"
    title="Tender Configurations<br />For Every Yacht Application"
    subtitle="Paddle Board Overstock RIB tenders can be customized to match your vessel, operation type, and storage requirements — from superyacht builder specs to charter fleet programs."
    content={'- Custom tube colors to match or complement mother vessel — any RAL color available for Hypalon or PVC tubes\n- Custom upholstery and stitching — premium marine-grade vinyl with color matching and logo embroidery\n- Console or tiller steering — choose based on usage pattern and operator preference\n- Fiberglass deep-V hull for smooth, dry ride in varying sea conditions\n- Compact storage — deflates or nests for deck garage, locker, or davit storage\n- Hypalon tubes for UV resistance and long-term appearance preservation\n- Lifting points and tow rings standard on all models\n- Optional bow cover, full cover, and protective chafe guards\n- Engine range: 15 HP to 60 HP — outboard or tiller configurations\n- OEM/private labeling available for yacht builders and marine dealers'}
  />
  <Content
    tagline="Customer Profiles"
    title="Yacht Tender Solutions<br />By Customer Type"
    subtitle="Different yacht industry segments have unique requirements. Paddle Board Overstock configures tenders to match each application."
    content={'_Superyacht Builders — OEM integration from spec to delivery_\n\nYacht builders require tenders that match exact dimensional specifications, weight limits, and aesthetic standards. The tender must integrate with davit systems, garage dimensions, and the overall design language of the vessel. Paddle Board Overstock works directly with builder procurement teams to deliver tenders with custom RAL tube colors, matching upholstery, branded console panels, and OEM documentation packages.\n\nFeatures:\n- Custom dimensions and weight specifications\n- Any RAL tube color matching builder standards\n- OEM branding on console and tube\n- Davit and garage fit validation\n- Bulk delivery scheduling for production timelines\n\n_Yacht Management Companies — Reliable tenders for global fleet operations_\n\nManagement companies oversee multiple yachts operating worldwide. They need tenders that are reliable, easy to maintain, and consistent across the fleet. Standardization reduces training time for crew and simplifies spare parts management. Paddle Board Overstock offers fleet pricing, consistent specifications, and global spares support.\n\nFeatures:\n- Standardized fleet specifications\n- Consistent parts and service documentation\n- Fleet pricing and volume discounts\n- Global spare parts availability\n- Multi-unit delivery coordination\n\n_Yacht Charter Operators — Built for daily guest transfer operations_\n\nCharter tenders face the most demanding operational schedule — daily guest transfers, shore trips, water sports support, and port tendering. The tender must look pristine at all times while withstanding frequent boarding, saltwater exposure, and continuous engine hours. Paddle Board Overstock configures charter tenders with upgraded upholstery, heavy-duty tube materials, and reinforced handling areas.\n\nFeatures:\n- Heavy-duty Hypalon tubes for daily use\n- Reinforced boarding and handling areas\n- Premium upholstery with stain-resistant vinyl\n- Easy-clean deck surfaces\n- Reliable outboard packages with easy service access\n\n_Yacht Dealers & Brokers — Inventory tenders for vessel completion and resale_\n\nDealers and brokers need tenders that complement the vessels they sell, with reliable supply, consistent quality, and attractive presentation. A well-chosen tender can enhance the appeal of a yacht listing. Paddle Board Overstock offers dealer inventory programs with flexible ordering, seasonal delivery scheduling, and co-branding options for dealer showrooms.\n\nFeatures:\n- Inventory stocking programs\n- Flexible delivery scheduling\n- Dealer co-branding options\n- Consistent quality across batches\n- Competitive dealer pricing'}
  />
  <Content
    tagline="Key Benefits"
    title="Why Paddle Board Overstock as<br />Your Yacht Tender"
    subtitle="Premium yacht tenders chosen by superyacht owners, builders, charter operators, and dealers worldwide."
    content={'- Lightweight and compact when deflated — easy to store in garage, locker, or deck cradle\n- Hypalon construction — superior UV resistance for marina storage in tropical sun\n- Stable and comfortable ride for guest transfers in varying sea conditions\n- Custom upholstery, tube colors, and branding to match your yacht perfectly\n- Outboard range: 15 HP to 60 HP for tender and dinghy applications\n- Fast turnaround: 25-45 days from order to shipment for standard tender configurations\n- Fleet pricing available for multi-unit yacht builder and management company programs'}
  />
  <CallToAction
    title="Specify your tender"
    subtitle="Tell us about your vessel, storage arrangement, and guest transfer requirements — we will recommend the ideal tender configuration for your operation."
    actions={ctaActions}
  />
</Layout>
