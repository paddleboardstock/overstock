---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Checkout Cancelled">
  <div class="mx-auto max-w-lg py-12 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 text-3xl">!</div>
    <h1 class="mt-6 text-2xl font-bold">Checkout cancelled</h1>
    <p class="mt-3 text-sm text-slate-600">
      No payment was taken for order <span id="order-number" class="font-mono font-semibold"></span>.
      Your stock reservation is held for a short window — you can retry from the order page before it expires.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/orders/" class="btn-primary">View My Order</a>
      <a href="/products/" class="btn-secondary">Back to Catalog</a>
    </div>
  </div>
</Layout>

<script>
  const order = new URLSearchParams(location.search).get('order');
  if (order) {
    document.getElementById('order-number')!.textContent = order;
    document.title = `Checkout cancelled · Paddle Board Overstock Shop`;
  }
</script>
