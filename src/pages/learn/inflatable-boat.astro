---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Inflatable Board Technology — Construction, Materials & Care — ${SITE.name}`,
  description:
    'Technical guides on inflatable SUP boards — drop-stitch construction, materials, manufacturing, care, and repair.',
};
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Learn' }, { name: 'Board Technology' }];

const topics = [
  {
    title: 'How Boards Are Made',
    desc: 'From material cutting and lamination to 100% pressure testing — see how every board leaves the factory.',
    href: '/factory/process',
  },
  {
    title: 'Drop-Stitch Technology',
    desc: 'How thousands of internal threads create rigid, high-pressure inflatable structures.',
    href: '/learn/drop-stitch-core',
  },
  {
    title: 'Materials Reference',
    desc: 'PVC denier ratings, fabric weights, UV resistance, and what makes a durable board.',
    href: '/learn/materials',
  },
  {
    title: 'Inflatable Technology',
    desc: 'Welded seams, rail construction, and valve systems explained.',
    href: '/learn/inflatable-technology',
  },
  {
    title: 'How to Choose a Board',
    desc: 'Construction, thickness, fin setup, and included accessories — pick the right SUP for you.',
    href: '/guides/how-to-choose-your-sup/',
  },
  {
    title: 'Board Maintenance',
    desc: 'Cleaning, storage, valve care, and off-season tips for inflatable SUPs.',
    href: '/v2/inflatable-sup-maintenance',
  },
  {
    title: 'Board Repair',
    desc: 'Fix small punctures, seam leaks, and valve issues with a PVC repair kit.',
    href: '/v2/inflatable-sup-repair',
  },
  {
    title: 'Water Safety',
    desc: 'Essential safety equipment, PFD requirements, and paddling guidelines.',
    href: '/learn/water-safety',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <JsonLd
    type="Article"
    article={{
      headline: metadata.title,
      description: metadata.description,
      datePublished: '2024-12-01',
      dateModified: '2025-06-10',
    }}
  />
  <section class="px-6 py-16 max-w-5xl mx-auto text-center">
    <p class="text-sm font-semibold text-primary uppercase tracking-wider">Board Technology</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">Inflatable SUP Board Guides</h1>
    <p class="mt-3 text-lg text-muted max-w-2xl mx-auto">
      Technical guides covering construction, materials, care, and repair of inflatable paddle boards.
    </p>
  </section>

  <section class="px-6 pb-20 max-w-6xl mx-auto">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        topics.map((t) => (
          <a
            href={t.href}
            class="group block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-0.5"
          >
            <h3 class="font-semibold text-gray-900 group-hover:text-sky-600 transition-colors">{t.title}</h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed">{t.desc}</p>
            <span class="mt-4 inline-flex text-sm font-medium text-sky-600 group-hover:text-sky-700">Read guide →</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
