---
import merge from 'lodash.merge';
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/widgets/ProductCard.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Icon from '~/components/ui/Icon.astro';

import { SITE } from 'astrowind:config';
import {
  getProducts,
  getProductCategories,
  isProductsEnabled,
  isProductsListEnabled,
  urlSlugToCategory,
  CATEGORY_SLUG_TO_URL,
} from '~/utils/products';
import { PRODUCT_LIST, getCanonical, getPermalink } from '~/utils/permalinks';
import { breadcrumbNode, collectionNode } from '~/utils/schema-graph';
import type { MetaData } from '~/types';

export const prerender = true;

export async function getStaticPaths() {
  const categories = await getProductCategories();
  return categories.map((c) => ({
    params: { category: CATEGORY_SLUG_TO_URL[c.slug] },
  }));
}

const { category: urlSlug } = Astro.params;
const activeCategory = urlSlugToCategory(urlSlug || '')!;

if (!activeCategory) {
  Astro.redirect('/404');
}

const CATEGORY_COPY: Record<string, { title: string; description: string; h1: string; subtitle: string }> = {
  'rib-boats': {
    title: `RIBs & Inflatable Patrol Boats 2.5\u20137.6 m | OEM/ODM | ${SITE.name}`,
    description: `Commercial-grade RIBs with aluminium or fibreglass hulls \u2014 2.5\u20137.6 m, Hypalon/PVC tubes, CE certified. OEM/ODM patrol, rescue & tender boats from MOQ 2\u20135 units.`,
    h1: 'Commercial & Patrol RIBs \u2014 2.5\u20137.6 m, OEM/ODM',
    subtitle: 'Aluminium-hull rigid inflatable boats for patrol, rescue, diving and yacht tender fleets.',
  },
  'inflatable-boats': {
    title: `Inflatable Boats & Dinghies | Marine-Grade PVC & Hypalon | ${SITE.name}`,
    description: `Inflatable dinghies, boats and tenders in marine-grade PVC and Hypalon \u2014 drop-stitch floors, 1.5\u00d7 pressure-tested, CE certified. Factory-direct OEM/ODM.`,
    h1: 'Inflatable Boats & Dinghies \u2014 PVC & Hypalon, Factory Direct',
    subtitle: 'Marine-grade inflatable dinghies and boats for tenders, rentals and commercial fleets.',
  },
  supboard: {
    title: `Inflatable SUP Boards & Paddleboards | Drop-Stitch, OEM | ${SITE.name}`,
    description: `Drop-stitch inflatable paddle boards at 12\u201315 PSI with EVA decks \u2014 all-round, touring, yoga, fishing and kids models. OEM/ODM from MOQ 5\u201310 units.`,
    h1: 'Inflatable SUP Boards \u2014 Drop-Stitch, 12\u201315 PSI, OEM',
    subtitle: 'Drop-stitch paddleboards built for rentals, resorts and retail brands.',
  },
  accessory: {
    title: `Inflatable Boat & SUP Accessories | Pumps, Paddles, Fins | ${SITE.name}`,
    description: `Factory-direct inflatable boat and SUP accessories \u2014 electric pumps, paddles, fins, repair kits, life vests and covers. Wholesale OEM/ODM available.`,
    h1: 'Pumps, Paddles, Fins & Repair Kits \u2014 Factory Direct',
    subtitle: 'Everything your rental fleet or retail line needs \u2014 from electric pumps to repair kits.',
  },
  kayaks: {
    title: `Inflatable Kayaks & Catamaran Kayaks | Drop-Stitch, OEM | ${SITE.name}`,
    description: `Drop-stitch inflatable kayaks and catamaran kayaks \u2014 full drop-stitch performance touring, hybrid recreational, and stable twin-hull KaBoat models. Factory-direct OEM/ODM.`,
    h1: 'Inflatable Kayaks & Catamarans \u2014 Drop-Stitch, Factory Direct',
    subtitle: 'Rigid drop-stitch hulls and stable twin-hull platforms for touring, fishing and rental fleets.',
  },
};

const copy = CATEGORY_COPY[urlSlug];

const products = await getProducts();
const categories = await getProductCategories();
const filteredProducts = products.filter((p) => p.category === activeCategory);
const totalCount = products.length;
const hidden = !isProductsEnabled() || !isProductsListEnabled();

const metadata = merge(
  {
    title: copy ? copy.title : `${activeCategory.toUpperCase()} \u2014 Inflatable Boat & SUP Products | ${SITE.name}`,
    description: copy
      ? copy.description
      : `Browse ${SITE.name} ${activeCategory} products \u2014 OEM/ODM available. Factory-direct pricing.`,
    canonical: getCanonical('/' + urlSlug + '/'),
    robots: { index: !hidden, follow: true },
    openGraph: { type: 'website' },
  },
  {}
) as MetaData;

const catalogUrl = '/' + urlSlug + '/';
const categoryGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    ...collectionNode({
      path: catalogUrl,
      name: copy ? copy.h1 : activeCategory,
      description: copy ? copy.description : `Browse ${SITE.name} ${activeCategory} products`,
      items: filteredProducts.map((p) => ({
        name: p.title,
        path: `/products/${p.slug}/`,
        ...(p.image ? { image: p.image } : {}),
      })),
    }),
    breadcrumbNode([
      { name: 'Home', path: '/' },
      { name: copy ? copy.h1 : activeCategory, path: catalogUrl },
    ]),
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(categoryGraph)} />
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
    <header class="mb-8 md:mb-12 text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-400 mb-2">Catalog</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        {copy ? copy.h1 : `Aquafarer ${urlSlug}`}
      </h1>
      <p class="mt-3 md:mt-4 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        {copy ? copy.subtitle : `Premium ${urlSlug} — built for life on the water.`}
      </p>
    </header>

    {
      categories.length > 0 && (
        <WidgetWrapper containerClass="mb-10">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <a
              href={getPermalink(PRODUCT_LIST)}
              class:list={[
                'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
              ]}
            >
              <Icon name="tabler:layout-grid" class="w-4 h-4" />
              All ({totalCount})
            </a>
            {categories.map((c) => {
              const catUrl = CATEGORY_SLUG_TO_URL[c.slug];
              return (
                <a
                  href={getPermalink(catUrl)}
                  class:list={[
                    'inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition-colors',
                    activeCategory === c.slug
                      ? 'bg-primary text-white border-primary dark:bg-blue-500 dark:border-blue-500'
                      : 'bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-700',
                  ]}
                >
                  {c.title} ({c.count})
                </a>
              );
            })}
          </div>
        </WidgetWrapper>
      )
    }

    <!-- Category Catalog Download -->
    {
      (activeCategory === 'sup' || activeCategory === 'rib' || activeCategory === 'inflatable') && (
        <WidgetWrapper containerClass="mb-10">
          <div class="flex flex-wrap items-center justify-center gap-4">
            {activeCategory === 'sup' && (
              <a
                href="/catalogs/aquafarer-sup-catalog.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-sky-50 dark:bg-sky-900/30 border border-sky-200 dark:border-sky-800 text-sky-700 dark:text-sky-300 text-sm font-medium rounded-full hover:bg-sky-100 dark:hover:bg-sky-900/50 transition-colors"
              >
                <Icon name="tabler:download" class="w-4 h-4" />
                Download SUP Board Catalog
              </a>
            )}
            {(activeCategory === 'rib' || activeCategory === 'inflatable') && (
              <a
                href="/catalogs/aquafarer-inflatable-boat-catalog.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-sm font-medium rounded-full hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition-colors"
              >
                <Icon name="tabler:download" class="w-4 h-4" />
                Download Inflatable Boat Catalog
              </a>
            )}
          </div>
        </WidgetWrapper>
      )
    }

    {
      filteredProducts.length === 0 ? (
        <div class="text-center py-16 text-muted dark:text-slate-400">
          <Icon name="tabler:package-off" class="w-12 h-12 mx-auto mb-4" />
          <p class="text-lg">No products in this category yet.</p>
          <a
            class="text-primary dark:text-blue-400 hover:underline mt-2 inline-block"
            href={getPermalink(PRODUCT_LIST)}
          >
            View all products
          </a>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {filteredProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      )
    }
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>Aquafarer product catalog — {urlSlug} category.</p>
  </section>
</Layout>
