---
import PageLayout from '~/layouts/PageLayout.astro';
import { articleSchema } from '~/lib/seo/schema';
import { nodes } from '~/content/graph/nodes';
import { getPageContent, setPageContentData } from '~/i18n/page-content';
import __pageData from '~/i18n/generated/pages/search-and-rescue.ts';

const lang = 'en';
setPageContentData(__pageData);
const page = getPageContent(lang, 'search-and-rescue');
const node = nodes.find((n) => n.id === 'search-and-rescue');

const graphJsonLd = node
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        articleSchema({
          headline: page.seo?.headline || 'Search & Rescue Inflatable Boats — OEM Manufacturing for SAR Operations',
          description:
            page.seo?.description ||
            'Paddle Board Overstock manufactures professional-grade inflatable boats for search and rescue operations. Hypalon and PVC construction, custom SAR configurations.',
          datePublished: page.seo?.datePublished || '2024-06-01',
          dateModified: page.seo?.dateModified || '2026-06-01',
          author: 'Paddle Board Overstock',
          publisher: 'Paddle Board Overstock',
        }),
        {
          '@type': 'Product',
          name: node?.name?.en || 'Search & Rescue Inflatable Boats',
          description:
            node?.description?.en || 'Professional-grade inflatable boats designed for search and rescue operations.',
          brand: { '@type': 'Brand', name: 'Paddle Board Overstock' },
          category: 'Search & Rescue Equipment',
        },
      ],
    }
  : null;

const metadata = {
  title: page.seo?.headline || 'Search & Rescue Inflatable Boats — OEM Manufacturing for SAR Operations',
  description:
    page.seo?.description ||
    'Paddle Board Overstock manufactures professional-grade inflatable boats for search and rescue operations. Hypalon and PVC construction, custom SAR configurations.',
};
---

<PageLayout metadata={metadata}>
  <script
    slot="before"
    is:inline
    type="application/ld+json"
    set:html={graphJsonLd ? JSON.stringify(graphJsonLd) : ''}
  />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">{page.label || 'Use Case'}</span>
    <h1 class="font-semibold text-gray-900 dark:text-gray-100 mt-4 text-4xl">
      {page.headline || 'Superior Inflatable Boats for Search and Rescue Operations'}
    </h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mt-3">
      {page.subtitle || 'Engineered for the uncompromising reliability that life-saving missions demand.'}
    </p>

    <div class="mt-12 prose prose-gray dark:prose-invert max-w-none" set:html={page.body || ''} />
  </section>
</PageLayout>
