---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { SITE } from 'astrowind:config';
import useCasesData from '~/data/site/use-cases.yaml';

interface UseCaseEntry {
  id: string;
  title: string;
  desc: string;
  image: string;
}

const d = useCasesData as any;
const useCases: UseCaseEntry[] = (d.cases ?? []).map((c: any) => ({
  id: c.id,
  title: c.title,
  desc: c.desc,
  image: c.image,
}));

const staticUseCases = [
  {
    id: 'tourism-recreation',
    title: 'Tourism & Recreation',
    desc: 'Whitewater rafts, fishing boats, dinghies, and SUP boards for tourism operators and rental fleets.',
    image: 'https://assets.aquafarer.com/images/aquafarer/use-cases/aquafarer-professional-use-case.webp',
  },
  {
    id: 'search-and-rescue',
    title: 'Search & Rescue',
    desc: 'Inflatable rescue boats and RIBs for emergency response, coast guard, and water rescue operations.',
    image: 'https://assets.aquafarer.com/images/aquafarer/categories/aquafarer-rescue-operations.webp',
  },
  {
    id: 'maritime-safety-defense',
    title: 'Maritime Safety & Defense',
    desc: 'Military-grade inflatable craft for patrol, defense, and maritime security applications.',
    image: 'https://assets.aquafarer.com/images/aquafarer/products/rib/aquafarer-rib-600.webp',
  },
  {
    id: 'fishing',
    title: 'Fishing',
    desc: 'Stable inflatable boats and kayaks for recreational and commercial fishing in lakes, rivers, and coastal waters.',
    image: 'https://assets.aquafarer.com/images/aquafarer/products/aquafarer-inflatable-boat.webp',
  },
  {
    id: 'disaster-relief',
    title: 'Disaster Relief & Humanitarian Aid',
    desc: 'Deployable inflatable craft for flood rescue, humanitarian aid delivery, and emergency response.',
    image: 'https://assets.aquafarer.com/images/aquafarer/products/rib/aquafarer-rib-330-boat.webp',
  },
  {
    id: 'commercial-workboats',
    title: 'Commercial Workboats',
    desc: 'Heavy-duty inflatable workboats for diving support, transport, and commercial marine operations.',
    image: 'https://assets.aquafarer.com/images/aquafarer/factory/aquafarer-stock-boat-inventory.webp',
  },
];

const allUseCases = [...useCases, ...staticUseCases];

const metadata = {
  title: `Use Cases & Applications | ${SITE.name}`,
  description: `Explore how Aquafarer inflatable watercraft are used across tourism, rescue, fishing, recreation, defense, disaster relief, and commercial operations.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <JsonLd
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      headline: 'Use Cases & Applications',
      description: metadata.description,
      author: { '@type': 'Organization', name: SITE.name },
    }}
  />

  <div class="max-w-6xl mx-auto px-6 py-16">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-sky-600">{SITE.name}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">Use Cases</span>
    </nav>

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-sm font-medium text-sky-600 tracking-wide uppercase">Use Cases</span>
      <h1 class="mt-4 text-4xl font-bold text-gray-900">Applications & Use Cases</h1>
      <p class="mt-4 text-lg text-gray-500">
        From first-time paddlers to professional operators — Aquafarer equips every water adventure.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        allUseCases.map((uc) => (
          <a
            href={`/use-cases/${uc.id}`}
            class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-0.5 flex flex-col"
          >
            <div class="h-44 bg-gray-100 overflow-hidden">
              <img
                src={uc.image}
                alt={uc.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h2 class="text-lg font-semibold text-gray-900 group-hover:text-sky-700 transition-colors mb-2">
                {uc.title}
              </h2>
              <p class="text-sm text-gray-500 line-clamp-3 flex-1">{uc.desc}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-sky-700">
                View use case &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
