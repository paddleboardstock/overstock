---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'R&D Center', href: '/randdcenter' },
  { name: 'RF Welding Center' },
];

const metadata = {
  title: `RF Welding Center — Dielectric Bonding for Airtight Seams | ${SITE.name}`,
  description: `Radio-frequency welding technology delivering ISO 6185 compliant airtight seams. Peel testing, air-retention validation, and custom seam specifications. Discuss your welding requirements with our team.`,
};
import RfWeldingEn from '~/components/randdcenter/rf-welding.en.astro';
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <RfWeldingEn lang="en" />
</Layout>
