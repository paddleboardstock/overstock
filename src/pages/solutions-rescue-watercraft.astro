---
export const prerender = true;

import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Rescue Watercraft — ${SITE.name} | Search & Rescue RIBs`,
  description:
    'High-speed RIBs engineered for search and rescue, coast guard operations, and emergency response. Self-bailing decks, reinforced hulls, navigation suites.',
};
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Solutions', href: '/solutions/' }, { name: 'Rescue Watercraft' }];
const ctaActions = [
  { variant: 'primary' as const, text: 'Talk to our SAR team', href: '/contact' },
  { text: 'View patrol RIB models', href: '/products' },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <Hero
    tagline="Rescue & Emergency"
    title={'Rescue Watercraft<br />For Life-Saving Missions'}
    subtitle="High-speed RIBs engineered for search and rescue, coast guard operations, and emergency response — where reliability is not optional."
    image={{
      src: 'https://assets.paddleboardoverstock.com/images/paddleboardoverstock/categories/paddleboardoverstock-rescue-operations.webp',
      alt: 'Paddle Board Overstock rescue RIB boat for search and rescue operations',
    }}
  />
  <Stats
    title="Popular Rescue RIB Models"
    stats={[
      { title: 'RIB 450 Patrol', amount: '4.5m — 6 persons' },
      { title: 'RIB 600 Patrol', amount: '6.0m — 10 persons' },
      { title: 'RIB 680', amount: '6.8m — 12 persons' },
      { title: 'RIB 760', amount: '7.6m — 15 persons' },
    ]}
  />
  <Content
    tagline="The Challenge"
    title={'Rescue Operations Demand<br />Uncompromising Reliability'}
    subtitle="Search and rescue organizations need boats that start every time, perform in extreme conditions, and carry the equipment needed for life-saving missions."
    content={'In rescue operations, the margin between success and failure is measured in minutes. The boat must be ready to launch immediately, operate in rough conditions, and return safely with passengers.\n\nSAR boats need high speed to reach victims quickly, combined with exceptional stability for safe recovery operations. They must carry rescue equipment, medical supplies, and communication gear — often in limited deck space.\n\nVisibility, both for the operator and for searching, is critical. Console design must provide 360-degree visibility, and the boat should be highly visible to aircraft and other vessels.\n\nPaddle Board Overstock rescue RIBs are engineered from the keel up for these requirements — with self-bailing decks, reinforced hulls, navigation suites, and tow posts standard on patrol models.'}
  />
  <Content
    tagline="Our Solution"
    title="Purpose-Built Rescue RIBs"
    subtitle="Every Paddle Board Overstock rescue boat is designed to meet or exceed SOLAS and national SAR standards."
    content={'- Self-bailing deck — water drains automatically for stability during recovery operations\n- Reinforced deep-V hull — rough-water capability with predictable handling at speed\n- Full navigation light suite — operational day and night in all weather conditions\n- Tow post and tow line — ready for vessel tow or rescue sled operations\n- Equipment mounting plates — radio, searchlight, siren, and medical equipment\n- Multiple engine configurations — single outboard or twin-engine redundancy\n- High-visibility tube colors — orange, yellow, or red for maximum visibility'}
  />
  <Content
    tagline="Key Benefits"
    title="Why Paddle Board Overstock for Rescue Operations"
    subtitle="Professional SAR watercraft trusted by coast guards, lifeguards, and civil defense agencies."
    content={'- Military-grade Hypalon/PVC construction — withstands extreme conditions\n- Self-bailing deck design for rapid water clearance\n- Multiple independent air chambers — redundant buoyancy for maximum safety\n- Custom console and electronics integration (GPS, radar, VHF, searchlights)\n- SOLAS reflective tape and high-visibility color options\n- Twin-engine configuration available for mission-critical redundancy'}
  />
  <CallToAction
    title="Discuss your rescue requirements"
    subtitle="Our team has supplied rescue organizations worldwide. We understand procurement requirements and can provide compliance documentation."
    actions={ctaActions}
  />
</Layout>
