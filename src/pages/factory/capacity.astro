---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: `Production Capacity — Inflatable SUP Board Factory Output | ${SITE.name}`,
  description: `${SITE.name} factory capacity: 12,000 m² facility, 15,000 boards/year, 200-300 workers, 6 specialized workshops for all-around, touring, and art-series SUP production.`,
};

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Factory', href: '/factory' }, { name: 'Production Capacity' }];

const highlights = [
  { value: '12,000 m²', label: 'Total manufacturing floor', detail: 'Across 6 specialized workshops' },
  { value: '15,000', label: 'Boards produced annually', detail: 'All-around, touring & art-series SUPs' },
  { value: '200-300', label: 'Skilled workforce', detail: '25+ engineers, 2 shifts/day' },
  { value: '50+', label: 'Shipping countries', detail: 'EU, US, AU, Middle East, Asia' },
  { value: '2-3', label: 'Business days to dispatch', detail: 'In-stock orders leave Weihai fast' },
  { value: '10+', label: 'Years of export experience', detail: 'Since 2012' },
];

const workshops = [
  {
    title: 'SUP Board Production',
    description:
      '4 parallel assembly lines for inflatable SUP boards. Each line can produce 50–80 boards per shift. Digital printing and screen printing stations run concurrently. Annual SUP capacity: 8,000+ boards.',
    output: '8,000+ SUPs/year',
  },
  {
    title: 'Deck Art & EVA Finishing',
    description:
      'Dedicated finishing workshop for art-series decks. Precision EVA cutting, hand-laid deck patterns, and final trim. Annual capacity covers the full art-series range.',
    output: 'Full art-series range',
  },
  {
    title: 'Drop-Stitch Lamination',
    description:
      'Heat-lamination lines bond drop-stitch cores to outer PVC laminates. Rail bands are triple-layer fusion bonded for airtight strength. Annual capacity: 15,000+ cores.',
    output: '15,000+ cores/year',
  },
  {
    title: 'Accessories & Packaging',
    description:
      'Accessory assembly and packing lines for pumps, paddles, leashes, and repair kits. Boards are vacuum-packed, boxed, and palletized for worldwide shipping.',
    output: 'Complete packages, ready to ship',
  },
];
---

<Layout metadata={metadata} breadcrumbs={crumbs}>
  <meta name="ai-intent" content="inflatable-sup-factory-capacity,sup-board-production,sup-manufacturing" />
  <section class="px-6 sm:px-6 py-16 sm:py-20 lg:py-24 mx-auto max-w-5xl text-center">
    <a href="/factory" class="text-sm text-gray-500 hover:underline">&larr; Back to Factory</a>
    <p class="mt-4 text-sm font-semibold text-primary uppercase tracking-wider">{SITE.name}</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold">Production Capacity</h1>
    <p class="mt-3 text-lg text-muted">12,000 m² facility producing 15,000 boards per year with room to scale</p>
  </section>

  <section class="px-6 sm:px-6 pb-16 mx-auto max-w-4xl">
    <p class="text-muted leading-relaxed">
      {SITE.name} operates one of the largest dedicated inflatable SUP board manufacturing facilities in Weihai, China. Our
      12,000 m² factory is organized into six specialized workshops operating in parallel, giving us the capacity to produce
      15,000 boards annually across all-around, touring, and art-series SUP lines.
    </p>
  </section>

  <section class="px-6 sm:px-6 pb-8 mx-auto max-w-6xl">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      {
        highlights.map((s) => (
          <div class="text-center p-6 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
            <span class="block text-3xl font-bold text-primary">{s.value}</span>
            <span class="block text-sm text-muted mt-1">{s.label}</span>
            <span class="block text-xs text-muted mt-1">{s.detail}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-6xl">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">By Product Line</p>
      <h2 class="mt-2 text-3xl font-bold">Production Capacity by Category</h2>
      <p class="mt-3 text-muted max-w-2xl mx-auto">
        Dedicated production lines for each product category, running in parallel for maximum throughput.
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {
        workshops.map((w) => (
          <div class="p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xl font-bold">{w.title}</h3>
              <span class="text-sm font-semibold text-primary">{w.output}</span>
            </div>
            <p class="text-sm text-muted leading-relaxed">{w.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- How to Order -->
  <section class="px-6 sm:px-6 py-16 mx-auto max-w-5xl bg-gray-50 dark:bg-gray-900 rounded-2xl">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">Factory-Direct</p>
      <h2 class="mt-2 text-3xl font-bold">Direct From the Factory to Your Door</h2>
      <p class="mt-3 text-muted max-w-2xl mx-auto">
        No middlemen, no retail markup — clearance pricing on the same pressure-tested boards.
      </p>
    </div>
    <div class="max-w-3xl mx-auto space-y-3">
      <div
        class="flex items-center justify-between p-4 rounded-lg bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800"
      >
        <span class="font-medium">Order Dispatch</span>
        <span class="text-sm text-muted text-right">In-stock orders ship in 2-3 business days</span>
      </div>
      <div
        class="flex items-center justify-between p-4 rounded-lg bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800"
      >
        <span class="font-medium">Tracked Shipping</span>
        <span class="text-sm text-muted">Delivery to 50+ countries worldwide</span>
      </div>
      <div
        class="flex items-center justify-between p-4 rounded-lg bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800"
      >
        <span class="font-medium">No Minimum Order</span>
        <span class="text-sm text-muted">Buy exactly what you need — one board or a family fleet</span>
      </div>
      <div
        class="flex items-center justify-between p-4 rounded-lg bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800"
      >
        <span class="font-medium">Warranty</span>
        <span class="text-sm text-muted">Every board covered by a 2-year SUP warranty</span>
      </div>
    </div>
  </section>

  <section class="sr-only" data-ai-block="definition" aria-hidden="true">
    <p>
      {SITE.name} inflatable SUP board factory production capacity. 12,000 m² facility in Weihai, China producing 15,000 boards
      annually. Workshops: SUP board production (8,000+/year), deck art and EVA finishing, drop-stitch lamination (15,000+
      cores/year), and accessories and packaging. 200-300 skilled workers, 25+ engineers, 2 shifts per day. Shipping to 50+
      countries since 2012. In-stock orders dispatch in 2-3 business days.
    </p>
  </section>

  <section class="px-6 sm:px-6 py-16 mx-auto max-w-4xl text-center">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-8">
      <h2 class="text-xl font-bold">See what's in stock</h2>
      <p class="mt-2 text-sm text-muted">
        Browse current factory overstock and clearance boards — complete packages at up to 60% off retail.
      </p>
      <a
        href="/products"
        class="mt-4 inline-block px-6 py-3 bg-primary text-white font-semibold rounded-md hover:bg-primary/90"
        >Shop boards →</a
      >
    </div>
  </section>
</Layout>
