{
  "name": "paddleboardoverstock-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:worker": "tsc --noEmit -p workers/shop-api",
    "deploy:worker": "wrangler deploy --config workers/shop-api/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply paddleboardoverstock-shop-db --local --config workers/shop-api/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply paddleboardoverstock-shop-db --remote --config workers/shop-api/wrangler.toml",
    "worker:dev": "wrangler dev --config workers/shop-api/wrangler.toml",
    "seed:sql": "node scripts/seed-stock.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
